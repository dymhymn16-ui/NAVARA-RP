new bool:usedBotNames[sizeof(botNames)];

new const botColors[] = {
    0x0000FEFF,
    0x996533FF,
    0x238C18FF,
    0x29a1e5FF,
    0xffff00AA,
    0x00CCFFAA,
    0xA1AAADBB,
    0x880000BB
};
new const botColorsCount = sizeof(botColors);
const mainBotColor = 0xFFFFFF80;

stock bool:StartsWith(const str[], const prefix[])
{
    new i;
    for(i = 0; prefix[i] != '\0'; i++)
    {
        if(str[i] == '\0' || str[i] != prefix[i])
            return false;
    }
    return true;
}

stock UInt32:ChooseBotColor(playerid)
{
    new score = GetPlayerScore(playerid);

    if(score >= 1 && score <= 6)
        return mainBotColor;

    new r = random(99);
    if(r < 65) return mainBotColor;

    new idx = random(botColorsCount - 1);
    return botColors[idx];
}

stock bool:AssignRandomBotName(playerid)
{
    new playerName[24];
    GetPlayerName(playerid, playerName, sizeof(playerName));

    if(!StartsWith(playerName, "botuser_"))
        return false;

    new availableNames[sizeof(botNames)];
    new count = 0;

    for(new i = 0; i < sizeof(botNames); i++)
    {
        if(!usedBotNames[i])
        {
            availableNames[count++] = i;
        }
    }

    if(count == 0)
        return false;

    new randIndex = random(count - 1);
    new selected = availableNames[randIndex];

    new botName[MAX_PLAYER_NAME];

    format(botName, sizeof botName, "%s", botNames[selected]);

    if(random(2) == 1)
    {
        if(random(10) < 4)
        {
            format(botName, sizeof botName, "%s[PC]", botNames[selected]);
        }
        else if(random(15) <= 2)
        {
            format(botName, sizeof botName, "%s[VIP]", botNames[selected]);
        }
        else if(random(50) <= 2)
        {
            format(botName, sizeof botName, "%s[PC][VIP]", botNames[selected]);
        }
    }

    SetPlayerName(playerid, botName);
    usedBotNames[selected] = true;

    new chance2 = random(100);
    if(chance2 < 50)
    {
        SetPlayerScore(playerid, random(18) + 1);
    }
    else if(chance2 < 85)
    {
        SetPlayerScore(playerid, random(24) + 15);
    }
    else
    {
        SetPlayerScore(playerid, random(21) + 38);
    }

    new color = ChooseBotColor(playerid);
    SetPlayerColor(playerid, color);

    new Float:x = 0.0, y = 0.0, z = 3.0;
    SetPlayerPos(playerid, x, y, z);

    return true;
}

stock bool:FreeBotName(playerid)
{
    new playerName[24];
    GetPlayerName(playerid, playerName, sizeof(playerName));

    for(new i = 0; i < sizeof(botNames); i++)
    {
        if(strcmp(playerName, botNames[i], true) == 0)
        {
            usedBotNames[i] = false;
            return true;
        }
        if(StartsWith(playerName, botNames[i]))
        {
            usedBotNames[i] = false;
            return true;
        }
    }

    return false;
}

stock bool:isBotPlayer(playerid)
{
    new playerName[24];
    GetPlayerName(playerid, playerName, sizeof(playerName));

    for(new i = 0; i < sizeof(botNames); i++)
    {
        if(strcmp(playerName, botNames[i], true) == 0)
        {
            return true;
        }
    }

    if(StartsWith(playerName, "botuser_"))
        return true;

    return false;
}

forward KickRandomBots();
public KickRandomBots()
{
    new count = random(5)+1;
    new players[MAX_PLAYERS], pcount;

    for(new i=0; i<MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && isBotPlayer(i))
        {
            players[pcount++] = i;
        }
    }

    if(pcount == 0) return 1;

    for(new j=0; j<count && j<pcount; j++)
    {
        new idx = random(pcount);
        Kick(players[idx]);
    }

    return 1;
}

stock bots_OnGameModeInit()
{
    SetTimer("KickRandomBots", random(2000)+4000, true); 
}