CreateFire(playerid)
{
    new rand = random(sizeof(FireInfo)), index = -1;
    for(new i, idx = -1; i < sizeof(FireInfo) * 2; i++)
    {
        idx++;
        if(idx >= sizeof(FireInfo)) idx = 0;
        if(FireInfo[idx][fStatus] == 1) continue;
        rand--;
        if(rand <= 0)
        {
            FireInfo[idx][fStatus] = 1;
            for(new x; x < 5; x++)
            {
                if(FireInfo[idx][fObject][x] != -1)
                {
                    DestroyDynamicObject(FireInfo[idx][fObject][x]);
                    FireInfo[idx][fObject][x] = -1;
                }
                if(FireInfo[idx][fPos][x * 3  + 0] == 0.0) continue;
                FireInfo[idx][fObject][x] = CreateDynamicObject(18691, FireInfo[idx][fPos][x * 3  + 0], FireInfo[idx][fPos][x * 3  + 1], FireInfo[idx][fPos][x * 3  + 2] - 1.86, 0.0, 0.0, 0.0);
            }
            index = idx;
            break;
        }
    }
    if(index == -1)
    {
        p_t_info[playerid][FireStatus] = 0;
        p_t_info[playerid][FireTimer] = 10;
        return 1;
    }
    p_t_info[playerid][FireStatus] = index + 1;
    p_t_info[playerid][FireTimer] = 900;

    new Float:distance = GetPlayerDistanceFromPoint(playerid, FireInfo[index][fPos][0], FireInfo[index][fPos][1], FireInfo[index][fPos][2]);

    new time = floatround(distance) / 500 * 30;

    SetPlayerRaceCheckpoint(playerid, 1, FireInfo[index][fPos][0], FireInfo[index][fPos][1], FireInfo[index][fPos][2], 0, 0, 0, 5);
    SendInfo(playerid, "Dar yeki az sherkatha dar manteghe %s atashsozi shode. Fasele: %.0f metar.", FireInfo[index][fCity], distance);
    SendInfo(playerid, "Mahal atashsozi dar GPS navigator shoma neshan dade shode ast.");
    SendInfo(playerid, "Shoma %d daghighe zaman darid ta be mahal atashsozi beresid va an ra khamosh konid.", time);
    return 1;
}

DestroyFire(playerid)
{
    if(p_t_info[playerid][FireStatus] == 0) return 1;
    new idx = p_t_info[playerid][FireStatus] - 1;
    FireInfo[idx][fStatus] = 0;
    for(new i; i < 5; i++)
    {
        if(FireInfo[idx][fObject][i] != -1) DestroyDynamicObject(FireInfo[idx][fObject][i]);
        FireInfo[idx][fObject][i] = -1;
    }
    return 1;
}
