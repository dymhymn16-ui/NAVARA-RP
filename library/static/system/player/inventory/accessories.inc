    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",
    PlayerInfo[playerid][accessories_use][0], PlayerInfo[playerid][accessories_use][1], PlayerInfo[playerid][accessories_use][2], PlayerInfo[playerid][accessories_use][3], PlayerInfo[playerid][accessories_use][4], PlayerInfo[playerid][accessories_use][5], PlayerInfo[playerid][accessories_use][6], PlayerInfo[playerid][accessories_use][7],
    PlayerInfo[playerid][accessories_use][8], PlayerInfo[playerid][accessories_use][9], PlayerInfo[playerid][accessories_use][10], PlayerInfo[playerid][accessories_use][11], PlayerInfo[playerid][accessories_use][12], PlayerInfo[playerid][accessories_use][13], PlayerInfo[playerid][accessories_use][14], PlayerInfo[playerid][accessories_use][15],
    PlayerInfo[playerid][accessories_use][16], PlayerInfo[playerid][accessories_use][17], PlayerInfo[playerid][accessories_use][18], PlayerInfo[playerid][accessories_use][19], PlayerInfo[playerid][accessories_use][20], PlayerInfo[playerid][accessories_use][21], PlayerInfo[playerid][accessories_use][22], PlayerInfo[playerid][accessories_use][23],
	PlayerInfo[playerid][accessories_use][24]);
    update_str_sql(playerid, "Accessories_Use", STRING_GLOBAL);
    return 1;
}

// ~~~~~~~~~~ [ Accessories - Start ] ~~~~~~~~~~ //
GetPlayerAccessoriesID(playerid, idx)
{
    return PlayerInfo[playerid][accessories][idx];
}

GetPlayerAccessoriesUseID(playerid, idx)
{
    return PlayerInfo[playerid][accessories_use][idx];
}

SetPlayerAccessoriesID(playerid, accessories_idx, idx)
{
    if(accessories_idx == INVALID_ACCESSORIES_ID && GetPlayerAccessoriesUseID(playerid, idx) == 1)
    {
        new sidx = GetPlayerAccessoriesID(playerid, idx) - 1, slot = AccessoriesInfo[sidx][aSlot];
        if(IsPlayerAttachedObjectSlotUsed(playerid, slot)) RemovePlayerAttachedObject(playerid, slot);
        PlayerInfo[playerid][accessories_use][idx] = 0;
        SavePlayerAccessories(playerid);
    }
    PlayerInfo[playerid][accessories][idx] = accessories_idx;
    SavePlayerAccessories(playerid, 1);
}

ClearOwnerAccessories(playerid, accessories_idx)
{
    for(new i; i < MAX_PLAYER_ACCESSORIES; i++)
    {
        if(accessories_idx == GetPlayerAccessoriesID(playerid, i))
        {
            SetPlayerAccessoriesID(playerid, INVALID_ACCESSORIES_ID, i);
            break;
        }
    }
}

GetFreeSlotAccessories(playerid)
{
    new count_accessories;
    for(new i; i < MAX_PLAYER_ACCESSORIES; i++)
    {
        if(GetPlayerAccessoriesID(playerid, i) == INVALID_ACCESSORIES_ID)
            count_accessories++;
    }
    if(count_accessories == MAX_PLAYER_ACCESSORIES)
        return MAX_PLAYER_ACCESSORIES;
    if(count_accessories == 0)
        return ALL_BUSY_SLOT_ACCESSORIES;
    return count_accessories;
}

stock SetFreeSlotAccessories(playerid, accessories_idx)
{
    for(new i; i < MAX_PLAYER_ACCESSORIES; i++)
    {
        if(GetPlayerAccessoriesID(playerid, i) == INVALID_ACCESSORIES_ID)
        {
            SetPlayerAccessoriesID(playerid, accessories_idx, i);
			
            break;
        }
    }
}

AccessoriesPlayerList(playerid, acc_dialig_id)
{
    STRING_GLOBAL[0] = EOS;
    for(new i = 0; i < MAX_PLAYER_ACCESSORIES; i++)
    {
        if(PlayerInfo[playerid][accessories][i] != 0) fmt(STRING_GLOBAL, "%s[%d] %s - (%s)\n", STRING_GLOBAL, i+1, AccessoriesInfo[PlayerInfo[playerid][accessories][i]-1][aName], (!GetPlayerAccessoriesUseID(playerid, i)) ? ("Naaktiv") : ("Aktiv"));
        else fmt(STRING_GLOBAL, "%s[%d] Na\n", STRING_GLOBAL, i+1);
    }
    ShowPlayerDialog(playerid, D_ACCESSORIES, DIALOG_STYLE_LIST, "Accessories List", STRING_GLOBAL, "Dalee", "Otmena");
    p_t_info[playerid][p_listitem_int] = acc_dialig_id;
    return 1;
}

// ~~~~~~~~~~ [ Accessories - The End ] ~~~~~~~~~~ //

forward AttachedPlayerAccAndCostume(playerid);
public AttachedPlayerAccAndCostume(playerid)
{
    for(new i = 0; i < MAX_PLAYER_ACCESSORIES; i++)
    {
        if(GetPlayerAccessoriesID(playerid, i) == 0 || GetPlayerAccessoriesUseID(playerid, i) == 0) continue;

        new
            idx = PlayerInfo[playerid][accessories][i] - 1,
            type = AccessoriesInfo[idx][aType] - 1,
            slot = AccessoriesInfo[idx][aSlot],
            model = AccessoriesInfo[idx][aModel],
            bone = AccessoriesInfo[idx][aBone],
            idx_skin = GetPlayerSkin(playerid);

        new
            Float:fOffsetX = AccessoriesCoords[type][idx_skin][0], Float:fOffsetY = AccessoriesCoords[type][idx_skin][1], Float:fOffsetZ = AccessoriesCoords[type][idx_skin][2],
            Float:fRotX = AccessoriesCoords[type][idx_skin][3], Float:fRotY = AccessoriesCoords[type][idx_skin][4], Float:fRotZ = AccessoriesCoords[type][idx_skin][5],
            Float:fScaleX = AccessoriesCoords[type][idx_skin][6], Float:fScaleY = AccessoriesCoords[type][idx_skin][7], Float:fScaleZ = AccessoriesCoords[type][idx_skin][8];

        if(fOffsetX == 0.0 && fOffsetY == 0.0 && fOffsetZ == 0.0 && fRotX == 0.0 && fRotY == 0.0 && fRotZ == 0.0 && fScaleX == 0.0 && fScaleY == 0.0 && fScaleZ == 0.0)
        {
            PlayerInfo[playerid][accessories_use][i] = 0;
            continue;
        }

        if(IsPlayerAttachedObjectSlotUsed(playerid, slot)) RemovePlayerAttachedObject(playerid, slot);
        SetPlayerAttachedObject(playerid, slot, model, bone, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);
    }

    return 1;
}