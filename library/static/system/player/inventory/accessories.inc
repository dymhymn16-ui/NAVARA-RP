ShowPlayerAccessoriesInfo(playerid, aidx)
{
    new idx = GetPlayerAccessoriesID(playerid, aidx);
    STRING_GLOBAL[0] = EOS;
    format(STRING_GLOBAL, sizeof(STRING_GLOBAL), ""c_white"\
    Item name: "c_server"%s."c_white"\n\
    Item cost: "c_server"$%d.", AccessoriesInfo[idx-1][aName], AccessoriesInfo[idx-1][aPrice]);
    show_dialog(playerid, D_ACCESSORIES_INFO, DIALOG_STYLE_MSGBOX, "Item Info", STRING_GLOBAL, "Next", "Cancel");
    InventoryUseAccessories[playerid] = aidx;
    return 1;
}

UsePlayerAccessories(playerid, aidx)
{
    if(aidx == -1) return printf("CRASHED: %d", aidx);
	if(GetPlayerAccessoriesUseID(playerid, aidx) == 0)
	{
		new
			sidx = GetPlayerAccessoriesID(playerid, aidx) - 1,
			type = AccessoriesInfo[sidx][aType] - 1,
			slot = AccessoriesInfo[sidx][aSlot],
			model = AccessoriesInfo[sidx][aModel],
			bone = AccessoriesInfo[sidx][aBone],
			idx_skin = GetPlayerSkin(playerid);

		new
			Float:fOffsetX = AccessoriesCoords[type][idx_skin][0], Float:fOffsetY = AccessoriesCoords[type][idx_skin][1], Float:fOffsetZ = AccessoriesCoords[type][idx_skin][2],
			Float:fRotX = AccessoriesCoords[type][idx_skin][3], Float:fRotY = AccessoriesCoords[type][idx_skin][4], Float:fRotZ = AccessoriesCoords[type][idx_skin][5],
			Float:fScaleX = AccessoriesCoords[type][idx_skin][6], Float:fScaleY = AccessoriesCoords[type][idx_skin][7], Float:fScaleZ = AccessoriesCoords[type][idx_skin][8];

		if(fOffsetX == 0.0 && fOffsetY == 0.0 && fOffsetZ == 0.0 && fRotX == 0.0 && fRotY == 0.0 && fRotZ == 0.0 && fScaleX == 0.0 && fScaleY == 0.0 && fScaleZ == 0.0) return SendError(playerid, "Not available for this skin.");

		for(new i = 0; i < MAX_PLAYER_ACCESSORIES; i++)
		{
			if(GetPlayerAccessoriesID(playerid, i) != 0 && GetPlayerAccessoriesUseID(playerid, i) != 0)
			{
				new fidx = GetPlayerAccessoriesID(playerid, i) - 1, fslot = AccessoriesInfo[fidx][aSlot];
				if(fslot == slot)
				{
					PlayerInfo[playerid][accessories_use][i] = 0;
					if(IsPlayerAttachedObjectSlotUsed(playerid, fslot)) RemovePlayerAttachedObject(playerid, fslot);
				}
			}
		}

		if(IsPlayerAttachedObjectSlotUsed(playerid, slot)) RemovePlayerAttachedObject(playerid, slot);
		SetPlayerAttachedObject(playerid, slot, model, bone, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);
		PlayerInfo[playerid][accessories_use][aidx] = 1;
		SavePlayerAccessories(playerid);
		SendAccess(playerid, "Shoma accessory ra poshidid.");
	}
	else
	{
		new sidx = GetPlayerAccessoriesID(playerid, aidx) - 1, slot = AccessoriesInfo[sidx][aSlot];
		if(IsPlayerAttachedObjectSlotUsed(playerid, slot)) RemovePlayerAttachedObject(playerid, slot);
		PlayerInfo[playerid][accessories_use][aidx] = 0;
		SavePlayerAccessories(playerid);
		SendAccess(playerid, "Shoma accessory ra bardashtid.");
	}
	return 1;
}

SellPlayerAccessories(playerid, aidx)
{
	show_dialog(playerid, D_ACCESSORIES_SELL_PLAYER, DIALOG_STYLE_INPUT, "Sale", ""c_white"Enter the player's ID and the amount separated by a comma:", "Next", "Cancel");
	InventoryUseAccessories[playerid] = aidx;
	return 1;
}

DropPlayerAccessories(playerid, aidx)
{
	if(PlayerInfo[playerid][admin]) 
		return SendError(playerid, "You are an administrator, this action is not possible.");

	PlayerInfo[playerid][pAccessories][aidx] = 0;
	PlayerInfo[playerid][pAccessoriesUse][aidx] = 0;
	SendInfo(playerid, "Shoma yek accessory ra door rikhtid.");
	SavePlayerAccessories(playerid, 1);

	return 1;
}

