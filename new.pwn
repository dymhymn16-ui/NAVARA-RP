}

cmd:v(playerid, params[])
{
	if(PlyayerIsGang && !PlayerInfo[playerid][vip]) return SendError(playerid, "Shoma VIP nهوtid.");

	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /v [Matn]");

	new scm_string[144];
