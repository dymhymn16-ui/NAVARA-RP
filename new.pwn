	if(PlayerInfo[playerid][f_mute])
	{
		new scm_string[78];
		format(scm_string, sizeof(scm_string),""c_orange_red"* "c_grey"أنت a gag in the organization's chat | %d ثانية(s)", PlayerInfo[playerid][f_mute]);
		SendClientMessage(playerid, col_gray, scm_string);
		return 0;
	}
	if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /fn [Matn]");
 	CheckForAdvTexts(playerid, params[0]);
	new scm_string[144],
		chat_color;

	switch(getPlayerFactionID(playerid))
	{
		case 22..25: chat_color = 0x326EA1FF;
		default: chat_color = 0x2B7FDBFF;
	}
	
	format(scm_string, sizeof scm_string, "(([F] %s %s[%d]: %s))", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params[0]);
	foreach(new i: logged_players) if((PlayerInfo[i][member] == PlayerInfo[playerid][member] || is_control_chat {i} == PlayerInfo[playerid][member]) && PlayerInfo[i][settings][0] != 0)SendClientMessage(i, chat_color, scm_string);
	return 1;
}

cmd:leave(playerid)
{
	if(PlyayerIsGang && !PlayerInfo[playerid][enhancement][2]) return SendError(playerid, "لم تحصل على الترقية "c_white"'Resolve'"c_grey".");
    if(!playerLeaderStatus(playerid)) return SendError(playerid, "لا يستطيع القائد مغادرة المنظمة.");
    if(!playerFactionStatus(playerid)) return SendError(playerid, "أنت لست ضمن المنظمة.");
	if(get_player_donate(playerid) < 250) return SendError(playerid, "Shoma 250 M-Coin Baraye Khهمj Shodan Az Faction Nadarid.");

	addWorkBook(playerid, "السيرفر", "مغادرة");

	SendClientMessage(playerid, col_white, ""c_green"* "c_white"أنت مغادرة from the organization! [-250 M-Coin] [60 ساعة Punهوh]");
	
	PlayerInfo[playerid][faction_punish] = 60;
	update_int_sql(playerid, "u_faction_punهوh", PlayerInfo[playerid][faction_punish]);

	give_donate(playerid, -250);
	insert_donate_log(playerid, INVALID_PLAYER_ID, -250);
	return 1;
}

cmd:hleave(playerid)
{
	if(PlayerInfo[playerid][rent_house] <= 0) return SendError(playerid, "Shoma hich khane'i ejهم nakarde'id.");

	PlayerInfo[playerid][rent_house] = -1;
	update_int_sql(playerid, "u_استئجارالمنزل", getPlayerRentHouseID(playerid));

	SendClientMessage(playerid, col_white, ""scm_sucess"Shoma ba movafaghiat gharardad ejهم khane ra faskh kardid.");
	return 1;
}

cmd:break(playerid, params[])
{
 	if(!cop_player(playerid) && ! fbi_player(playerid)) return 1;
    if( IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't use thهو in the السيارة.");
    if(p_t_info[playerid][p_data][0] !=0 || p_t_info[playerid][p_data][0] != 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا يمكنك be used in inte here .");
    if(GetPVarInt(playerid,"SetBlock")>0)
	{
        DestroyDynamicObject(GetPVarInt(playerid,"SetBlock"));
        DeletePVar(playerid, "SetBlock");
        SendClientMessage(playerid, col_white,""c_green"* "c_white"Obstruction تمت العملية بنجاحfully removed.");
        return 1;
	}
	show_dialog(playerid, d_cop_break, DIALOG_STYLE_LIST, ""c_server"encumbrance",""c_white"1. Encumbrance # 1\n2. Encumbrance # 2\n3. Encumbrance # 3\n4. Entitlement #4\n5 Enclosure #5\n6 Enclosure #6", "Entekhab", " إغلاق");
    return 1;
}

cmd:ceject(playerid, params[])
{
    if(!cop_player(playerid) && ! fbi_player(playerid)) return 1;

    extract params -> new player:target; else return SendClientMessage(playerid, col_gray, ""scm_info"أدخل: /ceject [id bazikon]");

	if(!IsPlayerConnected(target)) return SendError(playerid, "Bazikon Yaft Nashod.");

    if(target == INVALID_PLAYER_ID || target == playerid) return SendError(playerid, "Bazikon Yaft Nashod.");

    if(!IsPlayerStream(5.0, playerid, target)) return SendError(playerid, "Bazikon Yaft Nashod.");

    if(0 == IsPlayerInAnyVehicle(target)) return SendError(playerid, "Bazikon savar vasile naghlie nهوt.");

    new stringc[60 - 4 + MAX_PLAYER_NAME*2];

    format(stringc, sizeof(stringc), "%s ra az المركبة النقل biron keshid", PlayerInfo[target][name]);
    me_action(playerid, stringc);

	new scm_string[82];
	format(scm_string, 82, "%s أنت ra az المركبة النقل biron keshid.",
	PlayerInfo[playerid][name]);
	SendClientMessage(params[0], col_wavy, scm_string);

    GameTextForPlayer(target, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~EJECTED", 3000, 3);
    RemovePlayerFromVehicle(target);
	
    return 1;
}

cmd:cuff(playerid, params[])
{
	if(!cop_player(playerid) && ! fbi_player(playerid)) return 1;
	if(GetPVarInt(playerid, "اللاعبCuffed")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Shoma cuff hastid.");
	if(GetPVarInt(playerid, "اللاعبTied")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت connected.");
	if(PlayerInfo[playerid][rank] < 2) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"متاح from الرتبة 2.");
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /cuff [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't handcuff yourself.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");

	SetPVarInt(params[0], "اللاعبCuffed", 1);
	SetPlayerAttachedObject(params[0], 1, 19418, 6, -0.011000, 0.028000, -0.022000, -15.600012, -33.699977, -81.700035, 0.891999, 1.000000, 1.168000);
	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_CUFFED);

	new scm_string[82];
	format(scm_string, 82, "%s be أنت الأصفاد zad.",
	PlayerInfo[playerid][name]);
	SendClientMessage(params[0], col_wavy, scm_string);

	GameTextForPlayer(params[0], "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~CUFFED", 3000, 3);

	format(scm_string, sizeof(scm_string), "be %s الأصفاد zad", PlayerInfo[params[0]][name]);
	me_action(playerid, scm_string);

	PlayerInfo[playerid][activity_cuffs]++;
	update_int_sql(playerid, "u_activity_cuffs", PlayerInfo[playerid][activity_cuffs]);
	return 1;
}

cmd:uncuff(playerid, params[])
{
	if(PlayerInfo[playerid][admin] < 1 && !cop_player(playerid) && !fbi_player(playerid)) return 1;

	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, col_gray,"أدخل: /uncuff [id/الاسم]");
	if(PlayerInfo[playerid][admin] < 1)
	{
    if(!is_fraction_duty{playerid}) return SendError(playerid, "لم تبدأ يوم العمل.");
    if(GetPVarInt(playerid, "اللاعبCuffed")) return SendClientMessage(playerid, col_gray,"shoma cuff hastid.");
    if(GetPVarInt(playerid, "اللاعبTied")) return SendClientMessage(playerid, col_gray,"أنت connected.");
    if(PlayerInfo[playerid][rank] < 2) return SendClientMessage(playerid, col_gray,"متاح with الرتبة 2.");
    if(params[0] == playerid) return SendClientMessage(playerid, col_gray,"You can't remove your handcuffs.");
	}

	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, col_gray,"Bazikon Yaft Nashod.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2])|| GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,"Bazikon Kheyli door ast.");

    if(GetPVarInt(params[0], "اللاعبCuffed") != 1) return SendError(playerid, "There هم لا handcuffs on the اللاعب.");

	DeletePVar(params[0], "اللاعبCuffed");
	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_NONE);
	RemovePlayerAttachedObject(params[0], 1);
	new scm_string[82];
	format(scm_string, 82, "%s[%d] removed your handcuffs.",
	PlayerInfo[playerid][name], playerid);
	SendClientMessage(params[0], col_wavy, scm_string);

	format(scm_string, sizeof(scm_string), "remover(s) handcuffs with %s", PlayerInfo[params[0]][name]);
	me_action(playerid, scm_string);
	
	PlayerInfo[playerid][activity_uncuff]++;
	update_int_sql(playerid, "u_activity_uncuff", PlayerInfo[playerid][activity_uncuff]);
	return true;
}

cmd:frisk(playerid, params[])
{
	if(!cop_player(playerid) && ! fbi_player(playerid)) return 1;
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /frهوk [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا يمكنك search yourself.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");

	new scm_string[98];
	format(scm_string, sizeof(scm_string), ":::: Values %s ::::", PlayerInfo[params[0]][name]);
	SendClientMessage(playerid, col_wavy, scm_string);

	format(scm_string, sizeof(scm_string), "-%s",(PlayerInfo[params[0]][crim_ammo]) ?("الذخيرة"): ("Empty"));
	SendClientMessage(playerid, col_gray, scm_string);
	format(scm_string, sizeof(scm_string), "-%s",(PlayerInfo[params[0]][crim_guns]) ?("File سلاح"): ("Empty"));
	SendClientMessage(playerid, col_gray, scm_string);
	format(scm_string, sizeof(scm_string), "-%s",(PlayerInfo[params[0]][drugs]) ?("Drugs"):("Empty"));
	SendClientMessage(playerid, col_gray, scm_string);
	format(scm_string, sizeof(scm_string), "-%s",(PlayerInfo[params[0]][seed]) ?("Seeds"):("Empty"));
	SendClientMessage(playerid, col_gray, scm_string);

	format(scm_string, sizeof(scm_string), "took out gloves and بحثed %s", PlayerInfo[params[0]][name]);
	me_action(playerid, scm_string);

	PlayerInfo[playerid][activity_frisk]++;
	update_int_sql(playerid, "u_activity_frهوk", PlayerInfo[playerid][activity_frisk]);
	return 1;
}

cmd:take(playerid, params[])
{
	if(!cop_player(playerid) && ! fbi_player(playerid)) return 1;

	if(PlayerInfo[playerid][rank] < 2) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"متاح from الرتبة 2.");


	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /take [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't take anything from yourself.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");

	new header_string[18 + MAX_PLAYER_NAME];
	format(header_string, sizeof(header_string), ""c_server"أخذd %s", PlayerInfo[params[0]][name]);
	show_dialog(playerid, d_take, DIALOG_STYLE_LIST, header_string, "رخصة القيادة\nWater transport الرخصة\nAir transport الرخصة\nالرخصة on الأسلحة\nالذخيرة\nAdditional الأسلحة\nDrugs", "Entekhab", "Bastan");
	SetPVarInt(playerid, "target_id", params[0]);
	return 1;
}

cmd:ticket(playerid, params[])
{
	if(!cop_player(playerid) && ! fbi_player(playerid)) return 1;
	if(PlayerInfo[playerid][rank] < 2) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"متاح from الرتبة 2.");

	if(sscanf(params, "uds[42]", params[0], params[1], params[2])) return SendInfo(playerid, "أدخل: /ticket [id/الاسم] [meghdar] [السبب]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا يمكنك هوsue a fine to yourself.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");
    if(strlen(params[2]) > 62) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"السبب لا يمكنك be longer than 62 characters.");
    if(params[1] < 0 || params[1] > 100000) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"المبلغ لا يمكنك be less than 0$ or more than 10 $0.000.");
	new scm_string[130 + MAX_PLAYER_NAME * 2 + 42 + 6 + 6];
	mysql_format(sql_connection, scm_string, sizeof(scm_string), "INSERT INTO `users_tickets` (`t_اللاعب`,`t_اللاعب_الاسم`,`t_cop_الاسم`,`t_السبب`,`t_count`,`t_التاريخ`) VALUES ('%d','%s','%s','%s','%d',لاW())",
	PlayerInfo[params[0]][id], PlayerInfo[params[0]][name], PlayerInfo[playerid][name], params[2], params[1]);
	mysql_tquery(sql_connection, scm_string);
	format(scm_string, 144, "You هوsued a %s[%d] fine of $%d. السبب: %s.",
	PlayerInfo[params[0]][name], params[0], params[1], params[2]	);
	SendClientMessage(playerid, col_wavy, scm_string);
	format(scm_string, 144, "%s[%d] هوsued you a fine in the المبلغ of $%d. السبب: %s.",
	PlayerInfo[playerid][name], playerid, params[1], params[2]);
	SendClientMessage(params[0], col_wavy, scm_string);
	return 1;
}


cmd:search(playerid, params[])
{
	if(!cop_player(playerid) && ! fbi_player(playerid)) return 1;
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /search [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't search for yourself.");
    if(PlayerInfo[params[0]][wanted] == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Thهو اللاعب هو ليس in the القائمة.");

	if(is_gps_used {playerid})
	{
		SendInfo(playerid, "[نظام الملاحة] - Last search cleهمd.");
		DisablePlayerRaceCheckpoint(playerid);
		is_gps_used {playerid} = 0;
		is_searching_player_used[playerid] = INVALID_PLAYER_ID;
	}
	else
	{
		new scm_string[100];
		format(scm_string, sizeof(scm_string), ""c_green"* "c_white"You marked on the الخريطة "c_green"%s[%i]"c_white".", PlayerInfo[params[0]][name], params[0]);
		SendClientMessage(playerid, col_white, scm_string);

		DisablePlayerRaceCheckpoint(playerid);
		SetPlayerRaceCheckpoint(playerid, 1, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2], 0.0, 0.0, 0.0, 5);
		is_gps_used {playerid} = 1;

		is_searching_player_used[playerid] = params[0];
	}
	return 1;
}

cmd:m(playerid, params[])
{
	if(!cop_player(playerid) && getPlayerFactionID(playerid) != 7) return 1;
	
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(isnull(params)|| params[0] == ' ') return SendInfo(playerid, "أدخل: /m [Matn]");

	new veh_id = GetPlayerVehicleID(playerid);
	if(veh_id == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Need to be in transport.");

	if(veh_info[veh_id -1][v_type] == vehicle_type_server &&(veh_info[veh_id -1][v_owner] == 4 || veh_info[veh_id -1][v_owner] == 5 || veh_info[veh_id -1][v_owner] == 6 || veh_info[veh_id -1][v_owner] == 7))
	{
		new scm_string[144];
		format(scm_string, sizeof(scm_string),"[M] %s %s(%d): %s",
		f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params);
		send_world_message(playerid, 30.0, scm_string, col_yellow, col_yellow, col_yellow, false);
	}
	return 1;
}

cmd:su(playerid, params[])
{
    if(!cop_player(playerid) && getPlayerFactionID(playerid) != 7) return 1;
    if(!is_fraction_duty{playerid}) return SendError(playerid, "لم تبدأ يوم العمل.");
    if(PlayerInfo[playerid][rank] < 2) return SendError(playerid, "Thهو command هو متاح from الرتبة 2.");
    extract params -> new player:targetid; else return SendInfo(playerid, "أدخل: /su [id Bazikon]");
    if(!IsPlayerConnected(targetid) || targetid == playerid) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(isPlayerInJail(playerid)) return SendError(playerid, "Couldn't declهم السجنbroken.");
    if(pl_afk_time[targetid] > 30) return SendError(playerid, "Thهو هو an AFK اللاعب. He can't send a ping.");
    if(cop_player(targetid)) return SendError(playerid, "لا يمكنك إجراء تفتيش قانوني.");

    SetPVarInt(playerid, "مطلوب_search_target", targetid);
    show_dialog(
    	playerid, 
    	d_wanted_search,
    	DIALOG_STYLE_LIST,
    	""scm_dialog"مطلوب القائمة",
    	string_wanted_search_list,
    	"Entekhab",
    	"إلغاء");
    return 1;
}

cmd:comp(playerid)
{
	if((! cop_player(playerid) && getPlayerFactionID(playerid) != 7)|| ! IsPlayerInRangeOfPoint(playerid, 3, 1464.5409, -1783.7404, 2342.1479) && ! IsPlayerInRangeOfPoint(playerid, 3, 1464.5437, -1788.0006, 2342.1479) && ! IsPlayerInRangeOfPoint(playerid, 3, -2502.4155, -650.3958, 1331.6520) && veh_info[GetPlayerVehicleID(playerid) -1][v_owner] != PlayerInfo[playerid][member]) return 1;
	show_dialog(playerid, d_police_comp, DIALOG_STYLE_LIST, ""c_server"حاسوب الخدمة", ""c_server"1. "c_white"Find the تمت العملية بنجاحor\n"c_server"2. "c_white"Give the state's inhabitants\n"c_server"3. "c_white"View webcams\n"c_server"4. "c_white" Track by رقم الهاتف\n"c_server"5. "c_white"الإحصائيات الإحصائيات\n"c_server"6. "c_white"القائمةen to a teleالهاتف conversation\n"c_server"7. "c_white"Чёыыый market\n"c_server"8. "c_white"Particularly dangerous criminals", "Entekhab", "Bastan");
	return 1;
}

cmd:clear(playerid, params[])
{
	if(PlayerInfo[playerid][admin] < 1 && !cop_player(playerid) && getPlayerFactionID(playerid) != 7) return 1;

	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, col_gray,"أدخل: /clear [id/الاسم]");
	if(PlayerInfo[playerid][admin] < 1)
	{
	if(!is_fraction_duty{playerid}) return SendError(playerid, "You didn't بدء your work اليوم.");
    if(params[0] == playerid) return SendError(playerid, " لا يمكنك remove yourself from the search.");
	}
	if(!IsPlayerConnected(params[0])|| params[0] == playerid) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(PlayerInfo[params[0]][wanted] == 0) return SendError(playerid, "اللاعب غير مطلوب.");

	new scm_string[26 + MAX_PLAYER_NAME * 2];
    format(scm_string, sizeof(scm_string),"%s %s jostojye أنت ra pak العملd.",
	f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name]);
    SendClientMessage(params[0], col_lblue, scm_string);
    format(scm_string, sizeof(scm_string),"لديك cleهمd the مطلوب القائمة for the اللاعب %s[%i]", PlayerInfo[params[0]][name], params[0]);
    SendClientMessage(playerid, col_lblue, scm_string);

    format(scm_string, sizeof(scm_string),"%s cleهمd the مطلوب القائمة for the اللاعب %s[%i]", PlayerInfo[playerid][name], PlayerInfo[params[0]][name], params[0]);
 	foreach(new i: logged_players)if(cop_player(i))SendClientMessage(i, 0xFF8282AA, scm_string);

	PlayerInfo[params[0]][wanted] = 0;
	SetPlayerWantedLevel(params[0], PlayerInfo[params[0]][wanted]);
	update_int_sql(params[0], "u_مطلوب", PlayerInfo[params[0]][wanted]);

	PlayerInfo[playerid][activity_unwanted]++;
	update_int_sql(playerid, "u_activity_unمطلوب", PlayerInfo[playerid][activity_unwanted]);
	return true;
}

cmd:arrest(playerid, params[])
{
	if(!cop_player(playerid) && ! fbi_player(playerid)) return 1;
	if(!IsPlayerInRangeOfPoint(playerid, 3, 1452.6100,-1779.8398,3740.8970)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت too far from prهوon.");
    new targetid, jail_minutes, jail_bail_amount;
    if(sscanf(params, "u", targetid)) return SendInfo(playerid, "أدخل: /اعتقال [id/الاسم]");
    if(targetid == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't اعتقال yourself.");
	if(!IsPlayerConnected(targetid)  || targetid == playerid) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[targetid][p_pos][0], p_t_info[targetid][p_pos][1], p_t_info[targetid][p_pos][2]) || GetPlayerVirtualWorld(targetid) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");
    if(isPlayerInJail(targetid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب هو already in السجن.");
    
    if(PlayerInfo[targetid][wanted] == 0)
    	jail_minutes = 10;
    else
    	jail_minutes = PlayerInfo[targetid][wanted]* 10;

    jail_bail_amount = PlayerInfo[targetid][wanted] * 20000;

    if(cop_player(targetid)) return SendError(playerid, "You can't plant a thief.");
	PlayerInfo[targetid][bail] = jail_bail_amount;
	PlayerInfo[targetid][wanted] = 0;
	SetPlayerWantedLevel(targetid, PlayerInfo[targetid][wanted]);

	new scm_string[180];
	if(jail_bail_amount > 0)
	{
		format(scm_string, 68, "لديك been اعتقالed for %d دقائق. Pledge: $%d", jail_minutes, jail_bail_amount);
		SendClientMessage(targetid, col_light_red, scm_string);
		format(scm_string, sizeof(scm_string), "لديك %s اعتقالed for %d دقيقة(s). إيداع: $%d", PlayerInfo[targetid][name], jail_minutes, jail_bail_amount);
		SendClientMessage(playerid, col_lblue, scm_string);
	}
	else
	{
		format(scm_string, 68, "لديك been اعتقالed for %d دقائق. إيداع: لا إيداع", jail_minutes);
		SendClientMessage(targetid, col_light_red, scm_string);
		format(scm_string, sizeof(scm_string), "لديك %s اعتقالed for %d دقيقة(s). إيداع: لا إيداع", PlayerInfo[targetid][name], jail_minutes);
		SendClientMessage(playerid, col_lblue, scm_string);

	}

	if(GetPVarInt(targetid, "اللاعبCuffed")!= 0)
	{
		DeletePVar(targetid, "اللاعبCuffed");
		SetPlayerSpecialAction(targetid, SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(targetid, 1);
	}

	if(gotome_player[targetid] != -1)
	{
		DeletePVar(gotome_player[targetid], "اللاعب_gotome");
		gotome_player[targetid] = -1;
	}


	reset_player_weapon(targetid);

	PlayerInfo[targetid][jail] = p_t_info[playerid][p_data][1];
	PlayerInfo[targetid][jailed] = jail_minutes* 60;
	new random_jail_pos = random(sizeof jail_spawn);
	set_pos(targetid, jail_spawn[random_jail_pos][0],
						jail_spawn[random_jail_pos][1],
						jail_spawn[random_jail_pos][2],
						jail_spawn[random_jail_pos][3],
						1, PlayerInfo[targetid][jail]);

	format(
		scm_string,
		sizeof(scm_string),
		"UPالتاريخ `users` SET `u_السجن_السبب`='Dastgir Shodan Tavasote الشرطة',`u_السجن`=%d,`u_bail`=%d,`u_مطلوب`=%d WHERE `u_id`='%d'", 
		PlayerInfo[targetid][jail], 
		PlayerInfo[targetid][bail],
		PlayerInfo[targetid][wanted],
		PlayerInfo[targetid][id]);
	mysql_tquery(sql_connection, scm_string, "", "");

	PlayerInfo[playerid][activity_jails]++;
	update_int_sql(playerid, "u_activity_السجنs", PlayerInfo[playerid][activity_jails]);
	// update_activity(playerid);
	return 1;
}

cmd:wanted(playerid)
{
	if(!cop_player(playerid) && getPlayerFactionID(playerid) != 7) return 1;
	ShowWantedList(playerid);
	return 1;
}

cmd:d(playerid, params[])
{
	if(getPlayerFactionID(playerid) >= 18 || !playerFactionStatus(playerid)) return 1;
	if(PlayerInfo[playerid][rank] < 6) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Department Chat هو only متاح from الرتبة 6.");
	
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);
	
	if(CheckForAdvTexts(playerid, params)) return 1;

	if(sscanf(params, "s[128]", params[0])) return SendInfo(playerid, "أدخل: /d [Matn]");
	new scm_string[144];
	format(scm_string, sizeof scm_string, "[D] %s %s[%d]: %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params[0]);
	foreach(new i: logged_players) if(18 > getPlayerFactionID(i) > 0 && PlayerInfo[i][settings][0]) SendClientMessage(i, 0xFF8282AA, scm_string);
	return 1;
}

cmd:gov(playerid, params[])
{
	if(getPlayerFactionID(playerid) >= 18 && getPlayerFactionID(playerid) != 27 || !playerFactionStatus(playerid)) return 1;
	
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(!gov_access(playerid)) return 1;
	if(isnull(params)|| params[0] == ' ') return SendInfo(playerid, "أدخل: /gov [Matn]");
	if(CheckForAdvTexts(playerid, params[0])) return 1;
	foreach(new i: logged_players)
	{
		new scm_string[144];
		format(scm_string, sizeof scm_string, "[Governmental] %s [%d]: %s",
		PlayerInfo[playerid][name], playerid, params);
		SendClientMessage(i, 0x4466CCFF, scm_string);
	}
	return 1;
}

stock gov_access(playerid)
{
	if(!playerLeaderStatus(playerid)) return 1;
	if(getPlayerFactionID(playerid) == 11 && getPlayerFactionID(playerid) > 6) return 1;
	return 0;
}

new lastDriveTime[MAX_PLAYERS];

cmd:drive(playerid)
{
    if(PlayerInfo[playerid][rank] < 7) return  SendError(playerid, "Drive هو only متاح from الرتبة القائد / Sub القائد.");

    
    if(GetTickCount() - lastDriveTime[playerid] < 5000)
    {
        return SendError(playerid, "Shoma har 5 sanyie mitavanid az drive estefade konid.");
    }
    
    lastDriveTime[playerid] = GetTickCount();

	if(gang_player(playerid)|| mafia_player(playerid))
	{
		for(new vehicleid = 0; vehicleid < vehicle_count; vehicleid ++)
		{
			if(!IsValidVehicle(vehicleid + 1)) continue;
			if(veh_info[vehicleid][v_type] != vehicle_type_server || veh_info[vehicleid][v_owner] != PlayerInfo[playerid][member]) continue;
			if(is_vehicle_occupied(vehicleid + 1)!= -1) continue;
			SetVehicleToRespawn(vehicleid + 1);
		}

		new scm_string[144],
			chat_color;

		switch(getPlayerFactionID(playerid))
		{
			case 22..25: chat_color = 0x326EA1FF;
			default: chat_color = 0x2B7FDBFF;
		}

		format(scm_string, sizeof scm_string, "[F] %s %s[%d] الظهورed all faction السيارةs", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid);
		foreach(new i: logged_players) if((PlayerInfo[i][member] == PlayerInfo[playerid][member] || is_control_chat {i} == PlayerInfo[playerid][member]) && PlayerInfo[i][settings][0] != 0) SendClientMessage(i, chat_color, scm_string);
	}

	return 1;
}

cmd:lmenu(playerid)
{
	if(!playerLeaderStatus(playerid)) return 1;
	ShowLeaderMenu(playerid);
	return 1;
}

stock ShowLeaderMenu(playerid)
{
	if(mafia_player(playerid) || gang_player(playerid))
	show_dialog(playerid, d_lmenu, DIALOG_STYLE_LIST, ""c_server"قائمة القائد", "دعوة اللاعب\nUnدعوة اللاعب\nChange اللاعب الرتبة\nالقائمة عضوs ["c_green"متصل"c_white"]\nالقائمة عضوs ["c_orange_red"غير متصل"c_white"]\nالقائمة المركبة's\nBlackالقائمة\nفتح/إغلاق المستودع", "Entekhab", "Bastan" );

    else
    show_dialog(playerid, d_lmenu, DIALOG_STYLE_LIST, ""c_server"قائمة القائد", "دعوة اللاعب\nUnدعوة اللاعب\nChange اللاعب الرتبة\nالقائمة متصل عضوs", " اختيار", "Bastan");
	return 1;
}

cmd:giveleader(playerid, params [])
{
	if(getPlayerFactionID(playerid) != 11) return 1;
	if(PlayerInfo[playerid][rank] < 6 || PlayerInfo[playerid][rank] > 9) return 1;

	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /giveالقائد [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");

	switch(PlayerInfo[playerid][rank])
	{
		case 6:
		{
			global_string[0] = EOS;
			for(new j = 14; j < 14 + 3; j ++)
			{
				new line_string[64];
				format(line_string, 64, "{%s}%s\n", f_info[j][f_chat_color], f_info[j][f_name]);
				strcat(global_string, line_string);
			}
			strcat(global_string, ""c_white"Revoke perالمهمة");

			show_dialog(playerid, d_giveleader, DIALOG_STYLE_LIST, ""c_server"تعيين القائد", global_string, "Entekhab", "Bastan");
		}
		case 7:
		{
			global_string[0] = EOS;
			new line_string[64];
			for(new j = 3; j < 3 + 4; j ++)
			{
				format(line_string, 64, "{%s}%s\n", f_info[j][f_chat_color], f_info[j][f_name]);
				strcat(global_string, line_string);
			}
			strcat(global_string, ""c_white"سحب authority");
			show_dialog(playerid, d_giveleader, DIALOG_STYLE_LIST, ""c_server"تعيين القائد", global_string, "Entekhab", "Bastan");
		}
		case 8:
		{
			global_string[0] = EOS;
			new line_string[64];
			format(line_string, 64, "{%s}%s\n", f_info[7][f_chat_color], f_info[7][f_name]);
			strcat(global_string, line_string);
			strcat(global_string, ""c_white"سحب authority");
			show_dialog(playerid, d_giveleader, DIALOG_STYLE_LIST, ""c_server"تعيين القائد", global_string, "Entekhab", "Bastan");
		}
	}
	SetPVarInt(playerid, "pl_giveالقائد_id", params[0]);
	return 1;
}

