				DeletePVar(playerid, "d_biz_بيعer");
				return SendClientMessage(playerid, col_gray, "An خطأ occurred while بيعing the المشروع. Code: 19.");
			}


			new b = PlayerInfo[pl_id][business] -1;
			format(b_info[b][b_owner_name], MAX_PLAYER_NAME, "%s", PlayerInfo[playerid][name]);
			b_info[b][b_owner_inc] = PlayerInfo[playerid][id];
			PlayerInfo[playerid][business] = b_info[b][b_id];
			PlayerInfo[pl_id][business] = -1;
			give_money(playerid, -_b_sell_price);
			give_money(pl_id, _b_sell_price);

			insert_money_log(playerid, pl_id, -_b_sell_price, "الحافلةiness شراء");
			insert_money_log(pl_id, playerid, _b_sell_price, "الحافلةiness sale");

