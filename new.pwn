cmd:admins(playerid)
{
	new count_admin;
	global_string[0] = EOS;
	foreach(new i: admin_players)
	{
		if(PlayerInfo[i][admin] > 6) continue;

		new line_string[85];
		format(line_string, sizeof(line_string), ""c_white"%s[%d] - %s - المستوى%s\n", PlayerInfo[i][name], i, a_rank_name[PlayerInfo[i][admin]-1], pl_afk_time[i] >= 3 ? (" "c_red"[AFK]") : (""));
		strcat(global_string, line_string);
		count_admin++;
	}

	if(count_admin > 0)
	{
	    show_dialog(playerid, d_none, DIALOG_STYLE_LIST, !""scm_dialog"قائمة الإدارة", global_string, !"Bastan", !"");

		new line_string[85];
		format(line_string, sizeof(line_string), "\nIn the netالعمل of everything "c_gold"%d المدير(-a | -ov)", count_admin);
		strcat(global_string, line_string);
	}
	else SendError(playerid, "لا يوجد إداريون متصلون حاليًا.");
	
    return 1;
}

callback: changename_callback(playerid, rename_id)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Thهو nickالاسم هو already taken."), change_name[rename_id] = "لاne";

	if(SetPlayerName(rename_id, change_name[rename_id]) != 1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب with thهو الاسم هو connected to the السيرفر."), change_name[rename_id] = "لاne";
	
	ChangePlayerName(rename_id, change_name[rename_id], PlayerInfo[playerid][name]);

	return 1;
}

cmd:namestore(playerid, params[])
{

	if(sscanf(params, "s[30]", params[0])) return SendInfo(playerid, "أدخل: /الاسمالمتجر [الاسم]");
	new query_string[80 + MAX_PLAYER_NAME];
	mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_id` FROM `users` WHERE `u_الاسم` = '%e' LIMIT 1", params[0]);
	mysql_tquery(sql_connection, query_string, "الاسمالمتجر_اتصالرجوع", "i", playerid);

	return 1;
}


callback:namestore_callback(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب with the given nickالاسم كان ليس found in the database.");

	new db_increment = cache_get_field_content_int(0, "u_id", sql_connection);

	new query_string[80 + MAX_PLAYER_NAME];
	format(query_string, sizeof query_string, "اختر * FROM `nickالاسم_hهوtory` WHERE `nh_المالك` = '%d'", db_increment);
	mysql_tquery(sql_connection, query_string, "_الاسمالمتجر_اتصالرجوع", "i", playerid);
	return 1;
}

callback:_namestore_callback(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Thهو اللاعب's nickالاسم hهوtory هو empty.");

	global_string[0] = EOS;
	strcat(global_string, "{cccc99}قديم Nickالاسم - جديد Nickالاسم - Nickالاسم تغيير التاريخ\n\n"c_white"");

	for(new j = 0; j < rows; j ++)
    {
		new _nh_oldname[MAX_PLAYER_NAME],
			_nh_newname[MAX_PLAYER_NAME],
			_nh_date[20],
			line_string[68];

		cache_get_field_content(j, "nh_قديمالاسم", _nh_oldname, sql_connection, MAX_PLAYER_NAME);
		cache_get_field_content(j, "nh_جديدالاسم", _nh_newname, sql_connection, MAX_PLAYER_NAME);
		cache_get_field_content(j, "nh_التاريخ", _nh_date, sql_connection, 20);

		format(line_string, sizeof(line_string), "%s -%s -%s\n", _nh_oldname, _nh_newname, _nh_date);
		strcat(global_string, line_string);

	}
	show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "{E3D18D}Hهوtory of Nickالاسمs", global_string, "Bastan", "");
	return 1;
}

cmd:fwarnoff(playerid, params[])
{
	if(!playerLeaderStatus(playerid)) return 1;
	if(sscanf(params, "s[24]", params[0])) return SendClientMessage(playerid, col_gray, ""scm_info"أدخل: /fالحربلاff [nickالاسم]");
	new scm_string[128];
	format(scm_string, sizeof(scm_string), "اختر * FROM `users` WHERE `u_الاسم` = '%s' AND `u_عضو` = '%d' LIMIT 1", params[0], getPlayerFactionID(playerid));
	mysql_function_query(sql_connection, scm_string, true, "fالحربلاff_check_اتصالرجوع", "هو", playerid, params[0]);
	return 1;
}

callback: fwarnoff_check_callback(playerid, pl_name[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		new scm_string[128];
		format(scm_string, sizeof(scm_string), ""c_orange_red"* "c_orange_red"الحساب %s لاt found in database.", pl_name);
		SendClientMessage(playerid, col_gray, scm_string);
		return 1;
	}
	else
	{
		new scm_string[138],
			fwarns = 0;

		fwarns = cache_get_field_content_int(0, "u_f_تحذير", sql_connection);

		if(fwarns < 2)
		{
			format(scm_string, sizeof(scm_string ),""c_grey"You posted the reprimand %s in the غير متصل [%d/3].", pl_name, fwarns + 1);
			SendClientMessage(playerid, col_gray, scm_string);
			format(scm_string, sizeof(scm_string ), "UPالتاريخ `users` SET `u_f_تحذير` = `u_f_تحذير` + '1' WHERE `u_الاسم` = '%s' LIMIT 1", pl_name);
			mysql_query(sql_connection, scm_string);
		}
		else
		{
			addOffWorkBook(pl_name, PlayerInfo[playerid][name], "Faction الحربn");
			
			format(scm_string, sizeof(scm_string), "UDPATE `users` SET `u_f_تحذير` = '0' WHERE `u_الاسم` = '%s' LIMIT 1", pl_name);
			mysql_query(sql_connection, scm_string);
			SendAccess(playerid, "Shoma ba movafghiat in bazikon ra az sazman طرد kardid.");
		}
		
		return 1;
	}
}

cmd:offuninvite(playerid, params[])
{
	if(PlayerInfo[playerid][admin] < 4 && !playerLeaderStatus(playerid)) return 1;
	
	if(sscanf(params,"s[24]ds[70]", params[0], params[1], params[2])) return SendClientMessage(playerid,col_gray,""scm_info"أدخل: /offunدعوة [الاسم] [punهوhment ساعات] [السبب]");
	if(!(0 <= params[1] <= 24)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أدخل punهوhment ساعات between 0 to 24.");

	new scm_string[128];
	format(scm_string, sizeof(scm_string ), "اختر * FROM `users` WHERE `u_الاسم` = '%s' AND `u_عضو` = '%d' LIMIT 1", params[0], getPlayerFactionID(playerid));
	mysql_function_query(sql_connection, scm_string, true, "offunدعوة_check_اتصالرجوع", "iهو", playerid, params[1], params[0], params[2]);
	return 1;
}

callback: offuninvite_check_callback(playerid, punishmentHour, pl_name[], _reason[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		new scm_string[128];
		format(scm_string, sizeof(scm_string), ""c_orange_red"* "c_orange_red"الحساب %s كان لاt found in the database.", pl_name);
		SendClientMessage(playerid, col_gray, scm_string);
		return 1;
	}
	else
	{
		addOffWorkBook(pl_name, PlayerInfo[playerid][name], _reason);

		new scm_string[160];
		format(scm_string, sizeof(scm_string ), "UPالتاريخ `users` SET `u_faction_punهوh`=%d WHERE `u_الاسم`='%s' LIMIT 1", punishmentHour, pl_name);
		mysql_tquery(sql_connection, scm_string);

		AdminMes(""c_server"* A.معلومات: "c_grey"%s[%d] fired %s غير متصل.", PlayerInfo[playerid][name], playerid, pl_name);

		format(scm_string, sizeof(scm_string ),""c_server"You fired %s غير متصل.", pl_name);
		SendClientMessage(playerid, col_gray, scm_string);
		return 1;
	}
}

cmd:sellskin(playerid, params[])
{
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendError(playerid, "Lotfan ebteda az vasile naghlie khهمj shavid.");

	extract params -> new player:targetid, skinPrice; else return SendInfo(playerid, "أدخل: /بيعskin [id Bazikon] [gheymat]");
	
	if(!IsPlayerConnected(targetid) || targetid == playerid) return SendError(playerid, "Bazikon Yaft Nashod.");

	if(!(1 <= skinPrice <= 1_000_000)) return SendError(playerid, "Gheymat skin ra beyne $1 ta $1,000,000 vهمd konid.");

    if(!IsPlayerInRangeOfPoint(playerid, 5.0, p_t_info[targetid][p_pos][0], p_t_info[targetid][p_pos][1], p_t_info[targetid][p_pos][2]) || GetPlayerVirtualWorld(targetid) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Az Shoma Kheyli Door Ast.");

	new string[144];

	new tId = -1;
	new countSkins;

	for(new j = 0; j < 5; j ++)
	{
		if(PlayerInfo[playerid][temp_skin][j] != 0) countSkins++;
		if(PlayerInfo[playerid][temp_skin][j] == PlayerInfo[playerid][skin])
		{
			tId = j;
		}
	}

	if(countSkins <= 1) return SendError(playerid, "Shoma faght 1 skin darid.");
	if(tId == -1) return 1;

	SetPVarInt(targetid, !"بيع_skin_value", tId);

	fmt(string, "شراء Skin #%d", tId);

	createSuggestion(playerid, targetid, skinPrice, string, 0, 0);

	return 1;
}

cmd:sex(playerid, params[])
{
	if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) {
		SendError(playerid, "Az Mashin Khهمj Shavid.");
		return 1;
	}

	extract params -> new player:targetid; else return SendInfo(playerid, "أدخل: /sex [id Bazikon]");
	
	if(targetid == playerid) return SendError(playerid, "In ID Khodetan Ast.");
	if(!IsPlayerConnected(targetid)) return SendError(playerid, "Bazikon Yaft Nashod.");

    if(!IsPlayerInRangeOfPoint(playerid, 5.0, p_t_info[targetid][p_pos][0], p_t_info[targetid][p_pos][1], p_t_info[targetid][p_pos][2]) || GetPlayerVirtualWorld(targetid) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Az Shoma Kheyli Door Ast.");

	if(GetPVarInt(targetid, !"anim_sex") && GetPVarInt(targetid, !"anim_sex_target") == playerid) return SendError(playerid, "Ghablan Be In Bazikon Pهوhnehad Dadid.");

	SetPVarInt(targetid, !"anim_sex", 1);
	SetPVarInt(targetid, !"anim_sex_target", playerid);

	new string[128];

	format(string, sizeof(string), ""c_white"اقتراح أنت be اللاعب {%06x}%s "c_white":\n"c_orange_red"Sex", 
		GetPlayerColor(targetid) >>> 8,
		Name(targetid));
	show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "Pهوhnehad", string, "إغلاق", "");

	format(string, sizeof(string), "اللاعب {%06x}%s {508EAF}mikhahad ba أنت {E4851B}rabte jensi {508EAF}anjam bede", 
		GetPlayerColor(playerid) >>> 8,
		Name(playerid));
	SendClientMessage(targetid, 0x508EAFFF, string);
	SendClientMessage(targetid, 0x508EAFFF, "Baraye movafeghat "c_green"/نعم "c_white"Va Baraye Rad "c_red"/لا "c_white"vهمd konid");
	return 1;
}

