static Text:warningDraw[PANEL_LINE];

stock ShowConnectPanelAC(playerid) { for(new idx; idx < PANEL_LINE; idx++) TextDrawShowForPlayer(playerid, connectDraw[idx]); }
stock HideConnectPanelAC(playerid) { for(new idx; idx < PANEL_LINE; idx++) TextDrawHideForPlayer(playerid, connectDraw[idx]); }
stock ShowWarningPanelAC(playerid) { for(new idx; idx < PANEL_LINE; idx++) TextDrawShowForPlayer(playerid, warningDraw[idx]); }
stock HideWarningPanelAC(playerid) { for(new idx; idx < PANEL_LINE; idx++) TextDrawHideForPlayer(playerid, warningDraw[idx]); }


