new mes_str[500];
#define SendMes(%1,%2,%3) format(mes_str, sizeof(mes_str), %3), SendClientMessage(%1, %2, mes_str)
#define SendMesAll(%1,%2) format(mes_str, sizeof(mes_str), %2), SendClientMessageToAll(%1, mes_str)
#define SendDebug(%1,%2) format(mes_str, sizeof(mes_str), %2), SendDebugMessage(%1, mes_str)
#define SendError(%1,%2) format(mes_str, sizeof(mes_str), %2), SendErrorMessage(%1, mes_str)
#define SendAccess(%1,%2) format(mes_str, sizeof(mes_str), %2), SendAccessMessage(%1, mes_str)
#define SendInfo(%1,%2) format(mes_str, sizeof(mes_str), %2), SendInfoMessage(%1, mes_str)
#define SendAction(%1,%2) format(mes_str, sizeof(mes_str), %2), SendActionMessage(%1, mes_str)
#define SendSelfAdmin(%1,%2) format(mes_str, sizeof(mes_str), %2), SendSelfAdminMessage(%1, mes_str)
#define AdminMes(%1) format(mes_str, sizeof(mes_str), %1), AdminMessage(mes_str)
#define SendAdmin(%1) format(mes_str, sizeof(mes_str), %1), SendAdminMessage(mes_str)
#define RunQuery(%1) format(mes_str, sizeof(mes_str), %1), RunQueryDB(mes_str)
#define SendRcon(%1) format(mes_str, sizeof(mes_str), %1), SendRconCMD(mes_str)

#define fmt(%1, format(%1,sizeof(%1),

SendErrorMessage(playerid, const string[])
{
    new str[350];
    format(str, sizeof(str), ""scm_error"%s", string);
    SendMes(playerid, COLOR_WHITE, str);
    return 1;
}

SendAccessMessage(playerid, const string[])
{
    new str[350];
    format(str, sizeof(str), ""scm_sucess"%s", string);
    SendMes(playerid, COLOR_WHITE, str);
    return 1;
}

stock SendInfoMessage(playerid, const string[])
{
    new str[350];
    format(str, sizeof(str), ""scm_info"%s", string);
    SendMes(playerid, COLOR_WHITE, str);
    return 1;
}

stock SendActionMessage(playerid, const string[])
{
	new str[350];
    format(str, sizeof(str), "%s", string);
    me_action(playerid, str);
    return 1;
}

stock SendDebugMessage(playerid, const string[])
{
    new str[350];
    format(str, sizeof(str), "{FFFF00}[Deخلل]: "c_white"%s", string);
    SendMes(playerid, COLOR_WHITE, str);
    return 1;
}

stock SendAdminMessage(const string[])
{
    new str[350];
    format(str, sizeof(str), "%s", string);
    foreach(new i: logged_players) if(PlayerInfo[i][settings][2]) SendMes(i, col_light_red, str);
    return 1;
}

stock SendSelfAdminMessage(playerid, const string[])
{
    new str[350];
    format(str, sizeof(str), "%s", string);
    foreach(new i: logged_players) if(PlayerInfo[i][settings][2]) SendMes(playerid, col_light_red, str);
    return 1;
}

stock AdminMessage(const string[])
{
    new str[350];
    format(str, sizeof(str), "%s", string);
    foreach(new i: admin_players) SendMes(i, col_gray, str);
    return 1;
}

stock RunQueryDB(const string[])
{
    new str[350];
    format(str, sizeof(str), "%s", string);
    mysql_tquery(sql_connection, str);
    return 1;
}

stock SendRconCMD(const string[])
{
    new str[350];
    format(str, sizeof(str), "%s", string);
    SendRconCommand(str);
    return 1;
}

