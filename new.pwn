			{
				case 8:
				{
					carmarket_id = 0;
				}
				case 9:
				{
					carmarket_id = 1;
				}
				case 10:
				{
					carmarket_id = 2;
				}
			}

			for(new i = 0; i < CAR_MARKET_SLOTS; i ++)
			{
				if(car_market_slotes_toggled[carmarket_id][i] == true) continue;
				current_slot = i;
				break;
			}
			if(current_slot == -1) return SendError(playerid, "There هم لا مجاني spaces for المركبات at the السيارة market.");


			new vehicle_id = GetPVarInt(playerid, "sc_id");

