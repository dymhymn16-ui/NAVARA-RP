				format(_text_string, sizeof(_text_string), ""c_green"* "c_white"%s شراءd by Vash "c_green"%s "c_white"for "c_green"$%d", PlayerInfo[playerid][name], vehicle_name[GetVehicleModel(veh_id)-400], veh_info[veh_id -1][v_sell_price]);
				SendClientMessage(targetid, col_white, _text_string);
