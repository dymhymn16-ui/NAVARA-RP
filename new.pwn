"c_السيرفر"7 | "c_white" Listener Statistics",
(is_ether {playerid} =! -1)?(""c_red"إيقاف"):(""c_green"بدء"),
	(cas_price[getPlayerFactionID(playerid) -26] == 0) ? (""c_green"On") : (""c_red" Off"));
	show_dialog(playerid, d_news_menu, DIALOG_STYLE_LIST, ""scm_dialog"جديدs panel", str, "Entekhab", "Bastan");
	return 1;
}

PreloadAnimLib(playerid, animlib[])
{
