		case d_advert:
		{
			if(!response) return 1;
			if(ad_cooldown >= timestamp) return SendClientMessage(playerid, col_gray, "لا يمكنك send an advertهوement more than once a دقيقة.");
			if(PlayerInfo[playerid][money] < ad_price) return SendClientMessage(playerid, col_gray, "Shoma be andaze kafi pool nadarid.");
			new slot = -1;
			for(new i; i < MAX_ADVERTS; i++)
			{
				if(!ad_info[i][ad_busy])
				{
					slot = i;
					break;
				}
			}
			if(slot == -1) return SendError(playerid, "لا space for advertهوements, يرجى try later.");
			new ad_inputtext[100];
			GetPVarString(playerid, "advert_text", ad_inputtext, 100);
			DeletePVar(playerid, "advert_text");
			give_money(playerid, -ad_price);

			ad_cooldown = timestamp + 30;
			format(ad_info[slot][ad_sender], MAX_PLAYER_NAME, "%s", PlayerInfo[playerid][name]);
			ad_info[slot][ad_id] = playerid;
			ad_info[slot][ad_phone_number] = PlayerInfo[playerid][number];
			format(ad_info[slot][ad_text], 100, "%s", ad_inputtext);
			ad_info[slot][ad_busy] = true;

			SendClientMessage(playerid, 0xCCCCCCFF, "لديك تمت العملية بنجاحfully sent an advertهوement. يرجى الانتظار for it to be checked.");
			new _text_string[84 + MAX_PLAYER_NAME + 3];
			format(_text_string, sizeof(_text_string), "[R] A جديد advertهوement has arrived from %s (ID: %d) | More التفاصيل /edit", PlayerInfo[playerid][name], playerid);
			foreach(new i: logged_players) if(getPlayerFactionID(i) >= 26) SendClientMessage(i, col_lblue, _text_string);
			return 1;
		}
