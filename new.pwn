					foreach(new veh_idx:player_vehicles[playerid])
					{
						if(veh_info[veh_idx -1][v_id] == carID){
							if(veh_info[veh_idx -1][v_vehicle] == INVALID_VEHICLE_ID)
							{
								format(sql_string, sizeof sql_string, "اختر * FROM `users_المركبات` WHERE `v_المالك` = '%d' AND `v_id` = '%d' LIMIT 1", PlayerInfo[playerid][id], carID);
								mysql_tquery(sql_connection, sql_string, "load_اللاعب_المركبات", "i", playerid);

								SendAccess(playerid, "Mashin ba movafghiat الظهور shod.");
								
								SetPVarInt(playerid, "السيارة_القائمة_id", carID);

								foreach(new vehID:player_vehicles[playerid])
								{
									if(veh_info[vehID -1][v_id] == carID){
										format(car_title, sizeof car_title, ""scm_dialog"%s [%s]", vehicle_name[veh_info[vehID -1][v_model] -400], veh_info[vehID -1][v_plate]);

										if(veh_info[vehID -1][v_vehicle] != INVALID_VEHICLE_ID) {
											format(sql_string, sizeof sql_string, ""c_server"1 | "c_white"De-الظهور العملdan\n"c_server"2 | "c_white"Baz العملdan darhaye المركبة\n"c_server"3 | "c_white"Park العملan المركبة\n"c_server"4 | "c_white"Fix العملdan المركبة");
										}else{
											format(sql_string, sizeof sql_string, ""c_server"1 | "c_white"الظهور العملdan\n"c_server"2 | "c_white"إغلاق darhaye المركبة\n"c_server"3 | "c_white"Park العملan المركبة\n"c_server"4 | "c_white"Fix العملdan المركبة");
										}
									}
								}

								show_dialog(playerid, d_car_2, DIALOG_STYLE_TABLIST, car_title, sql_string, "Entekhab", "Bastan");
							}
							else
							{
								veh_info[veh_idx -1][v_owner] = 0;
								veh_info[veh_idx -1][v_rank] = 0;
								veh_info[veh_idx -1][v_type] = 0;
								DestroyVehicle(veh_idx);
								SendAccess(playerid, "Mashin ba movafghiat De-الظهور shod.");
								pc_cmd_car(playerid);
							}
						}
					}
				}
				case 1: pc_cmd_lock(playerid);
				case 2: pc_cmd_vpark(playerid);
				case 3:
				{
					if(PlayerInfo[playerid][money] < 3000) return SendError(playerid, "Shoma Pool Kafi Nadarid.");
					if(GetPlayerInterior(playerid) != 0) return  SendError(playerid, "Dar in makan nmitavanid in kar ra anjam dahid.");
					if(IsPlayerInAnyVehicle(playerid)) return  SendError(playerid, "Lotfan ebteda az vasile naghlie piade shavid.");
					if(AntiDMZone(playerid) == 1) return  SendError(playerid, "Dar greenzone nmitavanid in kar ra anjam dahid.");
					if(GetPVarInt(playerid, "اللاعبCuffed")) return SendError(playerid, "Shoma cuff hastid.");

					new carid;

					foreach(new _v_id:player_vehicles[playerid])
					{
						if(veh_info[_v_id -1][v_id] == carID)
						{
							carid = veh_info[_v_id -1][v_vehicle];
						}
					}

					foreach(new i: logged_players)
					{
						if(IsPlayerInVehicle(i, carid)) return SendError(playerid, "In vasile naghlie darhal estefade ast.");
						if(is_player_in_boat[i] == carid) return SendError(playerid, "Shoma nemitavanid yek yacht ra ba khod ya digaran dar dakhele an be hol bekeshid.");
						if(is_player_in_journey[i] == carid) return SendError(playerid, "Shoma nemitavanid yek journey ra ba khod ya digaran dar dakhele an be hol bekeshid.");
					}

					new Float:x, Float:y, Float:z;
					GetPlayerPos(playerid, x, y, z);

					UpdateDynamic3DTextLabelText(veh_info[carid -1][v_label_plate], col_gray, veh_info[carid -1][v_plate]);

					SetVehiclePos(carid, x+1.5, y+1.5, z+1.0);
					SetVehicleVirtualWorld(carid, GetPlayerVirtualWorld(playerid));
					LinkVehicleToInterior(carid, GetPlayerInterior(playerid));
					PutPlayerInVehicle(playerid, carid, 0);

					give_money(playerid, -3000);
					insert_money_log(playerid, INVALID_PLAYER_ID, -3000, "/fixالسيارة");

					SendClientMessage(playerid, col_gray, ""scm_sucess"Vasile naghlie movafghiat الظهور shod.");
				}
			}

		}
		case d_fine:
		{
			if(!response)
			{
				for(new i = 0; i < 20; i ++)
				{
					new pvar_string[14];
					format(pvar_string, sizeof(pvar_string), "lf_القائمةid_%d", i);
					DeletePVar(playerid, pvar_string);
				}
				return 1;
			}
			new pvar_string[14];
			format(pvar_string, sizeof(pvar_string), "lf_القائمةid_%d", listitem);
			SetPVarInt(playerid, "fine_vehid", GetPVarInt(playerid, pvar_string));

			for(new i = 0; i < 20; i ++)
			{
				format(pvar_string, sizeof(pvar_string), "lf_القائمةid_%d", i);
				DeletePVar(playerid, pvar_string);
			}

			show_dialog(playerid, d_fine_accept, DIALOG_STYLE_MSGBOX, ""c_server"Parking Toghifi", ""c_white"Aya vaghean mikhahid in transport ra az parking toghifi azad konid?\n\n"c_grey"* Hazine azad kardan: $30,000", "Taeed", "Bargasht");
		}
		case d_fine_accept:
		{
			if(!response)
			{
				new sql_string[128];
				format(sql_string, sizeof sql_string, "اختر * FROM `users_المركبات` WHERE `v_المالك` = '%d' AND `v_fine`>'0'", PlayerInfo[playerid][id]);
				mysql_tquery(sql_connection, sql_string, "load_fine_المركبات", "i", playerid);

				DeletePVar(playerid, "fine_vehid");
				return 1;
			}
			if(PlayerInfo[playerid][money] < 30000) return show_dialog(playerid, d_fine_accept, DIALOG_STYLE_MSGBOX, ""c_server"Parking Toghifi", ""c_white"Aya vaghean mikhahid in transport ra az parking toghifi azad konid?\n\n"c_orange_red"* Hazine azad kardan: $30,000", "Taeed", "Bargasht");

			give_money(playerid, -30000);
			insert_money_log(playerid, INVALID_PLAYER_ID, -30000, "Parking Toghifi");

			new sql_string[128];
			format(sql_string, sizeof sql_string, "اختر * FROM `users_المركبات` WHERE `v_id` = '%d'", GetPVarInt(playerid, "fine_vehid"));
			mysql_tquery(sql_connection, sql_string, "load_اللاعب_المركبات", "i", playerid);

			SendAccess(playerid, "Vasile naghliye azad shod va be sakhteman parking toghifi ersal shod.");
			SendInfo(playerid, "Faramosh nakonid in bar mashin khod ra park konid.");
			DeletePVar(playerid, "fine_vehid");
			return 1;
		}
		case d_b_fee_enter:
		{
			if(!response) return p_t_info[playerid][business] = -1;
			new t = p_t_info[playerid][business] -1;
			if(PlayerInfo[playerid][money] < b_info[t][b_fee]) return SendError(playerid, "Shoma pool kafi nadarid baraye vorood");
			give_money(playerid, -b_info[t][b_fee]);
			insert_money_log(playerid, INVALID_PLAYER_ID, -b_info[t][b_fee], "تسجيل الدخول to الحافلةiness");
			b_info[t][b_money] += b_info[t][b_fee];
			b_info[t][b_cash_today] += b_info[t][b_fee];

			new bis_int = b_info[t][b_int];
			if(bis_int == -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"An خطأ occurred while logging into the المشروع.");
			set_pos(playerid, b_interior[bis_int][i_position][0], b_interior[bis_int][i_position][1], b_interior[bis_int][i_position][2], b_interior[bis_int][i_position][3], b_interior[bis_int][i_interior], b_info[t][b_id] + 1000);
			SetPVarInt(playerid, "tp_همa_used", 1);

			if(b_info[t][b_improve][1]) SendClientMessage(playerid, col_gray, "* Baraye Por Kardan Jon Khod Use "c_green"/bheal"c_grey" ("c_green"250$"c_grey")");
		}
		case d_help:
		{
			if(!response) return 1;
			switch(listitem)
			{
				case 0:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"المساعدة with the game", ""c_server" About the project:\n\n\
					"c_white"Mihan Role Play is one of the most unique projects in the San Andreas Multiplayer industry.\n\
					We try to take into account all the wishes of the players, so that they The server was extremely interesting.\n\
					Our systems and external server design are unique in their own way and thought out to the smallest detail.\n\
					You can choose a job you like, open your own business, or you can Vorood and know the way.\n\
					You can apply to the law enforcement agencies or articles of journalism, articles first-class racer or shooter - here is the will of Vash.\n\
					We hope that the time spent on Mihan Role Play will be most interesting and helpful to pass a few hours with satisfaction.", "Bargasht", "Bastan");

				}
				case 1:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"Safety:\n\n\
					"c_white"Don't forget about account security. Your account is your property.\n\
					Under no circumstances give your registration data to anyone, otherwise you risk losing everything.\n\
					We strongly DO NOT recommend using cheat programs or other software that interferes with the game process and other players.\n\
					For Mihan Role Play players, advanced security settings have been created,\n\
					which, when used, reduce the chance of account hacking to near zero. More details: Command /menu => Safety.", "Bargasht", "Bastan");
				}
				case 2:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"Role Play:\n\n\
					"c_white"Role Play is a type of game where each player plays a specific role. Every player is free to decide\n\
					who they want to be: a policeman or a bandit, a Ranandeh Otobos or a mechanic, a Ranandeh Taxi or a soldier.\n\
					The Role Play mode requires knowledge of certain rules, and failure to follow them will result in punishment.\n\
					You can find this information on the forum of our project.\n", "Bargasht", "Bastan");
				}
				case 3:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"Basics of the game:\n\n\
					"c_white"By playing on Mihan Role Play, you gain experience points.\n\
					Upon accumulating a certain number of points, you advance to the next game level.\n\
					With each new level, new opportunities become available, granting access to more interesting features.\n\
					During gameplay, you will need to use commands. These are entered in the chat [F6] using a forward slash [/].\n\
					For example: /gps, /pass. You can view the full list of commands via /menu => Command List,\n\
					where all the necessary commands for the game and their functions are described.\n\
					You can also view your statistics via /menu => Character Statistics.\n", "Bargasht", "Bastan");
				}
				case 4:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"First steps:\n\n\
					"c_white"To start, you need to earn your first money. There are businesses in the state where you can work part-time.\n\
					These are the Mine, Factory, Sawmill, and Port. By working there, you earn profits and contribute to the state's economy.\n\
					You can also make new friends and enjoy the process while working.\n\
					You can find all businesses using the GPS navigator, which is activated with the /gps command.\n\
					You can take a bus to reach the work locations.\n\
					You can board the bus near the airport, train station, city hall, or the central bus terminal.\n\
					Once you earn a certain amount of money, head to the driving school to get a license.\n\
					The license will allow you to buy or rent a vehicle and take on better-paying and more interesting jobs.\n\
					The driving test costs $1000. Make sure you have this amount before heading to the driving school.\n\
					You can locate the driving school using the GPS navigator, and buses will help you get there.\n", "Bargasht", "Bastan");
				}
				case 5:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"Transport:\n\n\
					"c_white"The transportation system is very important for our state. It supports the operation of businesses and organizations.\n\
					The primary means of transport is the bus. Bus routes connect most businesses and settlements in the state.\n\
					The most convenient means of transportation is a taxi, which allows you to reach any point in the state, but\n\
					taxi rides are significantly more expensive than bus rides.\n\
					You can also buy or rent any type of land or water vehicle.\n\
					Whether it’s a bicycle or a luxury yacht, it’s a matter of taste and budget. You can use the GPS navigator to find places for buying or renting transport.\n\
					Keep in mind that state-owned transport companies are always looking for new employees.\n\
					You can learn more about vacancies and job requirements at City Hall, which you can locate using the GPS navigator.\n", "Bargasht", "Bastan");
				}
				case 6:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"Communication:\n\n\
					"c_white"Throughout the game, you will need to interact with other players. There are two types of chats for this:\n\
					1. IC (In Character) – Communication within the game. It is used for in-game situations.\n\
					You activate the chat by pressing [F6], then entering your message.\n\
					2. OOC (Out Of Character) – Here, you communicate information that is unrelated to the game.\n\
					This chat is also activated by pressing [F6], but you enter the /n command before your message.\n\
					Additionally, there are other communication methods. You can make phone calls or send SMS messages.\n\
					In organizations, radio communication is also available.\n\
					You can find information about all communication methods via /menu => Command List => Communication.\n", "Bargasht", "Bastan");
				}
				case 7:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"Housing:\n\n\
					"c_white"Houses are located throughout the state, and you can purchase one.\n\
					Each house has its own price, determined by many factors, such as location, interior, and whether it has a garage.\n\
					You could buy a small trailer on the outskirts of town, or spend millions on a luxury mansion in an elite neighborhood.\n\
					If you own a house, you can purchase upgrades such as a wardrobe, automatic doors, a safe, a basement setup, and subsidies to reduce rent payments.\n\
					Many houses also have garages where you can store your vehicle.\n\
					Depending on the prestige of your home, rent will be charged. If you stop paying rent,\n\
					City Hall workers may evict you and leave you with nothing.\n", "Bargasht", "Bastan");
				}
				case 8:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"المشروع:\n\n\
					"c_white"You can open your own business and earn good money. This can be a clothing store, a snack bar,\n\
					a gas station, or an elite nightclub. Our state has many different businesses.\n\
					By owning a business, you gain new opportunities to attract customers.\n\
					You can set prices, improve and develop your business - you have the freedom to do so.", "Bargasht", "Bastan");
				}
				case 9:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"البنكs and المخزن of funds:\n\n\
					"c_white"Our state has a banking system.\n\
					In the banks located in three cities, you can open an account where your salary and other income will be deposited.\n\
					With an account, you can deposit and withdraw money, transfer funds to another account, and top up your phone balance.\n\
					You can find banks using the GPS navigator.", "Bargasht", "Bastan");
				}
				case 10:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"الوظائف:\n\n\
					"c_white"In the state city hall, there is an employment department where you can apply for any of the available jobs.\n\
					However, you cannot work and be part of organizations simultaneously.\n\
					In addition to your main job, you can take on part-time work at the state businesses. These include the Mine, Factory, Sawmill, and Port.\n\
					You can use the GPS navigator to find job locations.\n\
					You can also apply at the casino's human resources department.", "Bargasht", "Bastan");
				}
				case 11:
				{
					show_dialog(playerid, d_help_box, DIALOG_STYLE_MSGBOX, ""c_server"مساعدة اللعبة", ""c_server"Organizations:\n\n\
					"c_white"Our state has a large number of organizations. They can be official\n\
					(Government, Police Department, Ministry of Defense, Ministry of Health, News Agency, etc.) or unofficial (gangs and mafias).\n\
					The management of organizations may set additional requirements for membership.\n\
					For example, to become a reporter, you need skills in editing announcements, while gang members will need to demonstrate weapon handling skills.\n\
					Additional requirements will be communicated by the organization management during recruitment.\n\
					After joining an organization, you can advance up the career ladder, gradually unlocking new opportunities.\n\
					As your position increases, your status and salary will rise. Over time, you can occupy one of the management positions.\n\
					You will also make new friends and have a great time.", "Bargasht", "Bastan");
				}
			}
			return 1;
		}
		case d_help_box:
		{
			if(!response) return 1;
			show_dialog(playerid, d_help, DIALOG_STYLE_LIST, ""c_server"مساعدة اللعبة", ""c_server"1. "c_white"About the project\n"c_server"2. "c_white"Safety\n"c_server"3. "c_white"Role Play\n"c_server"4. "c_white"Basics of the game\n"c_server"5. "c_white"First steps\n"c_server"6. "c_white"Transport\n"c_server"7. "c_white"Communication\n"c_server"8. "c_white"Housing\n"c_server"9. "c_white"المشروع\n"c_server"10. "c_white"البنكs and المخزن of funds\n"c_server"11. "c_white"Works\n"c_server"12. "c_white"Organizations", "Entekhab", "Bastan");
			return 1;
		}
		case d_port_help:
		{
			if(!response) return SetCameraBehindPlayer(playerid);
