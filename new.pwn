					mysql_tquery(sql_connection, query_string, "اتصالرجوع_bl_العائلة", "i", playerid);
				}
			}
		}
		case d_blclear_family:
		{
			if(!response) return show_dialog(playerid, d_blacklist_family, DIALOG_STYLE_LIST, !""scm_dialog"Blackالقائمة", !""c_server"1."c_white" Add a person to the blackالقائمة\n"c_server"2."c_white" Clear the blackالقائمة\n"c_server"3."c_white" Remove a person from the blackالقائمة\n"c_server"4."c_white"اللاعب القائمة السوداء", !"Entekhab", !"Bargasht");

			new query_string[75];
			format(query_string, sizeof(query_string), "حذف FROM `العائلة_blackالقائمة` WHERE `bl_العائلة`='%d'", PlayerInfo[playerid][family]);
			mysql_query(sql_connection, query_string);

			format(query_string, sizeof(query_string), "%s cleهمd the القائمة السوداء", PlayerInfo[playerid][name]);
			write_family(playerid, PlayerInfo[playerid][family], TYPE_LOG_BL, query_string);

			SendInfo(playerid, "Blackالقائمة تمت العملية بنجاحfully cleهمd.");
			show_dialog(playerid, d_blacklist_family, DIALOG_STYLE_LIST, !""scm_dialog"Blackالقائمة", !""c_server"1."c_white" Add a person to the blackالقائمة\n"c_server"2."c_white" Clear the blackالقائمة\n"c_server"3."c_white" Remove a person from the blackالقائمة\n"c_server"4."c_white"اللاعب القائمة السوداء", !"Entekhab", !"Bargasht");
		}
		case d_bluninvite_family:
		{
			if(!response) return show_dialog(playerid, d_blacklist_family, DIALOG_STYLE_LIST, !""scm_dialog"Blackالقائمة", !""c_server"1."c_white" Add a person to the blackالقائمة\n"c_server"2."c_white" Clear the blackالقائمة\n"c_server"3."c_white" Remove a person from the blackالقائمة\n"c_server"4."c_white"اللاعب القائمة السوداء", !"Entekhab", !"Bargasht");

			if(!strlen(inputtext)) return show_dialog(playerid, d_bluninvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_grey"You didn't specify anything\n"c_white"أدخل اللاعب الاسم you want to remove from the blackالقائمة:", !"التالي", !"Bargasht");
			if(is_text_invalid(inputtext)) return show_dialog(playerid, d_bluninvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_grey"غير صالح اللاعب nickالاسم\n"c_white"أدخل اللاعب الاسم you want to remove from the blackالقائمة:", !"التالي", !"Bargasht");
			if(strlen(inputtext) < 6 || strlen(inputtext) > 24) return show_dialog(playerid, d_bluninvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_grey"Nickالاسم too short / long\n"c_white"أدخل اللاعب الاسم you want to remove from the blackالقائمة:", !"التالي", !"Bargasht");

			new query_string[120];
			mysql_format(sql_connection, query_string, sizeof(query_string), "اختر `bl_اللاعب` FROM `العائلة_blackالقائمة` WHERE `bl_الاسم`='%e' AND `bl_العائلة`='%d' LIMIT 1", inputtext, PlayerInfo[playerid][family]);
			mysql_tquery(sql_connection, query_string, "check_bl_القائمة_العائلة", "ds", playerid, inputtext);
		}
		case d_blinvite_family:
		{
			if(!response) return show_dialog(playerid, d_blacklist_family, DIALOG_STYLE_LIST, !""scm_dialog"Blackالقائمة", !""c_server"1."c_white" Add a person to the blackالقائمة\n"c_server"2."c_white" Clear the blackالقائمة\n"c_server"3."c_white" Remove a person from the blackالقائمة\n"c_server"4."c_white" اللاعب القائمة السوداء", !"Entekhab", !"Bargasht");

			new targetid, reason[24];
			if(sscanf(inputtext, "p<,>ds[24]", targetid, reason)) return show_dialog(playerid, d_blinvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_white"أدخل اللاعب ID and السبب you want to add to the blackالقائمة:\n\n"c_grey"Example: 1, العائلة insult", !"التالي", !"Bargasht");
			if(targetid < 0) return show_dialog(playerid, d_blinvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_grey"اللاعب ليس Found\n"c_white"أدخل اللاعب ID and السبب you want to add to the blackالقائمة:\n\n"c_grey"Example: 1, العائلة insult", !"التالي", !"Bargasht");
			if(!IsPlayerConnected(targetid) || targetid == playerid) return show_dialog(playerid, d_blinvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_grey"اللاعب ليس Found\n"c_white"أدخل اللاعب ID and السبب you want to add to the blackالقائمة:\n\n"c_grey"Example: 1, العائلة insult", !"التالي", !"Bargasht");
			if(PlayerInfo[targetid][family] == PlayerInfo[playerid][family]) return show_dialog(playerid, d_blinvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_grey"The اللاعب هو ليس in your العائلة\n"c_white"أدخل اللاعب ID and السبب you want to add to the blackالقائمة:\n\n"c_grey"Example: 1, العائلة insult", !"التالي", !"Bargasht");
			if(strlen(reason) < 5) return show_dialog(playerid, d_blinvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_grey"السبب هو too short\n"c_white"أدخل اللاعب ID and السبب you want to add to the blackالقائمة:\n\n"c_grey"Example: 1, العائلة insult", !"التالي", !"Bargasht");
			if(strlen(reason) > 24) return show_dialog(playerid, d_blinvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_grey"السبب هو too long\n"c_white"أدخل اللاعب ID and السبب you want to add to the blackالقائمة:\n\n"c_grey"Example: 1, العائلة insult", !"التالي", !"Bargasht");

			new query_string[256];
			format(query_string, sizeof(query_string), "INSERT INTO `العائلة_blackالقائمة`(`bl_اللاعب`,`bl_العائلة`,`bl_الاسم`,`bl_التاريخ`,`bl_السبب`,`bl_add_الاسم`) VALUES ('%d','%d','%s',لاW(),'%s','%s')", PlayerInfo[targetid][id], PlayerInfo[playerid][family], PlayerInfo[targetid][name], reason, PlayerInfo[playerid][name]);
			mysql_query(sql_connection, query_string);

			new text_string[144];
			format(text_string, sizeof(text_string), "%s added %s to the العائلة القائمة السوداء %s. السبب: %s.", PlayerInfo[playerid][name], PlayerInfo[targetid][name], family_info[PlayerInfo[playerid][family]][fam_name], reason);
			write_family(playerid, PlayerInfo[playerid][family], TYPE_LOG_BL, text_string);

			format(text_string, sizeof(text_string), ""scm_info""c_server"%s"c_white" added you to the العائلة القائمة السوداء %s. السبب: %s", PlayerInfo[playerid][name], family_info[PlayerInfo[playerid][family]][fam_name], reason);
			SendClientMessage(targetid, col_white, text_string);

			format(text_string, sizeof(text_string), ""scm_info"You added "c_server"%s"c_white" to the القائمة السوداء", PlayerInfo[targetid][name]);
			SendClientMessage(playerid, col_white, text_string);

			show_dialog(playerid, d_blacklist_family, DIALOG_STYLE_LIST, !""scm_dialog"Blackالقائمة", !""c_server"1."c_white" Add a person to the blackالقائمة\n"c_server"2."c_white" Clear the blackالقائمة\n"c_server"3."c_white" Remove a person from the blackالقائمة\n"c_server"4."c_white" اللاعب القائمة السوداء", !"Entekhab", !"Bargasht");
		}
		case d_family_bank:
		{
			if(!response) return show_dialog(playerid, d_bank, DIALOG_STYLE_LIST, ""scm_dialog"البنك", ""c_server"1 | "c_white"الحساب Management\n"c_server"2 | "c_white"فتح a جديد الحساب\n"c_server"3 | "c_white"الأفضل up الهاتف الرصيد\n"c_server"4 | "c_white"دفعing taxes\n"c_server"5 | "c_white"دفعing fines\n"c_server"6 | "c_white"الرصيد organization\n"c_server"7 | "c_white"العائلة الحساب\n"c_server"8 | "c_white"المشروع reجديدal\n"c_server"9 | "c_white"المنزل reجديدal", "Entekhab", "Bastan");

			switch(listitem)
			{
				case 0: show_dialog(playerid, d_family_bank_put, DIALOG_STYLE_INPUT, !""scm_dialog"العائلة البنك", !""c_white"أدخل the المبلغ you want to إيداع into the العائلة البنك:", !"Entekhab", !"Bargasht");
				case 1: show_dialog(playerid, d_family_bank_take, DIALOG_STYLE_INPUT, !""scm_dialog"العائلة البنك", !""c_white"أدخل the المبلغ you want to سحب from the العائلة البنك:", !"Entekhab", !"Bargasht");
			}
		}
		case d_family_bank_put:
		{
			if(!response) return show_dialog(playerid, d_family_bank, DIALOG_STYLE_LIST, !""scm_dialog"العائلة الحساب", !""c_server"1 | "c_white"الأفضل up الحساب\n"c_server"2 | "c_white"سحب from الحساب", !"Entekhab", !"Bargasht");

			new _value = strval(inputtext), familyid = PlayerInfo[playerid][family];
			if(_value < 1) return show_dialog(playerid, d_family_bank_put, DIALOG_STYLE_INPUT, !""scm_dialog"العائلة البنك", !""c_white"أدخل the المبلغ you want to إيداع into the العائلة البنك:\n\n"c_grey"لا يمكنك إيداع less than $1", !"Entekhab", !"Bargasht");
			if(_value > PlayerInfo[playerid][money]) return show_dialog(playerid, d_family_bank_put, DIALOG_STYLE_INPUT, !""scm_dialog"العائلة البنك", !""c_white"أدخل the المبلغ you want to إيداع into the العائلة البنك:\n\n"c_grey"You do ليس have eلاugh المال", !"Entekhab", !"Bargasht");

			new text_string[144];
			format(text_string, sizeof(text_string), "{%s}[العائلة]"c_silver" %s %s[%d] إيداعed $%d into the العائلة البنك", family_info[familyid][fam_chat_color], family_rank[familyid][PlayerInfo[playerid][family_rang] -1], PlayerInfo[playerid][name], playerid, _value);
			family_message(familyid, col_silver, text_string);

			give_money(playerid, -_value);
			insert_money_log(playerid, INVALID_PLAYER_ID, -_value, "العائلة البنك");

			family_info[familyid][fam_bank] += _value;

			new query_string[80];
			mysql_format(sql_connection, query_string, sizeof(query_string), "UPالتاريخ `العائلة` SET `fam_البنك`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[familyid][fam_bank], getPlayerFamilyID(playerid));
			mysql_query(sql_connection, query_string);

			format(query_string, sizeof(query_string), "%s إيداعed $%d into the العائلة البنك", PlayerInfo[playerid][name], _value);
			write_family(playerid, familyid, TYPE_LOG_OBWYAK, query_string);
		}
		case d_family_bank_take:
		{
			if(!response) return show_dialog(playerid, d_family_bank, DIALOG_STYLE_LIST, !""scm_dialog"العائلة الحساب", !""c_server"1 | "c_white"الأفضل up الحساب\n"c_server"2 | "c_white"سحب from الحساب", !"Entekhab", !"Bargasht");

			new _value = strval(inputtext), familyid = PlayerInfo[playerid][family];
			if(family_info[familyid][fam_settings][3] > PlayerInfo[playerid][family_rang])
			{
				pc_cmd_fmenu(playerid);
				return SendError(playerid, "Only the القائد can سحب المال from the العائلة البنك.");
			}
			if(_value < 1) return show_dialog(playerid, d_family_bank_take, DIALOG_STYLE_INPUT, !""scm_dialog"العائلة البنك", !""c_grey"لا يمكنك سحب less than $1\n"c_white"أدخل the المبلغ you want to سحب from the العائلة البنك:", !"Entekhab", !"Bargasht");
			if(family_info[familyid][fam_bank] < _value) return show_dialog(playerid, d_family_bank_take, DIALOG_STYLE_INPUT, !""scm_dialog"العائلة البنك", !""c_grey"There هم insufficient funds in the العائلة البنك\n"c_white"أدخل the المبلغ you want to سحب from the العائلة البنك:", !"Entekhab", !"Bargasht");

			new text_string[128];
			format(text_string, sizeof(text_string), "{%s}[العائلة]"c_silver" %s %s[%d] withdrew $%d from the العائلة البنك", family_info[familyid][fam_chat_color], family_rank[familyid][PlayerInfo[playerid][family_rang] -1], PlayerInfo[playerid][name], playerid, _value);
			family_message(familyid, col_silver, text_string);

			give_money(playerid, _value);
			insert_money_log(playerid, INVALID_PLAYER_ID, _value, "العائلة البنك");

			family_info[familyid][fam_bank] -= _value;

			new query_string[80];
			mysql_format(sql_connection, query_string, sizeof(query_string), "UPالتاريخ `العائلة` SET `fam_البنك`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[familyid][fam_bank], getPlayerFamilyID(playerid));
			mysql_tquery(sql_connection, query_string);

			format(query_string, sizeof(query_string), "%s withdrew $%d from the العائلة البنك", PlayerInfo[playerid][name], _value);
			write_family(playerid, familyid, TYPE_LOG_OBWYAK, query_string);
		}
		case d_family_omembers:
		{
			if(!response) return 1;
			pc_cmd_fmenu(playerid);
