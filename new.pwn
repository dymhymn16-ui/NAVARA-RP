		case d_spawnchange:
		{
			if(!response) return 1;

			switch(listitem)
			{
				case 0: return pc_cmd_spawnchange(playerid);
				case 1: SendInfo(playerid, "Shoma ba movafghiat mahal الظهور khode ra be "c_gold"هوtgah Ghatar"c_white" taghir dadid.");
				case 2:
				{
					if(PlayerInfo[playerid][house] == -1) return SendError(playerid, "Shoma Khane Nadarid.");
					SendInfo(playerid, "Shoma ba movafghiat mahal الظهور khode ra be "c_gold"Dakhel Khane"c_white" taghir dadid.");
				}
				case 3:
				{
					if(!playerFactionStatus(playerid)) return SendError(playerid, "Shoma Dar Factioni Nهوtid.");
					SendInfo(playerid, "Shoma ba movafghiat mahal الظهور khode ra be "c_gold"Dakhel Faction"c_white" taghir dadid.");
				}
				case 4:
				{
					new yacht_id = 0;
					foreach(new veh_id: player_vehicles[playerid])
					{
						if(!v_boat_int(veh_id)) continue;
						yacht_id++;
						break;
					}
					if(!yacht_id) return SendError(playerid, "Shoma Yachat Shakhsi Nadarid.");
					SendInfo(playerid, "Shoma ba movafghiat mahal الظهور khode ra be "c_gold"Dakhel Yachat Shakhsi"c_white" taghir dadid.");
				}
				case 5:
				{
					if(!playerRentHouseStatus(playerid)) return SendError(playerid, "Shoma Khane Ejهمh Nakardid.");
					SendInfo(playerid, "Shoma ba movafghiat mahal الظهور khode ra be "c_gold"Dakhel Khoneh Ejهمh Shode"c_white" taghir dadid.");
				}
				case 6:
				{
					if(!playerFamilyStatus(playerid)) return SendError(playerid, "Shoma dar العائلة nهوtid.");

					if(!familyHouseStatus(PlayerInfo[playerid][family])) return SendError(playerid, "العائلة Shoma Khane Nadarad.");
					
					SendInfo(playerid, "Shoma ba movafghiat mahal الظهور khode ra be "c_gold"Dakhel Khoneh العائلة"c_white" taghir dadid.");
				}
				case 7:
				{
					new journey_id = 0;
					foreach(new veh_id: player_vehicles[playerid])
					{
						if(veh_info[veh_id -1][v_model] != 508) continue;
						journey_id++;
						break;
					}
					if(!journey_id) return SendError(playerid, "Shoma Journey Shakhsi Nadarid.");
					SendInfo(playerid, "Shoma ba movafghiat mahal الظهور khode ra be "c_gold"Dakhel Journey Shakhsi"c_white" taghir dadid.");
				}
			}
			PlayerInfo[playerid][spawnchange] = listitem -1;
			update_int_sql(playerid, "u_الظهورchange", PlayerInfo[playerid][spawnchange]);
			return 1;
		}
		case d_reg_mp:
		{
		    if(!response) return 1;


			switch(listitem)
		    {
		        case 0:
		        {
                    if(StartPaintBall != 1)
					{
						SendError(playerid, "SabtNam Baste ast sabr konid ta shoro beshe.");
						return 1;
					}
					if(TeamPaint[playerid])
					{
						SendError(playerid, "shoma az ghabl sabtnam kardid.");
						return 1;
					}
					if(PlayerInfo[playerid][money] < 500) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You do ليس have eلاugh funds for regهوtration.");
					KillPaint[playerid] = DeathPaint[playerid] = 0;
					if(RedPlayer == 0 && BluePlayer == 0 || BluePlayer < RedPlayer || RedPlayer == BluePlayer)
					{
						SendClientMessage(playerid, col_gray, ""c_server"* S.المعلومات:"c_grey" أنت إنشاء حسابed for the match. You play as the blue team.");
						BluePlayer ++;
						TeamPaint[playerid] = 1;
					}
					else if(BluePlayer > RedPlayer)
					{
						SendClientMessage(playerid, col_gray, ""c_server"* S.المعلومات:"c_grey" أنت إنشاء حسابed for the match. You play as the red team.");
						RedPlayer ++;
						TeamPaint[playerid] = 2;
					}
					give_money(playerid, -500);
					insert_money_log(playerid, INVALID_PLAYER_ID, -500, "regهوtration on m");
					paintball_bank += 500;
		        }
		        case 1:
		        {
		            if(StartRace != 1)
					{
						SendError(playerid, "Regهوtration إغلاقd.");
						return 1;
					}
					if(is_player_race_regged[playerid])
					{
						SendError(playerid, "أنت already إنشاء حسابed.");
						return 1;
					}
					if(PlayerInfo[playerid][money] < 500) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You do ليس have eلاugh funds for regهوtration.");
					is_player_race_regged[playerid] = 1;
					PlayerRaceCount ++;
					SendClientMessage(playerid, col_gray, ""c_server"* S.المعلومات:"c_grey" أنت إنشاء حسابed for the race, waiting for the بدء of the race.");
					give_money(playerid, -500);
					insert_money_log(playerid, INVALID_PLAYER_ID, -500, "regهوtration on m");
					race_bank += 500;
		        }
		    }
		    return 1;
		}

		case d_rent_vehicle:
		{
			if(!response) {
				DeletePVar(playerid, "استئجار_id");
				return 1;
			}

			new rent_id = GetPVarInt(playerid, "استئجار_id"), rent_model, rent_color[2], rent_name[50], rent_money, rent_level;

			switch(listitem)
			{
				case 0: rent_model = 481, rent_color[0] = random(255), rent_color[1] = random(255), rent_name = "BMX", rent_money = 5, rent_level = 1;
				case 1: rent_model = 509, rent_color[0] = random(255), rent_color[1] = random(255), rent_name = "Bike", rent_money = 15, rent_level = 1;
				case 2: rent_model = 510, rent_color[0] = random(255), rent_color[1] = random(255), rent_name = "Mountain", rent_money = 20, rent_level = 1;
				case 3: rent_model = 462, rent_color[0] = 1, rent_color[1] = 1, rent_name = "Faggio", rent_money = 50, rent_level = 2;
				case 4: rent_model = 468, rent_color[0] = random(255), rent_color[1] = random(255), rent_name = "Sanchez", rent_money = 90, rent_level = 5;
				case 5: rent_model = 585, rent_color[0] = random(255), rent_color[1] = random(255), rent_name = "Emperor", rent_money = 120, rent_level = 5;
				case 6:
				{
					if(check_admin_rank(playerid , 8)) return 1;

					new query_string[200];
					mysql_format(sql_connection, query_string, sizeof(query_string), "حذف FROM `استئجار_pos` WHERE `id` = '%d'", rent_info[rent_id][id]);
					mysql_query(sql_connection, query_string);

					DestroyDynamicPickup(rent_info[rent_id][rent_pickup]);
					DestroyDynamic3DTextLabel(rent_info[rent_id][rent_label]);
					DestroyDynamic3DTextLabel(rent_info[rent_id][rent_label_alt]);

					rent_info[rent_id][id] = -1;

					rent_info[rent_id][rent_pos][0] = -1;
					rent_info[rent_id][rent_pos][1] = -1;
					rent_info[rent_id][rent_pos][2] = -1;
					rent_info[rent_id][rent_pos][3] = -1;
					rent_info[rent_id][rent_spawn][0] = -1;
					rent_info[rent_id][rent_spawn][1] = -1;
					rent_info[rent_id][rent_spawn][2] = -1;

					SendClientMessage(playerid, col_gray, c_green"[استئجار-النظام]"c_white" استئجار ba movafaghiyat hazf shod va dar database حذفd shod.");
					return 1;
				}
			}

			if(player_rentcar[playerid] != INVALID_VEHICLE_ID) {
				RemovePlayerFromVehicle(playerid);
				return SendError(playerid, "Baraye hazf vasile ejهمh shode bznid "c_orange_red"/إيقافاستئجار");
			}

			if(PlayerInfo[playerid][money] < 20 && listitem <= 2)
			{
				rent_money = 0;
			}

			if(PlayerInfo[playerid][money] < rent_money)
				return SendError(playerid, "Shoma pool kafi baraye ejهمh in vasile naghlie ra nadarid.");

			if(PlayerInfo[playerid][level] < rent_level)
				return SendError(playerid, "Shoma المستوى kafi baraye ejهمh in vasile naghlie ra nadarid");

			new _vehicle_id = CreateVehicle(rent_model, rent_info[rent_id][rent_pos][0], rent_info[rent_id][rent_pos][1], rent_info[rent_id][rent_pos][2], rent_info[rent_id][rent_pos][3], rent_color[0], rent_color[1], 300);

			veh_info[_vehicle_id -1][v_type] = vehicle_type_job;
			veh_info[_vehicle_id -1][v_fuel] = 100;

			if(listitem == 3) AttachRentVehicleObjects(1, _vehicle_id);

			SetVehicleNumberPlate(_vehicle_id, rent_name);

			if(rent_money > 0)
				give_money(playerid, -rent_money);

			player_rentcar[playerid] = _vehicle_id;

			PutPlayerInVehicle(playerid, _vehicle_id, 0);

			new engine, lights, alarm, doors, bonnet, boot, objective;
			veh_info[player_rentcar[playerid] -1][v_locked] = true;

			GetVehicleParamsEx(player_rentcar[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(player_rentcar[playerid], VEHICLE_PARAMS_ON, lights, alarm, true, bonnet, boot, objective);

			pc_cmd_en(playerid);

			GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ السيارة LOCK", 3000, 3);

			new string[200];
			format(string, sizeof(string), ""scm_sucess"أنت ba movafaghiyat yek "c_yellow"%s"c_white" ra ejهمh العملdid.", rent_name);
			SendClientMessage(playerid, col_white, string);
			SendClientMessage(playerid, col_white, ""scm_sucess"Jahat Baz/Bastan dar vasile ejهمh shode az "c_green"/rlock"c_white" estefade konid.");

			DeletePVar(playerid, "استئجار_id");
			return 1;
		}

		case d_donate:
		{
