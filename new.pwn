				DeletePVar(playerid, "frac_دعوة");
				DeletePVar(playerid, "frac_دعوة_pl_id");
				return 1;
			}
			SendClientMessage(playerid, 0x14A3FFFF, "Wait for the القائد/النائب to اختر clothes for you.");
		
			new frac_id = GetPVarInt(playerid, "frac_دعوة"),
				dialog_string[max_rank * 6 + 108];

			for(new j = 0; j < max_rank; j ++)
			{
				if(f_skin[frac_id -1][PlayerInfo[playerid][gender]][j] == 1) break;
				new line_string[7];
				format(line_string, 7, "%d\n", f_skin[frac_id -1][PlayerInfo[playerid][gender]][j]);
				strcat(dialog_string, line_string);
			}
			show_dialog(GetPVarInt(playerid, "frac_دعوة_pl_id")-1, d_invite_skin, DIALOG_STYLE_LIST, ""c_server"Choice clothes", dialog_string, "قبول", "");
			SetPVarInt(GetPVarInt(playerid, "frac_دعوة_pl_id")-1, "frac_دعوة_sk_id", playerid + 1);

			PlayerInfo[playerid][member] = frac_id;
			PlayerInfo[playerid][rank] = 1;
			PlayerInfo[playerid][org_skin] = f_skin[frac_id -1][PlayerInfo[playerid][gender]][0];
			is_fraction_duty{playerid} = 1;

			SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);

			update_int_sql(playerid, "u_org_skin", PlayerInfo[playerid][org_skin]);

			PlayerInfo[playerid][spawnchange] = 2;
			update_int_sql(playerid, "u_الظهورchange", PlayerInfo[playerid][spawnchange]);

			RunQuery("UPالتاريخ `users` SET `u_عضو` = '%d', `u_الرتبة` = '%d', `u_fraction_التاريخ` = لاW(), `u_الوظيفة`='-1' WHERE `u_id` = '%d' LIMIT 1", getPlayerFactionID(playerid), PlayerInfo[playerid][rank], PlayerInfo[playerid][id]);

			if(PlayerInfo[playerid][member] == TopWarGangAttacker || PlayerInfo[playerid][member] == TopWarGangProtector) {
				TopWar_ShowSmallTopWarInfo(playerid);
				CaptureInfoUpdate(playerid, true);
			}

			PlayerInfo[playerid][job] = -1;

			PlayerInfo[playerid][f_warning] = 0;
			update_int_sql(playerid, "u_f_تحذير", PlayerInfo[playerid][f_warning]);
			DeletePVar(playerid, "frac_دعوة");
			DeletePVar(playerid, "frac_دعوة_pl_id");
		}
