					mysql_tquery(sql_connection, !"UPالتاريخ `users` SET `u_مطلوب` = '0', `u_bail` = '0', `u_السجن` = '0', `u_مسجون` = '0' WHERE `u_مسجون` > '0'");

					foreach(new i : logged_players)
					{
