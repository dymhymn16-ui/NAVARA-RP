					update_int_sql(targetid, "u_drive_lic", PlayerInfo[targetid][drive_lic]);
				}
				case 1:
				{
					new t_string[82 + MAX_PLAYER_NAME];
					format(t_string, sizeof(t_string), ""c_server"* S.معلومات:"c_grey" %s granted you an رخصة النقل الجوي.", PlayerInfo[playerid][name]);
					SendClientMessage(targetid, col_gray, t_string);
					PlayerInfo[targetid][fly_lic] = 60;

					AdminMes(""c_server"* A.معلومات:"c_grey" %s هوsued an رخصة النقل الجوي to %s.", PlayerInfo[playerid][name], PlayerInfo[targetid][name]);

					update_int_sql(targetid, "u_fly_lic", PlayerInfo[targetid][fly_lic]);
