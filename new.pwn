				show_dialog(playerid, d_family_fixcar_1, DIALOG_STYLE_LIST, !""scm_dialog"السيارة الإعدادات", slobal_string, !"Entekhab", !"إلغاء");
				
				return SetPVarInt(playerid, !"المركبةlMenu", vehicle_id);
			}

			veh_info[vehicle_id -1][v_rank] = listitem + 1;

