	        format(text_string, sizeof(text_string), "%s %s[%d] declهمd %s[%d] مطلوب [%d/6], السبب: %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, PlayerInfo[targetid][name], targetid, PlayerInfo[targetid][wanted], wanted_search_list[listitem][wanted_reason]);
	        foreach(new i: logged_players) if(cop_player(i) || fbi_player(i)) SendClientMessage(i, 0xFFD700FF, text_string);
	        
	        PlayerInfo[playerid][activity_wanted_give_players]++;
