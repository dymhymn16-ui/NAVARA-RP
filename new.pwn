			new pvar_string[38],
				pl_name[MAX_PLAYER_NAME -4];

			format(pvar_string, sizeof(pvar_string), "ofm_%d", GetPVarInt(playerid, "ofm_القائمةالعنصر"));
			GetPVarString(playerid, pvar_string, pl_name, MAX_PLAYER_NAME -4);
			format(pvar_string, sizeof(pvar_string), ""c_server"%s", pl_name);
			show_dialog(playerid, d_offmembers_pl_menu, DIALOG_STYLE_LIST, pvar_string, "اللاعب المعلومات\nDهوmهوs from Organizations\nPromote/Demote اللاعب", "Entekhab", "Bargasht");
		}
		case d_invite:
		{
			if(!response)
			{
				ShowLeaderMenu(playerid);
				return 1;
			}
			new targetid = strval(inputtext);
			if(!targetid) return show_dialog(playerid, d_invite, DIALOG_STYLE_INPUT, ""c_server"موافق اللاعب", ""c_grey"غير صالح اللاعب ID!\n\n"c_white"أدخل the ID of the اللاعب you want to قبول into the organization:", "قبول", "Bargasht");
			if(!IsPlayerConnected(targetid) || targetid == playerid) return show_dialog(playerid, d_invite, DIALOG_STYLE_INPUT, ""c_server"موافق اللاعب", ""c_grey"غير صالح اللاعب ID!\n\n"c_white"أدخل the ID of the اللاعب you want to قبول into the organization:", "قبول", "Bargasht");
			if(playerFactionStatus(playerid) || GetPVarInt(playerid, "frac_دعوة")) return show_dialog(playerid, d_invite, DIALOG_STYLE_INPUT, ""c_server"موافق اللاعب", ""c_grey"The اللاعب هو already in Organizations!\n\n"c_white"أدخل the ID of the اللاعب you want to قبول into the organization:", "قبول", "Bargasht");
			if(p_t_info[targetid][p_dialog] != -1) return show_dialog(playerid, d_invite, DIALOG_STYLE_INPUT, ""c_server"موافق اللاعب", ""c_grey"Thهو اللاعب هو busy!\n\n"c_white"أدخل the ID of the اللاعب you want to قبول into the organization:", "قبول", "Bargasht");
			if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[targetid][p_pos][0], p_t_info[targetid][p_pos][1], p_t_info[targetid][p_pos][2]) || GetPlayerVirtualWorld(targetid) != GetPlayerVirtualWorld(playerid)) return show_dialog(playerid, d_invite, DIALOG_STYLE_INPUT, ""c_server"موافق اللاعب", ""c_grey"Thهو اللاعب هو too far away from you!\n\n"c_white"أدخل the ID of the اللاعب you want to قبول into the organization:", "قبول", "Bargasht");
			if(get_player_warn_count(targetid) != 0) return show_dialog(playerid, d_invite, DIALOG_STYLE_INPUT, ""c_server"موافق اللاعب", ""c_orange_red"* لا يمكنك قبول a اللاعب with a تحذير into the organization.\n\n"c_white"أدخل the ID of the اللاعب you want to قبول into the organization:", "قبول", "Bargasht");
			if(is_player_fraction_bl(targetid, PlayerInfo[playerid][member]) != 0) return show_dialog(playerid, d_invite, DIALOG_STYLE_INPUT, ""c_server"موافق اللاعب", ""c_orange_red"* لا يمكنك قبول a اللاعب from the blackالقائمة of Organizations.\n\n"c_white"أدخل the ID of the اللاعب you want to قبول into the organization:", "قبول", "Bargasht");

			new _text_string[128];
			format(_text_string, sizeof _text_string, "You دعوةd %s to the organization", PlayerInfo[targetid][name]);
			SendClientMessage(playerid, col_gray, _text_string);
			format(_text_string, sizeof _text_string, ""c_server"%s "c_white"دعوةs you to join the organization "c_grey"\"%s\"", PlayerInfo[playerid][name], f_info[PlayerInfo[playerid][member]][f_name]);
			show_dialog(targetid, d_invite_box, DIALOG_STYLE_MSGBOX, ""c_server"Joining the Organization", _text_string, "أدخل", "رفض");
			SetPVarInt(targetid, "frac_دعوة", PlayerInfo[playerid][member]);
			SetPVarInt(targetid, "frac_دعوة_pl_id", playerid + 1);
		}
		case d_uninvite_reason:
		{
			if(!response)
			{
				show_dialog(playerid, d_uninvite, DIALOG_STYLE_INPUT, ""c_server"Remove اللاعب", ""c_white"أدخل the ID of the اللاعب you want to fire from the organization:", "قبول", "Bargasht");
				DeletePVar(playerid, "unدعوة_plid");
				return 1;
			}
			if(strlen(inputtext) < 3 || strlen(inputtext) > 68)
			{
				show_dialog(playerid, d_uninvite_reason, DIALOG_STYLE_INPUT, ""c_server"Fire اللاعب", ""c_white"أدخل the السبب for firing the اللاعب\n\n"c_orange_red"* * The length of the السبب must be between 3 and 48 characters", "قبول", "Bargasht");
				return 1;
			}
			if(is_text_invalid(inputtext))
			{
				show_dialog(playerid, d_uninvite_reason, DIALOG_STYLE_INPUT, ""c_server"Fire اللاعب", ""c_white"أدخل the السبب for firing the اللاعب\n\n"c_orange_red"* Contains prohibited characters", "قبول", "Bargasht");
				return 1;
			}
			new targetid = GetPVarInt(playerid, "unدعوة_plid");

			new scm_string[266];
			format(scm_string, 128, "%s fired you from Organizations. السبب: "c_white"%s", PlayerInfo[playerid][name], inputtext);
			SendClientMessage(targetid, 0x14A3FFFF, scm_string);
			format(scm_string, 128, "You fired %s from Organizations. السبب: "c_white"%s", PlayerInfo[targetid][name], inputtext);
			SendClientMessage(playerid, 0x14A3FFFF, scm_string);
			if(gang_player(playerid))
			{
				format(scm_string, 128, "%s(%d) %s الخبرةelled %s(%d) %s from the همa. السبب: %s",
				f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1],
				PlayerInfo[playerid][rank],
				PlayerInfo[playerid][name],

				f_rank[PlayerInfo[targetid][member]][PlayerInfo[targetid][rank] -1],
				PlayerInfo[targetid][rank],
				PlayerInfo[targetid][name], inputtext);
				foreach(new i: logged_players) if((PlayerInfo[i][member] == PlayerInfo[playerid][member] || is_control_chat {i} == PlayerInfo[playerid][member]) && PlayerInfo[i][settings][0] != 0) SendClientMessage(i, 0x4682B4AA, scm_string);
			}

			// ----------------------
			// Top War
			new topWarTarget = targetid;
			if(PlayerInfo[topWarTarget][member] == TopWarGangAttacker || PlayerInfo[topWarTarget][member] == TopWarGangProtector) {
				TopWar_HideSmallTopWarInfo(topWarTarget);

				// Reset Vars
				for(new GangPlayerEnum:i; i < GangPlayerEnum; i++) GangPlayer[topWarTarget][i] = 0;
			}
			// ----------------------

			addWorkBook(targetid, PlayerInfo[playerid][name], inputtext);
		}
		case d_uninvite:
		{
			if(!response)
			{
				ShowLeaderMenu(playerid);
				return 1;
			}
			new targetid = strval(inputtext);
			if(targetid == INVALID_PLAYER_ID || targetid < 0) 
				return show_dialog(playerid, d_uninvite, DIALOG_STYLE_INPUT, ""c_server"Fire the اللاعب", ""c_grey"غير صالح اللاعب ID!\n\n"c_white"أدخل the ID of the اللاعب you want to fire from Organizations:", "قبول", "Bargasht");
			if(!IsPlayerConnected(targetid) || p_t_info[targetid][p_logged] == false || targetid == playerid) 
				return show_dialog(playerid, d_uninvite, DIALOG_STYLE_INPUT, ""c_server"Fire the اللاعب", ""c_grey"غير صالح اللاعب ID!\n\n"c_white"أدخل the ID of the اللاعب you want to fire from Organizations:", "قبول", "Bargasht");
			if(PlayerInfo[targetid][member] != PlayerInfo[playerid][member]) 
				return show_dialog(playerid, d_uninvite, DIALOG_STYLE_INPUT, ""c_server"Fire the اللاعب", ""c_grey"The اللاعب هو ليس a عضو of your Organizations!\n\n"c_white"أدخل the ID of the اللاعب you want to fire from Organizations:", "قبول", "Bargasht");
			if(PlayerInfo[playerid][rank] <= PlayerInfo[targetid][rank]) 
				return show_dialog(playerid, d_uninvite, DIALOG_STYLE_INPUT, ""c_server"Fire the اللاعب", ""c_grey"لا يمكنك fire your superiors!\n\n"c_white"أدخل the ID of the اللاعب you want to fire from Organizations:", "قبول", "Bargasht");

			show_dialog(playerid, d_uninvite_reason, DIALOG_STYLE_INPUT, ""c_server"Fire the اللاعب", ""c_white"أدخل the السبب for firing the اللاعب\n\n"c_grey"* The السبب must be between 3 to 48 characters long", "قبول", "Bargasht");
			SetPVarInt(playerid, "unدعوة_plid", targetid);
		}
		case d_setrank_id:
		{
			if(!response) return ShowLeaderMenu(playerid);
			new targetid = strval(inputtext);
			if(!IsPlayerConnected(targetid) || p_t_info[targetid][p_logged] == false) 
				return show_dialog(playerid, d_setrank_id, DIALOG_STYLE_INPUT, ""c_server"Change الرتبة", ""c_grey"* غير صالح اللاعب ID.\n\n"c_white"أدخل the ID of the اللاعب you want to promote/demote:", "التالي", "Bargasht");
			if(targetid == playerid) 
				return show_dialog(playerid, d_setrank_id, DIALOG_STYLE_INPUT, ""c_server"Change الرتبة", ""c_grey"* لا يمكنك change your own الرتبة.\n\n"c_white"أدخل the ID of the اللاعب you want to promote/demote:", "التالي", "Bargasht");
			if(PlayerInfo[targetid][member] != PlayerInfo[playerid][member]) 
				return show_dialog(playerid, d_setrank_id, DIALOG_STYLE_INPUT, ""c_server"Change الرتبة", ""c_grey"The اللاعب هو ليس a عضو of your Organizations!\n\n"c_white"أدخل the ID of the اللاعب you want to promote/demote:", "التالي", "Bargasht");
			if(PlayerInfo[targetid][rank] >= PlayerInfo[playerid][rank]) 
				return show_dialog(playerid, d_setrank_id, DIALOG_STYLE_INPUT, ""c_server"Change الرتبة", ""c_grey"لا يمكنك promote or demote your superiors!\n\n"c_white"أدخل the ID of the اللاعب you want to promote/demote:", "التالي", "Bargasht");

			global_string[0] = EOS;
			for(new i = 0; i < f_info[PlayerInfo[playerid][member] - 1][f_rank_settings][0]; i++)
			{
				new line_string[64];
				format(line_string, 64, ""c_white"%d. "c_grey"%s\n", i + 1, f_rank[PlayerInfo[playerid][member] - 1][i]);
				strcat(global_string, line_string);
			}
			show_dialog(playerid, d_rank, DIALOG_STYLE_LIST, ""c_server"Change of الرتبة", global_string, "اختر", "إلغاء");
			SetPVarInt(playerid, "pl_setالرتبة_id", targetid);
		}
		case d_give_lic:
		{
			if(!response) return DeletePVar(playerid, "gl_id");
			new targetid = GetPVarInt(playerid, "gl_id");
