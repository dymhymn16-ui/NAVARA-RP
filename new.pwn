			if(PlayerInfo[targetid][rent_house] != -1 || PlayerInfo[targetid][house] != -1) return show_dialog(playerid, d_h_rent_invite, DIALOG_STYLE_INPUT, ""c_server"Subletting", ""c_grey"* The اللاعب already lives somewhere.\n\n"c_white"أدخل the اللاعب ID you want to sublet in the المنزل:", "قبول", "إلغاء");

