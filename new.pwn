			format(_dialog_string,sizeof(_dialog_string),""c_green"* "c_white"You offered "c_green"%s "c_white"housing in your hoاستخدام for "c_green"$%d", PlayerInfo[targetid][name], money_count);
			SendClientMessage(playerid, col_white, _dialog_string);

			format(_dialog_string, sizeof(_dialog_string),""c_white"%s offers you to sublet for %d اليومs for $%d.\n\n"c_grey"* Do you agree to the offer?", PlayerInfo[playerid][name], day_count, money_count);
			show_dialog(targetid, d_rent_accept, DIALOG_STYLE_MSGBOX, ""c_server"Subletting",_dialog_string, "نعم", "لا");
		}
		case d_rent_accept:
