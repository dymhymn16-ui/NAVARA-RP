			format(label_string, sizeof(label_string), ""c_yellow"%s (#%d)\n"c_green_shop"%s\n"c_white"السعر: "c_green_shop"$%s\n"c_white"العائلة: "c_green_shop"%s\n\n"c_silver"Interaction: "c_green_shop"'ALT'",
