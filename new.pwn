callback: check_order_callback(playerid, type)
{
	new rows,
		fields;
	cache_get_data(rows, fields);

	DisablePlayerRaceCheckpoint(playerid);
	if(rows)
	{
		if(type == 1)
		{
			show_dialog(playerid, d_bpanel_order, DIALOG_STYLE_LIST, ""c_server"Ordering البقالة", "1. Place an order\n2. إلغاء order\n3. View order", "Entekhab", "Bargasht");
			return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"First تحتاج إلى to إلغاء your الحالي order.");
		}
		else if(type == 2)
		{

			new string[68];
			format(string, sizeof(string), "حذف FROM `المشروعes_orders` WHERE `bo_bid` = '%d'", PlayerInfo[playerid][business]);
			mysql_tquery(sql_connection, string, "", "");
			show_dialog(playerid, d_bpanel_order, DIALOG_STYLE_LIST, ""c_server"Ordering products", "1. Place an order\n2. إلغاء order\n3. View order", "Entekhab", "Bargasht");
			return SendClientMessage(playerid, col_white,""c_green"* "c_white"Shoma Ba Movafghiat إلغاءed order.");
		}
	}
	else
	{
		if(type == 1) return 	show_dialog(playerid, d_bpanel_priceorder, DIALOG_STYLE_INPUT, ""c_server"Ordering البقالة", ""c_white"أدخل the شراء السعر for a unit of goods:", "قبول", "Bargasht");
		else if(type == 2)
		{
			show_dialog(playerid, d_bpanel_order, DIALOG_STYLE_LIST, ""c_server"Ordering products", "1. Place order\n2. إلغاء order\n3. View order", "Entekhab", "Bargasht");
			return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لديك لا نشط orders.");
		}
	}
	return 1;
}

callback: order_end_callback(playerid)
{
	new rows,
		fields;
	cache_get_data(rows, fields);

	DisablePlayerRaceCheckpoint(playerid);
	if(rows)
	{
		new order_products,
			order_price,
			order_date[16];

		order_products = cache_get_field_content_int(0, "bo_products", sql_connection);
		order_price = cache_get_field_content_int(0, "bo_السعر", sql_connection);
		cache_get_field_content(0, "bo_التاريخ", order_date, sql_connection, 16);

		format(global_string, 228, ""c_server"\
		Доставка:\n\
		"c_grey"business: "c_white"%s\n\
		"c_grey"Product: "c_white"%d kg.\n\
		"c_grey"Pay: "c_white"$%d\n\
		"c_grey"Order date: "c_white"%s",
		b_info[is_gps_used {playerid} -21][b_name],
		order_products,
		order_price * order_products,
		order_date);
		show_dialog(playerid, d_delivery_end, DIALOG_STYLE_MSGBOX, ""c_server"Shipping المعلومات", global_string, "Pass", "Bastan");
	}
	else if(!rows)
	{
		is_gps_used {playerid} = 0;
		is_searching_player_used[playerid] = INVALID_PLAYER_ID;
		SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The order كان already مكتمل by someone or إلغاءled.");
		return 1;
	}
	return 1;
}



callback: order_endaccept_callback(playerid)
{
	new rows,
		fields;
	cache_get_data(rows, fields);

	if(player_rentcar[playerid] == INVALID_VEHICLE_ID || player_rentcar[playerid] != player_vehicle[playerid]) {
		is_gps_used {playerid} = 0;
		is_searching_player_used[playerid] = INVALID_PLAYER_ID;
		return 1;
	}

	if(rows)
	{
		new order_products,
			order_price;

		order_products = cache_get_field_content_int(0, "bo_products", sql_connection);
		order_price = cache_get_field_content_int(0, "bo_السعر", sql_connection);

		if(veh_info[player_vehicle[playerid] -1][v_cargo] >= order_products)
		{
			veh_info[player_vehicle[playerid] -1][v_cargo] -= order_products;
			b_info[is_gps_used {playerid} -21][b_product] += order_products;
			new string[118];
			format(string, sizeof(string), ""c_green"* "c_white"Вы разгрузили "c_green"%d/5000 kg."c_white" товара for "c_green"$%d"c_white".", order_products, order_products * order_price);
			SendClientMessage(playerid, col_white, string);
			give_money(playerid, order_products * order_price);
			insert_money_log(playerid, INVALID_PLAYER_ID, order_products * order_price, "доставка товаров");

			format(string, sizeof(string), "حذف FROM `المشروعes_orders` WHERE `bo_bid` = '%d'",
			is_gps_used {playerid} -20);
			mysql_tquery(sql_connection, string, "", "");
		}
		else
		{
			order_products = veh_info[player_vehicle[playerid] -1][v_cargo];
			veh_info[player_vehicle[playerid] -1][v_cargo] = 0;
			b_info[is_gps_used {playerid} -21][b_product] += order_products;
			new string[118];
			format(string, sizeof(string), ""c_green"* "c_white"Вы разгрузили "c_green"%d/5000 kg."c_white" товара for "c_green"$%d"c_white".", order_products, order_products * order_price);
			SendClientMessage(playerid, col_white, string);

			give_money(playerid, order_products * order_price);
			insert_money_log(playerid, INVALID_PLAYER_ID, order_products * order_price, "доставка товаров");

			format(string, sizeof(string), "UPالتاريخ `المشروعes_orders` SET `bo_products`=`bo_products`-'%d' WHERE `bo_bid` = '%d'",
			order_products, is_gps_used {playerid} -20);
			mysql_tquery(sql_connection, string, "", "");
		}
		is_gps_used {playerid} = 0;
		is_searching_player_used[playerid] = INVALID_PLAYER_ID;
	}
	else
	{
		is_gps_used {playerid} = 0;
		is_searching_player_used[playerid] = INVALID_PLAYER_ID;
		SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The order has already been مكتمل or إلغاءled by someone.");
		return 1;
	}
	return 1;
}

callback: order_get_callback(playerid)
{
	new rows,
		fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		new order_bid = cache_get_field_content_int(0, "bo_bid", sql_connection)-1;

		new ordertext[100];
		format(ordertext, sizeof ordertext , ""c_green"* "c_white"أنت ba movafaghiat sefهمsh "c_green"#%d"c_white" ra gereftid.",order_bid);
		SendClientMessage(playerid, col_white, ordertext);
		is_gps_used {playerid} = 21 + order_bid;
		SetPlayerRaceCheckpoint(playerid, 1, b_info[order_bid][b_position][0], b_info[order_bid][b_position][1], b_info[order_bid][b_position][2] -1,0.0,0.0,0.0,4.0);
	}
	else
	{
		show_dialog(playerid, d_delivery_bid, DIALOG_STYLE_INPUT, ""c_server"Take an order", ""c_orange_red"* "c_grey"In sefهمsh dar database-e sefهمshha peyda nashod.\n\n"c_white"Shomهم sefهمshi ke mikhahid begirid ra vهمd konid:", "Paziroftan", "Bargasht");
	}
	return 1;
}


callback: order_list_callback(playerid)
{
	new rows,
		fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		global_string[0] = EOS;
		strcat(global_string, "{cccc99}Shomهم\tMiqdar\t\tMajmooe\t\tالمشروع\n\n"c_white"");

		new line_string[76];
		for(new i = 0; i < rows; i ++)
		{
			new order_id,
				order_products,
				order_price,
				order_bid;

			order_id = cache_get_field_content_int(i, "bo_id", sql_connection);
			order_products = cache_get_field_content_int(i, "bo_products", sql_connection);
			order_price = cache_get_field_content_int(i, "bo_السعر", sql_connection);
			order_bid = cache_get_field_content_int(i, "bo_bid", sql_connection);

			format(line_string, sizeof(line_string), "%d\t%d kg.\t\t$%d\t\t%s\n",
															order_id,
															order_products,
															order_price * order_products,
															b_info[order_bid -1][b_name]);
			strcat(global_string, line_string);
			if(i >= 32) break;
		}
		format(line_string, 54, ""c_server"القائمة-e Sefهمsha | Peyda Shod"c_grey" %d", rows);
		show_dialog(playerid, d_delivery_list, DIALOG_STYLE_MSGBOX, line_string, global_string, "Bargasht", "");
		return 1;
	}
	if(!rows)
	{
		return show_delivery_menu(playerid);
	}
	return 1;
}

