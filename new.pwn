		    mysql_query(sql_connection, query_string);

		    new family_id = PlayerInfo[playerid][family];
		    Iter_Add(family_players[family_id], playerid);

			family_info[family_count][fam_id] = find_last_family();

		    format(query_string, sizeof(query_string), "UPالتاريخ `users` SET `u_العائلة`='%d',`u_العائلة_الرتبة`='3',`u_العائلة_التاريخ` = لاW() WHERE `u_id`='%d' LIMIT 1", getPlayerFamilyID(playerid), PlayerInfo[playerid][id]);
		    mysql_query(sql_connection, query_string);

		    format(query_string, sizeof(query_string), "UPالتاريخ `العائلة` SET `fam_عضوs`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[family_count][fam_members], getPlayerFamilyID(playerid));
		    mysql_query(sql_connection, query_string);

		    new text_string[144];
		    format(text_string, sizeof(text_string), ""scm_info"لديك تمت العملية بنجاحfully شراءd a %s العائلة "c_gold"%s"c_white". To see the العائلة القائمة استخدام: "c_gold"/fmenu", fam_types, family_info[family_count][fam_name]);
		    SendClientMessage(playerid, col_white, text_string);

		    if(PlayerInfo[playerid][family_text] != Text3D:INVALID_3DTEXT_ID) {
				format(text_string, sizeof(text_string), "{%s}%s "c_white"العائلة", family_info[family_count][fam_chat_color], family_info[family_count][fam_name]);
				UpdateDynamic3DTextLabelText(PlayerInfo[playerid][family_text], -1, text_string);
			} else {
				format(text_string, sizeof text_string, "{%s}%s "c_white"العائلة", family_info[family_count][fam_chat_color], family_info[family_count][fam_name]);
				PlayerInfo[playerid][family_text] = CreateDynamic3DTextLabel(text_string, col_white, 0.0, 0.0, 0.7, 10.0, playerid, INVALID_VEHICLE_ID, 1);
			}


		    family_count++;
		}

		case d_family:
		{
