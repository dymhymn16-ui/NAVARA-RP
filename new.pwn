					!""scm_dialog"Estekhdam",

					!""c_white"الرخصة\t"c_white"Gheymat\n\
					"c_السيرفر"1 | "c_white"Govahiname ranandegi\t"c_green"80,000$\n\
					"c_السيرفر"2 | "c_white"Govahiname kashtirani\t"c_green"120,000$\n\
					"c_السيرفر"3 | "c_white"Govahiname khalabani\t"c_green"200,000$\n\
					", 

					!"Entekhab", !"Bastan");
			}

			return 1;
		}
		case d_government_buy_lic:
		{
			if(!response) return 1;

			if(listitem == 0) 
			{
				if(PlayerInfo[playerid][drive_lic] >= 1) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"Shoma Govahiالاسم ranandegi darid.");
				if(80_000 > PlayerInfo[playerid][money]) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"أنت 80,000$ المال لا تملك.");
				give_money(playerid, -80_000);
				PlayerInfo[playerid][drive_lic] = 60;
				update_int_sql(playerid, "u_drive_lic", PlayerInfo[playerid][drive_lic]);
				SendClientMessage(playerid,col_white,""scm_sucess"Shoma govahiالاسم ranandegi kharidid.");
			}
			else if(listitem == 1) 
			{
				if(PlayerInfo[playerid][boat_lic] >= 1) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"Shoma Govahiالاسم kashtirani darid.");
				if(120_000 > PlayerInfo[playerid][money]) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"أنت 120,000$ المال لا تملك.");
				give_money(playerid, -120_000);
				PlayerInfo[playerid][boat_lic] = 60;
				update_int_sql(playerid, "u_boat_lic", PlayerInfo[playerid][boat_lic]);
				SendClientMessage(playerid,col_white,""scm_sucess"Shoma govahiالاسم kashtirani kharidid.");
			}
			else if(listitem == 2) 
			{
				if(PlayerInfo[playerid][fly_lic] >= 1) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"Shoma Govahiالاسم khalabani darid.");
				if(200_000 > PlayerInfo[playerid][money]) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"أنت 200,000$ المال لا تملك.");
				give_money(playerid, -200_000);
				PlayerInfo[playerid][fly_lic] = 60;
				update_int_sql(playerid, "u_fly_lic", PlayerInfo[playerid][fly_lic]);
				SendClientMessage(playerid,col_white,""scm_sucess"Shoma govahiالاسم khalabani kharidid.");
			}

			return 1;
		}
		case d_job:
		{
			if(!response) return 1;
			if((getPlayerFactionID(playerid) < 18 || getPlayerFactionID(playerid) > 25) && playerFactionStatus(playerid)) return SendError(playerid, "Namayandegan sazemanha nemitavanand estekhdam shavand.");

			if(PlayerInfo[playerid][drive_lic] == 0) return SendError(playerid, "Shoma govahiالاسمh ranandegi nadarid, ke baraye in لاe kar zaroori ast.");
			
			if(player_rentcar[playerid] != INVALID_VEHICLE_ID )
			{
				if(!(veh_info[player_rentcar[playerid] - 1][v_model] == 481 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 509 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 510 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 462 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 468 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 585)) return SendError(playerid, "Shoma kهم khod ra dar shoghle ghabli tamam nakardid, Bezanid: "c_orange_red"/إيقافاستئجار");
			}
			if(listitem == 7)
			{
				if(!playerJobStatus(playerid))
				{
					show_employment(playerid);
					return SendError(playerid, "Shoma dar hich shoghli estekhdam nashodeid.");

				}
				if(player_rentcar[playerid] != INVALID_VEHICLE_ID)
				{
					if(!(veh_info[player_rentcar[playerid] - 1][v_model] == 481 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 509 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 510 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 462 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 468 ||
					veh_info[player_rentcar[playerid] - 1][v_model] == 585))
					{
						show_employment(playerid);
						return SendError(playerid, "Shoma kهم khod ra dar shoghle ghabli tamam nakardid, Bezanid: "c_orange_red"/إيقافاستئجار");
					}
				}
				PlayerInfo[playerid][job] = job_none;
				update_int_sql(playerid, "u_الوظيفة", job_none);
				SendAccess(playerid, "Shoma ba movafghiat shoghle feliton tark kardid.");
				show_employment(playerid);
				return 1;
			}
			else if(playerJobStatus(playerid)) return SendInfo(playerid, "Shoma az ghabl dakhel yek shoghl hastid, baraye tark kardan shoghl, Bezanid: "c_orange_red"/quitالوظيفة");
			
			for(new i; i < 7; i ++)
				if(listitem == i && PlayerInfo[playerid][level] >= jobs_level[i]) break;
				else if(PlayerInfo[playerid][level] < jobs_level[i]) return SendError(playerid, "Shoma المستوى kafi baraye in shoghl nadarid.");


			new _text_string[92];
			format(_text_string, sizeof _text_string, ""scm_sucess"أنت ba movafaghiat yek العمل dar "c_green"%s"c_white" gereftid.", jobs_name[listitem]);
			SendClientMessage(playerid, col_white, _text_string);
			SendInfo(playerid, "Baraye peyda kardan makane kar az "c_green"'/نظام الملاحة'"c_white" estefade konid.");
			SendInfo(playerid, "Baraye motale'e dastorat az  "c_green"'/mm >> القائمة of commands'"c_white" estefade konid.");
			
			switch(listitem)
			{
				case 0: PlayerInfo[playerid][job] = getFactionID(job_bus);
				case 1: PlayerInfo[playerid][job] = getFactionID(job_taxi);
				case 2: PlayerInfo[playerid][job] = getFactionID(job_mechanic);
				case 3: PlayerInfo[playerid][job] = getFactionID(job_trucker);
				case 4: PlayerInfo[playerid][job] = getFactionID(job_delivery);
				case 5: PlayerInfo[playerid][job] = getFactionID(job_fuel_delivery);
				case 6: PlayerInfo[playerid][job] = getFactionID(job_fireman);
			}

			update_int_sql(playerid, "u_الوظيفة", getJobFactionID(playerid));
		}
		case d_taxi:
		{
			if(!response) return 1;
			new price = strval(inputtext);
			if(price < 1 || price > 70)
			{
				return show_dialog(playerid, d_taxi, DIALOG_STYLE_INPUT, !""scm_dialog"Rate", !""c_orange_red"* The السعر should be from 1 to 70$\n\n"c_white"أدخل the fهم for 1 km.:", !"قبول", !"Bastan");
			}
			foreach(new i: logged_players)
			{
				if(i == playerid) continue;
				if(GetPlayerVehicleID(i) == GetPlayerVehicleID(playerid)) return SendClientMessage(playerid,col_gray,"You can set/change the السعر only when لديك لا passengers in your السيارة.");
			}
			p_t_info [playerid][pTaxiPrice] = price;
			new mes[60];
			format(mes,sizeof(mes),"** Rate **\n"c_grey"$%i for 1 km", price);
			if(IsValid3DTextLabel(p_t_info[playerid][pTaxi3DText]))
			{
				DestroyDynamic3DTextLabel(p_t_info[playerid][pTaxi3DText]);
				p_t_info[playerid][pTaxi3DText] = CreateDynamic3DTextLabel(mes, col_lblue, 0.0,0.0,1.5,20.0,INVALID_PLAYER_ID,GetPlayerVehicleID(playerid));
				return 1;
			}
			if(!IsValid3DTextLabel(p_t_info[playerid][pTaxi3DText])) p_t_info[playerid][pTaxi3DText] = CreateDynamic3DTextLabel(mes, col_lblue, 0.0, 0.0, 1.5, 20.0, INVALID_PLAYER_ID, GetPlayerVehicleID(playerid));
		}
		case d_taxi_mark:
		{
			new mapmark = GetPVarInt(playerid, "الخريطة_mark");
			if(mapmark == 2)
			{
				if(!response) return show_dialog(playerid, d_taxi_mark, DIALOG_STYLE_LIST, ""c_server"Navigator Ranandeh تاكسي", ""c_server"1. "c_white"Place a marker on the الخريطة\n"c_server"2. "c_white"Set a mark from a نظام الملاحة navigator\n"c_grey"متابعة the trip without a navigator", "Entekhab", "Bastan"), DeletePVar(playerid, "الخريطة_mark");
				new driverid = GetPVarInt(playerid, "تاكسي_السائق_id");
				switch(listitem)
				{
					case 0: SetPlayerRaceCheckpoint(driverid, 1, 1481.2469,-1743.4403,13.5469, 0.0, 0.0, 0.0, 2.0); // City Hall
					case 1: SetPlayerRaceCheckpoint(driverid, 1, 1375.9095,-1088.4717,25.9133, 0.0, 0.0, 0.0, 2.0); // Los Santos Bank
					case 2: SetPlayerRaceCheckpoint(driverid, 1, -2047.2146,-231.3838,35.4309, 0.0, 0.0, 0.0, 2.0); // Driving school
					case 3: SetPlayerRaceCheckpoint(driverid, 1, 2645.9961,-2428.7090,13.2651, 0.0, 0.0, 0.0, 2.0); // Port
					case 4: SetPlayerRaceCheckpoint(driverid, 1, 596.7739,868.2286,-43.0937, 0.0, 0.0, 0.0, 2.0); // Mine
					case 5: SetPlayerRaceCheckpoint(driverid, 1, -50.2125,-282.1606,5.4297, 0.0, 0.0, 0.0, 2.0); // Factory
					case 6: SetPlayerRaceCheckpoint(driverid, 1, -1083.6823,-1647.6613,76.3672, 0.0, 0.0, 0.0, 2.0); // Sawmill
				}
				SendClientMessage(playerid, col_white, ""c_green"* "c_white"Shoma Ba Movafghiat gave the السائق a flag.");
				DeletePVar(playerid, "تاكسي_السائق_id");
				DeletePVar(playerid, "الخريطة_mark");
				is_gps_used {driverid} = 1;
			}
			if(!response) return DeletePVar(playerid, "تاكسي_السائق_id"), DeletePVar(playerid, "الخريطة_mark");
			if(!mapmark)
			{
				switch(listitem)
				{
					case 0:
					{
						SetPVarInt(playerid, "الخريطة_mark", 1);
						SendClientMessage(playerid, col_white, ""c_server"* "c_white"Place a marker on the الخريطة (ESC -الخريطة -RMB).");
					}
					case 1:
					{
						SetPVarInt(playerid, "الخريطة_mark", 2);
						return show_dialog(playerid, d_taxi_mark, DIALOG_STYLE_LIST, ""c_server"تاكسي Navigator", ""c_server"1. "c_white"City Hall Los Santos\n"c_server"2. "c_white"البنك of Los Santos\n"c_server"3. "c_white"Driving school\n"c_server"4. "c_white"Port\n"c_server"5. "c_white"Mine\n"c_server"6. "c_white"المصنع\n"c_server"7. "c_white"Sawmill", "Choice", "Bastan");
					}
				}
			}
			return 1;
		}
		case d_rank:
		{
			if(!response) return DeletePVar(playerid, "pl_setالرتبة_id");
			new _pl_id = GetPVarInt(playerid, "pl_setالرتبة_id");

			if(!IsPlayerConnected(_pl_id) || _pl_id == playerid) return SendError(playerid, "Bazikon Yaft Nashod.");
			if(PlayerInfo[_pl_id][member] != PlayerInfo[playerid][member]) return SendError(playerid, "The اللاعب هو ليس a عضو of your organization.");
			if(listitem + 1 >= PlayerInfo[playerid][rank])
			{
				global_string[0] = EOS;
				for(new i = 0; i < f_info[PlayerInfo[playerid][member]][f_rank_settings][0]; i ++)
				{
					new line_string[72];
					format(line_string, 72, ""c_grey"%i. "c_white"%s\n", i + 1, f_rank[PlayerInfo[playerid][member]][i]);
					strcat(global_string, line_string);
				}
				show_dialog(playerid, d_rank, DIALOG_STYLE_LIST, ""c_server"Change of الرتبة", global_string, "Entekhab", "Bastan");
				return SendError(playerid, "لا يمكنك assign a اللاعب to thهو الرتبة.");
			}
			PlayerInfo[_pl_id][rank] = listitem + 1;
			update_int_sql(_pl_id, "u_الرتبة", PlayerInfo[_pl_id][rank]);


			new _text_string[128];
			format(_text_string, 128, ""c_green"* "c_white"لديك assigned %s to الرتبة "c_green"%s(%d)", PlayerInfo[_pl_id][name], f_rank[PlayerInfo[_pl_id][member]][listitem], listitem + 1);
			SendClientMessage(playerid, col_white, _text_string);
			format(_text_string, 128, ""c_green"* %s "c_white"assigned you to الرتبة "c_green"%s(%d)", PlayerInfo[playerid][name], f_rank[PlayerInfo[_pl_id][member]][listitem], listitem + 1);
			SendClientMessage(_pl_id, col_succes, _text_string);
		}
		case d_refill:
		{
		    new id_mhnk = GetPVarInt(playerid,"id_refill")-1;
		    new price_mhnk = GetPVarInt(id_mhnk,"السعر_refill");
			new litres = GetPVarInt(id_mhnk,"litres_refill");
			if(!response)
			{
			    SendClientMessage(id_mhnk,col_gray,"The اللاعب refused the offer");
			    SendClientMessage(playerid,col_gray,"You refused the offer");
			}
			else
			{
				if(check_fuel_vehicle(playerid)) return 1;
				
				new _text_string[128];
				format(_text_string,128, "%s filled سيارتك with %d liters for $%i", PlayerInfo[id_mhnk][name],litres,price_mhnk);
			    SendClientMessage(playerid,col_succes,_text_string);

			    format(_text_string,128, "You filled up your %s السيارة with %d liters $%i",PlayerInfo[playerid][name],litres,price_mhnk);
			    SendClientMessage(id_mhnk,col_succes,_text_string);

				give_money(playerid, -price_mhnk);
				give_money(id_mhnk, price_mhnk);

				new vehicleid = GetPlayerVehicleID(playerid);

				if(vehicleid)
				{
                	veh_info[vehicleid -1][v_fuel] += float(litres);
                }
                SetPVarInt(playerid,"الأفضلlivo",GetPVarInt(playerid,"الأفضلlivo") -litres);

 				new mehname [32];
				GetPVarString(id_mhnk,"Mehالاسم",mehname,31);

				if(strlen(mehname) > 0)
				{
					format(_text_string, 128,""c_white"<< "c_server"%s "c_white">>\n"c_grey"الوقود: %d L.",mehname,GetPVarInt(id_mhnk,"الأفضلlivo") + litres);
					UpdateDynamic3DTextLabelText(PlayerMehText[id_mhnk], -1, _text_string);
				}
				else
				{
					format(_text_string, 128,""c_grey"الوقود: %d L.",GetPVarInt(id_mhnk,"الأفضلlivo") + litres);
					UpdateDynamic3DTextLabelText(PlayerMehText[id_mhnk], -1, _text_string);
				}
			}
		 	DeletePVar(id_mhnk,"id_إصلاح");
		 	DeletePVar(id_mhnk,"السعر_إصلاح");
		  	DeletePVar(playerid,"id_إصلاح");
			return 1;
		}
		case d_repair:
		{
		    new id_mhnk = GetPVarInt(playerid,"id_إصلاح")-1;
		    new price_mhnk = GetPVarInt(id_mhnk,"السعر_إصلاح");
			if(!response)
			{
			    SendClientMessage(id_mhnk,col_gray,"The اللاعب refused the offer.");
			    SendClientMessage(playerid,col_lblue, "You refused the offer.");
			}
			else
			{
			    new _text_string[128];
				format(_text_string,128, "%s fixed سيارتك for $%i",PlayerInfo[id_mhnk][name],price_mhnk);
			    SendClientMessage(playerid,col_succes,_text_string);

			    format(_text_string,128, "You fixed the %s السيارة for $%i",PlayerInfo[playerid][name],price_mhnk);
			    SendClientMessage(id_mhnk,col_succes,_text_string);

				give_money(playerid, -price_mhnk);
				give_money(id_mhnk, price_mhnk);

				new _v_id = GetPlayerVehicleID(playerid);
		 		SetVehicleHealth(_v_id, 1000.0);
		 		RepairVehicle(_v_id);
