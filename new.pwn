					strcat(global_string, line_string);
					format(line_string, sizeof(line_string), ""c_gold"[VIP]"c_white" الحالة: %s\n\n", family_info[family_id][fam_vip] ? c_green"Fa'al" : c_orange_red"Gheyr Fa'al");
					strcat(global_string, line_string);
					format(line_string, sizeof(line_string), ""c_white"العائلة النوع: {%s}%s\n", family_info[family_id][fam_chat_color], fam_types);
					strcat(global_string, line_string);
					format(line_string, sizeof(line_string), ""c_white"العائلة Origin: {%s}%s\n", family_info[family_id][fam_chat_color], nationality_string);
					strcat(global_string, line_string);
					format(line_string, sizeof(line_string), ""c_white"متصل: {%s}%d اللاعبين\n", family_info[family_id][fam_chat_color], Iter_Count(family_players[family_id]));
					strcat(global_string, line_string);
					if(family_info[family_id][fam_vip])
					{
						format(line_string, sizeof(line_string), ""c_white"العائلة عضوs: {%s}%d اللاعبين\n\n", family_info[family_id][fam_chat_color], family_info[family_id][fam_members]);
						strcat(global_string, line_string);
					}
					else
