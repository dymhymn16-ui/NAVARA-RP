cmd:quitjob(playerid)
{
	if(!playerJobStatus(playerid)) return SendError(playerid, "Shoma dar hich shoghi estekhtam nashidid.");
	if(player_rentcar[playerid] != INVALID_VEHICLE_ID) return SendError(playerid, "Ebteda shoghl khod ra دفعan dahid sepas eghdam be tark shoghl farmaid.");
	PlayerInfo[playerid][job] = -1;
	update_int_sql(playerid, "u_الوظيفة", PlayerInfo[playerid][job]);
	SendAccess(playerid, "Shoma ba movafghiat shoghl khod ra tark kardid.");
	return 1;
}

cmd:sellsim(playerid, params[])
{
	if(duel_opponent[playerid] != INVALID_PLAYER_ID) return 1;
	if(p_t_info[playerid][business] == -1) return SendError(playerid, "Must be in المتجر 24/7.");

	if(PlayerInfo[playerid][number] == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لديك لا نشط sim السيارةdы.");
	if(sscanf(params, "ud", params[0], params[1])) return SendInfo(playerid, "أدخل: /بيعsim [id/الاسم] [Gheymat]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't apply thهو to yourself.");
	if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");
	if(p_t_info[params[0]][p_dialog] != -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"ليس متاح at the moment.");

	if(PlayerInfo[params[0]][exp] < 3 && PlayerInfo[params[0]][level] == 1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب must play 3 ساعات to be able to بيع the sim السيارةd.");
	if(params[1] < 1 || params[1] > 200000) return SendError(playerid, "Gheymat sim السيارةd must be from "c_orange_red"1$"c_grey" to "c_orange_red"200.000$"c_grey".");

	if(GetString(p_t_info[params[0]][p_ip], p_t_info[playerid][p_ip]))
	{
		AdminMes(""c_orange_red"* A.تحذير: "c_grey"%s[%d] بيعs sim السيارةd %s[%d] | same ip", PlayerInfo[playerid][name], playerid, PlayerInfo[params[0]][name], params[0]);

		SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Unable to بيع sim السيارةd to thهو اللاعب.");
		
		return 1;
	}

	buyer_id[playerid] = params[0];
	sell_price[playerid] = params[1];
	seller_id[params[0]] = playerid;
	sell_type[playerid] = PlayerInfo[playerid][number];


	new dialog_string[90 + MAX_PLAYER_NAME + 32 + 1 + 6];
	format(dialog_string, sizeof(dialog_string), "You offered the اللاعب "c_server"%s"c_white" to شراء "c_server"SIM(tel.%d)"c_white" for "c_server"$%d",
	PlayerInfo[params[0]][name], PlayerInfo[playerid][number], params[2]);
	SendClientMessage(playerid, col_white, dialog_string);
	format(dialog_string, sizeof(dialog_string ), ""c_server"%s "c_white"offers you to شراء "c_server" sim السيارةd(tel.%d)"c_white" za "c_server"$%d",
	PlayerInfo[playerid][name], PlayerInfo[playerid][number], params[1]);
	show_dialog(params[0], d_sellsim_accept, DIALOG_STYLE_MSGBOX, ""c_server"SIM السيارةd", dialog_string, "قبول", "إلغاء");
	return 1;
}

cmd:number(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /number [id/الاسم]");

 	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't apply thهو to yourself.");
	if(PlayerInfo[params[0]][number] == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Doesn't own a الهاتف or doesn't have a SIM السيارةd.");
	new scm_string[128];
	format(scm_string, sizeof(scm_string), ""c_green"* "c_white"اللاعب الرقم "c_green"%s[%d]"c_white": "c_green"%i", PlayerInfo[params[0]][name], params[0], PlayerInfo[params[0]][number]);
	SendClientMessage(playerid, col_white, scm_string);
	return 1;
}

