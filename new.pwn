		`Weapon` = '%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d', `Ammo` = '%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d' WHERE `u_id`='%i' LIMIT 1",
		PlayerInfo[playerid][Weapon][0], PlayerInfo[playerid][Weapon][1], PlayerInfo[playerid][Weapon][2], PlayerInfo[playerid][Weapon][3],
		PlayerInfo[playerid][Weapon][4], PlayerInfo[playerid][Weapon][5], PlayerInfo[playerid][Weapon][6], PlayerInfo[playerid][Weapon][7], PlayerInfo[playerid][Weapon][8],
		PlayerInfo[playerid][Weapon][9], PlayerInfo[playerid][Weapon][10], PlayerInfo[playerid][Weapon][11], PlayerInfo[playerid][Weapon][12], PlayerInfo[playerid][Ammo][0],
		PlayerInfo[playerid][Ammo][1], PlayerInfo[playerid][Ammo][2], PlayerInfo[playerid][Ammo][3], PlayerInfo[playerid][Ammo][4], PlayerInfo[playerid][Ammo][5],
		PlayerInfo[playerid][Ammo][6], PlayerInfo[playerid][Ammo][7], PlayerInfo[playerid][Ammo][8], PlayerInfo[playerid][Ammo][9], PlayerInfo[playerid][Ammo][10],
		PlayerInfo[playerid][Ammo][11], PlayerInfo[playerid][Ammo][12], PlayerInfo[playerid][id]);
		mysql_tquery(con_bd, query_string);
	
		if(checkPlayerStatus(playerid))
		{
			mysql_format(con_bd, query_string, sizeof(query_string), "UPالتاريخ `users` SET \
			`last_position_unix` = %d, `last_position` = '%i,%i,%i,%i,%f,%f,%f,%f' WHERE `u_id`='%i' LIMIT 1",
			timestamp + 10*60, 
			GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid), 
			p_t_info[playerid][business], p_t_info[playerid][house],
			x, y, z, a, 
			PlayerInfo[playerid][id]);

			mysql_tquery(con_bd, query_string);
		}else{
			mysql_format(con_bd, query_string, sizeof(query_string), "UPالتاريخ `users` SET \
			`last_position_unix` = %d WHERE `u_id`='%i' LIMIT 1",
			timestamp, 
			PlayerInfo[playerid][id]);

			mysql_tquery(con_bd, query_string);
		}
	}
	
	if(quest_photographer_id[playerid] != -1)
		EndJobPhotographer(playerid);
	p_t_info[playerid][p_logged] = false;

	LeavePlayerFromCounterStrike(playerid);

	return 1;
}

public OnPlayerUpdate(playerid)
{
    if(!p_t_info[playerid][p_logged]) return 0;
    new weapon_player = GetPlayerWeapon(playerid);
    if(IsPlayerInAnyVehicle(playerid) && weapon_player == 24) SetPlayerArmedWeapon(playerid, 0);
    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && (weapon_player == WEAPON_DEAGLE ||
        weapon_player == WEAPON_SHOTGSPA || weapon_player == WEAPON_SAWEDOFF ||
        weapon_player == WEAPON_MINIGUN || weapon_player == WEAPON_MP5)) SetPlayerArmedWeapon(playerid, 0);

    if(isPlayerSurfing[playerid]) {
        // Check if the player is surfing on a vehicle
        new vehicleid = GetPlayerSurfingVehicleID(playerid);
        if(vehicleid != INVALID_VEHICLE_ID) {
            // If the player is still on the same vehicle or a new one
            if(attachedVehicle[playerid] != vehicleid) {
                attachedVehicle[playerid] = vehicleid; // Register the new vehicle

                // Save the current position of the player relative to the vehicle
                new Float:playerPos[3], Float:vehiclePos[3];
                GetPlayerPos(playerid, playerPos[0], playerPos[1], playerPos[2]);
                GetVehiclePos(vehicleid, vehiclePos[0], vehiclePos[1], vehiclePos[2]);

                // Calculate the player's offset relative to the vehicle
                playerOffset[playerid][0] = playerPos[0] - vehiclePos[0];
                playerOffset[playerid][1] = playerPos[1] - vehiclePos[1];
                playerOffset[playerid][2] = playerPos[2] - vehiclePos[2];
            }

            // Continuously update the player's position based on the vehicle's position
            new Float:vehiclePos[3];
            GetVehiclePos(vehicleid, vehiclePos[0], vehiclePos[1], vehiclePos[2]);

            // Calculate the new player position considering the stored offset
            new Float:newPos[3];
            newPos[0] = vehiclePos[0] + playerOffset[playerid][0];
            newPos[1] = vehiclePos[1] + playerOffset[playerid][1];
            newPos[2] = vehiclePos[2] + playerOffset[playerid][2];

            // Set the player's position
            SetPlayerPos(playerid, newPos[0], newPos[1], newPos[2]);
        } else if(attachedVehicle[playerid] != INVALID_VEHICLE_ID) {
            // If the player dismounted from the vehicle, reset the status
            attachedVehicle[playerid] = INVALID_VEHICLE_ID;
        }
    }

    if(GetPlayerWeapon(playerid) && PlayerInfo[playerid][settings][PACIFIST_MODE] && !IsPlayerInAnyDMZone(playerid) && player_practice {playerid} != 0)
    {
        SetPlayerArmedWeapon(playerid, 0);
    }

	if(p_t_info[playerid][player_gm])
	{
		new Float:gmuser_hp,Float:gmuser_armour;
    	GetPlayerHealth(playerid,gmuser_hp);
    	GetPlayerArmour(playerid,gmuser_armour);

		if(gmuser_hp < 999.0) set_health(playerid, 1000.0);
    	if(gmuser_armour < 999.0) set_armour(playerid, 1000.0);
    	
		if(IsPlayerInAnyVehicle(playerid))
		{
			new Float:gmuser_health;
    		new gmuser_veh = GetPlayerVehicleID(playerid);

    		GetVehicleHealth(gmuser_veh, gmuser_health);

			if(gmuser_health < 999.0) SetVehicleHealth(gmuser_veh, 1000.0);
			RepairVehicle(gmuser_veh);
			p_t_info[playerid][engine_stalled] = 0;
		}
	}

	new pl_state = GetPlayerState(playerid);

	new Float:_speed_return;
	get_speed_float(playerid, _speed_return);

	last_speed[playerid] = _speed_return;

	if(pl_state == PLAYER_STATE_ONFOOT)
	{

		if(gotome_player[playerid] != -1)
		{
			new pl_id = gotome_player[playerid];

			if(IsPlayerInAnyVehicle(pl_id)) {
				new vehicleid = GetPlayerVehicleID(pl_id);
				if(GetPlayerVehicleID(playerid) != vehicleid) {
					PutPlayerInVehicle(playerid, vehicleid, 1);
				}
			} else {

				new Float:pl_x, Float:pl_y, Float:pl_z, Float:pl_r;

				GetPlayerPos(pl_id, pl_x, pl_y, pl_z);
				SetPlayerFaceToPoint(playerid, pl_x, pl_y);


				new Float:g_pos[3];
				new anim = move_animation(playerid, pl_x, pl_y, pl_z);
				if(GetPlayerInterior(pl_id)!= GetPlayerInterior(playerid)|| GetPlayerVirtualWorld(pl_id)!= GetPlayerVirtualWorld(playerid)|| GetPlayerDistanceFromPoint(playerid, pl_x, pl_y, pl_z)> 10)
				{

					SetPlayerPos(playerid, pl_x, pl_y, pl_z);
					SetPlayerInterior(playerid, GetPlayerInterior(pl_id));
					SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(pl_id));
				}
				if(anim != 1)
				{
					g_pos[0] = GetPVarFloat(playerid,"cuff_x");
					g_pos[1] = GetPVarFloat(playerid,"cuff_y");
					g_pos[2] = GetPVarFloat(playerid,"cuff_z");
					if(IsPlayerInRangeOfPoint(playerid, 0.05, g_pos[0],g_pos[1],g_pos[2]))
					{
						GetPlayerPos(playerid, pl_x, pl_y, pl_z);
						GetPlayerFacingAngle(playerid, pl_r);
						ShiftCords(pl_x, pl_y, pl_r, 1.5);
						SetPlayerPos(playerid, pl_x, pl_y, pl_z);
					}
					GetPlayerPos(playerid, pl_x, pl_y, pl_z);
					SetPVarFloat(playerid, "cuff_x", pl_x);
					SetPVarFloat(playerid, "cuff_y", pl_z);
					SetPVarFloat(playerid, "cuff_z", pl_z);
				}

			}

		}
	}
	else if(pl_state == PLAYER_STATE_DRIVER)
	{
		new veh_id = GetPlayerVehicleID(playerid);

		if(veh_info[veh_id -1][v_model] == 530)
		{
			new Float:vehicle_health_now;
			GetVehicleHealth(veh_id, vehicle_health_now);
			if(vehicle_health_now < 1000)
			{
				RepairVehicle(veh_id);
				veh_info[veh_id -1][v_fuel] = 100.0;
			}
		}
	}

	p_t_info[playerid][p_update] = GetTickCount();
	pl_afk_time[playerid] = -2;
	if(noclipdata[playerid][cameramode] == CAMERA_MODE_FLY)
	{
		new keys,ud,lr;
		GetPlayerKeys(playerid,keys,ud,lr);

		if(noclipdata[playerid][mode] && (GetTickCount() -noclipdata[playerid][lastmove] > 100))
		{
		    // If the last move was > 100ms ago, process moving the object the players camera is attached to
		    MoveCamera(playerid);
		}

		// Is the players current key state different than their last keystate?
		if(noclipdata[playerid][udold] != ud || noclipdata[playerid][lrold] != lr)
		{
			if((noclipdata[playerid][udold] != 0 || noclipdata[playerid][lrold] != 0) && ud == 0 && lr == 0)
			{  // All keys have been released, stop the object the camera is attached to and reset the acceleration multiplier
				StopPlayerObject(playerid, noclipdata[playerid][flyobject]);
				noclipdata[playerid][mode]      = 0;
				noclipdata[playerid][accelmul]  = 0.0;
			}
			else
			{  // Indicates a new key has been pressed

			    // Get the direction the player wants to move as indicated by the keys
				noclipdata[playerid][mode] = GetMoveDirectionFromKeys(ud, lr);

				// Process moving the object the players camera is attached to
				MoveCamera(playerid);
			}
		}
		noclipdata[playerid][udold] = ud; noclipdata[playerid][lrold] = lr; // Store current keys pressed for comparison next update
		return 0;
	}

	return 1;
}

public OnPlayerStreamIn(playerid, forplayerid)
{
	Iter_Add(streamed_players[forplayerid], playerid);
	if(PlayerInfo[playerid][settings][1] == 0)ShowPlayerNameTagForPlayer(playerid, forplayerid, 0);
	return 1;
}

public OnPlayerStreamOut(playerid, forplayerid)
{
	Iter_Remove(streamed_players[forplayerid], playerid);
	return 1;
}

public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
	if(GetPVarInt(playerid, "biz_الحرب_الخريطة") ==  1)
	{
		if(mw_biz != -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The الحرب for المشروع هو already underway."), DeletePVar(playerid, "biz_الحرب_الخريطة");

		if(!available_gz_pos(fX, fY))
		{
			SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"It هو impossible to place an arrow in thهو همa.");
			SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Thهو should be an همa in the suburbs of Las Venturas."), DeletePVar(playerid, "biz_الحرب_الخريطة");
			return 1;
		}

		if(timestamp_hour < 12 || timestamp_hour > 22) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"المشروعes can only be taken over from 12 to 23 ساعات."), DeletePVar(playerid, "biz_الحرب_الخريطة");

		for(new b = 0; b < b_count; b ++)
		{
			DeletePVar(playerid, "biz_الحرب_الخريطة");
			if(!IsPlayerInRangeOfPoint(playerid , 3.0 , b_info[b][b_position][0], b_info[b][b_position][1], b_info[b][b_position][2])) continue;

			new zone_name[32];
			GetPlayer2DZone(playerid, zone_name, 32);

			get_gz_pos(fX, fY, 80.0, mw_quad[0], mw_quad[1], mw_quad[2], mw_quad[3]);
			mw_gangzone = GangZoneCreate(mw_quad[0], mw_quad[1], mw_quad[2], mw_quad[3]);

			mw_attacker = PlayerInfo[playerid][member];
			mw_owner = b_info[b][b_mafia];

			GangZoneShowForAll(mw_gangzone, f_info[mw_owner -1][f_radar_color]);

			mw_time = 600;
			mw_biz = b;

			GangZoneFlashForAll(mw_gangzone, f_info[mw_attacker -1][f_radar_color]);

			mw_owner_points = 0;
			mw_attacker_points = 0;

			mafia_cd = 7200;


			new _string[144];
			format(_string, sizeof(_string), "{%s}%s have begun taking over الحافلةiness %s at الموقع %s near {%s}%s ",
			f_info[PlayerInfo[playerid][member]][f_chat_color],
			f_info[PlayerInfo[playerid][member]][f_name],
			b_info[b][b_name],
			zone_name,
			f_info[mw_owner -1][f_chat_color],
			f_info[mw_owner -1][f_name]);


			SendMafiaMessage(col_gray, _string);

			format(_string, sizeof(_string), "{%s}%s %s[%d] provoked a الحرب on الحافلةiness.",
			f_info[PlayerInfo[playerid][member]][f_chat_color],

			f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1],
			PlayerInfo[playerid][name],
			playerid);
			SendMafiaMessage(col_gray, _string);

			AdminMes(""c_server"* S.معلومات:"c_grey" %s shoro be tasahob الحافلةsines az %s", f_info[PlayerInfo[playerid][member]][f_name], f_info[mw_owner -1][f_name]);

			TextDrawSetString(mw_td[5], "BIZالحرب_الوقت:_10:00");
			TextDrawSetString(mw_td[14], mafia_td_name[getPlayerFactionID(playerid) -23]);
			TextDrawSetString(mw_td[15], mafia_td_name[mw_owner -23]);
			TextDrawSetString(mw_td[16], "0");
			TextDrawSetString(mw_td[17], "0");

			mw_owner_points = 0,
				mw_attacker_points	= 0;

			TextDrawColor(mw_td [10], f_info[PlayerInfo[playerid][member]][f_radar_color]);
			TextDrawColor(mw_td [11], f_info[PlayerInfo[playerid][member]][f_radar_color]);
			TextDrawColor(mw_td [12], f_info[mw_owner -1][f_radar_color]);
			TextDrawColor(mw_td [13], f_info[mw_owner -1][f_radar_color]);


			mw_timer = SetTimerEx("اتصالرجوع_mw_الوقتr", 1000, 1, "i", b);

			return 1;
		}
		return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت ليس at the المشروع.");
	}

	if(GetPVarInt(playerid, "الخريطة_mark"))
	{
		new get_taxidriver = GetPVarInt(playerid, "تاكسي_السائق_id");
		SetPlayerRaceCheckpoint(get_taxidriver, 1, fX, fY, fZ, 0.0, 0.0, 0.0, 2.0);
		is_gps_used {get_taxidriver} = 1;
		SendClientMessage(get_taxidriver, col_white, ""c_server"* "c_white"لديك been marked on the الخريطة to remove أدخل "c_grey"'/نظام الملاحة'"c_white".");
		SendClientMessage(playerid, col_white, ""c_green"* "c_white"لديك tagged the Ranandeh تاكسي.");
		DeletePVar(playerid, "الخريطة_mark");
		DeletePVar(playerid, "تاكسي_السائق_id");
		return 1;
	}

	if(PlayerInfo[playerid][admin] == 0) return 1;
	p_t_info[playerid][p_tp_immune_time] = 4;

    SetPVarFloat(playerid,"teleportX",fX), SetPVarFloat(playerid,"teleportY",fY), SetPVarFloat(playerid,"teleportZ",fZ);
	show_dialog(playerid, d_click_map_teleport, DIALOG_STYLE_MSGBOX, ""c_server"Teleport", ""c_white"Aya mikhahid be nagshe click shode teleport konid?", "Bale", "Kheyr");
	return 1;
}

public OnPlayerClickPlayer(playerid, clickedplayerid, source)
{
    if(clickedplayerid == INVALID_PLAYER_ID) return 1;
	if(!p_t_info[clickedplayerid][p_logged]) return SendError(playerid, "Bazikon vard bazi nashode ast.");
    
    new info[256];
    format(info, sizeof(info), c_white"Nickالاسم: "c_server"%s\n"c_white"الهاتف الرقم: %d\n"c_white"Device: %s", PlayerInfo[clickedplayerid][name], PlayerInfo[clickedplayerid][number], IsPlayerMobile(clickedplayerid) ? ("Android") : ("PC"));
    
	new header_title[10+MAX_PLAYER_NAME];

	format(header_title, sizeof header_title, "%s", PlayerInfo[clickedplayerid][name]);

    show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, header_title, info, "Ok", "");
    
    return 1;
}

forward FCNPC_OnTakeDamage(npcid, damagerid, weaponid, bodypart, Float:health_loss);
public FCNPC_OnTakeDamage(npcid, damagerid, weaponid, bodypart, Float:health_loss)
{
	if(weaponid<0||weaponid>47)return 1;
	if(npcid==Boss&&BossArea!=-1)
	{
		if(IsBossAsleep)
		{
			FCNPC_ResetAnimation(Boss);
			IsBossAsleep=false;
			UpdateDynamic3DTextLabelText(BossLabel,0xFF0000FF,"I'm here to conquer the world!");
			new str[100];
			format(str,sizeof(str), "{ff0000}[BOSS-فعالية]: "c_white"%s Has Awaken The Boss, He Can Move Around لاw!",GetName(damagerid));
			SendClientMessageToAll(COLOR_RED,str);
			BossMoveTimer = SetTimer("MoveBoss", 30000, true);
		}
		BossScore[damagerid]+=health_loss;
		CheckForAim(damagerid);
	}
	return 1;
}

forward FCNPC_OnDeath(npcid, killerid, weaponid);
public FCNPC_OnDeath(npcid, killerid, weaponid)
{
	if(npcid==Boss&&BossArea!=-1)
	{
		DestroyDynamicArea(BossArea);
		BossArea=-1;
		DestroyDynamicArea(BossArea2);
		BossArea2=-1;
		DestroyDynamic3DTextLabel(BossLabel);
		BossLabel=Text3D:-1;
		DestroyDynamic3DTextLabel(AngelLabel);
		AngelLabel=Text3D:-1;
		KillTimer(BossTimer);
		BossTimer=-1;
		KillTimer(BossMoveTimer);
		BossMoveTimer = -1;
		DestroyBossTD();
		SetTimer("DestroyBoss",3000,false);
		SetTimer("DestroyAngel",3000,false);
		new str[144];
		new first=-1,second=-1,third=-1;
		GetTopBossKillers(first,second,third);
		format(str, sizeof(str),  "{ff0000}[BOSS-فعالية]: "c_white"1: %s, 2: %s, 3: %s.",(first!=-1)?(ReturnBossKillerScore(first)):("لا-one"),(second!=-1)?(ReturnBossKillerScore(second)):("لا-one"),(third!=-1)?(ReturnBossKillerScore(third)):("لا-one"));
		SendClientMessageToAll(0xFF0000FF,str);
		foreach(new i:Player)
		{
			BossSpawn[i]=false;
			if(UsedWita[i])
			{
				DisablePlayerCheckpoint(i);
				UsedWita[i] = false;
			}
			if(BossScore[i]<1)continue;
			GivePlayerBossPrize(i, GetPlayerBossRank(i));
		}
		SendClientMessageToAll(0xFF0000FF, "{ff0000}[BOSS-EVENT]: "c_white"The Boss Event تم Ended, المكافأةs Will Be Sent To Winners.");
		return 1;
	}
	return 1;
}

public FCNPC_OnReachDestination(npcid)
{
	FCNPC_Stop(npcid);
	return 1;
}

public OnPlayerDeath(playerid, killerid, reason)
{
	#if defined debug_mode
		printf("[DEخلل] [Onاللاعبوفيات] اللاعبid:%d | قتلerid:%d | السبب:%d", playerid, killerid, reason);
	#endif

	#if defined _metro_stop_included
		ms_OnPlayerDeath(playerid);
	#endif

	if(BossSpawn[playerid])
	{
	    new Float:BossRevivePos[2][3] =
		{
			{1879.5676,-2309.9890,13.5469},
			{1653.2657,1619.1860,10.8203}
		};
		SetSpawnInfo(playerid, PlayerInfo[playerid][pTeam], PlayerInfo[playerid][skin], BossRevivePos[BossSpawnLocation][0],BossRevivePos[BossSpawnLocation][1],BossRevivePos[BossSpawnLocation][2], 0.0, 0, 0, 0, 0, 0, 0);
	}

	if(IsPlayerNPC(playerid) || FCNPC_IsValid(playerid)) return 1;

	g_PlayerSpawned[playerid] = false;

	p_t_info[playerid][p_tp_immune_time] = 3;
	p_t_info[playerid][p_dialog] = -1;

	g_DelayForSetPos[playerid] = 0;
    g_BeforeDelayPositons[playerid][0] = 0.0;

	StopAudioStreamForPlayer(playerid);

	p_t_info[playerid][gomp] = false;

	// --------------

	if(!GetPVarInt(playerid, "p_dead") && (!gang_player(playerid) || !mafia_player(playerid)) && !IsPlayerInAnyDMZone(playerid))
	{
		if(IsPlayerToSquare(playerid, -891.3302, -2950.0190,2915.9917,560.3257)) SetPVarInt(playerid, "p_dead", 1);	 // LS
		else if(IsPlayerToSquare(playerid,-2929.6589,-2889.1660,-1326.9077,1493.1770)) SetPVarInt(playerid, "p_dead", 2); // SF
		else SetPVarInt(playerid, "p_dead", 3);	 // LV
		if(army_player(playerid)) SetPVarInt(playerid, "p_dead", 4);
		if(gang_player(playerid) && IsPlayerToSquare(playerid,1843.9275,-2205.1902,2960.9487,-954.5435)) SetPVarInt(playerid, "p_dead", 5);


		if(GetPVarInt(playerid, "exam_المركبة")!= 0)
		{
			is_leave_exam_vehicle {playerid} = 0;
			SendError(playerid, "You made serious mهوtakes, you failed the exam.");
			GameTextForPlayer(playerid, "~r~FAILED", 5000, 6);
			new vehicle_id = GetPVarInt(playerid, "exam_المركبة");
			DeletePVar(playerid, "exam_المركبة");
			DeletePVar(playerid, "driving_cp");
			DisablePlayerRaceCheckpoint(playerid);

			SetPVarInt(playerid, "p_dead", GetVehicleModel(vehicle_id));
			DestroyVehicle(vehicle_id);
		}
	}
	if(GetPVarInt(playerid, "filling_الوقتr")!= 0)KillTimer(GetPVarInt(playerid, "filling_الوقتr")), DeletePVar(playerid, "filling_الوقتr");
	if(GetPVarInt(playerid,"Stol")) ExitBone(playerid);

	if(GetPVarInt(playerid, "p_h_bed") > 0)
	{
		h_bed_toggled[GetPVarInt(playerid, "p_h_bed")-1][GetPlayerVirtualWorld(playerid)-1] = false;
		DeletePVar(playerid, "p_h_bed");
	}

	if((gang_player(playerid) || mafia_player(playerid)) && IsPlayerToSquare(playerid, 80.8047, 1762.5040, 390.7005, 2093.4778))
	{
		PlayerInfo[playerid][crim_ammo] = 0;
		PlayerInfo[playerid][crim_guns] = 0;
		SendClientMessage(playerid, col_gray, "* Before sending you to the المستشفى, the sقديمiers confهوcated your ammunition and الأسلحة.");
	}

	if(GetPVarInt(playerid,"p_masked")) DeletePVar(playerid, "p_masked");

	if(playerTimeJobStatus(playerid))
	{
		give_money(playerid, PlayerInfo[playerid][salary]);
		PlayerInfo[playerid][salary] = 0;
		if(getTimeJobFactionID(playerid) == job_porter || getTimeJobFactionID(playerid) == job_forklift)
		{
			give_money(playerid, PlayerInfo[playerid][salary]);
			insert_money_log(playerid, INVALID_PLAYER_ID, PlayerInfo[playerid][salary], "الراتب in the الميناء");

			SendClientMessage(playerid, col_white, ""c_green"* "c_white"لديك left the port همa and مكتمل your work shift.");
			new __t_string[72];
			format(__t_string, sizeof(__t_string), ""c_green"* "c_white"المكتسب: "c_green"$%d", PlayerInfo[playerid][salary]);
			SendClientMessage(playerid, col_white, __t_string);

			new pljob = getTimeJobFactionID(playerid);

			PlayerInfo[playerid][timejob] = -1;
			PlayerInfo[playerid][salary] = 0;

			if(is_fraction_duty {playerid} == 1)SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
			else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

			hide_payment(playerid);
			DisablePlayerCheckpoint(playerid);


			if(pljob == job_forklift)
			{
				if(forklift_ptd[playerid] != PlayerText:-1)
				{
					PlayerTextDrawDestroy(playerid, forklift_ptd[playerid]);
					TextDrawHideForPlayer(playerid, forklift_td);

					forklift_ptd[playerid] = PlayerText:-1;
					forklift_time[playerid] = -600;
				}
				new _v_id = player_rentcar[playerid];
				player_rentcar[playerid] = INVALID_VEHICLE_ID;

				SetVehicleToRespawn(_v_id);
				if(GetPVarInt(playerid, "fork_object"))
				{
					DestroyDynamicObject(GetPVarInt(playerid, "fork_object"));
					DeletePVar(playerid, "fork_object");
				}
			}
			else if(pljob == job_porter)
			{
				if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
				ClearAnimations(playerid);
				DeletePVar(playerid, "have_المصنع_box");
			}

		}
		PlayerInfo[playerid][timejob] = job_none;

		if(IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid, 0);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
		DisablePlayerCheckpoint(playerid);

	}
	if(td_db[playerid][1] != PlayerText:-1)
	{
		for(new j = 0; j < 4; j ++)
		{
			PlayerTextDrawDestroy(playerid, td_db[playerid][j]);
			td_db[playerid][j] = PlayerText:-1;
		}
	}
	if(GetPVarInt(playerid, "اللاعبCuffed")> 0)
	{
		DeletePVar(playerid, "اللاعبCuffed");
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(playerid, 1);
	}
	if(GetPVarInt(playerid, "اللاعبTied")> 0)
	{
		DeletePVar(playerid, "اللاعبTied");
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	}

	is_ether {playerid} = -1; // we turn off the air

	if(quest_photographer_id[playerid] != -1)
		EndJobPhotographer(playerid);
	if(p_t_info[playerid][phone_id] != INVALID_PLAYER_ID)
	{
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
		SetPlayerSpecialAction(p_t_info[playerid][phone_id], SPECIAL_ACTION_STOPUSECELLPHONE);
		RemovePlayerAttachedObject(playerid, 2);
		RemovePlayerAttachedObject(p_t_info[playerid][phone_id], 2);

		SendClientMessage(p_t_info[playerid][phone_id], 0x940000FF, "mikhad ye chizi bege...");
		me_action(p_t_info[playerid][phone_id], "put the handset down", 5.0);

		new temp_stream_id = GetPlayerPhoneCallStreamVC(playerid);
		ResetVoicePhoneCallChannel(playerid);
		ResetVoicePhoneCallChannel(p_t_info[playerid][phone_id]);
		DeleteVoicePhoneCallChannel(temp_stream_id);

		p_t_info[p_t_info[playerid][phone_id]][phone_id] = INVALID_PLAYER_ID;
		p_t_info[p_t_info[playerid][phone_id]][phone_caller] = 0;

		p_t_info[playerid][phone_id] = INVALID_PLAYER_ID;
		p_t_info[playerid][phone_caller] = 0;
	}
	if(GetPVarInt(playerid, "p_sm_used")!= 0)
	{
		CancelSelectTextDraw(playerid);
		PlayerTextDrawDestroy(playerid, sm_ptd[playerid]);
		sm_ptd[playerid] = PlayerText:INVALID_TEXT_DRAW;
		for(new i = 0; i < 4; i ++)
		{
			TextDrawHideForPlayer(playerid, sm_td[i]);
		}
		sm_used[GetPVarInt(playerid, "p_sm_used")-1] = false;
		DeletePVar(playerid, "p_sm_used");
		DeletePVar(playerid, "sm_bet");
	}

	if(GetPVarInt(playerid, "p_skin_المتجر") == 1)
	{
		DeletePVar(playerid, "skin_اختر_number");
		DeletePVar(playerid, "p_skin_المتجر");

		TogglePlayerControllable(playerid, true);
		SetCameraBehindPlayer(playerid);
		set_world(playerid, 0);

		for(new i = 0; i < 19; i ++)
		{
			TextDrawHideForPlayer(playerid, td_skinshop[i]);
		}
		CancelSelectTextDraw(playerid);
		PlayerTextDrawDestroy(playerid, td_skinshop_price[playerid]);
		td_skinshop_price[playerid] = PlayerText:-1;
		SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);
	}

	if(duel_opponent[playerid] != INVALID_PLAYER_ID)
	{
		new _text_string[144];
		format(_text_string, sizeof(_text_string), ""c_green"* "c_white"لديك defeated "c_green"%s"c_white" and won the bet of "c_green"$%d", PlayerInfo[playerid][name], duel_price[playerid]);
		SendClientMessage(duel_opponent[playerid], col_white, _text_string);

        set_health(playerid, 100);
        set_health(duel_opponent[playerid], 100);

		give_money(duel_opponent[playerid], duel_price[playerid]*2);
		insert_money_log(playerid, duel_opponent[playerid], duel_price[playerid], "Duel");

		SendClientMessage(playerid, col_white, ""c_green"* "c_white"You lost the Duel.");

		if(isPlayerInJail(duel_opponent[playerid]))
		{
			if(4 > PlayerInfo[duel_opponent[playerid]][jail] > 0)
			{
				new random_jail_pos = random(sizeof jail_spawn);
				set_pos(duel_opponent[playerid], jail_spawn[random_jail_pos][0],
									jail_spawn[random_jail_pos][1],
									jail_spawn[random_jail_pos][2],
									jail_spawn[random_jail_pos][3],
									1, PlayerInfo[duel_opponent[playerid]][jail]);
				if(is_fraction_duty {duel_opponent[playerid]} == 1)SetPlayerSkin(duel_opponent[playerid], PlayerInfo[duel_opponent[playerid]][org_skin]), SetPlayerColor(duel_opponent[playerid], f_info[PlayerInfo[duel_opponent[playerid]][member]][f_radar_color]);
				else SetPlayerSkin(duel_opponent[playerid], PlayerInfo[duel_opponent[playerid]][skin]);
			}
			else if(PlayerInfo[duel_opponent[playerid]][jail] == 10)
			{
				new random_jail_pos = random(sizeof admin_jail_spawn);
				set_pos(duel_opponent[playerid], admin_jail_spawn[random_jail_pos][0],
					admin_jail_spawn[random_jail_pos][1],
					admin_jail_spawn[random_jail_pos][2],
					admin_jail_spawn[random_jail_pos][3],
					1, 15);

				if(is_fraction_duty {duel_opponent[playerid]} == 1)SetPlayerSkin(duel_opponent[playerid], PlayerInfo[duel_opponent[playerid]][org_skin]), SetPlayerColor(duel_opponent[playerid], f_info[PlayerInfo[duel_opponent[playerid]][member]][f_radar_color]);
				else SetPlayerSkin(duel_opponent[playerid], PlayerInfo[duel_opponent[playerid]][skin]);
			}
		}
		else set_pos(duel_opponent[playerid], 2049.470, -1908.065, 13.546, 270.0, 0, 0);
		SetPVarInt(duel_opponent[playerid], "tp_همa_used", 1);


		ResetPlayerWeapons(duel_opponent[playerid]);
		for(new i = 0; i < 12; i ++)
		{
			GivePlayerWeapon(duel_opponent[playerid], duel_guns[duel_opponent[playerid]][i][0], duel_guns[duel_opponent[playerid]][i][1]);
		}
		duel_price[playerid] = 0;
		duel_price[duel_opponent[playerid]] = 0;
		duel_opponent[duel_opponent[playerid]] = INVALID_PLAYER_ID;
		duel_opponent[playerid] = INVALID_PLAYER_ID;

		SetPVarInt(playerid, "p_dead", 322);
	}
	if(GetPVarInt(playerid, "fork_object"))
	{
		DestroyDynamicObject(GetPVarInt(playerid, "fork_object"));
		DeletePVar(playerid, "fork_object");
	}

	if(killerid != INVALID_PLAYER_ID) {
		if((army_player(killerid) || cop_player(killerid) || fbi_player(killerid)) && is_fraction_duty {killerid}) {
			PlayerInfo[killerid][activity_killed_and_jails]++;
			update_int_sql(killerid, "u_activity_killed_and_السجنs", PlayerInfo[killerid][activity_killed_and_jails]);
		}
	}

	return 1;
}

public OnPlayerSpawn(playerid)
{
	if(IsPlayerNPC(playerid) || FCNPC_IsValid(playerid)) return 1;

	p_t_info[playerid][player_death] = false;

	if(google_checking {playerid} == 1)
	{
		show_dialog(playerid, d_googleauth_entrance, DIALOG_STYLE_INPUT, ""c_server"Google Auth", ""c_white"أدخل the code from the application:", "تسجيل الدخول", "Logout");
	}

	#if defined debug_mode
		printf("[DEخلل] [Onاللاعبينpawn] اللاعبid: %d", playerid);
	#endif

	set_health(playerid, 100.0);
	SetPlayerScore(playerid, PlayerInfo[playerid][level]);
	SetPlayerSkills(playerid);

	p_t_info[playerid][p_tp_immune_time] = 4;

	g_DelayForSetPos[playerid] = 0;
    g_BeforeDelayPositons[playerid][0] = 0.0;

	if(!MRP_OnPlayerSpawn(playerid)) return 1;

	if(!p_t_info[playerid][p_logged] && GetPVarInt(playerid, "first_entrance") == 1)
	{
		TogglePlayerSpectating(playerid, false);
		TogglePlayerControllable(playerid, true);
		set_world(playerid, playerid);
		SetPlayerPos(playerid, 203.8164, -128.2053, 1003.5259);
		set_interior(playerid, 0);
		SetPlayerFacingAngle(playerid, 143.130);
		TogglePlayerControllable(playerid, 0);
		SetPlayerSkin(playerid, registration_skins[reg_info[playerid][reg_national] -1][reg_info[playerid][reg_gender] -1][0]);

		SetPlayerCameraPos(playerid, 201.5432,-131.7309,1004.5259);
		SetPlayerCameraLookAt(playerid, 203.8164,-128.2053,1003.5259);

		SelectTextDraw(playerid, 0xB0C4DEFF);
		for(new i = 0; i <= 12; i ++)
		{
			TextDrawShowForPlayer(playerid, td_regskins[i]);
		}
		return 1;
	}

	PlayerPlaySound(playerid, 1184, 0.0, 0.0, 0.0);
    SetTimerEx("AttachedاللاعبAccAndالتكلفةume", 3000, false, "i", playerid);

	if(!p_t_info[playerid][p_logged]) return kick_player(playerid);

	if(p_t_info[playerid][AudioLogin]) {
		p_t_info[playerid][AudioLogin] = false;
		StopAudioStreamForPlayer(playerid); // stop login audio
	}

	g_PlayerSpawned[playerid] = true;

	if(anim_loaded {playerid} == 0)
	{
		PlayerLoadPreloadAnims(playerid);
		anim_loaded {playerid} = 1;
	}

	if(PlayerInfo[playerid][fight_style]) SetPlayerFightingStyle(playerid, PlayerInfo[playerid][fight_style]);
	else SetPlayerFightingStyle(playerid, 0);

	ResetPlayerMoney(playerid);
	GivePlayerMoney(playerid, PlayerInfo[playerid][money]);
	
	if(is_fraction_duty[playerid] == 1)
		SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]), SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
	else 
		SetPlayerSkin(playerid, PlayerInfo[playerid][skin]), SetPlayerColor(playerid, 0xFFFFFF80);

	// -------------

	if(BossSpawn[playerid])
	{
		SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld(playerid, 0);
		SetSpawnInfo(playerid, PlayerInfo[playerid][pTeam], PlayerInfo[playerid][skin], 1481.0996,-1793.2894,13.5469, 1.0, -1, -1, -1, -1, -1, -1);
	}

	if(!p_t_info[playerid][first_spawn]) {
		if(satiety_progress_bar[playerid] == INVALID_PLAYER_BAR_ID) {
			if(!IsPlayerUsingSampMobile(playerid)) {
				satiety_progress_bar[playerid] = CreatePlayerProgressBar(
					playerid, 
					448.000000, 
					8.000000, 
					60.000000, 
					3.0, 
					0x037DF8FF, 
					100.00, 
					BAR_DIRECTION_RIGHT);
			} else {
				satiety_progress_bar[playerid] = CreatePlayerProgressBar(
					playerid,
					424.000000,
					11.000000,
					52.500000,
					4.699998,
					0x037DF8FF,
					100.00,
					BAR_DIRECTION_RIGHT);
			}
		}
		SetPlayerProgressBarValue(playerid, satiety_progress_bar[playerid], PlayerInfo[playerid][hunger]);
		ShowPlayerProgressBar(playerid, satiety_progress_bar[playerid]);

		LoadDamageInfoTextdraws(playerid);

	}

	if(GetPVarInt(playerid, "have_box")) DeletePVar(playerid, "have_box");
	if(GetPVarInt(playerid, "have_المصنع_box")) DeletePVar(playerid, "have_المصنع_box");
	if(GetPVarInt(playerid, "exam_المركبة")!= 0)DestroyVehicle(GetPVarInt(playerid, "exam_المركبة")), DeletePVar(playerid, "exam_المركبة");
	if(action_type {playerid} != 0)
	{
		action_td_status(playerid, false);
	}

	if(PlayerInfo[playerid][salary] != 0)
	{
		new _t_string[62];
		format(_t_string, sizeof(_t_string), "You received compensation in the المبلغ of $%d.", PlayerInfo[playerid][salary]);
		SendClientMessage(playerid, 0xCCCCCCFF, _t_string);
		give_money(playerid, PlayerInfo[playerid][salary]);
		insert_money_log(playerid, INVALID_PLAYER_ID, PlayerInfo[playerid][salary], "compensation");
		PlayerInfo[playerid][salary] = 0;
	}

	if(TeamPaint[playerid] > 0)
	{
	    switch(StartPaintBall)
	    {
	        case 0:
	        {
	            TeamPaint[playerid]=
				KillPaint[playerid]=
				DeathPaint[playerid] = 0;
				TextDrawHideForPlayer(playerid, PaintTextDraws);
				PlayerTextDrawDestroy(playerid, PaintStats[playerid]);
				PaintStats[playerid] = PlayerText:-1;
			}
			case 2:
			{
				set_health(playerid, 100.0);
				SetPlayerSkinEx(playerid, SkinPaint[PlayerInfo[playerid][gender]][TeamPaint[playerid] -1]);

				GivePlayerWeapon(playerid, 24, 2000);
				GivePlayerWeapon(playerid, 25, 2000);
				GivePlayerWeapon(playerid, 31, 2000);

				new spawn = random(10);
				switch(TeamPaint[playerid])
				{
				    case 1:
					{
						set_pos(playerid, SpawnBlueTeam[PaintBallMap-1][spawn][0], SpawnBlueTeam[PaintBallMap-1][spawn][1], SpawnBlueTeam[PaintBallMap-1][spawn][2], SpawnBlueTeam[PaintBallMap-1][spawn][3], 0, 45);
						SetPlayerColor(playerid, 0x33AAFFFF);
					}
					case 2:
					{
						set_pos(playerid, SpawnRedTeam[PaintBallMap-1][spawn][0], SpawnRedTeam[PaintBallMap-1][spawn][1], SpawnRedTeam[PaintBallMap-1][spawn][2], SpawnRedTeam[PaintBallMap-1][spawn][3], 0, 45);
						SetPlayerColor(playerid, 0xAA3333FF);
					}
				}
				return 1;
			}
		}
	}

	if(PlayerInfo[playerid][admin] != 0 && GetPVarInt(playerid, "spectate_الحالة")> 0)
	{
		DeletePVar(playerid, "spectate_الحالة");
		set_pos(playerid, p_t_info[playerid][p_pos][0], p_t_info[playerid][p_pos][1], p_t_info[playerid][p_pos][2], p_t_info[playerid][p_pos][3], p_t_info[playerid][p_data][0], p_t_info[playerid][p_data][1]);
		CancelSelectTextDraw(playerid);
		ResetPlayerWeapons(playerid);
		is_control_chat{playerid} = in_recon_chat{playerid};
		for(new j = 0; j < 7; j ++)
		{
			TextDrawHideForPlayer(playerid, sp_td[j]);
			if(j < 3)
			{
				if(sp_ptd[playerid][j] != PlayerText:-1)PlayerTextDrawDestroy(playerid, sp_ptd[playerid][j]);
				sp_ptd[playerid][j] = PlayerText:-1;
			}
		}

		for(new i = 0; i < 12; i ++)
		{
			GivePlayerWeapon(playerid, PlayerInfo[playerid][Weapon][i], PlayerInfo[playerid][Ammo][i]);
		}
		return 1;
	}

	if(!p_t_info[playerid][first_spawn]) {
		p_t_info[playerid][first_spawn] = true;

		ResetPlayerWeapons(playerid);
		for (new i; i < MAX_WEAPONS; i++)
		{
			if(PlayerInfo[playerid][Weapon][i] == 42)
			{
				PlayerInfo[playerid][Weapon][i] = 0;
				PlayerInfo[playerid][Ammo][i] = 0;
				p_t_info[playerid][FireAmmo] = 0;
				continue;
			}
			GivePlayerWeapon(playerid, PlayerInfo[playerid][Weapon][i], PlayerInfo[playerid][Ammo][i]);
		}
		SetPlayerArmedWeapon(playerid, 0);
	}

	//---------

	if(gang_player(playerid)|| mafia_player(playerid)|| radio_player(playerid)) is_fraction_duty {playerid} = 1;
	else is_fraction_duty {playerid} = 0, SetPlayerColor(playerid, 0xFFFFFF80); // col_white
	

	if(!playerFactionStatus(playerid)) 
	{
		is_fraction_duty {playerid} = 0;
		SetPlayerColor(playerid, 0xFFFFFF80);
	}

	if(GetPVarInt(playerid, "goto_last_position")) {
		DeletePVar(playerid, "goto_last_position");
		DeletePVar(playerid, "last_position_valid");

		set_pos(playerid, 
			p_t_info[playerid][LastPositionX], 
			p_t_info[playerid][LastPositionY], 
			p_t_info[playerid][LastPositionZ],
			p_t_info[playerid][LastPositionANGLE],
			p_t_info[playerid][LastPositionINT],
			p_t_info[playerid][LastPositionWORLD]);

		p_t_info[playerid][business] = p_t_info[playerid][LastPositionBIZID];
		p_t_info[playerid][house] = p_t_info[playerid][LastPositionHOUSEID];

		if(is_fraction_duty {playerid} == 1) SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]), SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);
		
		return 1;
	}

	if(isPlayerInJail(playerid))
	{
		if(4 > PlayerInfo[playerid][jail] > 0)
		{
			new random_jail_pos = random(sizeof jail_spawn);
			set_pos(playerid, jail_spawn[random_jail_pos][0],
								jail_spawn[random_jail_pos][1],
								jail_spawn[random_jail_pos][2],
								jail_spawn[random_jail_pos][3],
								1, PlayerInfo[playerid][jail]);

			if(is_fraction_duty {playerid} == 1) SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]), SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
			else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);
			return 1;
		}
		else if(PlayerInfo[playerid][jail] == 10)
		{
			new random_jail_pos = random(sizeof admin_jail_spawn);
			set_pos(playerid, admin_jail_spawn[random_jail_pos][0],
								admin_jail_spawn[random_jail_pos][1],
								admin_jail_spawn[random_jail_pos][2],
								admin_jail_spawn[random_jail_pos][3],
								1, 15);

			if(is_fraction_duty {playerid} == 1)SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]), SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
			else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);
			return 1;
		}
	}
	else if(PlayerInfo[playerid][csjail])
	{
        new random_csjail = random(sizeof csjailpos);
	    set_pos(playerid, -942.625, 1941.764, 5.000, 177.806, 1, 15);
	    SetPlayerInterior(playerid, 17);
	    SetPlayerCheckpoint(playerid,csjailpos[random_csjail][0],csjailpos[random_csjail][1],csjailpos[random_csjail][2],0.5);
	    SetPlayerSkin(playerid, 42);
	    return 1;
	}

    if(IsPlayerInAnyDMZone(playerid))
    {
        switch(player_lobby_type[playerid])
        {
            case LOBBY_TYPE_DEATHMATCH:
            {
                ResetPlayerWeapons(playerid);
                new idx = player_lobby_idx[playerid], sidx = random(20), type = LobbyInfo[idx][LobbyType] - 1, map = LobbyInfo[idx][LobbyMap], interior_map[5] = {1, 1, 0, 0, 0};
               	set_pos(playerid, LobbyPos[type][map][sidx][0], LobbyPos[type][map][sidx][1], LobbyPos[type][map][sidx][2], LobbyPos[type][map][sidx][3], interior_map[map], idx + 1);
                SetCameraBehindPlayer(playerid);
				if(is_fraction_duty {playerid} == 1) SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
				else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);
                set_health(playerid, 100.0);
                SetPlayerColor(playerid, 0xFF0000FF);
                GivePlayerWeapon(playerid, LobbyInfo[idx][LobbySubject], 9999);
				if(LobbyInfo[idx][LobbyDefault]) GivePlayerWeapon(playerid, LobbyInfo[idx][LobbyDefaultWeapon], 9999);
                return 1;
            }
            case LOBBY_TYPE_RACE:
            {
                new idx = player_lobby_idx[playerid];
                OnPlayerLeaveLobby(playerid, idx, "الظهور.");
                return 1;
            }
            case LOBBY_TYPE_DERBY:
            {
                new idx = player_lobby_idx[playerid];
                OnPlayerLeaveLobby(playerid, idx, "الظهور.");
                return 1;
            }
            case LOBBY_TYPE_STUNT:
            {
                new idx = player_lobby_idx[playerid];
                OnPlayerLeaveLobby(playerid, idx, "الظهور.");
                return 1;
            }
            case LOBBY_TYPE_PARKOUR:
            {
                ResetPlayerWeapons(playerid);
                new idx = player_lobby_idx[playerid], sidx = random(20), type = LobbyInfo[idx][LobbyType] - 1, map = LobbyInfo[idx][LobbyMap];
                SetPlayerSkin(playerid, LobbyInfo[idx][LobbySubject]);
				set_pos(playerid, LobbyPos[type][map][sidx][0], LobbyPos[type][map][sidx][1], LobbyPos[type][map][sidx][2], LobbyPos[type][map][sidx][3], 1, idx);
                SetCameraBehindPlayer(playerid);
                set_health(playerid, 100.0);
                SetPlayerColor(playerid, 0xFF0000FF);
                return 1;
            }
        }
    }

	if(GetPVarInt(playerid, "p_dead") == 5) DeletePVar(playerid, "p_dead");
	
	if(GetPVarInt(playerid, "p_dead") >= 1 && PlayerInfo[playerid][spawnchange] == 0)
	{
		if(GetPVarInt(playerid, "p_dead") > 5)
		{

			switch(GetPVarInt(playerid, "p_dead"))
			{
				case 593:set_pos(playerid, 739.3827, -1414.3588, 1500.9509, 176.8004, 1, 3);
				case 473:set_pos(playerid, 739.3827, -1414.3588, 1500.9509, 176.8004, 1, 2);
				case 587:set_pos(playerid, 1148.1576, -1770.4432, 16.5914, 0.0000, 0, 0);
				case 322:
				{
					set_pos(playerid, 2049.470, -1908.065, 13.546, 270.0, 0, 0);
					SetPVarInt(playerid, "tp_همa_used", 1);
					ResetPlayerWeapons(playerid);
					for(new i = 0; i < 12; i ++)
					{
						GivePlayerWeapon(playerid, duel_guns[playerid][i][0], duel_guns[playerid][i][1]);
					}
					if(is_fraction_duty {playerid} == 1)SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]), SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
					else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

				}
			}

			DeletePVar(playerid, "p_dead");
			return 1;
		}
		else if(GetPVarInt(playerid, "p_dead") == 4)
		{
			set_pos(playerid, 1868.8661, 1348.5306, 2211.6094, 86.0880, 1, 1);
			set_health(playerid, 35.0);
			SendError(playerid, "أنت in a military state, الخبرةect full recovery of الصحة to مغادرة it.");
			return 1;
		}
		new random_h_pos = random(2);
		set_pos(playerid, hospital_spawn[random_h_pos][0],
							hospital_spawn[random_h_pos][1],
							hospital_spawn[random_h_pos][2],
							hospital_spawn[random_h_pos][3],
							1, //LS
							PlayerInfo[playerid][hospital]);

		set_health(playerid, 15.0);

		if(is_fraction_duty {playerid} == 1)SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]), SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

		SendError(playerid, "You will need to undergo treatment or be treated by a medic. Take a bed in pVorood for more effective treatment.");
		return 1;
	}

	if(GetPVarInt(playerid, "الشرطة_camid")||  GetPVarInt(playerid, "إيقاف_comp"))
	{
		if(is_fraction_duty {playerid} == 1)SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]), SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

		SetCameraBehindPlayer(playerid);
		set_pos(playerid, last_coord[playerid][0], last_coord[playerid][1], last_coord[playerid][2], last_coord[playerid][3], GetPVarInt(playerid, "last_interior"), GetPVarInt(playerid, "last_virtualworld"));
		DeletePVar(playerid, "الشرطة_camid");
		DeletePVar(playerid, "إيقاف_comp");
		DeletePVar(playerid, "last_virtualworld");
		DeletePVar(playerid, "last_interior");
		return 1;
	}

	if(playerHouseStatus(playerid) && PlayerInfo[playerid][spawnchange] == 1)
	{
		new h = PlayerInfo[playerid][house];
		new hint = h_info[h][h_int] -1;

		if(is_fraction_duty{playerid} == 1)
		{
			SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
			SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
		}
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

		set_pos(playerid, house_int[hint][hspawn_position][0], house_int[hint][hspawn_position][1], house_int[hint][hspawn_position][2], house_int[hint][hspawn_position][3], house_int[hint][hint_int], h_info[h][h_id]);
		return p_t_info[playerid][house] = h;
	}

	if((playerFactionStatus(playerid) || playerLeaderStatus(playerid)) && PlayerInfo[playerid][spawnchange] == 2)
	{
		set_pos(playerid, f_info[PlayerInfo[playerid][member]][f_spawn][0], f_info[PlayerInfo[playerid][member]][f_spawn][1], f_info[PlayerInfo[playerid][member]][f_spawn][2], f_info[PlayerInfo[playerid][member]][f_spawn][3], f_info[PlayerInfo[playerid][member]][f_spawn_int], f_info[PlayerInfo[playerid][member]][f_spawn_virt]);

		if(is_fraction_duty{playerid} == 1)
		{
			SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
			SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
		}
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

		set_health(playerid, 100.0);

		return 1;
	}

	new yacht_id = 0;
	foreach(new veh_id: player_vehicles[playerid])
	{
		if(!v_boat_int(veh_id)) continue;
		yacht_id = veh_id;
		break;
	}

	if(yacht_id && PlayerInfo[playerid][spawnchange] == 3)
	{
		is_player_in_boat[playerid] = yacht_id;

		if(is_fraction_duty{playerid} == 1)
		{
			SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
			SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
		}
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

		set_pos(playerid, 1390.1287, -24.9963, 1001.0063, 182.7941, 5, yacht_id);

		set_health(playerid, 100.0);

		return 1;
	}

	if(playerRentHouseStatus(playerid) && PlayerInfo[playerid][spawnchange] == 4)
	{
		new h = PlayerInfo[playerid][rent_house];
		new hint = h_info[h][h_int] -1;

		if(is_fraction_duty{playerid} == 1)
		{
			SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
			SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
		}
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

		set_pos(playerid, house_int[hint][hspawn_position][0], house_int[hint][hspawn_position][1], house_int[hint][hspawn_position][2], house_int[hint][hspawn_position][3], house_int[hint][hint_int], h_info[h][h_id]);
		return p_t_info[playerid][house] = h;
	}

    if(playerFamilyStatus(playerid))
    {
    	if(PlayerInfo[playerid][spawnchange] == 5) 
    	{
	        // i Houses
	        if(familyHouseStatus(PlayerInfo[playerid][family]))
	        {
	        	new h = family_info[PlayerInfo[playerid][family]][fam_house];
				new hint = h_info[h][h_int] -1;

				if(is_fraction_duty{playerid} == 1)
				{
					SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
					SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
				}
				else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

				set_pos(playerid, house_int[hint][hspawn_position][0], house_int[hint][hspawn_position][1], house_int[hint][hspawn_position][2], house_int[hint][hspawn_position][3], house_int[hint][hint_int], h_info[h][h_id]);
				return p_t_info[playerid][house] = h;
	        }
    	}
    }

	new journey_id = 0;
	foreach(new veh_id: player_vehicles[playerid])
	{
		if(veh_info[veh_id -1][v_model] != 508) continue;
		journey_id = veh_id;
		break;
	}

	if(journey_id && PlayerInfo[playerid][spawnchange] == 6)
	{
		is_player_in_journey[playerid] = journey_id;

		if(is_fraction_duty{playerid} == 1)
		{
			SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
			SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
		}
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

		set_pos(playerid, 4512.4331, -1729.1394, 778.6370, 271.0123, 5, journey_id);

		set_health(playerid, 100.0);
		
		return 1;
	}

	new logsCount = 0;

    new query[256];
    mysql_format(sql_connection, query, sizeof(query), "اختر * FROM `users_إداريs` WHERE `u_a_الاسم`='%s' LIMIT 1", PlayerInfo[playerid][name]);

    new Cache:result = mysql_query(sql_connection, query);

    logsCount = cache_num_rows();

    cache_delete(result);

	if(logsCount != 0)
	{
		set_pos(playerid, 1298.8677, -794.6638, 1084.0078, 359.1086, 5, 0);
		return 1;
	}else
	{
		if(PlayerInfo[playerid][level] < 4)
		{
			new i = random(3), j = random(3);
			if(i == 2)
				set_pos(playerid, newbie_spawn_pos[i][j][0], newbie_spawn_pos[i][j][1], newbie_spawn_pos[i][j][2], newbie_spawn_pos[i][j][3], 0, 0);
			else
				set_pos(playerid, newbie_spawn_pos[i][j][0], newbie_spawn_pos[i][j][1], newbie_spawn_pos[i][j][2], newbie_spawn_pos[i][j][3], 0, 0);
			return 1;
		}
		else
		{
			set_pos(playerid, -1971.038, 137.892, 27.687, 89.010, 0, 0);
			return 1;
		}
	}
}

public OnPlayerShootDynamicObject(playerid, weaponid, objectid, Float:x, Float:y, Float:z)
{
	#if defined debug_mode
		printf("[DEخلل] [OnاللاعبينhootDynamicObject] %d | %d | %d | %f | %f | %f", playerid, weaponid, objectid, Float:x, Float:y, Float:z);
	#endif
	return 1;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    if(!p_t_info[playerid][p_logged]) 
		return 0;
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && weaponid != 38 && !(21 < weaponid < 35))
        return 0;
    if(weaponid > 47 && hittype == 0 && fX == 0.0000 && hitid == 0 && fY == 0.0000 && fZ == 0.0000)
        return 0;
	if(fX == 0.000000 && fY == 0.000000 && fZ == 0.000000)
        return 0;
    if(weaponid == 38)
        return 0;

    // anticheat:
    if((!(22 <= weaponid <= 34) && weaponid != 38) || IsPlayerPausedAC(playerid)) return 0;

    new Float:topldist;
	switch(hittype)
	{
		case BULLET_HIT_TYPE_PLAYER:
		{
			if(!IsPlayerConnected(hitid) || IsPlayerPausedAC(hitid)) return 0;
            new Float:ac_pos_x, Float:ac_pos_y, Float:ac_pos_z;
			GetPlayerPos(hitid, ac_pos_x, ac_pos_y, ac_pos_z);
		 	if((topldist = GetPlayerDistanceFromPoint(playerid, ac_pos_x, ac_pos_y, ac_pos_z)) > MaxDistShot[weaponid - 22]) return 0;
		}
		case BULLET_HIT_TYPE_VEHICLE:
		{
			if(!GetVehicleModel(hitid)) return 0;
			if(GetVehicleDriver(hitid) == INVALID_PLAYER_ID) return 0;
		}
		case BULLET_HIT_TYPE_OBJECT: if(!IsValidObject(hitid)) return 0;
		case BULLET_HIT_TYPE_PLAYER_OBJECT: if(!IsValidPlayerObject(playerid, hitid)) return 0;
	}

    if(hittype == BULLET_HIT_TYPE_PLAYER && hitid != INVALID_PLAYER_ID)
    {
        if(!IsPlayerStreamedIn(hitid, playerid))
            return 0;
        if(!PacifistMode(hitid, playerid)) return 0;

		if(p_t_info[hitid][player_gm]) return 0;

		if(GetTickCount() -p_t_info[hitid][p_update] > 1000) return 0;

		if(!ProxDetectorS(150.0, playerid, hitid)) return 0;

		if(hittype == BULLET_HIT_TYPE_PLAYER && IsPlayerConnected(hitid))
		{
			if((weaponid == 3 || weaponid == 23) && (cop_player(playerid) || fbi_player(playerid)))
			{
				if(!GetPVarInt(hitid, !"اللاعبCuffed") && is_tazered{hitid} == 0 && GetPlayerState(hitid) == PLAYER_STATE_ONFOOT)
				{
					ApplyAnimation(hitid, !"CRACK", !"crckdeth2", 4.0, 1, 0, 0, 0, 0);
					SetTimerEx("untazer_الوقتr", 15000, false, "i", hitid);
					TogglePlayerControllable(hitid, 0);
					is_tazered{hitid} = 1;

					new _text_string[125];
					format(_text_string, sizeof(_text_string), ""scm_info"You stunned citizen "c_server"%s"c_white" for 15 ثوانٍ", PlayerInfo[hitid][name]);
					SendClientMessage(playerid, col_white, _text_string);

					format(_text_string, sizeof(_text_string), ""scm_info"You were stunned "c_server"%s"c_white" for 15 ثوانٍ", PlayerInfo[playerid][name]);
					SendClientMessage(hitid, col_white, _text_string);

					format(_text_string, sizeof(_text_string), "be %s shoker zad", PlayerInfo[hitid][name]);
					me_action(playerid, _text_string);
				}
			}

			p_t_info[playerid][p_gun_accuracy] ++;

			foreach(new i: admin_players)
			{
				if(GetPVarInt(i, !"spectate_الحالة") == hitid + 1 && GetPVarInt(i, !"spectate_الحالة") != 0) PlayerPlaySound(i, 6401, 0.0, 0.0, 0.0);
			}
		}

	  	if((AntiDMZone(playerid, true) || AntiDMZone(hitid, true) || isPlayerInJail(playerid)))
	    {
			if(!is_player_race_regged[playerid] && 
	        	!TeamPaint[playerid] &&
	        	!cop_player(playerid) && 
	        	!fbi_player(playerid) && 
	        	!army_player(playerid) && 
	        	!gov_player(playerid)  &&
	        	!is_fraction_duty {playerid})
	        {
	            p_t_info[playerid][dm_zone_timer] = 3;
	            TogglePlayerControllable(playerid, false);
		        show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, c_server"GreenZone", "{FFFFFF}Dakhel \"Green Zone\" nemitoni kasi ro bezani!", "Bashe" , "");
		        ClearAnimations(playerid);
		        SetPlayerArmedWeapon(playerid, 0);
	        }
	        return 0;
	    }

		if(isSpawnZoneShowed[playerid])
	    {
			p_t_info[playerid][dm_zone_timer] = 3;
	        TogglePlayerControllable(playerid, false);
		    show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, c_server"الظهور قتل", "{FFFFFF}Lotfan الظهور kill nakonid!", "Bashe" , "");
		    ClearAnimations(playerid);
		    SetPlayerArmedWeapon(playerid, 0);
	        
			return 0;
	    }
		
        if((gang_player(playerid) || mafia_player(playerid)) && duel_opponent[playerid] == INVALID_PLAYER_ID && duel_opponent[hitid] == INVALID_PLAYER_ID && TeamPaint[playerid] == 0 && !IsPlayerInAnyDMZone(playerid) && ReturnPlayerInCounterStrike(playerid) == 0 && !IsPlayerInAnyDMZone(hitid) && ReturnPlayerInCounterStrike(hitid) == 0 && checkPlayerStatus(hitid) && checkPlayerStatus(playerid))
        {
            if(PlayerInfo[playerid][member] == PlayerInfo[hitid][member])
            {
                GameTextForPlayer(playerid, "~r~ANTI TEAM KILL", 1000, 3);
                return 0;
            }
        }
    }

	if(hittype == BULLET_HIT_TYPE_VEHICLE)
	{
		if(random(100) < 70)
        {
			if(!IsValidVehicle(hitid)) return 0;
			if(weaponid == 23  && (cop_player(playerid) || fbi_player(playerid)) && veh_info[hitid -1][v_ems] != true)
			{
				new time = 5+random(10);
				SetTimerEx("un_ems_الوقتr", time, false, "i", hitid);
				veh_info[hitid -1][v_ems] = true;

				if(veh_info[hitid -1][v_driver] != INVALID_PLAYER_ID) SendInfo(veh_info[hitid -1][v_driver], "Motor az kar oftade baraye %d sanie.", time);
			}

			me_action(playerid, "Electro-magneti impulse ra rahaa العملd.");
		}
	}

	if(!IsPlayerInGunLicenseExam(playerid))
	{
		switch(weaponid)
		{
			case 23:
			{
				if(!(PlayerInfo[playerid][gun_skills][0] >= 100))
				{
					gun_skill_up{playerid}++;
					if(gun_skill_up{playerid} >= 12)
					{
						gun_skill_up{playerid} = 0;
						PlayerInfo[playerid][gun_skills][0] ++;

						new _query[96];
						format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SقتلS SD PISTOL ~n~ALL: ~g~ %i/100", PlayerInfo[playerid][gun_skills][0]);
						GameTextForPlayer(playerid, _query, 2000, 5);
						SetPlayerSkills(playerid);
					}
				}
			}
			case 24:
			{
				if(!(PlayerInfo[playerid][gun_skills][1] >= 100))
				{
					gun_skill_up{playerid}++;
					if(gun_skill_up{playerid} >= 12)
					{
						gun_skill_up{playerid} = 0;
						PlayerInfo[playerid][gun_skills][1] ++;

						new _query[96];
						format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SقتلS DEAGLE ~n~ALL: ~g~ %i/100", PlayerInfo[playerid][gun_skills][1]);
						GameTextForPlayer(playerid, _query, 2000, 5);
						SetPlayerSkills(playerid);
					}
				}
			}
			case 25:
			{
				if(!(PlayerInfo[playerid][gun_skills][2] >= 100))
				{
					gun_skill_up{playerid}++;
					if(gun_skill_up{playerid} >= 12)
					{
						gun_skill_up{playerid} = 0;
						PlayerInfo[playerid][gun_skills][2] ++;

						new _query[96];
						format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SقتلS SHOTGUN ~n~ALL: ~g~ %i/100", PlayerInfo[playerid][gun_skills][2]);
						GameTextForPlayer(playerid, _query, 2000, 5);
						SetPlayerSkills(playerid);
					}
				}
			}
			case 29:
			{
				if(!(PlayerInfo[playerid][gun_skills][3] >= 100))
				{	
					gun_skill_up{playerid}++;
					if(gun_skill_up{playerid} >= 23)
					{
						gun_skill_up{playerid} = 0;
						PlayerInfo[playerid][gun_skills][3] ++;

						new _query[96];
						format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SقتلS MP5 ~n~ALL: ~g~ %i/100", PlayerInfo[playerid][gun_skills][3]);
						GameTextForPlayer(playerid, _query, 2000, 5);
						SetPlayerSkills(playerid);
					}
				}
			}
			case 30:
			{
				if(!(PlayerInfo[playerid][gun_skills][4] >= 100))
				{
					gun_skill_up{playerid}++;
					if(gun_skill_up{playerid} >= 34)
					{
						gun_skill_up{playerid} = 0;
						PlayerInfo[playerid][gun_skills][4] ++;

						new _query[96];
						format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SقتلS AK47 ~n~ALL: ~g~ %i/100", PlayerInfo[playerid][gun_skills][4]);
						GameTextForPlayer(playerid, _query, 2000, 5);
						SetPlayerSkills(playerid);
					}
				}
			}
			case 31:
			{
				if(!(PlayerInfo[playerid][gun_skills][5] >= 100))
				{
					gun_skill_up{playerid}++;
					if(gun_skill_up{playerid} >= 34)
					{
						gun_skill_up{playerid} = 0;
						PlayerInfo[playerid][gun_skills][5] ++;

						new _query[96];
						format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SقتلS M4 ~n~ALL: ~g~ %i/100", PlayerInfo[playerid][gun_skills][5]);
						GameTextForPlayer(playerid, _query, 2000, 5);
						SetPlayerSkills(playerid);
					}
				}
			}
			case 33:
			{
				if(!(PlayerInfo[playerid][gun_skills][6] >= 100))
				{
					gun_skill_up{playerid}++;
					if(gun_skill_up{playerid} >= 20)
					{
						gun_skill_up{playerid} = 0;
						PlayerInfo[playerid][gun_skills][6] ++;

						new _query[96];
						format(_query, 72, "~n~~n~~n~~n~~g~+1 ~w~SقتلS RIFLE ~n~ALL: ~g~ %i/100", PlayerInfo[playerid][gun_skills][6]);
						GameTextForPlayer(playerid, _query, 2000, 5);
						SetPlayerSkills(playerid);
					}
				}
			}
		}
	}

	p_t_info[playerid][p_gun_shots] ++;

    new slot = WEAPON_Slot[weaponid];
    if(PlayerInfo[playerid][Weapon][slot] == weaponid)
    {
        if(PlayerInfo[playerid][Ammo][slot] > 0) PlayerInfo[playerid][Ammo][slot]--;
    }

    //damage system:
    if(hittype == BULLET_HIT_TYPE_PLAYER || hittype == BULLET_HIT_TYPE_VEHICLE)
	{
		DamageSystem(playerid, weaponid, hitid, hittype, topldist);
		return 0;
	}

    return 1;
}

public OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat, Float:new_x, Float:new_y, Float:new_z, Float:vel_x, Float:vel_y, Float:vel_z)
{
	#if defined debug_mode
		printf("[DEخلل] [OnUلاccupiedالمركبةUpالتاريخ] المركبةid:%d | اللاعبid:%d | passenger_seat:%d", vehicleid, playerid, passenger_seat);
	#endif
	
	if(passenger_seat)
	{
		p_t_info[playerid][last_unoccup_tick] = GetTickCount();
		return 0;
	}

	veh_info[vehicleid -1][v_now_pos][0] = new_x;
    veh_info[vehicleid -1][v_now_pos][1] = new_y;
    veh_info[vehicleid -1][v_now_pos][2] = new_z;


    veh_info[vehicleid -1][v_velocity][0] = vel_x;
    veh_info[vehicleid -1][v_velocity][1] = vel_y;

	if(GetVehicleDistanceFromPoint(vehicleid,new_x, new_y, new_z) < 0.0) return 0;
	GetVehiclePos(vehicleid, new_x, new_y, new_z);
	if(!IsPlayerInRangeOfPoint(playerid, 10, new_x, new_y, new_z)) return 0;

	if(GetVehicleDistanceFromPoint(vehicleid, new_x, new_y, new_z)> 15.0)
	{
		new Float:pos_x, Float:pos_y, Float:pos_z;
		GetVehiclePos(vehicleid, pos_x, pos_y, pos_z);
		if(pos_z > -70.0) SetVehiclePos(vehicleid, pos_x, pos_y, pos_z);
		return 0;
 	}
	return 1;
}
public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
	if(p_t_info[playerid][p_dialog] != -1) return 1;

	// ----------------
	for(new i = 0; i < 15; i++)
    {
        if(playertextid == InventoryItems[playerid][i])
        {
            CheckPlayerInventoryColor(playerid);
            UpdatePlayerInventoryColor(playerid, InventoryItems[playerid][i], true);
            InventoryTextDrawUse[playerid] = i;
            InventoryTextDrawUseType[playerid] = 1;
        }
	}
	for(new i = 0; i < 15; i++)
	{
        if(playertextid == InventoryAccessories[playerid][i])
        {
            CheckPlayerInventoryColor(playerid);
            UpdatePlayerInventoryColor(playerid, InventoryAccessories[playerid][i], true);
            InventoryTextDrawUse[playerid] = i;
            InventoryTextDrawUseType[playerid] = 2;
        }
    }
	// ----------------

	if(playertextid == dice_ptd[playerid][18]) return show_dialog(playerid, d_dice_exit,DIALOG_STYLE_MSGBOX,""c_server"تحذير",""c_white"If لديك placed a bet and the game has already بدءed, your المال will ليس be returned.\n\n"c_grey"* هم you sure you want to مغادرة the table?", "خروج", "إلغاء");
	else if(playertextid == Passport_PTD[playerid][25])
	{
		for(new i = 0; i < 39; i++)
		{
		    PlayerTextDrawDestroy(playerid, Passport_PTD[playerid][i]);
		    Passport_PTD[playerid][i] = PlayerText:-1;
		    
			if(i < 6) TextDrawHideForPlayer(playerid, Passport_TD[i]);
		}
		CancelSelectTextDraw(playerid);
		
		DeletePVar(playerid, "show_pass");
	}
	else if(playertextid == dice_ptd[playerid][14])
	{
		if(GetPVarInt(playerid,"Krupje"))
		{
			new null = 0;
			for(new i; i < 5; i++) if(GetPVarInt(dice_info[GetPVarInt(playerid,"Stol")-1][b_player][i],"InGame")) null++;
			if(null > 0) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"لا يمكنك Change your bid at thهو الوقت.");
			return show_dialog(playerid,d_dice_bet,1,""c_server"Setting the bet for the game",""c_white"أدخل the المبلغ to bet\n\n"c_grey"* The bet must be لا less than $1,000 and لا more than $30,000,000","التالي","إلغاء");
		}
		if(!dice_info[GetPVarInt(playerid,"Stol")-1][b_bet]) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"The rate has ليس been set.");
		if(GetPVarInt(playerid,"InGame")) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"You've already placed your bet.");
		if(PlayerInfo[playerid][money] < dice_info[GetPVarInt(playerid,"Stol")-1][b_bet]) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"Insufficient funds.");
		if(dice_info[GetPVarInt(playerid,"Stol")-1][b_started] > 0) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"The game has already بدءed.");
		give_money(playerid,-dice_info[GetPVarInt(playerid,"Stol")-1][b_bet]);
		insert_money_log(playerid, INVALID_PLAYER_ID, -dice_info[GetPVarInt(playerid,"Stol")-1][b_bet], "dice bet");

		dice_info[GetPVarInt(playerid,"Stol")-1][b_bank] += dice_info[GetPVarInt(playerid,"Stol")-1][b_bet];
		SetPVarInt(playerid,"InGame",1);
		UpdateBone(GetPVarInt(playerid,"Stol")-1);
	}
	else if(playertextid == dice_ptd[playerid][15])
	{
		if(GetPVarInt(playerid,"Krupje"))
		{
			new null = 0;
			for(new i; i < 5; i++) if(GetPVarInt(dice_info[GetPVarInt(playerid,"Stol")-1][b_player][i],"InGame")) null++;
			if(null < 2) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"غير كافٍ اللاعبون to بدء.");
			if(dice_info[GetPVarInt(playerid,"Stol")-1][b_started] > 0) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"The game has already بدءed.");
			return dice_info[GetPVarInt(playerid,"Stol")-1][b_started] = 30;
		}
		else
		{
			if(!GetPVarInt(playerid,"InGame")) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"لديك ليس placed a bet.");
			if(dice_info[GetPVarInt(playerid,"Stol")-1][b_started] <= 0) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"You can't roll the dice at thهو الوقت.");
			if(GetPVarInt(playerid,"InGame") > 1) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"لديك already rolled the dice thهو round.");
			new null = 0;
			SetPVarInt(playerid,"InGame",random(11) + 2);
			UpdateBone(GetPVarInt(playerid,"Stol")-1);
			foreach(new i:logged_players)
			{
				if(GetPVarInt(i,"Stol") == GetPVarInt(playerid,"Stol") && GetPVarInt(i,"InGame") == 1) null++;
			}
			if(!null) dice_info[GetPVarInt(playerid,"Stol")-1][b_started] = 4;
		}
	}

	if(GetPVarInt(playerid, "cm_used"))
	{
		if(playertextid == cm_ptd[playerid][53])
		{
			show_dialog(playerid,d_camikaze_exit,DIALOG_STYLE_MSGBOX,""c_server"تحذير",""c_white"If لديك placed a bet and the game has already بدءed, your المال will ليس be returned\n\n"c_grey"* To إيقاف the game, click the إيقاف odds button\n"c_grey"* Do you really want to مغادرة the game?", "خروج", "إلغاء");
			return 1;
		}
		else if(playertextid == cm_ptd[playerid][37])
		{
			if(roulette_number[playerid] != 1) return SendError(playerid, "You can't إيقاف at thهو coefficient, أنت at a diffeاستئجار stage.");
			SetPVarInt(playerid, "cm_step", 1);
			show_dialog(playerid, d_camikaze_cfexit, DIALOG_STYLE_MSGBOX, ""c_server"اللعبة إيقاف", ""c_white"Your winnings will be calculated from thهو odds\n\n"c_grey"* Do you really want to مغادرة the game?", "خروج", "إلغاء");
			return 1;
		}
		else if(playertextid == cm_ptd[playerid][39])
		{
			if(roulette_number[playerid] != 2) return SendError(playerid, "You can't إيقاف at thهو coefficient, أنت at a diffeاستئجار stage.");
			SetPVarInt(playerid, "cm_step", 2);
			show_dialog(playerid, d_camikaze_cfexit, DIALOG_STYLE_MSGBOX, ""c_server"اللعبة إيقاف", ""c_white"Your winnings will be calculated from thهو odds\n\n"c_grey"* Do you really want to مغادرة the game?", "خروج", "إلغاء");
			return 1;
		}
		else if(playertextid == cm_ptd[playerid][41])
		{
			if(roulette_number[playerid] != 3) return SendError(playerid, "You can't إيقاف at thهو coefficient, أنت at a diffeاستئجار stage.");
			SetPVarInt(playerid, "cm_step", 3);
			show_dialog(playerid, d_camikaze_cfexit, DIALOG_STYLE_MSGBOX, ""c_server"اللعبة إيقاف", ""c_white"Your winnings will be calculated from thهو odds\n\n"c_grey"* Do you really want to مغادرة the game?", "خروج", "إلغاء");
			return 1;
		}
		else if(playertextid == cm_ptd[playerid][43])
		{
			if(roulette_number[playerid] != 4) return SendError(playerid, "You can't إيقاف at thهو coefficient, أنت at a diffeاستئجار stage.");
			SetPVarInt(playerid, "cm_step", 4);
			show_dialog(playerid, d_camikaze_cfexit, DIALOG_STYLE_MSGBOX, ""c_server"اللعبة إيقاف", ""c_white"Your winnings will be calculated from thهو odds\n\n"c_grey"* Do you really want to مغادرة the game?", "خروج", "إلغاء");
			return 1;
		}
		else if(playertextid == cm_ptd[playerid][45])
		{
			if(roulette_number[playerid] != 5) return SendError(playerid, "You can't إيقاف at thهو coefficient, أنت at a diffeاستئجار stage.");
			SetPVarInt(playerid, "cm_step", 5);
			show_dialog(playerid, d_camikaze_cfexit, DIALOG_STYLE_MSGBOX, ""c_server"اللعبة إيقاف", ""c_white"Your winnings will be calculated from thهو odds\n\n"c_grey"* Do you really want to مغادرة the game?", "خروج", "إلغاء");
			return 1;
		}
		else if(playertextid == cm_ptd[playerid][47])
		{
			if(roulette_number[playerid] != 6) return SendError(playerid, "You can't إيقاف at thهو coefficient, أنت at a diffeاستئجار stage.");
			SetPVarInt(playerid, "cm_step", 6);
			show_dialog(playerid, d_camikaze_cfexit, DIALOG_STYLE_MSGBOX, ""c_server"اللعبة إيقاف", ""c_white"Your winnings will be calculated from thهو odds\n\n"c_grey"* Do you really want to مغادرة the game?", "خروج", "إلغاء");
			return 1;
		}
		else if(playertextid == cm_ptd[playerid][49])
		{
			if(roulette_number[playerid] != 7) return SendError(playerid, "You can't إيقاف at thهو coefficient, أنت at a diffeاستئجار stage.");
			SetPVarInt(playerid, "cm_step", 7);
			show_dialog(playerid, d_camikaze_cfexit, DIALOG_STYLE_MSGBOX, ""c_server"اللعبة إيقاف", ""c_white"Your winnings will be calculated from thهو odds\n\n"c_grey"* Do you really want to مغادرة the game?", "خروج", "إلغاء");
			return 1;
		}
		else if(playertextid == cm_ptd[playerid][55])
		{
			show_dialog(playerid, d_cm_bet, 1, ""c_server"إلغاء", ""c_white"أدخل the المبلغ you wهوh to bet\n\n"c_grey"* The bet must be لا less than $1,000 and لا more than $50,000.", "قبول", "إلغاء");
			return 1;
		}

		for(new j = 2; j < 37; j ++)
		{
			if(playertextid == cm_ptd[playerid][j])
			{
				if(roulette_bet[playerid] == 0) return  SendError(playerid, "First تحتاج إلى to place a bet.");
				if(j >((roulette_number[playerid] + 1)* 5)+ 1 || j <((roulette_number[playerid] + 1)* 5)-3) return SendError(playerid, "Thهو slot هو ليس متاح, يرجى use aليسher one.");

				new useless_point = random(5);
				new td_cell =((roulette_number[playerid] + 1)* 5)-5 + useless_point;

				if(random(5) ==  3)
				{
					cm_ptd[playerid][57 + roulette_number[playerid]] = CreatePlayerTextDraw(playerid, cm_td_pos[j -2][0], cm_td_pos[j -2][1], "LD_SPAC:white");
					PlayerTextDrawFont(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 5);
					PlayerTextDrawLetterSize(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0.500000, 1.000000);
					PlayerTextDrawColor(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], -1);
					PlayerTextDrawSetOutline(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0);
					PlayerTextDrawSetProportional(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 1);
					PlayerTextDrawSetShadow(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 1);
					PlayerTextDrawTextSize(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 30.000000, 30.000000);
					PlayerTextDrawSetPreviewModel(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 1654);
					PlayerTextDrawSetPreviewRot(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0.000000, 0.000000, 90.000000, 1.000000);
					PlayerTextDrawSetSelectable(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0);
					PlayerTextDrawBackgroundColor(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0);


					PlayerTextDrawBackgroundColor(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], -16776961);
					PlayerTextDrawShow(playerid, cm_ptd[playerid][57 + roulette_number[playerid]]);
					roulette_number[playerid] = 0;
					roulette_bet[playerid] = 0;
					SendError(playerid, "You lost the kamikaze game, place a جديد bet and try again.");

					SetTimerEx("kamikaze_reset", 1500, false, "d", playerid);

				}
				else if(useless_point != j -((roulette_number[playerid] + 1)* 5)+ 2 + 1)
				{
					cm_ptd[playerid][57 + roulette_number[playerid]] = CreatePlayerTextDraw(playerid, cm_td_pos[td_cell][0], cm_td_pos[td_cell][1], "LD_SPAC:white");
					PlayerTextDrawFont(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 5);
					PlayerTextDrawLetterSize(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0.500000, 1.000000);
					PlayerTextDrawColor(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], -1);
					PlayerTextDrawSetOutline(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0);
					PlayerTextDrawSetProportional(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 1);
					PlayerTextDrawSetShadow(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 1);
					PlayerTextDrawTextSize(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 30.000000, 30.000000);
					PlayerTextDrawSetPreviewModel(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 1654);
					PlayerTextDrawSetPreviewRot(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0.000000, 0.000000, 90.000000, 1.000000);
					PlayerTextDrawSetSelectable(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0);
					PlayerTextDrawBackgroundColor(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0);

					PlayerTextDrawShow(playerid, cm_ptd[playerid][57 + roulette_number[playerid]]);
					if(roulette_number[playerid] != 6)
					{
						roulette_number[playerid] ++;
					}
					else
					{
						new win_count = floatround(roulette_bet[playerid]* 4.5);

						roulette_number[playerid] = 0;
						roulette_bet[playerid] = 0;

						give_money(playerid, win_count);
						insert_money_log(playerid, INVALID_PLAYER_ID, win_count, "Kamikaze فوز");

						new scm_string[98];
						format(scm_string, sizeof(scm_string), ""c_green"* "c_white"لقد نجحت في مكتمل the اللعبة and took home the فوزnings of "c_green"$%d", win_count);
						SendClientMessage(playerid, col_white, scm_string);

						cm_status(playerid, false);
						return 1;
					}
				}
				else
				{
					cm_ptd[playerid][57 + roulette_number[playerid]] = CreatePlayerTextDraw(playerid, cm_td_pos[td_cell][0], cm_td_pos[td_cell][1], "LD_SPAC:white");
					PlayerTextDrawFont(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 5);
					PlayerTextDrawLetterSize(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0.500000, 1.000000);
					PlayerTextDrawColor(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], -1);
					PlayerTextDrawSetOutline(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0);
					PlayerTextDrawSetProportional(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 1);
					PlayerTextDrawSetShadow(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 1);
					PlayerTextDrawTextSize(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 30.000000, 30.000000);
					PlayerTextDrawSetPreviewModel(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 1654);
					PlayerTextDrawSetPreviewRot(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0.000000, 0.000000, 90.000000, 1.000000);
					PlayerTextDrawSetSelectable(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0);
					PlayerTextDrawBackgroundColor(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], 0);
					PlayerTextDrawBackgroundColor(playerid, cm_ptd[playerid][57 + roulette_number[playerid]], -16776961);
					PlayerTextDrawShow(playerid, cm_ptd[playerid][57 + roulette_number[playerid]]);
					roulette_number[playerid] = 0;
					roulette_bet[playerid] = 0;
					SendError(playerid, "You lost the kamikaze game, place a جديد bet and try again.");

					SetTimerEx("kamikaze_reset", 1500, false, "d", playerid);
				}
			}
		}
	}
	if(playertextid == ptd_policecam[playerid][25]) // Selecting a camera in PD (Tracking by state) (Back)
	{
		new camid = GetPVarInt(playerid, "الشرطة_camid");
		if(camid == 0)camid = 11;
		else camid--;
		return show_cams(playerid, camid);
	}
	else if(playertextid == ptd_policecam[playerid][26]) // (Forward)
	{
		new camid = GetPVarInt(playerid, "الشرطة_camid");
		if(camid == 11)camid = 0;
		else camid++;
		return show_cams(playerid, camid);
	}
	else if(playertextid == ptd_policecam[playerid][20])
	{
		pdcam_status(playerid, false);
		CancelSelectTextDraw(playerid);
		return 1;
	}
	return 1;
}

public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
	if(p_t_info[playerid][p_dialog] != -1) return 1;

    if(clickedid == InventoryButton[0]) // Use;
	{
	    if(InventoryTextDrawUse[playerid] == -1 || InventoryTextDrawUseType[playerid] == -1) return SendMes(playerid, -1, "لديكn't chosen anything.");
	    new idx = InventoryTextDrawUse[playerid], type = InventoryTextDrawUseType[playerid];
	    if(type == 1) UsePlayerInventoryItems(playerid, InventoryTextDrawItems[playerid][idx]);
	    else UsePlayerAccessories(playerid, InventoryTextDrawAccessories[playerid][idx]);
	    CheckPlayerInventoryColor(playerid);
	    HidePlayerInventoryTextDraw(playerid);
	}
	else if(clickedid == InventoryButton[1]) // Info;
	{
	    if(InventoryTextDrawUse[playerid] == -1 || InventoryTextDrawUseType[playerid] == -1) return SendMes(playerid, -1, "لديكn't chosen anything.");
	    new idx = InventoryTextDrawUse[playerid], type = InventoryTextDrawUseType[playerid];
	    if(type == 1) ShowPlayerInventoryInfo(playerid, InventoryTextDrawItems[playerid][idx]);
	    else ShowPlayerAccessoriesInfo(playerid, InventoryTextDrawAccessories[playerid][idx]);
	}
	else if(clickedid == InventoryButton[2]) // Sell;
	{
	    if(InventoryTextDrawUse[playerid] == -1 || InventoryTextDrawUseType[playerid] == -1) return SendMes(playerid, -1, "لديكn't chosen anything.");
	    new idx = InventoryTextDrawUse[playerid], type = InventoryTextDrawUseType[playerid];
	    if(type == 1) SellPlayerInventoryItems(playerid, InventoryTextDrawItems[playerid][idx]);
	    else SellPlayerAccessories(playerid, InventoryTextDrawAccessories[playerid][idx]);
	}
	else if(clickedid == InventoryButton[3]) // Drop;
	{
	    if(InventoryTextDrawUse[playerid] == -1 || InventoryTextDrawUseType[playerid] == -1) return SendMes(playerid, -1, "لديكn't chosen anything.");
	    new idx = InventoryTextDrawUse[playerid], type = InventoryTextDrawUseType[playerid];
	    if(type == 1) DropPlayerInventoryItems(playerid, InventoryTextDrawItems[playerid][idx]);
	    else DropPlayerAccessories(playerid, InventoryTextDrawAccessories[playerid][idx]);
	}
	else if(clickedid == InventoryButton[4]) // Clothes;
	{
	    show_clothes(playerid);

	    return 1;
	}
	else if(clickedid == InventoryButton[5]) // Exit;
	{
	    CheckPlayerInventoryColor(playerid);
	    HidePlayerInventoryTextDraw(playerid);
	}
	else if(clickedid == InventoryButton[6]) // Accessories (Back);
	{
	    if(InventoryTextDrawList[playerid][1] == 0) return  SendMes(playerid, -1, "أنت on the first page of accessories.");
	    if(InventoryTextDrawAccessoriesCnt[playerid][InventoryTextDrawList[playerid][1] - 1] < 0) return SendMes(playerid, -1, "خطأ when dهوplaying العناصر, يرجى report to the technical section.");
	    InventoryTextDrawList[playerid][1]--;
	    LoadPlayerAccessoriesList(playerid, InventoryTextDrawAccessoriesCnt[playerid][InventoryTextDrawList[playerid][1]], 1);
	    new str[24];
	    format(str, sizeof(str), "%d/%d", InventoryTextDrawList[playerid][1] + 1, MAX_ACCESSORIES_LIST + 1);
	    PlayerTextDrawSetString(playerid, InventoryInfo[playerid][1], str);
	}
	else if(clickedid == InventoryButton[7]) // Accessories (Next);
	{
	    if(InventoryTextDrawList[playerid][1] == MAX_ACCESSORIES_LIST) return SendMes(playerid, -1, "أنت on the last page of accessories.");
	    if(InventoryTextDrawAccessories[playerid][14] == -1) return SendMes(playerid, -1, "The page still has slots for dهوplaying العناصر.");
	    if(InventoryTextDrawAccessories[playerid][14] + 1 >= MAX_PLAYER_ACCESSORIES) return SendMes(playerid, -1, "خطأ when dهوplaying العناصر, يرجى report to the technical section.");
	    InventoryTextDrawAccessoriesCnt[playerid][InventoryTextDrawList[playerid][1]] = InventoryTextDrawAccessories[playerid][0];
	    InventoryTextDrawList[playerid][1]++;
	    LoadPlayerAccessoriesList(playerid, InventoryTextDrawAccessories[playerid][14] + 1, 1);
	    new str[24];
	    format(str, sizeof(str), "%d/%d", InventoryTextDrawList[playerid][1] + 1, MAX_ACCESSORIES_LIST + 1);
	    PlayerTextDrawSetString(playerid, InventoryInfo[playerid][1], str);
	}
	else if(clickedid == InventoryButton[8]) // Items (Next);
	{
	    if(InventoryTextDrawList[playerid][0] == MAX_ACCESSORIES_LIST) return SendMes(playerid, -1, "أنت on the last العنصر page.");
	    if(InventoryTextDrawItems[playerid][14] == -1) return SendMes(playerid, -1, "The page still has slots for dهوplaying العناصر.");
	    if(InventoryTextDrawItems[playerid][14] + 1 >= MAX_INVENTORY) return SendMes(playerid, -1, "خطأ when dهوplaying العناصر, يرجى report to the technical section.");
	    InventoryTextDrawItemsCnt[playerid][InventoryTextDrawList[playerid][0]] = InventoryTextDrawItems[playerid][0];
