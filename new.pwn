UpdatePlayerSettings(playerid) {
	new query_string[150];
	format(query_string, sizeof(query_string), "UPالتاريخ `users` SET `u_الإعدادات`='%d|%d|%d|%d|%d|%d|%d|%d',`u_load_textures`='%d' WHERE `u_id`='%d' LIMIT 1",
		PlayerInfo[playerid][settings][0],
		PlayerInfo[playerid][settings][1],
		PlayerInfo[playerid][settings][2],
		PlayerInfo[playerid][settings][3],
		PlayerInfo[playerid][settings][PACIFIST_MODE],
		PlayerInfo[playerid][settings][SPEEDOMETER_TYPE],
		PlayerInfo[playerid][settings][CASH_BERIFCASE_HAND],
		PlayerInfo[playerid][settings][AUTO_LOGIN],

		PlayerInfo[playerid][load_textures],
		PlayerInfo[playerid][id]);
	mysql_tquery(sql_connection, query_string);
}

