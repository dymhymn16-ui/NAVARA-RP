					if(!family_info[family_id][fam_vip]) return show_dialog(playerid, d_family_buy_vip, DIALOG_STYLE_MSGBOX, c_gold"[VIP]"c_white" العائلة","\
					"c_grey"-"c_white"VIP-Family be family emkanat zir ra mide:\n\n\
					"c_grey"-"c_white"Sherkat dar rob haye family\n\
