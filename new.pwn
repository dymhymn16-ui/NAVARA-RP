	format(dialog_string, sizeof(dialog_string ), ""c_server"%s "c_white"enables you to شراء "c_server" سلاح رخصة "c_white" for "c_server"$%d\n\n"c_grey"* رخصة for أسلحة will allow you to شراء أسلحة in the الدولة's ammunition.",
	PlayerInfo[playerid][name], params[1]);
