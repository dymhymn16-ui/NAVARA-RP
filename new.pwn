				case 2: show_dialog(playerid, d_phone_menu, DIALOG_STYLE_INPUT, ""c_server"إرسال رسالة إلى رقم", ""c_white"أدخل رقم الهاتف الذي تريد إرسال الرسالة إليه:", "التالي", "Bargasht");
