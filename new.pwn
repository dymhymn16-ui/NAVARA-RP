		case d_h_improvement:
		{
			if(!response) return show_hmenu(playerid);
			new house_id = PlayerInfo[playerid][house];
			if(h_info[house_id][h_improve][listitem])
			{
				SendClientMessage(playerid, col_gray,""scm_error"Shoma in bebood ra ghablan nasb kardeid.");
				show_hmenu(playerid);
				return 1;
			}
			else if((!listitem && !h_info[house_id][h_improve][listitem]) || (h_info[house_id][h_improve][listitem-1] && !h_info[house_id][h_improve][listitem]))
			{
				new mes[250];
				format(mes, sizeof(mes),""c_white"Aya mikhahid in bebood ra شراءari konid? "c_server"\"%s\"?\n\n"c_white"Hazine nasb in behbod "c_green"$%s.",h_improve_name[listitem], convert_money(h_improve_price[listitem]));
				show_dialog(playerid, d_h_improvement_accept, DIALOG_STYLE_MSGBOX,""c_server"Behbod Khane", mes,"Kharid","Bargasht");
				SetPVarInt(playerid,"improveid", listitem);
			}
			else
			{
				SendError(playerid, "In bebood hamin zoodi barayetan mojud nemهوhavad.");
				show_hmenu(playerid);
			}
		}
		case d_h_improvement_accept:
		{
            if(!response) return pc_cmd_home(playerid);

            new improveid = GetPVarInt(playerid, !"improveid");
            DeletePVar(playerid, !"improveid");

            new price = h_improve_price[improveid];
            if(PlayerInfo[playerid][money] < price)
            {
                pc_cmd_home(playerid);
                return SendError(playerid, "Shoma pol kafi nadarid.");
            }
            new house_id = PlayerInfo[playerid][house];

			new hintid =  h_info[house_id][h_int] -1;
			switch(improveid)
			{
				case improve_safe: CreateDynamic3DTextLabel("خروج\n"c_grey"Dokme "c_white"[Y]"c_grey" Ra Feshar Dahid", col_server, house_safe_pos[hintid][0], house_safe_pos[hintid][1], house_safe_pos[hintid][2], 3.5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info[house_id][h_id], 2);
				case improve_freeze: CreateDynamic3DTextLabel("Cooler\n"c_grey"Dokme "c_white"[Y]"c_grey" Ra Feshar Dahid", col_server, house_freeze_pos[hintid][0], house_freeze_pos[hintid][1], house_freeze_pos[hintid][2], 3.5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_info[house_id][h_id], 2);
			}

			h_info[house_id][h_improve][improveid] = 1;

			new data[32];
			for(new i; i < 8; i++)
			{
				if(!i) format(data, sizeof(data), "%d", h_info[house_id][h_improve][i]);
				else format(data, sizeof(data), "%s|%d", data, h_info[house_id][h_improve][i]);
			}
			new query_string[90];
			format(query_string, sizeof(query_string), "UPالتاريخ `المنزلs` SET `h_improve`='%s' WHERE `h_id`='%d'", data, getPlayerHouseID(playerid));
			mysql_query(sql_connection, query_string);

			give_money(playerid, -price);
			insert_money_log(playerid, INVALID_PLAYER_ID, -price, "hoاستخدام improvement");

            new _text_string[144];
            format(_text_string, sizeof(_text_string), ""scm_info"أنت ba movafaghiyat النظام "c_gold"%s"c_white" be mablagh "c_green"$%s"c_white" nasb العملdid.", h_improve_name[improveid], convert_money(h_improve_price[improveid]));
            SendClientMessage(playerid, col_white, _text_string);

			if(improveid == improve_safe)
			{
                h_info[house_id][h_safe_code] = 0;

                format(query_string, sizeof(query_string), "UPالتاريخ `المنزلs` SET `h_safe_code`='0000' WHERE `h_id`='%d' LIMIT 1",h_info[house_id][h_id]);
                mysql_tquery(sql_connection, query_string);

                SendInfo(playerid, "Code-e amniyat-e pهوhfarz: "c_gold"0000");
			}

			slobal_string[0] = EOS;
			for(new i; i < 8; i++)
			{
				new line_string[105];
				format(line_string, sizeof(line_string), "%s | %s\n", h_improve_name[i], h_info[house_id][h_improve][i] ? (""c_green"Nasb Shode") : (""c_orange_red"Nasb لم يتم"));
				strcat(slobal_string, line_string);
			}
			show_dialog(playerid, d_h_improvement, DIALOG_STYLE_LIST, !""scm_dialog"Behbod Khane", slobal_string, !"Entekhab", !"Bargasht");
		}
		case d_safe_pin:
		{
			if(!response) return 1;

			if(p_t_info[playerid][house] != -1)
			{
				new house_id = p_t_info[playerid][house];
				if(strval(inputtext) != h_info[house_id][h_safe_code]) 
					return SendError(playerid, "Shoma code-e ghalat-e gavsandoogh ra vهمd kardid.");

				new line_string[68],
					gun_name[32];

				global_string[0] = EOS;
				format(global_string, 368,""c_white"مخدرات["c_green"%d grams"c_white"]\n\
										Money["c_green"$%s"c_white"]\n\n\
										{cccc99}Weapons:"c_white"\n\n", h_المعلومات[المنزل_id][h_safe_data][0], convert_المال(h_المعلومات[المنزل_id][h_safe_data][1]));

