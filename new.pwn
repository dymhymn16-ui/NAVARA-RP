						strcat(global_string, line_string);
					}
				}
				show_dialog(playerid, d_ss_clothes, DIALOG_STYLE_LIST, ""scm_dialog"Forushgah Lebas", global_string, "Entekhab", "Bargasht");
				return 1;
			}

			if(PlayerInfo[playerid][money] < shop_skins_price[PlayerInfo[playerid][gender]][GetPVarInt(playerid, "skin_اختر_number")]) return SendClientMessage(playerid, col_gray, "shoma pol kafi nadarid for purchasing clothes.");
			give_money(playerid, -shop_skins_price[PlayerInfo[playerid][gender]][GetPVarInt(playerid, "skin_اختر_number")]);
			insert_money_log(playerid, INVALID_PLAYER_ID, -shop_skins_price[PlayerInfo[playerid][gender]][GetPVarInt(playerid, "skin_اختر_number")], "شراء skin");

			if(quest_status[playerid][7] == 1)
			{
				quest_status[playerid][7] = 2;
				SendClientMessage(playerid, col_succes, "Exercهوe مكتمل تمت العملية بنجاحfully. Go to one of the assهوtants to receive your المكافأة.");
				update_quest_data(playerid);
			}
			set_skin(playerid, shop_skins[PlayerInfo[playerid][gender]][GetPVarInt(playerid, "skin_اختر_number")]);
			PlayerInfo[playerid][temp_skin][listitem -1] = shop_skins[PlayerInfo[playerid][gender]][GetPVarInt(playerid, "skin_اختر_number")];

			new _query[126];
			format(_query, sizeof(_query), "UPالتاريخ `users` SET `u_tempskin`='%d|%d|%d|%d|%d' WHERE `u_الاسم` = '%s'",
			PlayerInfo[playerid][temp_skin][0], PlayerInfo[playerid][temp_skin][1], PlayerInfo[playerid][temp_skin][2],
			PlayerInfo[playerid][temp_skin][3], PlayerInfo[playerid][temp_skin][4], PlayerInfo[playerid][name]);
			mysql_tquery(sql_connection, _query);


			new b = p_t_info[playerid][business] -1;
			TogglePlayerControllable(playerid, true);
			SetCameraBehindPlayer(playerid);
			set_world(playerid, b_info[b][b_id] + 1000);
			b_info[b][b_money] += floatround(shop_skins_price[PlayerInfo[playerid][gender]][GetPVarInt(playerid, "skin_اختر_number")]* 0.22);
			b_info[b][b_product] -= 75;
			b_info[b][b_cash_today] += floatround(shop_skins_price[PlayerInfo[playerid][gender]][GetPVarInt(playerid, "skin_اختر_number")]* 0.22);

			for(new i = 0; i < 19; i ++)
			{
				TextDrawHideForPlayer(playerid, td_skinshop[i]);
			}
			CancelSelectTextDraw(playerid);
			PlayerTextDrawDestroy(playerid, td_skinshop_price[playerid]);
			td_skinshop_price[playerid] = PlayerText:-1;
			DeletePVar(playerid, "skin_اختر_number");
			DeletePVar(playerid, "p_skin_المتجر");
		}

		case d_fixcar:
		{
			if(!response) return 1;
			
			if(PlayerInfo[playerid][money] < 3000) return SendError(playerid, "Shoma Pool Kafi Nadarid.");
			
			if(listitem == 0)
			{
				new line_str[78];

				format(global_string, sizeof(global_string), ""c_server"اختيار a النقل for toفوزg:\t\n");
				foreach(new veh_id:player_vehicles[playerid])
				{
					format(line_str, 78, ""c_grey"-"c_white"%s\t"c_grey"%s\n", vehicle_name[GetVehicleModel(veh_id)-400], veh_info[veh_id -1][v_plate]);
					strcat(global_string, line_str);
				}
				show_dialog(playerid, d_fixcar, DIALOG_STYLE_TABLIST, ""c_server"Tow السيارة", global_string, "Entekhab", "Bastan");
				return 1;
			}

			new _step = 1,
				carid;

			foreach(new _v_id:player_vehicles[playerid])
			{
				if(_step == listitem)
				{
					carid = _v_id;
				}
				_step ++;
			}

			foreach(new i: logged_players)
			{
				if(IsPlayerInVehicle(i, carid))
				{
					return SendError(playerid, "In vasile naghlie darhal estefade ast.");
				}

				if(is_player_in_boat[i] == carid) return SendError(playerid, "Shoma nemitavanid yek yacht ra ba khod ya digaran dar dakhele an bokeshid.");
				if(is_player_in_journey[i] == carid) return SendError(playerid, "Shoma nemitavanid yek journey ra ba khod ya digaran dar dakhele an bokeshid.");

			}

			new Float:x, Float:y, Float:z;
			GetPlayerPos(playerid, x, y, z);

			UpdateDynamic3DTextLabelText(veh_info[carid -1][v_label_plate], col_gray, veh_info[carid -1][v_plate]);

			SetVehiclePos(carid, x+1.5, y+1.5, z+1.0);
			SetVehicleVirtualWorld(carid, GetPlayerVirtualWorld(playerid));
			LinkVehicleToInterior(carid, GetPlayerInterior(playerid));
			PutPlayerInVehicle(playerid, carid, 0);

			give_money(playerid, -3000);
			insert_money_log(playerid, INVALID_PLAYER_ID, -3000, "/fixالسيارة");

			SendClientMessage(playerid, col_gray, ""scm_sucess"Vasile naghlie movafghiat الظهور shod.");
		}
		case d_sellcar:
		{
			new targetid = GetPVarInt(playerid, "sc_بيعer") -1;
			if(!response)
			{
				DeletePVar(targetid, "sc_شراءer");
				DeletePVar(targetid, "sc_السعر");
				DeletePVar(playerid, "sc_بيعer");
				DeletePVar(playerid, "sc_بيعveh");
				SendClientMessage(targetid, col_gray, "The اللاعب refused to شراء the المركبة.");
				return 1;
			}
			if(!IsPlayerConnected(targetid)|| p_t_info[targetid][p_logged] == false) return SendClientMessage(playerid, col_gray, "An خطأ occurred while بيعing the المركبة. Code: 19.");
			new veh_id = GetPVarInt(playerid, "sc_بيعveh");
			if(veh_info[veh_id -1][v_owner] != PlayerInfo[targetid][id] || veh_info[veh_id -1][v_type] != vehicle_type_player)
			{
				DeletePVar(targetid, "sc_شراءer");
				DeletePVar(targetid, "sc_السعر");
				DeletePVar(playerid, "sc_بيعer");
				DeletePVar(playerid, "sc_بيعveh");
				return SendClientMessage(playerid, col_gray, "The المركبة لا longer belongs to the اللاعب, an خطأ occurred.");
			}
			new _sell_price = GetPVarInt(targetid, "sc_السعر");
			if(PlayerInfo[playerid][money] < _sell_price)
			{
				DeletePVar(targetid, "sc_شراءer");
				DeletePVar(targetid, "sc_السعر");
				DeletePVar(playerid, "sc_بيعer");
				DeletePVar(playerid, "sc_بيعveh");
				SendClientMessage(targetid, col_gray, "The اللاعب does ليس have eلاugh funds to شراء transport.");
				return SendClientMessage(playerid, col_gray, "shoma pol kafi nadarid for purchasing transport.");
			}
			if(!IsPlayerInRangeOfPoint(playerid, 5.00, p_t_info[targetid][p_pos][0], p_t_info[targetid][p_pos][1], p_t_info[targetid][p_pos][2]) || p_t_info[playerid][p_data][1] != p_t_info[targetid][p_data][1])
			{
				DeletePVar(targetid, "sc_شراءer");
				DeletePVar(targetid, "sc_السعر");
				DeletePVar(playerid, "sc_بيعer");
				DeletePVar(playerid, "sc_بيعveh");
				SendClientMessage(targetid, col_gray, "أنت too far from the شراءer.");
				return SendClientMessage(playerid, col_gray, "أنت too far from the بيعer.");
			}
			if(!IsPlayerConnected(targetid)|| p_t_info[targetid][p_logged] == false)
			{
				DeletePVar(targetid, "sc_شراءer");
				DeletePVar(targetid, "sc_السعر");
				DeletePVar(playerid, "sc_بيعer");
				DeletePVar(playerid, "sc_بيعveh");
				return SendClientMessage(playerid, col_gray, "An خطأ occurred while بيعing the المركبة. Code: 19.");
			}
			if(get_player_veh_count(playerid)>= PlayerInfo[playerid][max_veh])
			{
				DeletePVar(targetid, "sc_شراءer");
				DeletePVar(targetid, "sc_السعر");
				DeletePVar(playerid, "sc_بيعer");
				DeletePVar(playerid, "sc_بيعveh");
				return SendError(playerid, "First, تحتاج إلى to بيع one of your exهوting المركبات.");
			}

			give_money(playerid,-_sell_price);
			give_money(targetid, _sell_price);
			insert_money_log(playerid, targetid, -_sell_price, "شراء of النقل");
			insert_money_log(targetid, playerid, _sell_price, "sale of النقل");

			SendClientMessage(playerid, col_succes, "Shoma Ba Movafghiat شراءd transport.");
		 	SendClientMessage(targetid, col_succes, "The المركبة كان تمت العملية بنجاحfully sقديم.");

			new query_string[168];
			format(query_string, sizeof(query_string), "UPالتاريخ `users_المركبات` SET `v_المالك`='%d' WHERE `v_id` = '%d'",PlayerInfo[playerid][id], veh_info[veh_id -1][v_id]);
			mysql_tquery(sql_connection, query_string);
			DeletePVar(targetid, "sc_شراءer");
			DeletePVar(targetid, "sc_السعر");
			DeletePVar(playerid, "sc_بيعer");
			DeletePVar(playerid, "sc_بيعveh");
			Iter_Remove(player_vehicles[targetid], veh_id);
			veh_info[veh_id -1][v_owner] = PlayerInfo[playerid][id];
			Iter_Add(player_vehicles[playerid], veh_id);
		}
		case d_sellcar_gov:
		{
