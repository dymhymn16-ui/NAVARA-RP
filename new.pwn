}

cmd:unmarried(playerid, params[])
{
	if(GetPlayerDistanceFromPoint(playerid, 1963.973, -369.672, 1093.728) > 20.0) return SendError(playerid, "Shoma bayad dar kelهوa bashid.");

	if(PlayerInfo[playerid][married_account_id] == -1) return SendError(playerid, "Shoma ezdevaj nakardid.");

	new query_string[64];

	format(query_string, sizeof(query_string), "اختر `u_الاسم` FROM `users` WHERE `u_id`=%d LIMIT 1", 
		PlayerInfo[playerid][married_account_id]);
	mysql_tquery(sql_connection, query_string, "اللاعبUnmarriedاتصالرجوع", "d", playerid);
	return 1;
}

callback: PlayerUnmarriedCallback(playerid) {
	if(!cache_num_rows()) {
		return 1;
	}
	cache_get_field_content(0, "u_الاسم", p_t_info[playerid][married_player_name], sql_connection, 24);

	new string[128];
	format(string, sizeof(string), ""c_white"Aya Mikhahid Az {C8154A}%s "c_white"Talagh Begirid?", p_t_info[playerid][married_player_name]);
	show_dialog(playerid, d_unmarried, DIALOG_STYLE_MSGBOX, ""c_server"Talagh Gerftan", string, "Bale", "Khyer");
	return 1;
}

