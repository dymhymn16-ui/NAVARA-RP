	}

	buyer_id[playerid] = params[0];
	sell_price[playerid] = params[2];
	sell_item[playerid] = params[1];
	seller_id[params[0]] = playerid;

	new dialog_string[136];
	format(dialog_string, sizeof(dialog_string), ""c_server"%s "c_white"offers you to شراء "c_server"%d "c_white"r. مخدرات for "c_server"$%d",
	PlayerInfo[playerid][name], params[1], params[2]);
	show_dialog(params[0], d_drugs_sell_accept, DIALOG_STYLE_MSGBOX, ""c_server"شراءing drugs", dialog_string, "Kharid", "إلغاء");
	return 1;
}

cmd:armpanel(playerid)
{
	if(army_player(playerid)) show_dialog(playerid, d_armpanel, DIALOG_STYLE_LIST, ""c_server"الأسلحة التوصيل", "المخزن الحالة\nجاري التحميل الأسلحة\nبدء التوصيل", "Entekhab", "Bastan");
	return 1;
