TaghibMojremTimer(playerid)
{
	new string[144];
	if(cop_player(playerid))
	{
		foreach(new i: logged_players) {
			if(i == playerid) continue;
			if(PlayerInfo[i][wanted] < 1) continue;
			
			if(GetDistanceBetweenPlayers(playerid, i) <= 20.0) 
			{
				if(!taghib_mojrem[playerid][i])
				{
					taghib_mojrem[playerid][i] = true;
					format(string, sizeof(string), "Taghib Mojrem %s Shoro Shod.", PlayerInfo[i][name]);
					SendClientMessage(playerid, col_server_green, string);
					SendClientMessage(i, col_server_green, "shoro be taghib to kardand. age az bazi beri biron mojazat mهوhi.");
				}
			} 
			else 
			{
				if(taghib_mojrem[playerid][i])
				{
					taghib_mojrem[playerid][i] = false;
					format(string, sizeof(string), "Taghib mojrem %s be دفعan resid.", PlayerInfo[i][name]);
					SendClientMessage(playerid, col_server_green, string);
				}
			}
		}
	}
}

TaghibMojremReset(playerid)
{
	foreach(new i: logged_players)
	{
		if(taghib_mojrem[playerid][i]) {
			taghib_mojrem[playerid][i] = false;
		}
		if(taghib_mojrem[i][playerid]) {
			taghib_mojrem[i][playerid] = false;
			if(PlayerInfo[playerid][wanted] >= 1)
			{
				PlayerInfo[playerid][jailed] = 30 * 60;
				PlayerInfo[playerid][jail] = 10;
				PlayerInfo[playerid][wanted] = 0;

				new scm_string[144];
				AdminMes(""c_server"* A.معلومات: "c_grey"%s[%d] moghe taghib az bazi khهمj shod (30 Min السجن).", PlayerInfo[playerid][name], playerid);

				format(
					scm_string,
					sizeof(scm_string),
					"UPالتاريخ `users` SET `u_السجن_السبب`='Khهمj Shodan Az Bazi Mogheye Taghib',`u_السجن`=%d,`u_مطلوب`=%d WHERE `u_id`='%d'", 
					PlayerInfo[playerid][jail], 
					PlayerInfo[playerid][wanted],
					PlayerInfo[playerid][id]);
				mysql_tquery(sql_connection, scm_string, "", "");
			}
		}
	}
}

callback: SellPlayerCarToGov(playerid, veh_id)
{
	new veh_model = GetVehicleModel(veh_id);
	new veh_price = GetModelPrice(veh_model);

	veh_price = veh_price -veh_price / 10;

	give_money(playerid, veh_price);
	insert_money_log(playerid, INVALID_PLAYER_ID, veh_price, "sale of النقل in the الدولة");


	new query_string[128];
 	format(query_string, 128, ""c_green"* "c_white" لقد نجحت في sقديم "c_green"%s"c_white" for "c_green"%d"c_white".", vehicle_name[veh_model -400], veh_price);
	SendClientMessage(playerid, col_white, query_string);

	format(query_string, sizeof(query_string), "حذف FROM `users_المركبات` WHERE `v_id` = '%d'", veh_info[veh_id -1][v_id]);
	mysql_tquery(sql_connection, query_string);

	DeletePVar(playerid, "sc_بيعveh");
	Iter_Remove(player_vehicles[playerid], veh_id);
	DestroyVehicle(veh_id);
}

stock AddConnect(playerid, type)
{
    for(new idx = (PANEL_LINE - 1); idx > 0; idx--)
    {
        connectTime[idx] = connectTime[idx - 1];
        connectText[idx] = connectText[idx - 1];
    }
    switch(type)
    {
        case 0: format(connectText[0], 112, "~g~~h~(connect) ~w~%s(%i)", PlayerInfo[playerid][name], playerid);
        case 1: format(connectText[0], 112, "~y~(dهوconnect) ~w~%s(%i)", PlayerInfo[playerid][name], playerid);
    }
    connectTime[0] = 30;
    for(new idx; idx < PANEL_LINE; idx++) TextDrawSetString(connectDraw[idx], connectText[idx]);
}

stock AddWarning(playerid, reason[], type = 0)
{
	new AStringF[200];

    switch(type)
    {
        case 0: format(AStringF, sizeof(AStringF), "~r~~h~~h~~h~(تحذير) ~w~%s(%i) السبب: %s", PlayerInfo[playerid][name], playerid, reason);
        case 1: format(AStringF, sizeof(AStringF), "~g~~h~(طرد) ~w~%s(%i) السبب: %s", PlayerInfo[playerid][name], playerid, reason);
    }
    for(new idx; idx < PANEL_LINE; idx++) if(!strcmp(warningText[idx], AStringF))
    {
        warningTime[idx] = 30;
        return;
    }
    for(new idx = (PANEL_LINE - 1); idx > 0; idx--)
    {
        warningTime[idx] = warningTime[idx - 1];
        warningText[idx] = warningText[idx - 1];
    }
    warningTime[0] = 30;
    format(warningText[0], 128, AStringF);
    for(new idx; idx < PANEL_LINE; idx++) TextDrawSetString(warningDraw[idx], warningText[idx]);
}

stock HideDamage(playerid) if(playerOldTargetID[playerid] != INVALID_PLAYER_ID)
{
    playerOldTargetID[playerid] = INVALID_PLAYER_ID;
    TextDrawHideForPlayer(playerid, DmgHealFon);
    PlayerTextDrawHide(playerid, DmgHealProgres[playerid][0]);
    PlayerTextDrawHide(playerid, DmgHealProgres[playerid][1]);
}

stock ShowDamage(playerid, hitid)
{
    PlayerPlaySound(playerid, 17802, 0.0, 0.0, 0.0);
    PlayerPlaySound(hitid, 17802, 0.0, 0.0, 0.0);
	
    playerTargetTime{playerid} = 5;

    if(playerOldTargetID[playerid] != hitid)
    {
        playerOldTargetID[playerid] = hitid;
        TextDrawShowForPlayer(playerid, DmgHealFon);
        PlayerTextDrawSetString(playerid, DmgHealProgres[playerid][1], PlayerInfo[hitid][name]);
    }
    if(p_t_info[hitid][p_armour] <= 0.0)
    {
        PlayerTextDrawColor(playerid, DmgHealProgres[playerid][1], -1);
        PlayerTextDrawBoxColor(playerid, DmgHealProgres[playerid][0], -16776961);
        if(p_t_info[hitid][p_health] > 100.0) PlayerTextDrawTextSize(playerid, DmgHealProgres[playerid][0], ((265.076629 - 5.0) + (100.0 / 100.0) * 109.862549), 0.0);
        else PlayerTextDrawTextSize(playerid, DmgHealProgres[playerid][0], ((265.076629 - 5.0) + (p_t_info[hitid][p_health] / 100.0) * 109.862549), 0.0);
    }
    else
    {
        PlayerTextDrawColor(playerid, DmgHealProgres[playerid][1], -2139062017);
        PlayerTextDrawBoxColor(playerid, DmgHealProgres[playerid][0], -1);
        if(p_t_info[hitid][p_armour] > 100.0) PlayerTextDrawTextSize(playerid, DmgHealProgres[playerid][0], ((265.076629 - 5.0) + (100.0 / 100.0) * 109.862549), 0.0);
        else PlayerTextDrawTextSize(playerid, DmgHealProgres[playerid][0], ((265.076629 - 5.0) + (p_t_info[hitid][p_armour] / 100.0) * 109.862549), 0.0);
    }
    PlayerTextDrawShow(playerid, DmgHealProgres[playerid][0]);
    PlayerTextDrawShow(playerid, DmgHealProgres[playerid][1]);
}

cmd:weapondata(playerid, params[])
{
	if(check_admin_rank(playerid , 1)) return 1;
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /سلاحdata [id]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");

	new pl_ammo, pl_gun, pl_slot = WEAPON_Slot[GetPlayerWeapon(params[0])];
	GetPlayerWeaponData(playerid, pl_slot, pl_gun, pl_ammo);

	new scm_string[128];
	format(scm_string, sizeof(scm_string ),""c_server"%s"c_white"["c_server"%d"c_white"] | REAL DATA:"c_server"%d %d"c_white" | السيرفر DATA:"c_server"%d %d", PlayerInfo[params[0]][name], params[0], pl_gun, pl_ammo, PlayerInfo[params[0]][Weapon][pl_slot], PlayerInfo[params[0]][Ammo][pl_slot]);
	SendClientMessage(playerid, col_white, scm_string);
	return 1;
}

// Change Player Name
//
// This function changes the player's nickname and updates all associated data across different systems,
// including the database, business ownership, house ownership, and sends notifications to the player 
// and the administrators. It also logs the name change in the nickname history and updates related labels.
//
// Parameters:
//    playerid - The ID of the player whose nickname is to be changed.
//    new_nickname[] - The new nickname to be set for the player.

stock ChangePlayerName(playerid, new_nickname[], nh_admin[])
{
    // If the player is an admin, update their name in the 'users_admins' table

	new logsCount = 0;

    new query[256];
    mysql_format(sql_connection, query, sizeof(query), "اختر * FROM `users_إداريs` WHERE `u_a_الاسم`='%s' LIMIT 1", PlayerInfo[playerid][name]);

    new Cache:result = mysql_query(sql_connection, query);

    logsCount = cache_num_rows();

    cache_delete(result);

	if(logsCount != 0)
        RunQuery("UPالتاريخ users_إداريs SET u_a_الاسم = '%s' WHERE u_a_الاسم = '%s' LIMIT 1", new_nickname, PlayerInfo[playerid][name]);

	if(logsCount == 0 && playerLeaderStatus(playerid))
	{
		format(f_info[PlayerInfo[playerid][member]][f_leader_name], MAX_PLAYER_NAME, "%s", new_nickname);

		RunQuery("UPالتاريخ `fractions` SET `f_القائد_الاسم`='%s' WHERE `f_id`='%d' LIMIT 1", new_nickname, getPlayerFactionID(playerid));
		
		UpdateGangDormLabel(PlayerInfo[playerid][member]);
	}

	new family_id = PlayerInfo[playerid][family];

	if(family_id != -1 && PlayerInfo[playerid][family_rang] >= family_info[family_id][fam_settings][3])
	{
		format(family_info[family_id][fam_creator], MAX_PLAYER_NAME, "%s", new_nickname);

		RunQuery("UPالتاريخ `العائلة` SET `fam_creator`='%s' WHERE `fam_id`='%d' LIMIT 1", new_nickname, getPlayerFamilyID(playerid));
	}

    // Update the player's name in the 'fractions_blacklist' table
    RunQuery("UPالتاريخ fractions_blackالقائمة SET bl_الاسم = '%s' WHERE bl_الاسم = '%s'", new_nickname, PlayerInfo[playerid][name]);

    // If the player owns a house, update the owner's name in the 'houses' table
    if(PlayerInfo[playerid][house] != -1)
    {
        format(h_info[PlayerInfo[playerid][house]][h_owner_name], MAX_PLAYER_NAME, "%s", new_nickname);
        RunQuery("UPالتاريخ المنزلs SET h_المالكالاسم = '%s' WHERE h_id = '%d' LIMIT 1", new_nickname, getPlayerHouseID(playerid));
    }

    // If the player owns a business, update the owner's name in the 'businesses' table
    if(PlayerInfo[playerid][business] != -1)
    {
        format(b_info[PlayerInfo[playerid][business]-1][b_owner_name], MAX_PLAYER_NAME, "%s", new_nickname);
        RunQuery("UPالتاريخ المشروعes SET b_المالك_الاسم = '%s' WHERE b_id = '%d' LIMIT 1", new_nickname, PlayerInfo[playerid][business]);
    }

    // Notify the player about the nickname change
    SendMes(playerid, col_gray, c_server"* S.المعلومات: "c_grey"Your nickالاسم تم changed to: "c_server"%s", new_nickname);
    SendMes(playerid, col_gray, c_server"* S.المعلومات: "c_grey"Pهوhnahad mikonim lotfan az bazi khهمj shodeh va ba esme jadid vهمd shavid.");

    // Notify administrators about the name change
    AdminMes(""c_server"* A.معلومات: "c_grey"%s تغييرd by nickالاسم to %s", PlayerInfo[playerid][name], new_nickname);

    // Notify logged players who have enabled notifications about the name change
    foreach(new i: logged_players) 
        if(PlayerInfo[i][settings][2]) 
            SendMes(i, col_light_red, "<< %s changed الاسم to %s >>", PlayerInfo[playerid][name], new_nickname);

    // Log the name change in the 'nickname_history' table
    RunQuery("INSERT INTO nickالاسم_hهوtory (nh_المالك,nh_قديمالاسم,nh_جديدالاسم,nh_التاريخ,nh_إداري) VALUES ('%d','%s','%s', لاW(), '%s')", PlayerInfo[playerid][id], PlayerInfo[playerid][name], new_nickname, nh_admin);

    // Update the player's name in the PlayerInfo structure
    format(PlayerInfo[playerid][name], MAX_PLAYER_NAME, new_nickname);

    // Update the player's name in the database
    update_str_sql(playerid, "u_الاسم", new_nickname);

    // Update the player's name in the NDP system
    UpdateNameNDP(playerid);

    // Update the player's name in the game system
    UpdatePlayerName(playerid);

    // If the player owns a business, update the business entry label
    if(PlayerInfo[playerid][business] != -1) 
        UpdateBusinessEnterLabel(PlayerInfo[playerid][business]-1);

    // If the player owns a house, update the house entry label
    if(PlayerInfo[playerid][house] != -1) 
        UpdateHouseEnterLabel(PlayerInfo[playerid][house]);
}


// Houses Loading/Update Label
//
// This function updates the label shown when a player enters a house, based on the house's price, 
// ownership status, and other details like family affiliation and rental status. It also updates 
// the 3D text label associated with the house for players who interact with it.
//
// Parameters:
//    house_id - The ID of the house whose label is being updated.

stock UpdateHouseEnterLabel(house_id)
{
    new enter_label_string[200];  // String to store the final label text.
    new enter_label_price[50];    // String to store the formatted price of the house.

    // Format the price based on the house price value.
    if(h_info[house_id][h_price] <= 15000)
        format(enter_label_price, sizeof enter_label_price, "{FFDC33}%d M-Coin", h_info[house_id][h_price]);
    else
        format(enter_label_price, sizeof enter_label_price, ""c_server"$%s", convert_money(h_info[house_id][h_price]));

    // If the house is not owned by anyone (h_owner == -1), format the label for a house "for sale."
    if(h_info[house_id][h_owner] == -1)
    {
        format(enter_label_string, sizeof enter_label_string, 
            "Hoاستخدام الرقم: "c_server"%d\n\
            "c_white"State price: %s\n\
            "c_white"Status: "c_السيرفر"For Sell\n\
            "c_white"Detailed information: "c_السيرفر"'ALT'",
            h_info[house_id][h_id],
            enter_label_price);
    }
    else
    {
        new enter_label_family[72];  // String to store the family name for owned houses.

        // If the house belongs to a family, add the family name to the label.
        if(h_info[house_id][h_family] != -1) {
            format(enter_label_family, sizeof enter_label_family, ""c_white"العائلة: "c_server"%s\n", family_info[h_info[house_id][h_family]][fam_name]);
        }

        // If the house is owned and there is no rent price, format the label as "Owned."
        if(h_info[house_id][h_rent_price] == 0)
        {
            format(enter_label_string, sizeof enter_label_string, 
                "Hoاستخدام الرقم: "c_server"%d\n\
                "c_white"State price: %s\n\
                "c_white"Status: "c_السيرفر"Owned\n\
                %s"c_white"Detailed information: "c_السيرفر"'ALT'",
                h_info[house_id][h_id],
                enter_label_price,
                enter_label_family);
        }
        else
        {
            // If the house is for rent, format the label as "For استئجار."
            format(enter_label_string, sizeof enter_label_string, 
                "Hoاستخدام الرقم: "c_server"%d\n\
                "c_white"State price: %s\n\
                "c_white"Status: "c_السيرفر"For Rent\n\
                %s"c_white"Detailed information: "c_السيرفر"'ALT'",
                h_info[house_id][h_id],
                enter_label_price,
                enter_label_family);
        }
    }

    // Update the 3D text label associated with the house with the newly formatted string.
    UpdateDynamic3DTextLabelText(h_info[house_id][h_enter_label], COLOR_WHITE, enter_label_string);
    return 1;  // Return 1 to indicate the function has executed successfully.
}


stock UpdateBusinessEnterLabel(biz_id)
{
	new label_string[300];

	if(b_info[biz_id][b_type] == bizz_type_shop || b_info[biz_id][b_type] == bizz_type_pharm || b_info[biz_id][b_type] == bizz_type_electronic || b_info[biz_id][b_type] == bizz_type_clothes || b_info[biz_id][b_type] == bizz_type_carshop || b_info[biz_id][b_type] == bizz_type_cafe || b_info[biz_id][b_type] == bizz_type_club || b_info[biz_id][b_type] == bizz_type_bar)
	{
		if(b_info[biz_id][b_owner_inc] == -1)
		{
			format(label_string, sizeof(label_string), ""c_yellow"%s (#%d)\n"c_green_shop"%s\n"c_white"السعر: "c_green_shop"$%s\n"c_white"Dar Control: "c_green_shop"%s\n\n"c_silver"Interaction: "c_green_shop"'ALT'",
			b_types[b_info[biz_id][b_type]], b_info[biz_id][b_id], b_info[biz_id][b_name], convert_money(b_info[biz_id][b_price]), mafia_owner_name[b_info[biz_id][b_mafia]]);
		}
		else
		{
			format(label_string, sizeof(label_string), ""c_yellow"%s (#%d)\n"c_green_shop"%s\n"c_white"المالك: "c_green_shop"%s\n"c_white"السعر: "c_green_shop"$%s\n"c_white"Extended اليومs: "c_green_shop"%d\n"c_white"Dar Control: "c_green_shop"%s\n"c_white"Vaziyat: %s\n"c_silver"Interaction: "c_green_shop"'ALT'",
