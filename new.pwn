cmd:slimit(playerid,params[]) 
{
	if(sscanf(params, "d", params[0]))
	{
		if(p_t_info[playerid][slimit] == -1)
		{
			return SendClientMessage(playerid, col_gray, ""scm_info"أدخل: "c_white"/slimit [spped (0 dهوable)]");
		}else
		{
			p_t_info[playerid][slimit] = -1;
			return SendClientMessage(playerid, col_gray, ""scm_sucess"Speed limit lifted.");
		}
	}

	if(params[0] == 0 || p_t_info[playerid][slimit] != -1)
	{
		p_t_info[playerid][slimit] = -1;
		return SendClientMessage(playerid, col_gray, ""scm_sucess"Speed limit lifted.");
	}
	else
	{
		p_t_info[playerid][slimit] = params[0];
		return SendClientMessage(playerid, col_gray, ""scm_sucess"Speed limit set.");
	}
}

