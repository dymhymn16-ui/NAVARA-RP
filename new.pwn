stock give_money(playerid, amount)
{
	if(amount == 0) return 1;
	new string[18];
	PlayerInfo[playerid][money] += amount;
	GivePlayerMoney(playerid, amount);
	if(amount <= -1) {
		format(string, sizeof string, "~r~$%d", amount);
		GameTextForPlayer(playerid, string, 3000, 1);
	}
	else if(amount >= 1) {
		format(string, sizeof string, "~g~+$%d", amount);
		GameTextForPlayer(playerid, string, 3000, 1);
	}
	update_int_sql(playerid, "u_المال", PlayerInfo[playerid][money]);
	return 1;
}

