			if(is_text_invalid(inputtext)) return show_dialog(playerid, d_family_rank_name, DIALOG_STYLE_INPUT, !""scm_dialog"Title الحالة", !""c_white"أدخل الحالة الاسم:\n"c_grey"The title الحالة must ليس contain غير صالح characters", !"التالي", !"Bargasht");

			new familyid = PlayerInfo[playerid][family];
			new dialog_rank_id = GetPVarInt(playerid, !"الرتبة_الاسم_القائمةالعنصر");
			format(family_rank[familyid][dialog_rank_id], 30, "%s", inputtext);

