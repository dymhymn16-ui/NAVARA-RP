callback: callback_mw_timer(mw_tid)
{
	foreach(new pl_id: logged_players)
	{
		if(!mafia_player(pl_id) && GetPVarInt(pl_id, "mw_td_الحالة") ==  1)
		{
			for(new j = 0; j < 18; j ++)
			{
				TextDrawHideForPlayer(pl_id, mw_td[j]);

			}
			DeletePVar(pl_id, "mw_td_الحالة");
			for(new j = 0; j < 5; j ++)if(!IsPlayerMobile(pl_id)) SendDeathMessageToPlayer(pl_id, 1001, 1001, 200);
		}
		else if(mafia_player(pl_id) && GetPVarInt(pl_id, "mw_td_الحالة") ==  0)
		{
			for(new j = 0; j < 18; j ++)
			{
				TextDrawShowForPlayer(pl_id, mw_td[j]);
			}
			GangZoneFlashForPlayer(pl_id, mw_gangzone, f_info[mw_attacker -1][f_radar_color]);
			SetPVarInt(pl_id, "mw_td_الحالة", 1);
		}
	}
	if(mw_time >= 1)
	{
		mw_time --;

		new td_string[24];
		format(td_string, sizeof(td_string), "BIZالحرب_الوقت:_%s", convert_time(mw_time));
		TextDrawSetString(mw_td[5], td_string);
	}
	else if(mw_time < 1)
	{
		if(mw_owner_points >= mw_attacker_points)// home win
		{
			new _string[92];
			format(_string, sizeof(_string), "{%s}%s دفاعed their الحافلةiness",
			f_info[mw_owner -1][f_chat_color],
			f_info[mw_owner -1][f_name]);
			SendMafiaMessage(col_gray, _string);
		}
		else if(mw_owner_points < mw_attacker_points)// attack victory
		{
			new _string[92];
			format(_string, sizeof(_string), "{%s}%s squeezed out المشروع from {%s}%s",
			f_info[mw_attacker -1][f_chat_color],
			f_info[mw_attacker -1][f_name],
			f_info[mw_owner -1][f_chat_color],
			f_info[mw_owner -1][f_name]);
			SendMafiaMessage(col_gray, _string);
			mw_owner = mw_attacker;
		}

		foreach(new i: logged_players)
		{
			if(GetPVarInt(i, "mw_td_الحالة") ==  1)
			{
				for(new j = 0; j < 18; j ++)
				{
					TextDrawHideForPlayer(i, mw_td[j]);
				}
				DeletePVar(i, "mw_td_الحالة");
				for(new j = 0; j < 5; j ++) SendDeathMessageToPlayer(i, 1001, 1001, 200);
			}
		}



		b_info[mw_tid][b_mafia] = mw_owner;

		UpdateBusinessEnterLabel(mw_tid);

		new query_string[118];

		format(query_string, 118,"UPالتاريخ `المشروعes` SET `b_mafia` = '%d' WHERE `b_id` = '%d' LIMIT 1", b_info[mw_tid][b_mafia], b_info[mw_tid][b_id]);
		mysql_tquery(sql_connection, query_string);

		KillTimer(mw_timer);

		mw_biz = -1,
			mw_owner_points = -1,
				mw_attacker_points	= -1;

		mw_time = -1;


		mw_attacker = -1;
		mw_owner = -1;

		GangZoneStopFlashForAll(mw_gangzone);
		GangZoneHideForAll(mw_gangzone);
		GangZoneDestroy(mw_gangzone);
		mw_gangzone = -1;
	}
	return 1;
}

callback: check_bl_list(playerid, pl_name[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		new target_inc = cache_get_field_content_int(0, "bl_اللاعب", sql_connection);



		new sql_string[128];
		format(sql_string, sizeof(sql_string), "حذف FROM `fractions_blackالقائمة` WHERE `bl_اللاعب`='%d' AND `bl_fraction`='%d'",
		target_inc, PlayerInfo[playerid][member]);
		mysql_tquery(sql_connection, sql_string);

		new targetid = INVALID_PLAYER_ID;

		foreach(new i: logged_players)
		{
			if(PlayerInfo[i][id] != target_inc) continue;
			targetid = i;
		}
		if(targetid != INVALID_PLAYER_ID)
		{
			format(sql_string, sizeof(sql_string), ""c_green"* "c_white"%s removed you from the blackالقائمة \"%s\".", PlayerInfo[playerid][name], f_info[PlayerInfo[playerid][member]][f_name]);
			SendClientMessage(targetid, col_white, sql_string);
		}

		format(sql_string, sizeof(sql_string), ""c_green"* "c_white"لديك been removed from the blackالقائمة %s.", pl_name);
		SendClientMessage(playerid, col_white, sql_string);
		show_dialog(playerid, d_blacklist, DIALOG_STYLE_LIST, ""c_server"القائمة السوداء", "Add Person to Black القائمة\nClear Black القائمة\nاختيار blackالقائمةed person", "Entekhab", "Bargasht");

	}
	else
	{
		new text_string[98];
		format(text_string, 98, ""c_orange_red"* "c_grey"%s لاt found in القائمة السوداء.", pl_name);
		SendClientMessage(playerid, col_gray, text_string);
		show_dialog(playerid, d_blacklist, DIALOG_STYLE_LIST, ""c_server"القائمة السوداء", "Add Person to Black القائمة\nClear Black القائمة\nاختيار blackالقائمةed person", "Entekhab", "Bargasht");
	}
	return 1;
}

callback: auction_cars()
{
	new time = GetTickCount();
	cache_get_row_count(unactiveCars);
	if(unactiveCars)
	{
		new car_id;
		for(new i = 0; i < unactiveCars; i++)
		{
			cache_get_field_content_int(i, "id", car_id);

			cache_get_field_content(i, "نشط", portInfo[car_id][bActive], sql_connection);
			portInfo[car_id][bCarModel] = cache_get_field_content_int(i, "model", sql_connection);
			portInfo[car_id][bColor1] = cache_get_field_content_int(i, "color1", sql_connection);
			portInfo[car_id][bColor2] = cache_get_field_content_int(i, "color2", sql_connection);
			portInfo[car_id][bCurrentRate] = cache_get_field_content_int(i, "الحالي_rate", sql_connection);
			portInfo[car_id][bAuctionPrice] = cache_get_field_content_int(i, "auction_السعر", sql_connection);
			portInfo[car_id][bStrengthPercentage] = cache_get_field_content_int(i, "strength", sql_connection);
			portInfo[car_id][bMileage] = cache_get_field_content_int(i, "mileage", sql_connection);
			cache_get_field_content(i, "tuning", portInfo[car_id][bTuning], sql_connection);
			cache_get_field_content(i, "ptuning", portInfo[car_id][bPTuning], sql_connection);
			portInfo[car_id][bRaterID] = cache_get_field_content_int(i, "winner_id", sql_connection);
			cache_get_field_content(i, "winner", portInfo[car_id][bRateInitiator], sql_connection, 32);
			portInfo[car_id][bDeliveryTime] = cache_get_field_content_int(i, "التوصيل_الوقت", sql_connection);
			portInfo[car_id][bTime] = cache_get_field_content_int(i, "الوقت", sql_connection);
			portInfo[car_id][bMaxSpeed] = max_veh_speed[portInfo[car_id][bCarModel] -400];
		}
		printf("[السيرفر] Loaded by السيارة in the الميناء: %d.", unactiveCars, GetTickCount() -time);
	}
	else print("[السيرفر] السيارة loaded at the الميناء: 0.");
	return 1;
}

