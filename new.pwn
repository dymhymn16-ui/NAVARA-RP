}

cmd:r(playerid, params[])
{
	if(getPlayerFactionID(playerid) > 17 && getPlayerFactionID(playerid) != 27 || !playerFactionStatus(playerid)) return 1;

	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(PlayerInfo[playerid][f_mute])
	{
		new scm_string[78];
		format(scm_string, sizeof(scm_string),""c_orange_red"* "c_grey"Your gag in your organization's chat | %d ثانية(s)", PlayerInfo[playerid][f_mute]);
		SendClientMessage(playerid, col_gray, scm_string);
		return 0;
	}

	if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /r [Matn]");
 	if(CheckForAdvTexts(playerid, params[0])) return 1;
	new scm_string[144],
		chat_color;

	switch(getPlayerFactionID(playerid))
	{
		case 8..10:chat_color = 0x6B8E23FF;
		case 11..13:chat_color = 0x0ECF80FF;
		case 15..17:chat_color = 0x0ECF80FF;
		default: chat_color = 0x4682B4AA;
	}

	format(scm_string, sizeof scm_string, "[R] %s %s[%d]: %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params[0]);
	foreach(new i: logged_players) if((PlayerInfo[i][member] == PlayerInfo[playerid][member] || is_control_chat {i} == PlayerInfo[playerid][member]) && PlayerInfo[i][settings][0] != 0) SendClientMessage(i, chat_color, scm_string);

	return 1;
}

cmd:rn(playerid, params[])
{
	if(getPlayerFactionID(playerid) > 17 && getPlayerFactionID(playerid) != 27 || !playerFactionStatus(playerid)) return 1;

	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);
	
