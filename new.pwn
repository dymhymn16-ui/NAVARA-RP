callback: clear_complaint(playerid) {
	new targetid = p_t_info[playerid][complaint];

	if(targetid != INVALID_PLAYER_ID){
		p_t_info[playerid][complaint] = INVALID_PLAYER_ID;
	}
}

alias:shekayat("complaint");
cmd:shekayat(playerid){

	new targetid = p_t_info[playerid][complaint];

	if(targetid == INVALID_PLAYER_ID) return SendError(playerid, "Hick fard mojremi peyda nashod.");
	if(!IsPlayerConnected(targetid)  || targetid == playerid)
	{
	    p_t_info[playerid][complaint] = INVALID_PLAYER_ID;
		return SendError(playerid, "Mojrem az bazi khهمj shode ast.");
	}

	if(PlayerInfo[targetid][wanted] >= 6)
		PlayerInfo[targetid][wanted] = 6;
	else
		PlayerInfo[targetid][wanted]++;

	KillTimer(p_t_info[playerid][complaint_timer]);

	SendMes(targetid, col_orange_red, "Bazikon %s[%d] az shoma be dail jorm ghatl shekayat kard.", PlayerInfo[playerid][name], playerid);

	SendInfo(playerid, "Shoma ba movafaghiat az bazikon %s[%d] shekayat kardid.", PlayerInfo[targetid][name], targetid);

	return 1;
}

