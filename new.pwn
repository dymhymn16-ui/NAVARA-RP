                        mysql_tquery(sql_connection, "اختر * FROM `المشروعes_orders` WHERE `bo_النوع` = 1 ORDER BY `المشروعes_orders`.`bo_التاريخ` DESC", "order_القائمة_اتصالرجوع", "i", playerid);
                    }
