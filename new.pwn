			if(PlayerInfo[playerid][money] < 250) return RemovePlayerFromVehicle(playerid), SendError(playerid, "استئجارing thهو المركبة التكلفةs "c_orange_red"$250");
			new veh_id = GetPlayerVehicleID(playerid);

			if(veh_info[veh_id -1][v_type] == vehicle_type_job && veh_info[veh_id -1][v_owner] == job_trucker)
			{
				new veh_model = GetVehicleModel(veh_id);
				if(veh_model == 514 && PlayerInfo[playerid][truck_skill] < 30000) return RemovePlayerFromVehicle(playerid), SendError(playerid, "You do ليس have eلاugh الخبرة to operate thهو truck.");
				if(veh_model == 515 && PlayerInfo[playerid][truck_skill] < 60000) return RemovePlayerFromVehicle(playerid), SendError(playerid, "You do ليس have eلاugh الخبرة to operate thهو truck.");
			}
			foreach(new i: logged_players)
