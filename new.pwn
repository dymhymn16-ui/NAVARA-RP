					format(color_dialog, sizeof(color_dialog), "{%s}Color 1\n{%s}Color 2\n{%s}Color 3\n{%s}Color 4\n{%s}Color 5\n"c_grey"أدخل your RGB color", family_chat_color[0], family_chat_color[1], family_chat_color[2], family_chat_color[3], family_chat_color[4]);
					return show_dialog(playerid, d_family_color, DIALOG_STYLE_LIST, !""scm_dialog"Chat Color", color_dialog, !"Entekhab", !"إلغاء");
				}
			}
