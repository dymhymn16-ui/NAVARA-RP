						{
							unJailPlayer(i);
						}
					}

					return SendClientMessage(playerid, col_light_red, !"All اللاعبون were released from prهوon");
				}
				case 4:
				{
					new params[7];
					for(new i = 1; i < house_count; i++)
					{
						if(h_info[i-1][h_owner] == -1) continue;

						format(params, sizeof params, "%d 0", i);
						pc_cmd_asellhouse(playerid, params);
					}

					mysql_tquery(sql_connection, "UPالتاريخ `users` SET `u_المنزل` = '-1', `u_الظهورchange` = '-1'");

					foreach(new i : logged_players)
					{
						PlayerInfo[i][house] = -1;
						PlayerInfo[i][spawnchange] = 0;
					}

					return SendClientMessage(playerid, col_light_red, !"All المنزلs on the السيرفر were sقديم to the state");
				}
				case 5:
				{
