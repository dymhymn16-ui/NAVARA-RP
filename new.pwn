				DeletePVar(opponent_id, "rالمنزل_id");
				return DeletePVar(playerid, "rالمنزل_id");
			}
			if(PlayerInfo[opponent_id][money] < GetPVarInt(playerid, "rالمنزل_السعر"))
			{
				DeletePVar(opponent_id, "rالمنزل_inv");
				SendClientMessage(opponent_id, col_gray, "* You do ليس have eلاugh المال to sublet.");
				SendClientMessage(playerid, col_gray, "* The اللاعب does ليس have eلاugh funds to sublet.");

				DeletePVar(playerid, "rالمنزل_السعر");
				DeletePVar(opponent_id, "rالمنزل_id");
				return DeletePVar(playerid, "rالمنزل_id");
			}
			if(GetPVarInt(opponent_id, "rالمنزل_inv") ==  0)
			{
				DeletePVar(opponent_id, "rالمنزل_inv");
				SendClientMessage(playerid, col_gray, "* The اللاعب has already left the game.");
				DeletePVar(playerid, "rالمنزل_السعر");
				DeletePVar(opponent_id, "rالمنزل_id");
				return DeletePVar(playerid, "rالمنزل_id");
			}
			PlayerInfo[playerid][rent_house] = PlayerInfo[opponent_id][house];
			update_int_sql(playerid, "u_استئجارالمنزل", getPlayerRentHouseID(opponent_id));

			new _text_string[128];
			format(_text_string, sizeof(_text_string), ""c_green"* "c_white"لديك تمت العملية بنجاحfully sublet to "c_green"%s"c_white".", PlayerInfo[opponent_id][name]);
			SendClientMessage(playerid, col_white, _text_string);
			format(_text_string, sizeof(_text_string), ""c_green"* "c_white"لديك تمت العملية بنجاحfully sublet "c_green"%s"c_white".", PlayerInfo[playerid][name]);
			SendClientMessage(opponent_id, col_white, _text_string);

			DeletePVar(opponent_id, "rالمنزل_inv");
			DeletePVar(opponent_id, "rالمنزل_السعر");

			DeletePVar(playerid, "rالمنزل_id");
			DeletePVar(opponent_id, "rالمنزل_id");
		}
