			if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[pl_id][p_pos][0], p_t_info[pl_id][p_pos][1], p_t_info[pl_id][p_pos][2]) || GetPlayerVirtualWorld(pl_id)!= GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray, "The اللاعب هو too far away."), DeletePVar(playerid, "mc_اللاعبid");
			new text_string[208];

