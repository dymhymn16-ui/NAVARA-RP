				InterpolateCameraLookAt(playerid, 2668.0283, -2522.2534, 27.8110, 2679.5945, -2388.2141, 19.5189, 10000, CAMERA_MOVE);
				show_dialog(playerid, d_port_help_1, DIALOG_STYLE_MSGBOX, ""c_server"المساعدة with work", "\
				"c_grey"Work as a loader:\n\
				"c_white"After taking the box from the container, you need to take it to the central warehouse of the port.",
				"التالي", "Bargasht");
