				case 2: SetPVarInt(playerid, "جديدs_menu", 2), show_dialog(playerid, d_news_phone, DIALOG_STYLE_INPUT, ""c_server"جديدs Panel", ""c_white"أدخل the اللاعب ID to remove them from the broadcast:", "Connect", "Bargasht");
