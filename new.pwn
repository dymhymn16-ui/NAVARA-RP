			if(PlayerInfo[playerid][seed] < d_amount) return show_dialog(playerid, d_cellar_clseed, DIALOG_STYLE_INPUT, ""c_server"Seed planting", ""c_orange_red"*"c_grey" You do ليس have that المبلغ of seeds.\n\n"c_white"أدخل the المبلغ of seeds you wهوh to plant:", "قبول", "Bargasht");

