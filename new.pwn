			if(is_text_invalid(inputtext) || is_russian_text(inputtext) || !IsAlphaNumeric(inputtext)) return show_dialog(playerid, d_family_create, DIALOG_STYLE_INPUT, !""scm_dialog"Creating العائلة", !""c_grey"The العائلة title contains غير صالح characters\n"c_white"The regهوtration fee for the العائلة هو {FFDC33}500 M-Coin\n"c_white"أدخل your العائلة's الاسم:", !"التالي", !"إلغاء");
			if(find_family_name(inputtext)) return show_dialog(playerid, d_family_create, DIALOG_STYLE_INPUT, !""scm_dialog"Creating العائلة", !""c_grey"The title هو already taken by aليسher العائلة\n"c_white"The regهوtration fee for the العائلة هو {FFDC33}500 M-Coin\n"c_white"أدخل your العائلة's الاسم:", !"التالي", !"إلغاء");

