					format(line_string, sizeof(line_string), ""c_white"متاح النقل slots: {%s}%d\n", family_info[family_id][fam_chat_color], family_info[family_id][fam_max_car]);
					strcat(global_string, line_string);
					format(line_string, sizeof(line_string), ""c_white"الرقم of العائلة المركبةs: {%s}%d\n\n", family_info[family_id][fam_chat_color], Iter_Count(family_vehicles[family_id]));
					strcat(global_string, line_string);
					format(line_string, sizeof(line_string), ""c_white"العائلة Reputation: {%s}%d نقاط\n", family_info[family_id][fam_chat_color], family_info[family_id][fam_rating]);
					strcat(global_string, line_string);
					format(line_string, sizeof(line_string), ""c_white"العائلة Vouchers: {%s}%d pcs\n", family_info[family_id][fam_chat_color], family_info[family_id][fam_ticket]);
					strcat(global_string, line_string);
					format(line_string, sizeof(line_string), ""c_white"العائلة البنك: {%s}$%s\n", family_info[family_id][fam_chat_color], convert_money(family_info[family_id][fam_bank]));
					strcat(global_string, line_string);

					show_dialog(playerid, d_family_info, DIALOG_STYLE_MSGBOX, !""scm_dialog"العائلة المعلومات", global_string, !"Bargasht", !"Bastan");
				}
				case 1:
				{
					global_string[0] = EOS;

					new number_logged = 0;
					foreach(new i: family_players[PlayerInfo[playerid][family]])
					{
						number_logged++;

						new line_string[120];
						format(line_string, sizeof(line_string), ""c_server"%d | "c_white"%s[%d] - %s (%d)\n", number_logged, PlayerInfo[i][name], i, family_rank[PlayerInfo[i][family]][PlayerInfo[i][family_rang] -1], PlayerInfo[i][family_rang]);
						strcat(global_string, line_string);
