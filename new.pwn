					show_dialog(playerid,d_rent_billd_bg,DIALOG_STYLE_LIST,"{E5D81E}لون الخلفية",string,"Change","رجوع");
				}
				case 2: show_dialog(playerid,d_rent_billd_font,DIALOG_STYLE_LIST,"{E5D81E}Font","Arial\nCalibri\nTahoma\nVerdana","اختر","رجوع");
				case 3: show_dialog(playerid,d_rent_billd_size,DIALOG_STYLE_INPUT,"{E5D81E}حجم النص",""c_white"Specify the text size (from 1 to 255)","اختر","رجوع");
				case 4: show_dialog(playerid,d_rent_billd_align,DIALOG_STYLE_LIST,"{E5D81E}محاذاة النص","Left\nCأدخل\nRight","اختر","رجوع");
				case 5: show_dialog(playerid,d_rent_billd_cancel,DIALOG_STYLE_MSGBOX,"{E5D81E}إنهاء العقد",""c_white"هل تريد فعلًا إنهاء عقد هذه اللوحة الإعلانية؟","نعم","لا");
			}
