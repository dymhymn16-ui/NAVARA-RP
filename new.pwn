stock AttachObjectToObjectEx(attachoid, Float:off_x, Float:off_y, Float:off_z, Float:rot_x, Float:rot_y, Float:rot_z, &Float:X, &Float:Y, &Float:Z, &Float:RX, &Float:RY, &Float:RZ, pobject = -1) {
	new Float:sin[3], Float:cos[3], Float:pos[3], Float:rot[3];

	switch (pobject) {
		case -1: { // dynamic object
			GetDynamicObjectPos(attachoid, pos[0], pos[1], pos[2]);
			GetDynamicObjectRot(attachoid, rot[0], rot[1], rot[2]);
		}
		default: { // player object
			GetPlayerObjectPos(pobject, attachoid, pos[0], pos[1], pos[2]);
			GetPlayerObjectRot(pobject, attachoid, rot[0], rot[1], rot[2]);
		}
	}
	AOP_FloatEulerFix(rot[0], rot[1], rot[2]);

	cos[0] = floatcos(rot[0], degrees); cos[1] = floatcos(rot[1], degrees); cos[2] = floatcos(rot[2], degrees); sin[0] = floatsin(rot[0], degrees); sin[1] = floatsin(rot[1], degrees); sin[2] = floatsin(rot[2], degrees);
	pos[0] = pos[0] + off_x * cos[1] * cos[2] - off_x * sin[0] * sin[1] * sin[2] - off_y * cos[0] * sin[2] + off_z * sin[1] * cos[2] + off_z * sin[0] * cos[1] * sin[2];
	pos[1] = pos[1] + off_x * cos[1] * sin[2] + off_x * sin[0] * sin[1] * cos[2] + off_y * cos[0] * cos[2] + off_z * sin[1] * sin[2] - off_z * sin[0] * cos[1] * cos[2];
	pos[2] = pos[2] - off_x * cos[0] * sin[1] + off_y * sin[0] + off_z * cos[0] * cos[1];
	rot[0] = asin(cos[0] * cos[1]); rot[1] = atan2(sin[0], cos[0] * sin[1]) + rot_z; rot[2] = atan2(cos[1] * cos[2] * sin[0] - sin[1] * sin[2], cos[2] * sin[1] - cos[1] * sin[0] * -sin[2]);
	cos[0] = floatcos(rot[0], degrees); cos[1] = floatcos(rot[1], degrees); cos[2] = floatcos(rot[2], degrees); sin[0] = floatsin(rot[0], degrees); sin[1] = floatsin(rot[1], degrees); sin[2] = floatsin(rot[2], degrees);
	rot[0] = asin(cos[0] * sin[1]); rot[1] = atan2(cos[0] * cos[1], sin[0]); rot[2] = atan2(cos[2] * sin[0] * sin[1] - cos[1] * sin[2], cos[1] * cos[2] + sin[0] * sin[1] * sin[2]);
	cos[0] = floatcos(rot[0], degrees); cos[1] = floatcos(rot[1], degrees); cos[2] = floatcos(rot[2], degrees); sin[0] = floatsin(rot[0], degrees); sin[1] = floatsin(rot[1], degrees); sin[2] = floatsin(rot[2], degrees);
	rot[0] = atan2(sin[0], cos[0] * cos[1]) + rot_x; rot[1] = asin(cos[0] * sin[1]); rot[2] = atan2(cos[2] * sin[0] * sin[1] + cos[1] * sin[2], cos[1] * cos[2] - sin[0] * sin[1] * sin[2]);
	cos[0] = floatcos(rot[0], degrees); cos[1] = floatcos(rot[1], degrees); cos[2] = floatcos(rot[2], degrees); sin[0] = floatsin(rot[0], degrees); sin[1] = floatsin(rot[1], degrees); sin[2] = floatsin(rot[2], degrees);
	rot[0] = asin(cos[1] * sin[0]); rot[1] = atan2(sin[1], cos[0] * cos[1]) + rot_y; rot[2] = atan2(cos[0] * sin[2] - cos[2] * sin[0] * sin[1], cos[0] * cos[2] + sin[0] * sin[1] * sin[2]);

	X = pos[0], Y = pos[1], Z = pos[2];
	RX = rot[0], RY = rot[1], RZ = rot[2];
}

stock AOP_FloatEulerFix(&Float:rot_x, &Float:rot_y, &Float:rot_z) {
	AOP_FloatGetRemainder(rot_x, rot_y, rot_z);
	if(
		(!floatcmp(rot_x, 0.0) || !floatcmp(rot_x, 360.0)) &&
		(!floatcmp(rot_y, 0.0) || !floatcmp(rot_y, 360.0))
	) rot_y = 0.00000002;

	return true;
}

stock AOP_FloatGetRemainder(&Float:rot_x, &Float:rot_y, &Float:rot_z) {
	AOP_FloatRemainder(rot_x, 360.0);
	AOP_FloatRemainder(rot_y, 360.0);
	AOP_FloatRemainder(rot_z, 360.0);

	return true;
}
stock AOP_FloatRemainder(&Float:remainder, Float:value) {
	if(remainder >= value) {
		while (remainder >= value) {
			remainder = remainder - value;
		}
	}
	else if(remainder < 0.0) {
		while (remainder < 0.0) {
			remainder = remainder + value;
		}
	}
	return true;
}

cmd:autologin(playerid) {
	if(PlayerInfo[playerid][settings][AUTO_LOGIN]) {
		SendClientMessage(playerid, col_white, ""scm_info"Autoتسجيل الدخول "c_red"Ghyre Faal "c_white"Shod.");
		PlayerInfo[playerid][settings][AUTO_LOGIN] = 0;
		UpdatePlayerSettings(playerid);
		return 1;
	}

	SendClientMessage(playerid, col_white, ""scm_info"Autoتسجيل الدخول "c_green"Faal "c_white"Shod.");
	PlayerInfo[playerid][settings][AUTO_LOGIN] = 1;
	UpdatePlayerSettings(playerid);
	return 1;
}

stock SellBussiness(b) {
	if(b_info[b-1][b_owner_inc] == -1) return 1;

	new b_owner = GetPlayerID(b_info[b-1][b_owner_name]);

	if(IsPlayerConnected(b_owner))
	{
		PlayerInfo[b_owner][business] = -1;
		// update_int_sql(b_owner, "u_المشروع", -1);
		
		SendClientMessage(b_owner, col_light_red, "المشروع Shoma Be Dalil Tamdid Nakardan Forokhte Shod.");
	}

	new query_string[200 + MAX_PLAYER_NAME + 1];

	format(query_string,sizeof(query_string),"UPالتاريخ `users` SET `u_المشروع` = '-1' WHERE `u_id` = '%d' LIMIT 1", b_info[b-1][b_owner_inc]);
	mysql_tquery(sql_connection, query_string, "", "");

	b_info[b-1][b_owner_inc] = -1;
	strfmt(b_info[b-1][b_owner_name], "The الدولة");
	
	format(query_string, 136,"UPالتاريخ `المشروعes` SET `b_المالك_inc` = '-1', `b_المالك_الاسم` = 'The State' WHERE `b_id` = '%d' LIMIT 1", b_info[b-1][b_id]);
	mysql_tquery(sql_connection, query_string);

	UpdateBusinessEnterLabel(b-1);

	new File:lFile, year, month, day;
    getdate(year, month, day);
    format(query_string, sizeof(query_string), "[%i-%02d-%02d | %02d:%02d]: الحافلةsines '%s' (ID %d) Forokhte Shod. (Tamdid Naالعملde) (%d/30)\r\n",year, month, day, timestamp_hour, timestamp_minute, b_info[b-1][b_owner_name], b, b_info[b-1][b_days]);
    lFile = fopen("بيع_bizz.txt", io_append);
    fwrite(lFile, query_string);
    fclose(lFile);

	b_info[b-1][b_days] = 5;
	return 1;
}

