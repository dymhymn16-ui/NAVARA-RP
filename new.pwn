cmd:players(playerid, params[])
{
    global_string[0] = EOS;

    new onlineCount = 0;
    for (new i = 0; i < MAX_PLAYERS; i++) {
        if(IsPlayerConnected(i)) onlineCount++;
    }

    new dialogTitle[64];
    format(dialogTitle, sizeof(dialogTitle), "متصل اللاعبين                 المجموع متصل: %d", onlineCount);

    new playerName[MAX_PLAYER_NAME];
    GetPlayerName(playerid, playerName, sizeof(playerName));
    format(global_string, sizeof(global_string), "{FFFF00}ID\tالاسم\tالنقاط\tPing\n%d\t%s\t%d\t%d\n", playerid, playerName, GetPlayerScore(playerid), GetPlayerPing(playerid));

    for (new i = 0; i < MAX_PLAYERS; i++) {
        if(IsPlayerConnected(i) && i != playerid) {
            new Name[MAX_PLAYER_NAME];
            GetPlayerName(i, Name, sizeof(Name));

            new line_string[85];
            format(line_string, sizeof(line_string), "%d\t%s\t%d\t%d\n", i, Name, GetPlayerScore(i), GetPlayerPing(i));
            strcat(global_string, line_string);
        }
    }

    show_dialog(playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, dialogTitle, global_string, "OK", "");
    return 1;
}

cmd:members(playerid)
{
	if(!playerFactionStatus(playerid)) return SendError(playerid, "Shoma ozv hich sazmani nهوtid.");

    global_string[0] = EOS;

	new membersCount;

	foreach(new i: logged_players) {
		if(PlayerInfo[i][member] != PlayerInfo[playerid][member]) continue;
		membersCount++;
	}

    format(global_string, sizeof(global_string), c_white"المجموع متصل: {e8d6b0}%d\n{e8d6b0}ID   المستوى   الهاتف   الرتبة   Speech   اللاعب الاسم\n\n", membersCount);

    foreach(new i: logged_players)
    {
		new line_string[130];
        strcat(global_string, line_string);
        if(IsPlayerConnected(i) && p_t_info[playerid][p_logged])
        {
			if(PlayerInfo[i][member] != PlayerInfo[playerid][member]) continue;

            new status_tag[60],
				status_tag_pc[30],
				status_tag_duty[30];

			if(!IsPlayerMobile(i)) format(status_tag_pc, sizeof status_tag_pc, c_yellow"[PC]");

			if(is_fraction_duty {i}) format(status_tag_duty, sizeof status_tag_duty, c_green"[Duty]");

			format(status_tag, sizeof status_tag, "%s %s", status_tag_pc, status_tag_duty);

			format(line_string, sizeof(line_string), c_white"%d     %d       %d       %d     %d/3       %s%s\n", i, PlayerInfo[i][level], PlayerInfo[i][number], PlayerInfo[i][rank], PlayerInfo[i][f_warning], PlayerInfo[i][name], status_tag);
            strcat(global_string, line_string);
        }
    }

    show_dialog(playerid, d_none , DIALOG_STYLE_MSGBOX, ""scm_dialog"Organization عضوs متصل", global_string, "OK", "");
    return 1;
}

cmd:alt(playerid){
	return OnPlayerPressedALT(playerid);
}

