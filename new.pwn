stock _DestroyVehicle(vehicleid)
{
	new Float:tempX, Float:tempY, Float:tempZ;
	GetVehiclePos(vehicleid, tempX, tempY, tempZ);
	foreach(new playerid : Player) {
		if(GetPlayerVehicleID(playerid) == vehicleid) {
			SetPlayerPos(playerid, tempX + 1.0, tempY + 1.0, tempZ);
		}
	}

	veh_info[vehicleid -1][v_color][0] = 0;
	veh_info[vehicleid -1][v_color][1] = 0;
	veh_info[vehicleid -1][v_type] = 0;
	veh_info[vehicleid -1][v_vehicle] = INVALID_VEHICLE_ID;
	veh_info[vehicleid -1][v_owner] = -1;
	veh_info[vehicleid -1][v_millage] = 0.0;
	veh_info[vehicleid -1][v_health] = 0.0;
	veh_info[vehicleid -1][v_paint] = 3;
	veh_info[vehicleid -1][v_engine_boost] = 0.0;
	veh_info[vehicleid -1][v_brake_boost] = 0;
	veh_info[vehicleid -1][v_stability_boost] = 0;

	veh_info[vehicleid -1][v_engine_status] = VEHICLE_PARAMS_OFF;

	veh_info[vehicleid -1][v_sell_price] = 0;
	veh_info[vehicleid -1][v_sell_slot] = 0;
	veh_info[vehicleid -1][v_sell_carmarket] = 0;

	veh_info[vehicleid -1][v_fine] = 0;

	veh_info[vehicleid -1][v_pos][0] = 0.0;
	veh_info[vehicleid -1][v_pos][1] = 0.0;
	veh_info[vehicleid -1][v_pos][2] = 0.0;

	for(new i; i < 5; i ++)
	{
		veh_info[vehicleid -1][v_pt_engine][i] = 0;
		veh_info[vehicleid -1][v_pt_brake][i] = 0;
		veh_info[vehicleid -1][v_pt_stability][i] = 0;
	}
	if(IsValidDynamic3DTextLabel(veh_info[vehicleid -1][v_sell_text]))
	{
		DestroyDynamic3DTextLabel(veh_info[vehicleid -1][v_sell_text]);
		veh_info[vehicleid -1][v_sell_text] = Text3D:INVALID_3DTEXT_ID;
	}

	if(IsValidDynamic3DTextLabel(veh_info[vehicleid -1][v_label_plate]))
	{
		DestroyDynamic3DTextLabel(veh_info[vehicleid -1][v_label_plate]);
		veh_info[vehicleid -1][v_label_plate] = Text3D:INVALID_3DTEXT_ID;
	}

	if(IsValidDynamic3DTextLabel(veh_info[vehicleid -1][v_label_family]))
	{
		DestroyDynamic3DTextLabel(veh_info[vehicleid -1][v_label_family]);
		veh_info[vehicleid -1][v_label_family] = Text3D:INVALID_3DTEXT_ID;
	}

	if(veh_info[vehicleid -1][v_offtruckguard]) {
		if(veh_info[vehicleid -1][v_offtruckguard_object] > 0) {
			DestroyDynamicObject(veh_info[vehicleid -1][v_offtruckguard_object]);
			veh_info[vehicleid -1][v_offtruckguard_object] = 0;
		}
		veh_info[vehicleid -1][v_offtruckguard] = 0;
	}

	if(veh_info[vehicleid -1][v_roadtrainguard]) {
		if(veh_info[vehicleid -1][v_roadtrainguard_object] > 0) {
			DestroyDynamicObject(veh_info[vehicleid -1][v_roadtrainguard_object]);
			veh_info[vehicleid -1][v_roadtrainguard_object] = 0;
		}
		veh_info[vehicleid -1][v_roadtrainguard] = 0;
	}

	if(veh_info[vehicleid -1][v_patriotguard]) {
		if(veh_info[vehicleid -1][v_patriotguard_object] > 0) {
			DestroyDynamicObject(veh_info[vehicleid -1][v_patriotguard_object]);
			veh_info[vehicleid -1][v_patriotguard_object] = 0;
		}
		veh_info[vehicleid -1][v_patriotguard] = 0;
	}

	if(veh_info[vehicleid -1][v_ufo_object] > 0) {
		DestroyDynamicObject(veh_info[vehicleid -1][v_ufo_object]);
		veh_info[vehicleid -1][v_ufo_object] = 0;
	}

	//remove amg cars objects
	for(new y = 0; y < MAX_CAR_OBJECT_ATTACHES; y++) {
		if(!IsValidDynamicObject(Car_Tunned_OBJ[vehicleid][y])) continue;
		DestroyDynamicObject(Car_Tunned_OBJ[vehicleid][y]);
		Car_Tunned_OBJ[vehicleid][y] = -1;
	}
	//---------

	for(new i = 0; i < 10; i ++)
	{
		veh_info[vehicleid -1][v_component][i] = 0;
	}

	//SetTimerEx("Destroyالمركبةالوقتd", 1000, false, "d", vehicleid);
	return DestroyVehicle(vehicleid);
	//return 1;
}

