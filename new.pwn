	}

	new query_string[95];
	format(query_string, sizeof query_string, "INSERT INTO `السيرفر_promocodes`(`promo_text`, `promo_used`)VALUES('%s', '0')", text, text);
	mysql_tquery(sql_connection, query_string);

	SendClientMessage(playerid, col_green, "Promo code إنشاءd");
	return callcmd::promocodelist(playerid);
}

