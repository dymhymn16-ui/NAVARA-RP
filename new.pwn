cmd:pradio(playerid, params[])
{
	show_dialog(playerid, d_radio_select, DIALOG_STYLE_LIST,""c_server"الراديو اخترion", "National Public الراديو\nTurn off", "قبول", "Bastan");
	return 1;
}

cmd:audience(playerid)
{
	new aud;

	foreach(new i: logged_players)
	{
		if(PlayerInfo[i][radio] == 27)aud ++;
	}
	new _dialog_string[78];
	format(_dialog_string, sizeof(_dialog_string), ""c_white"National Public الراديو | %d", aud);
	show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX,!""scm_dialog"الراديو القائمةeners", _dialog_string, !"Bastan", !"");
	return 1;
}



cmd:t(playerid, params[])
{
	if(is_ether {playerid} == -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"يجب عليك be on the air!");

	if(sscanf(params, "s[118]", params[0])) return SendInfo(playerid, "أدخل: /t [Matn]");
	new scm_string[144];

	if(is_ether {playerid} == 27)format(scm_string, sizeof(scm_string ),"[الراديو] [TV] %s: %s ", PlayerInfo[playerid][name], params[0]);
	if(getPlayerFactionID(playerid) == 27)format(scm_string, sizeof(scm_string ),"[الراديو] %s: %s ", PlayerInfo[playerid][name], params[0]);


	foreach(new i: logged_players)
	{
		SendClientMessage(i, 0x1EBF7FAA, scm_string);
	}
	return 1;
}

cmd:ether(playerid)
{
	if(getPlayerFactionID(playerid) != 27) return 1;
	if(!IsPlayerInRangeOfPoint(playerid, 15.0, 1448.0076, -1055.2706, 1717.9939)) return SendError(playerid, "يجب عليك be at the venue.");
	if(PlayerInfo[playerid][rank] < 5) return SendError(playerid, "Ether متاح from الرتبة 5.");
	if(is_ether {playerid} == -1)
	{
		is_ether {playerid} = getPlayerFactionID(playerid);
		SendInfo(playerid, "لديك أدخلed the air (قبولing اتصالs and sms / cas).");
	}
	else
	{
		is_ether {playerid} = -1;
		SendInfo(playerid, "لديك finهوhed the broadcast.");
		if(cas_price[getPlayerFactionID(playerid) -26] != 0)pc_cmd_offcas(playerid);
	}
	return 1;
}

cmd:nmenu(playerid)
{
	if(getPlayerFactionID(playerid) != 27) return 1;
	show_nmenu(playerid);
	return 1;
}


cmd:cas(playerid, params[])
{
	if(getPlayerFactionID(playerid) != 27) return 1;
	if(is_ether {playerid} == -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"يجب عليك be on the air!");
	if(cas_price[getPlayerFactionID(playerid) -26] != 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"اتصال and SMS already بدءed!");
	if(sscanf(params, "d", params[0])) return SendInfo(playerid, "أدخل: /cas [اتصال السعر]");
	if(params[0] < 1 || params[0] > 1000) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The التكلفة of a اتصال لا يمكنك be less than $1 or more than $1000!");
	cas_price[getPlayerFactionID(playerid) -26] = params[0];
	SendClientMessage(playerid, col_succes, "To turn off ringtones, أدخل the command /offcas.");
	return 1;
}


cmd:offcas(playerid)
{
	if(getPlayerFactionID(playerid) != 27) return 1;
	if(is_ether {playerid} == -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"يجب عليك be on the air!");
	if(cas_price[getPlayerFactionID(playerid) -26] == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Receiving اتصالs and SMS هو ليس بدءed!");
	cas_price[getPlayerFactionID(playerid) -26] = 0;
	new scm_string[98];

	format(scm_string, sizeof scm_string, "%s %s إنهاءed موافقing اتصالs. Income: $%d.", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], cas_bank[PlayerInfo[playerid][member] -26]);
	foreach(new i: logged_players)
	{
		if(PlayerInfo[i][member] == PlayerInfo[playerid][member]) SendClientMessage(i, 0x7DA1FFFF, scm_string);
		if(is_ether {i} == -1 || is_ether {i} != getPlayerFactionID(playerid) || i == playerid) continue;
		is_ether {i} = -1;
		SetPlayerSpecialAction(i, SPECIAL_ACTION_STOPUSECELLPHONE);
		RemovePlayerAttachedObject(i, 2);
	}
	return 1;
}

cmd:numether(playerid)
{
	if(getLeaderFactionID(playerid) != 27) return 1;
	if(cas_price[getPlayerFactionID(playerid) -26] != 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا يمكنك change the number while receiving اتصالs.");

	new _dialog_string[98];
	format(_dialog_string, sizeof _dialog_string, ""c_white"الرقم: %d.\n\nIf you want to تغيير the الرقم, put it in an empty column:", f_info[PlayerInfo[playerid][member]][f_materials]);
	show_dialog(playerid, d_numether, DIALOG_STYLE_INPUT,""c_server"Live number", _dialog_string, "قبول", "إلغاء");
	return 1;
}

cmd:incas(playerid, params[])
{
	if(getPlayerFactionID(playerid) != 27) return 1;
	if(is_ether {playerid} == -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"يجب عليك be in the ether!");
    if(cas_price[getPlayerFactionID(playerid) -26] == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Receive اتصالs and إلغاء الرسائل!");
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /incas [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(is_ether_calling {params[0]} == -1 &&
		(! IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid))) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب هو ليس trying to اتصال on the air and هو ليس near you.");

	if(is_ether_calling {params[0]} != -1 && p_t_info[params[0]][p_dialog] == d_ether_calling) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"I'm ليس trying to اتصال on the air");

	new scm_string[78];
	format(scm_string, sizeof scm_string, "You connected to the direct ether of the القائمةener %s.", PlayerInfo[params[0]][name]);
	SendClientMessage(playerid, col_succes, scm_string);

	is_ether {params[0]} = getPlayerFactionID(playerid);
	is_ether_calling {params[0]} = -1;
	return 1;
}

cmd:uncas(playerid, params[])
{
	if(getPlayerFactionID(playerid) != 27) return 1;
	if(is_ether {playerid} == -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"يجب عليك be in the ether!");
    if(cas_price[getPlayerFactionID(playerid) -26] == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Receive اتصالs and إلغاء الرسائل!");
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /uncas [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(is_ether {params[0]} == -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب هو ليس on the air.");


	new scm_string[98];
	format(scm_string, sizeof scm_string, "%s %s dهوconnect القائمةener %s from the air.",
	f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1],
	PlayerInfo[playerid][name], PlayerInfo[params[0]][name]);

	foreach(new i: logged_players)
	{
		if(PlayerInfo[i][member] == PlayerInfo[playerid][member]) SendClientMessage(i, 0x7DA1FFFF, scm_string);
	}

	is_ether {params[0]} = -1;
	is_ether_calling {params[0]} = -1;
 	SetPlayerSpecialAction(params[0], SPECIAL_ACTION_STOPUSECELLPHONE);
  	RemovePlayerAttachedObject(params[0], 2);
	return 1;
}



