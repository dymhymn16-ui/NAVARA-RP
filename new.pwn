}

stock checkPlayerStatus(playerid)
{
	if(isPlayerInJail(playerid) || p_t_info[playerid][gomp] || IsPlayerInAnyDMZone(playerid) || player_practice {playerid} != 0 || duel_opponent[playerid] != INVALID_PLAYER_ID) return false;
	else return true;
}

stock checkPlayerAllowed(playerid)
{
	if(isPlayerInJail(playerid)) return SendError(playerid, "Shoma dar السجن hastid."), 0;
	if(GetPVarInt(playerid, "اللاعبCuffed") > 0) return SendError(playerid, "Shoma cuff hastid."), 0;
	if(p_t_info[playerid][gomp]) return SendError(playerid, "Shoma dar event hastid."), 0;
	if(IsPlayerInAnyDMZone(playerid)) return SendError(playerid, "Shoma dar lobby hastid."), 0;
	if(player_practice {playerid} != 0) return SendError(playerid, "Shoma dar markaz-e amozeshi hastid."), 0;
	if(duel_opponent[playerid] != INVALID_PLAYER_ID) return SendError(playerid, "Shoma dar hal duel hastid."), 0;
	if(!IsPlayerSpawned(playerid)) return SendError(playerid, "أنت الظهور لم يتم."), 0;
	
	return 1;
}

stock checkTargetAllowed(playerid)
{
	if(isPlayerInJail(playerid)) return SendError(playerid, "In bazikon dar السجن hastan."), 0;
	if(p_t_info[playerid][gomp]) return SendError(playerid, "In bazikon dar event hastan."), 0;
	if(IsPlayerInAnyDMZone(playerid)) return SendError(playerid, "In bazikon dar lobby hastan."), 0;
	if(player_practice {playerid} != 0) return SendError(playerid, "In bazikon dar markaz-e amozeshi hastan."), 0;
	if(duel_opponent[playerid] != INVALID_PLAYER_ID) return SendError(playerid, "In bazikon dar hal duel hastan."), 0;
	if(!IsPlayerSpawned(playerid)) return SendError(playerid, "In bazikon الظهور nashode."), 0;
	
	return 1;
}

stock checkPlayerStats(playerid){
	if(isPlayerInJail(playerid)) return 0;
	if(GetPVarInt(playerid, "اللاعبCuffed") > 0) return 0;
	if(p_t_info[playerid][gomp]) return 0;
	if(IsPlayerInAnyDMZone(playerid)) return 0;
	if(player_practice {playerid} != 0) return 0;
	if(duel_opponent[playerid] != INVALID_PLAYER_ID) return 0;
	if(IsPlayerInCS(playerid)) return 0;

	return 1;
}

PlayerLevelUpdateCheck(playerid)
{
    if(PlayerInfo[playerid][exp] >= (PlayerInfo[playerid][level]+1)*4)
    {
        PlayerInfo[playerid][exp] -= (PlayerInfo[playerid][level] + 1) * 4;
        PlayerInfo[playerid][level] += 1;
		PlayerInfo[playerid][age] ++;

		if(PlayerInfo[playerid][exp] >= (PlayerInfo[playerid][level]+1)*4)
		{
			PlayerInfo[playerid][exp] = 0;
		}

        SendInfo(playerid, "المستوى bazi shoma afzaنعمh yaft.");
        SendInfo(playerid, "أنت "c_gold"5"c_white" M-Coin daryaft kardid.");

		give_donate(playerid, 5);

        if(PlayerInfo[playerid][level] == 3)
        {
			new _t_string[250];
            format(_t_string, sizeof(_t_string), "اختر `u_id`,`u_الاسم` FROM `users` WHERE `u_الاسم` IN (اختر `u_referal` FROM `users` WHERE `u_id`='%d')",
			PlayerInfo[playerid][id]);
			mysql_tquery(sql_connection, _t_string, "referal_bonus_اتصالرجوع", "i", playerid);
        }
    }

	SetPlayerScore(playerid, PlayerInfo[playerid][level]);

	update_int_sql(playerid, "u_الخبرة", PlayerInfo[playerid][exp]);
	update_int_sql(playerid, "u_المستوى", PlayerInfo[playerid][level]);
	update_int_sql(playerid, "u_age", PlayerInfo[playerid][age]);

	return 1;
}

