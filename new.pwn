			switch(veh_info[veh_id -1][v_owner])
			{
				case job_bus: show_dialog(playerid, d_bus_route, 2, ""c_server"اختر route:", "1. Los Santos -المصنع ($3,000/flight)\n2. Los Santos -Sawmill ($3,400/flight)\n3. Los Santos -Mine ($3,800/flight)\n4. Los Santos -Driving School ($3,200/flight)\n5. Los Santos -Port (2800$/flight)", "Entekhab", "إلغاء");
				case job_delivery:SendClientMessage(playerid, col_white, ""c_green"* "c_white"أدخل "c_green"/التوصيل"c_white" to بدء التوصيل.");
				case job_fuel_delivery:SendClientMessage(playerid, col_white, ""c_green"* "c_white"أدخل "c_green"/التوصيل"c_white" to بدء التوصيل.");
				case job_fireman:
				{
					p_t_info[playerid][FireStatus] = 0;
                    p_t_info[playerid][FireTimer] = RandomEx(30, 60);
                    SendMes(playerid, COLOR_BLUE, "Montazer tamas ersal konande bashid.");
				}
				case job_forklift:
				{
					forklift_ptd[playerid] = CreatePlayerTextDraw(playerid, 595.416625, 208.666702, "SHIFT_الوقت 10:00");
					PlayerTextDrawLetterSize(playerid,forklift_ptd[playerid], 0.212500, 0.879260);
					PlayerTextDrawAlignment(playerid,forklift_ptd[playerid], 2);
					PlayerTextDrawColor(playerid,forklift_ptd[playerid], -1);
					PlayerTextDrawSetShadow(playerid,forklift_ptd[playerid], 1);
					PlayerTextDrawSetOutline(playerid,forklift_ptd[playerid], 0);
					PlayerTextDrawBackgroundColor(playerid,forklift_ptd[playerid], 255);
					PlayerTextDrawFont(playerid,forklift_ptd[playerid], 1);
					PlayerTextDrawSetProportional(playerid,forklift_ptd[playerid], 1);
					PlayerTextDrawSetShadow(playerid,forklift_ptd[playerid], 1);

					PlayerTextDrawShow(playerid, forklift_ptd[playerid]);
					TextDrawShowForPlayer(playerid, forklift_td);
					forklift_time[playerid] = 600;
					SetPlayerCheckpoint(playerid, 2783.1885, -2378.3904, 13.2751, 4.0);
					SendClientMessage(playerid, col_white, ""c_green"* "c_white"To lift the container press "c_green"'Y'"c_white".");
				}
			}
		}
		case d_bus_route:
		{
			if(!response) return 1;
			SetPVarInt(playerid,"pbusroute",listitem);
			show_dialog(playerid, d_bus_price,1,""c_server"السعر for travel",""c_white"أدخل ticket السعر:","قبول","إلغاء");
		}
		case d_bus_price:
		{
			if(!response) return DeletePVar(playerid,"pbusroute");
			new price = strval(inputtext);
			if(price < 10 || price > 500)
			{
				return show_dialog(playerid, d_bus_price, 1, ""c_server"السعر for travel",""c_orange_red"* السعر must be from 10$ to 500$\n\n"c_white"أدخل ticket السعر:", "قبول", "إلغاء");
			}

			is_gps_used {playerid} = 0;
			is_searching_player_used[playerid] = INVALID_PLAYER_ID;

			new route = GetPVarInt(playerid,"pbusroute");
			DeletePVar(playerid,"pbusroute");

			new routename[56];
			switch(route)
			{
				case 0: routename = "Los Santos - المصنع";
				case 1: routename = "Los Santos - منشرة الخشب";
				case 2: routename = "Los Santos - المنجم";
				case 3: routename = "Los Santos - مدرسة القيادة";
				case 4: routename = "Los Santos - الميناء";
			}
			new mes[78];
			format(mes,sizeof(mes),""c_server"** %s **\n"c_grey"Ticket السعر: "c_white"$%i",routename,price);
			if(IsValid3DTextLabel(p_t_info [playerid][pBusText]))UpdateDynamic3DTextLabelText(p_t_info [playerid][pBusText], -1, mes);
			else if(!IsValid3DTextLabel(p_t_info [playerid][pBusText])) p_t_info [playerid][pBusText] = CreateDynamic3DTextLabel(mes,-1,0.0,0.0,3.0,40.0,INVALID_PLAYER_ID, player_rentcar[playerid]);


			p_t_info [playerid][pBusRoute] = route;
			p_t_info [playerid][pBusPrice] = price;
			p_t_info [playerid][pBusPos] = 0;
			SetNextBusCP(playerid,0);
		}
		case d_end:
		{
			if(!response) return 1;
			new _v_id = player_rentcar[playerid];

			if((veh_info[_v_id - 1][v_model] == 481 ||
				veh_info[_v_id - 1][v_model] == 509 ||
				veh_info[_v_id - 1][v_model] == 510 ||
				veh_info[_v_id - 1][v_model] == 462 ||
				veh_info[_v_id - 1][v_model] == 468 ||
				veh_info[_v_id - 1][v_model] == 585) &&
				veh_info[_v_id - 1][v_type] == vehicle_type_job)
			{
				DestroyVehicle(_v_id);
				player_rentcar[playerid] = INVALID_VEHICLE_ID;
				SendClientMessage(playerid, col_white, ""scm_sucess"Vasileh naghliyeh ejهمh dadeh shodeh pas gerafteh shod.");

				return 1;
			}

			if(getJobFactionID(playerid) == job_bus)
			{
				DisablePlayerRaceCheckpoint(playerid);
				p_t_info [playerid][pBusRoute] = 0;
				p_t_info [playerid][pBusPos] = 0;
				p_t_info [playerid][pBusPrice] = 0;
				if(IsValid3DTextLabel(p_t_info [playerid][pBusText])) DestroyDynamic3DTextLabel (p_t_info [playerid][pBusText]);
				p_t_info [playerid][pBusText] = Text3D:INVALID_3DTEXT_ID;
			}
			else if(getJobFactionID(playerid) == job_taxi)
			{
				p_t_info [playerid][pTaxiPrice] = 0;
				if(IsValid3DTextLabel(p_t_info[playerid][pTaxi3DText])) DestroyDynamic3DTextLabel(p_t_info[playerid][pTaxi3DText]);
				p_t_info[playerid][pTaxi3DText] = Text3D:INVALID_3DTEXT_ID;

			}
			else if(getJobFactionID(playerid) == job_mechanic)
			{
				p_t_info [playerid][pTaxiPrice] = 0;
				if(IsValid3DTextLabel(PlayerMehText[playerid])) DestroyDynamic3DTextLabel (PlayerMehText[playerid]);
				PlayerMehText[playerid] = Text3D:INVALID_3DTEXT_ID;
				DeletePVar(playerid, "Mehالاسم");
				DeletePVar(playerid, "الأفضلlivo");
			}
			// We remove cargo from the car on the loader in the port and remove textdrive
			if(getTimeJobFactionID(playerid) == job_forklift)
			{
				if(GetPVarInt(playerid, "fork_object"))
				{
					DestroyDynamicObject(GetPVarInt(playerid, "fork_object"));
					DeletePVar(playerid, "fork_object");
				}
				if(forklift_ptd[playerid] != PlayerText:-1)
				{
					PlayerTextDrawDestroy(playerid, forklift_ptd[playerid]);
					TextDrawHideForPlayer(playerid, forklift_td);

					forklift_ptd[playerid] = PlayerText:-1;
					forklift_time[playerid] = -600;
				}
			}
			player_rentcar[playerid] = INVALID_VEHICLE_ID;
			SetVehicleToRespawn(_v_id);
			SendClientMessage(playerid, col_white, ""c_green"* "c_white"Shoma ba movafghiat ejهمh vasileh naghliyeh ra faskh.");
		}
		case d_municipality:
		{
			if(!response) return 1;

