callback: deposit_boxes_callback(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		show_dialog(playerid, d_bank_control, DIALOG_STYLE_LIST, ""c_server"الحساب Management", "Main الحساب", "Entekhab", "Bargasht");
	}
	else
	{
		new dialog_string[168],
			_db_name[32],
			line_string[56];


		strcat(dialog_string, "Main الحساب\n");
        for(new j = 0; j < rows; j ++)
        {
			new _db_id = cache_get_field_content_int(j, "db_id", sql_connection);

			cache_get_field_content(j, "db_الاسم", _db_name, sql_connection, 32);


			format(line_string, 14, "إيداع_%d", j + 1);
			SetPVarInt(playerid, line_string, _db_id);

			format(line_string, 16, "n_إيداع_%d", j + 1);
			SetPVarString(playerid, line_string, _db_name);


			format(line_string, sizeof(line_string), "%s(#%d)\n", _db_name, _db_id);
			strcat(dialog_string, line_string);

		}
		show_dialog(playerid, d_bank_control, DIALOG_STYLE_LIST, ""c_server"الحساب Management", dialog_string, "Entekhab", "Bargasht");
	}
	return 1;
}

callback: deposit_pincode_callback(playerid, deposit_id)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		new sql_string[96];
		mysql_format(sql_connection, sql_string, 96, "اختر * FROM `إيداع_boxes` WHERE `db_المالك` = '%d' LIMIT 3",
		PlayerInfo[playerid][id]);
		mysql_tquery(sql_connection, sql_string, "إيداع_boxes_اتصالرجوع", "i", playerid);
		SendClientMessage(playerid, col_gray, "Inصحيح PIN code.");
		return 1;
	}
	new _db_id = cache_get_field_content_int(0, "db_id", sql_connection),
		_db_name[32],
		_db_money = cache_get_field_content_int(0, "db_المال", sql_connection);

	cache_get_field_content(0, "db_الاسم", _db_name, sql_connection, 32);

	new header_string[78];
	format(header_string, sizeof(header_string), ""c_server"%s(#%d)", _db_name, _db_id);
	show_dialog(playerid, d_row_deposit, DIALOG_STYLE_LIST, header_string, "الحساب المعلومات\nتحويل المال to aليسher الحساب\nPut المال\nسحب المال\nالأفضل up your الهاتف الرصيد", "Entekhab", "Bargasht");

	SetPVarInt(playerid, "p_db_id", _db_id);
	SetPVarInt(playerid, "p_db_المال", _db_money);
	SetPVarString(playerid, "p_db_الاسم", _db_name);
	return 1;
}

