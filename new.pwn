cmd:sf(playerid, params[])
{
	if(getPlayerFactionID(playerid) != 11) return 1;
	if(PlayerInfo[playerid][rank] < 6 || PlayerInfo[playerid][rank] > 9) return 1;

	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /sf [Matn]");
 	if(CheckForAdvTexts(playerid, params[0])) return 1;
	new scm_string[144];

	format(scm_string, sizeof scm_string, "[R] %s %s[%d]: %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params[0]);
	foreach(new i: logged_players) if((PlayerInfo[i][member] == player_ssf {playerid} || is_control_chat {i} == player_ssf {playerid}) && PlayerInfo[i][settings][0] != 0)SendClientMessage(i, 0x4682B4AA, scm_string);

	SendClientMessage(playerid, 0x4682B4AA, scm_string);
	return 1;
}



cmd:rank(playerid, params [])
{
	if(!playerFactionStatus(playerid)) return 1;
	if(PlayerInfo[playerid][rank] < f_info[PlayerInfo[playerid][member]][f_rank_settings][1]) return 1;
	if(PlayerInfo[playerid][rank] < 11 && fbi_player(playerid)) return 1;
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /الرتبة [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't change the early itself.");

    if(PlayerInfo[params[0]][member] != PlayerInfo[playerid][member]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"اللاعب هو ليس in your organization.");
    if(PlayerInfo[params[0]][rank] >= PlayerInfo[playerid][rank]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Can't change earlier manual.");

	global_string[0] = EOS;
	for(new i = 0; i < f_info[PlayerInfo[playerid][member]][f_rank_settings][0]; i ++)
	{
		new line_string[72];
		format(line_string, 72, ""c_grey"%i. "c_white"%s\n", i + 1, f_rank[PlayerInfo[playerid][member]][i]);
		strcat(global_string, line_string);
	}
	show_dialog(playerid, d_rank, DIALOG_STYLE_LIST, ""c_server"Change of الرتبة", global_string, "Entekhab", "Bastan");
	SetPVarInt(playerid, "pl_setالرتبة_id", params[0]);
	return 1;
}

cmd:heal(playerid, params[])
{
	if(!medic_player(playerid)) return 1;
	if(sscanf(params, "ud", params[0], params[1])) return SendInfo(playerid, "أدخل: /heal [id/الاسم] [Gheymat]");
    if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey" good الطبيب.");
    if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2] ) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");
    if(params[1] < 5 || params[1] > 1000) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Gheymat е 1000$.");
    if(p_t_info[params[0]][p_dialog] != -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب هو لاw فتحing the dialog.");



	new dialog_string[118];
	format(dialog_string, sizeof(dialog_string),
	""c_green"* "c_white"You suggested "c_green"%s "c_white" cure it for "c_green"$%d",
	PlayerInfo[params[0]][name], params[1]);
	SendClientMessage(playerid, col_white, dialog_string);

	format(dialog_string, sizeof(dialog_string),
	""c_server"%s "c_white"proposes to cure Vasa for {33AA33}$%d",
	PlayerInfo[playerid][name], params[1]);
	show_dialog(params[0], d_heal, DIALOG_STYLE_MSGBOX, ""c_server"الخدمة الطبية", dialog_string, "قبول", "Bastan");

	heal_price[params[0]] = params[1];
	heal_id[params[0]] = playerid;

	PlayerInfo[playerid][activity_heals]++;
	update_int_sql(playerid, "u_activity_heals", PlayerInfo[playerid][activity_heals]);

	// update_activity(playerid);
	return 1;
}


cmd:givemc(playerid, params[])
{
	if(!medic_player(playerid)) return 1;
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /givemc [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");

    show_dialog(playerid, d_give_mc, DIALOG_STYLE_LIST, ""c_server"Give med.السيارةds",
    "{cccc99}اختر inspection result:\n\
    "c_white"Seriously ill/sick\n\
    Observed deviations\n\
    Full health (a)",
    "Entekhab", "Bastan");
	SetPVarInt(playerid, "mc_اللاعبid", params[0]);
	return 1;
}

cmd:med(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /med [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");

	new scm_string[98];
	format(scm_string, sizeof(scm_string ), "اختر * FROM `users_medالسيارةds` WHERE `mc_المالك` = '%d' LIMIT 1", PlayerInfo[playerid][id]);
	mysql_tquery(sql_connection, scm_string, "mc_اتصالرجوع", "ii", playerid, params[0]);
	return 1;
}


callback: mc_callback(playerid, to_id)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا تملك a طبي السيارةd.");
	new cmd_mc_date[18],
		cmd_mc_result;



	cmd_mc_result = cache_get_field_content_int(0, "mc_result", sql_connection);
	cache_get_field_content(0, "mc_التاريخ", cmd_mc_date, sql_connection, 18);

	static const mc_status[][] = {
    "Seriously ill / ill",
    "Observed deviations",
    "Full الصحة(s)"};

	if(to_id == playerid)format(global_string, 72, "looked at hهو طبي السيارةd");
	else format(global_string, 72, "showed طبي السيارةd %s", PlayerInfo[to_id][name]);

	me_action(playerid, global_string);

	new dialog_string[186];

	format(dialog_string, sizeof(dialog_string), ""c_white"المالك: %s\nهوsue التاريخ: %s\n\n\n{cccc99}%s",
	PlayerInfo[playerid][name], cmd_mc_date, mc_status[cmd_mc_result]);

	show_dialog(to_id, d_none, DIALOG_STYLE_MSGBOX, ""c_server"طبي السيارةd", dialog_string, "Bastan", "");
	return 1;
}

cmd:en(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(v_velo(vehicleid)) 
	{
		new engine,lights,alarm,doors,bonnet,boot,objective;
		GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);

		veh_info[vehicleid -1][v_engine_status] = VEHICLE_PARAMS_ON;
		SetVehicleParamsEx(vehicleid, VEHICLE_PARAMS_ON, lights, alarm, doors, bonnet, boot, objective);
		return 1;
	}

	toggle_engine(playerid, vehicleid);
	return 1;
}


cmd:light(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);
	if(v_velo(vehicleid)|| v_plane(vehicleid)|| v_boat(vehicleid)) return 1;
	toggle_lights(vehicleid);
	return 1;
}


cmd:lock(playerid)
{
	if(IsPlayerInAnyVehicle(playerid))
	{
		new veh_id = GetPlayerVehicleID(playerid);
		if((veh_info[veh_id -1][v_type] != vehicle_type_player || veh_info[veh_id -1][v_owner] != PlayerInfo[playerid][id]) && p_t_info[playerid][v_key] != veh_id) return SendError(playerid, "لا تملك مفاتيح هذه المركبة.");

		PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);

		new engine, lights, alarm, doors, bonnet, boot, objective;

		veh_info[veh_id -1][v_locked] = !veh_info[veh_id -1][v_locked];
		GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
		SetVehicleParamsEx(veh_id, engine, lights, alarm, veh_info[veh_id -1][v_locked], bonnet, boot, objective);
		
		if(!veh_info[veh_id -1][v_locked])
			SendAction(playerid, "dar %s baz العملd", vehicle_name[GetVehicleModel(veh_id)-400]);
		else
			SendAction(playerid, "dar %s bast", vehicle_name[GetVehicleModel(veh_id)-400]);
	}
	else
	{
		new 
			bool:unlocked_any;

		new Float:pl_pos_x,
			Float:pl_pos_y,
			Float:pl_pos_z;

		new Float:vehicle_pos_x,
			Float:vehicle_pos_y,
			Float:vehicle_pos_z;

		GetPlayerPos(playerid, pl_pos_x, pl_pos_y, pl_pos_z);
		GetVehiclePos(p_t_info[playerid][v_key], vehicle_pos_x, vehicle_pos_y, vehicle_pos_z);

		if(p_t_info[playerid][v_key] != 0 && 
			GetDistanceBetweenPoints(pl_pos_x, pl_pos_y, pl_pos_z, vehicle_pos_x, vehicle_pos_y, vehicle_pos_z) <= 5.0)
		{
			new veh_id = p_t_info[playerid][v_key];
			PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);

			new engine, lights, alarm, doors, bonnet, boot, objective;
			veh_info[veh_id -1][v_locked] = !veh_info[veh_id -1][v_locked];
			GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(veh_id, engine, lights, alarm, veh_info[veh_id -1][v_locked], bonnet, boot, objective);
			if(!veh_info[veh_id -1][v_locked])
				SendAction(playerid, "dar %s baz العملd", vehicle_name[GetVehicleModel(veh_id)-400]);
			else
				SendAction(playerid, "dar %s bast", vehicle_name[GetVehicleModel(veh_id)-400]);

			GameTextForPlayer(playerid, (veh_info[veh_id -1][v_locked]) ? "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~ BOAT UNLOCK" :
				"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ BOAT LOCK", 3000, 3);

			return 1;
		}

		foreach(new veh_id:player_vehicles[playerid])
		{
			GetVehiclePos(veh_id, vehicle_pos_x, vehicle_pos_y, vehicle_pos_z);
			if(GetDistanceBetweenPoints(pl_pos_x, pl_pos_y, pl_pos_z, vehicle_pos_x, vehicle_pos_y, vehicle_pos_z) > 5.0) continue;

			if(v_boat(veh_id))
			{
				GameTextForPlayer(playerid, (veh_info[veh_id -1][v_locked]) ? "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~ BOAT UNLOCK" :
					"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ BOAT LOCK", 3000, 3);
			}
			else
			{
				GameTextForPlayer(playerid, (veh_info[veh_id -1][v_locked]) ? "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~ السيارة UNLOCK" :
					"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ السيارة LOCK", 3000, 3);
			}

			new engine, lights, alarm, doors, bonnet, boot, objective;

			PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
			veh_info[veh_id -1][v_locked] = !veh_info[veh_id -1][v_locked];
			GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(veh_id, engine, lights, alarm, veh_info[veh_id -1][v_locked], bonnet, boot, objective);
			if(!veh_info[veh_id -1][v_locked])
				SendAction(playerid, "dar %s baz العملd", vehicle_name[GetVehicleModel(veh_id)-400]);
			else
				SendAction(playerid, "dar %s bast", vehicle_name[GetVehicleModel(veh_id)-400]);

			unlocked_any = true;
			break;
		}

		if(!unlocked_any) SendClientMessage(playerid, col_white, ""scm_error"Shoma kenar mashin khod nهوtid.");
	}
	return 1;
}

cmd:time(playerid)
{
	new year,
		month,
		day,
		mtext[11],
		dialog_string[278];

	getdate(year, month, day);

	switch(month)
	{
		case 1: mtext = "Any";
		case 2: mtext = "February";
		case 3: mtext = "Mary";
		case 4: mtext = "April";
		case 5: mtext = "Мая";
		case 6: mtext = "June";
		case 7: mtext = "July";
		case 8: mtext = "Avgusta";
		case 9: mtext = "September";
		case 10: mtext = "October";
		case 11: mtext = "لا";
		case 12: mtext = "December";
	}

	if(isPlayerInJail(playerid))
	{
		format(dialog_string, sizeof(dialog_string),"\
        "c_السيرفر" You called the Timekeeping Service!\n\n\
        "c_السيرفر"*"c_white" Today's date:\t\t"c_grey"%d %s 2020 г\n\
        "c_السيرفر"*"c_white" Current Time:\t\t"c_grey"%s%d:%s%d\n\n\
        "c_السيرفر"*"c_white" End Time:\t\t"c_grey"%d second(s)",
		day,mtext,(timestamp_hour < 10) ? ("0") : (""), timestamp_hour, (timestamp_minute < 10) ? ("0") : (""), timestamp_minute, PlayerInfo[playerid][jailed]);
	}
	else
	{
		format(dialog_string, sizeof(dialog_string),"\
        "c_السيرفر" You called the Timekeeping Service!\n\n\
        "c_السيرفر"*"c_white" Today's date:\t\t"c_grey"%d %s 2020 г\n\
        "c_السيرفر"*"c_white" Current time:\t\t"c_grey"%s%d:%s%d\n\n",
		day,mtext,(timestamp_hour < 10) ? ("0") : (""), timestamp_hour, (timestamp_minute < 10) ? ("0") : (""), timestamp_minute);
	}

	show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, ""c_server"الوقت الدقيق", dialog_string, "Bastan", "");

	me_action(playerid, "looked at the watch.");

	return 1;
}

