					for(new i = 1; i < b_count; i++)
					{
						if(b_info[i-1][b_owner_inc] == -1) continue;

						format(params, sizeof params, "%d 0", i);
						pc_cmd_asellbiz(playerid, params);
					}
					return SendClientMessage(playerid, col_light_red, !"All المشروعes on the السيرفر were sقديم to the state");
				}
				case 6:
				{
					return SendClientMessage(playerid, col_light_red, !"قيد التطوير");
				}
				case 7:
				{
					pay_day_time();
					return SendClientMessage(playerid, col_light_red, !"تم إصدار الراتب المبكر");
