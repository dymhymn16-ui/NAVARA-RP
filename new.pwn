					"c_grey"* Aaya vaghan mikhahid \""c_white"VIP-العائلة"c_grey"\"baraye family khod fa'al konid?", "Kharid", "Barghast");


					show_dialog(playerid, d_family_vip, DIALOG_STYLE_MSGBOX, c_gold"[VIP]"c_white" العائلة المعلومات","\
					"c_white"Family shoma yek family "c_gقديم"[VIP]"c_white" ast.\n\n\
					"c_grey"-"c_white"VIP-Family be family emkanat zir ra midahad:\n\n\
					"c_grey"-"c_white"Sherkat dar rob haye family\n\
					"c_grey"-"c_white"10 Slot bishtar vasile naghlie\n\
					"c_grey"-"c_white"Raf mahdodiat tedad azaye family\n\
					"c_grey"-"c_white"Event haye makhsos ba javayez pool va exp\n\n\
					"c_white"Event haye makhsos ba javayez pool va exp\n\n", "Barghasht", "");

				}
