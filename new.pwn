		veh_info[veh - 1][v_model] == 468 ||
		veh_info[veh - 1][v_model] == 585) &&
		veh_info[veh - 1][v_type] == vehicle_type_job))
		{
			if(veh_info[veh -1][v_fuel] > 0)
			{
				if(veh_info[veh -1][v_fuel] > max_fuel_capacity[veh_info[veh -1][v_model] -400])
				{
					veh_info[veh -1][v_fuel] = max_fuel_capacity[veh_info[veh -1][v_model] -400];
				}
				else
				{
					if(veh_info[veh -1][v_engine_boost] > 0)
					{
						veh_info[veh -1][v_fuel] -= 0.03 *(veh_info[veh -1][v_engine_boost]* 5)+ 0.01;
					}
					else veh_info[veh -1][v_fuel] -= 0.03;
				}
			}
			
			if(veh_info[veh -1][v_fuel] > 0.5 && veh_info[veh -1][v_fuel] < 0.6)
			{
				new engine,lights,alarm,doors,bonnet,boot,objective;
				GetVehicleParamsEx(veh, engine, lights, alarm, doors, bonnet, boot, objective);

				SetVehicleParamsEx(veh, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
