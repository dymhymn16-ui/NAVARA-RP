callback: del_elections_list(playerid, inputtext[])
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		new _t_string[108];
		format(_t_string, 98, "حذف FROM `elections` WHERE `e_الاسم` = '%s'", inputtext);
		mysql_tquery(sql_connection, _t_string);
		show_dialog(playerid, d_election, DIALOG_STYLE_LIST,""c_server"Election Management | الحالة", "Elections هم إغلاقd\nCandiالتاريخ regهوtration\nVoting\nCandida deletion العنصر\nحذف candiالتاريخ", "قبول", "Bastan");
		
		AdminMes(""c_server"* A.معلومات: "c_grey"%s removed candiالتاريخ %s from the القائمة.", PlayerInfo[playerid][name], inputtext);
		
		return 1;
	}
	SendError(playerid, "Thهو اللاعب كان ليس found in the القائمة of candiالتاريخs.");
	show_dialog(playerid, d_election_delete, DIALOG_STYLE_INPUT, ""c_server"Remove Candiالتاريخ", ""c_white"أدخل the الاسم of the اللاعب you want to remove from the القائمة Applicants:", "قبول", "رجوع");
	return 1;
}


callback: elections_insert(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows >= 15) return SendError(playerid, "The limit of candiالتاريخs has already been reached.");
	give_money(playerid, -250000);
	insert_money_log(playerid, INVALID_PLAYER_ID, -250000, "candiالتاريخ regهوtration");

	new sql_string[76];
	format(sql_string, sizeof(sql_string), "INSERT INTO `elections` (e_الاسم) VALUES ('%s')", PlayerInfo[playerid][name]);
	mysql_tquery(sql_connection, sql_string);

	SendClientMessage(playerid, col_white, ""c_green"* "c_white"Shoma Ba Movafghiat إنشاء حسابed their candidacy for the elections.");
	return 1;
}


