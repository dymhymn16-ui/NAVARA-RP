stock toggle_engine(playerid, vid)
{
	if(!IsPlayerInAnyVehicle(playerid)) return 0;

	new Float:veh_health;
	GetVehicleHealth(vid, veh_health);

	if(veh_health <= 330) show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, !""scm_dialog"Ettela", !""c_white"Motor mashin kharab ast,\nnmitavand roshan shavad.", !"Bastan", !"");

	if(veh_info[vid -1][v_fuel] < 1) return show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, !""scm_dialog"Ettela", !""c_white"In mashin benzin nadard.", !"Bastan", !"");

	new engine,lights,alarm,doors,bonnet,boot,objective;
	GetVehicleParamsEx(vid, engine, lights, alarm, doors, bonnet, boot, objective);

	if(engine == VEHICLE_PARAMS_UNSET || engine == VEHICLE_PARAMS_OFF)
	{
		if(veh_info[vid -1][v_fuel] < 1)
		{
			SendClientMessage(playerid, col_white, ""c_orange_red"* "c_grey"لديك run out of الوقود in your المركبة. Use "c_white"'/الخدمة' "c_grey"to اتصال the الميكانيكي!");
	    	veh_info[vid -1][v_engine_status] = VEHICLE_PARAMS_OFF;
			return SetVehicleParamsEx(vid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
		}
		else {
	    	veh_info[vid -1][v_engine_status] = VEHICLE_PARAMS_ON;
			SetVehicleParamsEx(vid, VEHICLE_PARAMS_ON, lights, alarm, doors, bonnet, boot, objective);
		}
	}
	else {
	    veh_info[vid -1][v_engine_status] = VEHICLE_PARAMS_OFF;
		SetVehicleParamsEx(vid, VEHICLE_PARAMS_OFF, lights, alarm, doors, bonnet, boot, objective);
	}

 	if(bicycles(vid) || ((veh_info[vid - 1][v_model] == 481 ||
		veh_info[vid - 1][v_model] == 509 ||
		veh_info[vid - 1][v_model] == 510 ||
		veh_info[vid - 1][v_model] == 462 ||
		veh_info[vid - 1][v_model] == 468 ||
		veh_info[vid - 1][v_model] == 585) &&
		veh_info[vid - 1][v_type] == vehicle_type_job))
    {
	    veh_info[vid -1][v_fuel] = 100;
	    GetVehicleParamsEx(vid,engine,lights,alarm,doors,bonnet,boot,objective);
	    veh_info[vid -1][v_engine_status] = VEHICLE_PARAMS_ON;
	    SetVehicleParamsEx(vid,VEHICLE_PARAMS_ON, VEHICLE_PARAMS_ON, alarm, doors, bonnet, boot, objective);
	    return 1;
    }
	return 1;
}

stock toggle_lights(vehicleid)
{
	new engine,lights,alarm,doors,bonnet,boot,objective;
	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
	SetVehicleParamsEx(vehicleid, engine,(lights == VEHICLE_PARAMS_UNSET || lights == VEHICLE_PARAMS_OFF) ? VEHICLE_PARAMS_ON : VEHICLE_PARAMS_OFF, alarm, doors, bonnet, boot, objective);
	return 1;
}

stock memset(array[], value, size = sizeof(array))
{
    if(!size)
    {
        print("memset: لا array size specified");
        return 0;
    }

    new phys_addr;

    #emit LOAD.S.pri array
    #emit STOR.S.pri phys_addr

    /*return */memfill_byaddr(phys_addr, value, size);
}

stock memfill_byaddr(address, cellsize, value)
{
    new idx;

    #emit LCTRL       6
    #emit MOVE.alt
    #emit LCTRL       0

    #emit ADD
    #emit MOVE.alt

    #emit LCTRL       1
    #emit SUB.alt
    #emit ADD.C       92

    #emit STOR.S.pri  idx
    #emit LOAD.S.pri  cellsize
    #emit SHL.C.pri   2
    #emit SREF.S.pri  idx

    #emit LOAD.S.alt  address
    #emit LOAD.S.pri  value
    #emit FILL        0
}

