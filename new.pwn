    if(GetPVarInt(playerid, "اللاعبTied")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت connected.");
    if(PlyayerIsGang && !PlayerInfo[playerid][number]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت الهاتف المحمول لا تملك.");
