			mysql_query(sql_connection, query_string);

			slobal_string[0] = EOS;
			format(slobal_string, sizeof(slobal_string), ""c_server"1 | "c_white"Availability الرتبة ("c_gold"%s"c_white")\n"c_server"2 | "c_white"السيارة toفوزg\n"c_server"3 | "c_white"Parking the المركبة\n"c_server"4 | "c_white"Mark on نظام الملاحة\n"c_server"5 | "c_white"بيع the المركبة", family_rank[family_id][veh_info[vehicle_id -1][v_rank] -1]);
			show_dialog(playerid, d_family_fixcar_1, DIALOG_STYLE_LIST, !""scm_dialog"السيارة الإعدادات", slobal_string, !"Entekhab", !"إلغاء");
				
			SetPVarInt(playerid, !"المركبةlMenu", vehicle_id);
		}
		case d_blacklist_family:
		{
			if(!response) return pc_cmd_fmenu(playerid);
			switch(listitem)
			{
				case 0: 
					show_dialog(playerid, d_blinvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_white"أدخل the اللاعب ID and the السبب you want to add to the blackالقائمة:\n\n"c_grey"Example: 1, العائلة insult", !"التالي", !"Bargasht");
				case 1: 
					show_dialog(playerid, d_blclear_family, DIALOG_STYLE_MSGBOX, !""scm_dialog"Blackالقائمة", !""c_white"Do you really want to clear the العائلة blackالقائمة?\n\n"c_grey"إلغاءing thهو action will be impossible", !"التالي", !"Bargasht");
				case 2: 
					show_dialog(playerid, d_bluninvite_family, DIALOG_STYLE_INPUT, !""scm_dialog"Blackالقائمة", !""c_white"أدخل the اللاعب الاسم you want to remove from the blackالقائمة:", !"التالي", !"Bargasht");
				case 3:
				{
