					PlayerInfo[playerid][has_hookah] = 1;
					update_int_sql(playerid, "u_has_hookah", PlayerInfo[playerid][has_hookah]);
					SendClientMessage(playerid, col_white, ""c_green"* "c_white"Shoma yek hookah kharidid.");
				}
				case 9:
				{
					if(PlayerInfo[playerid][boombox] >= 1) return SendError(playerid, "Shoma dar hale hazer yek boombox darid.");
					PlayerInfo[playerid][boombox] = 1;
