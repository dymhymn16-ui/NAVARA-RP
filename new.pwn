{
    show_dialog(playerid, d_reg_pass, DIALOG_STYLE_INPUT, !""scm_dialog"Sakht الحساب", !""c_white"Be السيرفر "c_server"Mihan Role Play"c_white"\nKhosh amadid, Baraye edame niyaz be yek الحساب darid.\n\nlotfan yek ramz baraye الحساب khodetoon vهمd konid:\n\n"c_grey"\t-Ramz shoma bayad had aghal 6 va had aksar 15harf bashad.\n\t-ramz bayad faghat harf va adad dashte bashad.\n\t-Lotfan Yek Ramz Sakht vهمd konid baraye amniat hesab khod.", !"التالي", !"");

	return 1;
}

stock show_login(playerid)
{
    new dialog_string[300];
	format(dialog_string, sizeof(dialog_string),"\
	"c_white"Khosh Omadi be Server "c_السيرفر"Mihan Role Play\n\n\
	"c_السيرفر"-"c_white" Account Shoma Sabtnam Shode Ast.\n\
    "c_السيرفر"-"c_white" Esm Shoma: %s\n\
    "c_السيرفر"-{AEAE00} Agar taze be server amadid va mikhahid account besazid ba yek esm digar talash konid\n\
	\n"c_grey"- Password Khod Ra Vared Konid:", اللاعبالمعلومات[اللاعبid][الاسم]);
	show_dialog(playerid, d_login, DIALOG_STYLE_PASSWORD, !""scm_dialog"تسجيل الدخول", dialog_string, "Vorood", "Khorooj");


   	SetPVarInt(playerid, "Autorization", 1);
	
    return 1;
}

// -----------------------------------------------------------------------------------------------

stock show_stats(playerid, toid)
{
	static const mm_gender[][] = {"Mard","Zan"};

	new house_data[12];
	if(playerHouseStatus(playerid))
		format(house_data, sizeof(house_data), "hoاستخدام #%d", getPlayerHouseID(playerid));
	else
		format(house_data, sizeof(house_data), "لاne");

	new business_date[32];
	if(PlayerInfo[playerid][business] != -1)
		format(business_date, 32, "%s (#%d)", b_info[PlayerInfo[playerid][business] -1][b_name], b_info[PlayerInfo[playerid][business] -1][b_id]);
	else
		format(business_date, 32, "لاne");

	new job_data[22];
	if(playerJobStatus(playerid) && getJobFactionID(playerid) < 50)
		format(job_data, sizeof(job_data), "%s", jobs_name[PlayerInfo[playerid][job]]);
	else
		format(job_data, sizeof(job_data), "لاne");

	new fraction_data[32];
	if(playerFactionStatus(playerid))
		format(fraction_data, sizeof(fraction_data), "%s", f_info[PlayerInfo[playerid][member]][f_name]);
	else
		format(fraction_data, sizeof(fraction_data), "لاne");

	new rank_data[32];
	if(PlayerInfo[playerid][rank])
		format(rank_data, sizeof(rank_data), "%s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1]);
	else
		format(rank_data, sizeof(rank_data), "لاne");

	new hours=0, minutes=0, seconds=0;
	ToHHMMSS(PlayerInfo[playerid][timeplay], hours, minutes, seconds);
	new afk_hours=0, afk_minutes=0, afk_seconds=0;
	ToHHMMSS(PlayerInfo[playerid][timeplay_afk], afk_hours, afk_minutes, afk_seconds);

	new today_hours=0, today_minutes=0, today_seconds=0;
	ToHHMMSS(PlayerInfo[playerid][timeplaytoday], today_hours, today_minutes, today_seconds);
	new today_afk_hours=0, today_afk_minutes=0, today_afk_seconds=0;
	ToHHMMSS(PlayerInfo[playerid][timeplaytoday_afk], today_afk_hours, today_afk_minutes, today_afk_seconds);

	new vip_text_time[18];

	if(PlayerInfo[playerid][vip] > 0) {
		new year, month, day, hour, minute, second;
		MyTimeStamp(PlayerInfo[playerid][vip_time]-timestamp, year, month, day, hour, minute, second);

		if(day > 0) {
			format(vip_text_time, sizeof vip_text_time, " (%d اليومs)", day);
		}
		else if(hour > 0) {
			format(vip_text_time, sizeof vip_text_time, " (%d ساعات)", hour);
		}
		else {
			format(vip_text_time, sizeof vip_text_time, " (%d دقائق)", minute);
		}
	}

	new premium_text_time[18];

	if(PlayerInfo[playerid][premium] > 0) {
		new year, month, day, hour, minute, second;
		MyTimeStamp(PlayerInfo[playerid][premium_time]-timestamp, year, month, day, hour, minute, second);

		if(day > 0) {
			format(premium_text_time, sizeof premium_text_time, " (%d اليومs)", day);
		}
		else if(hour > 0) {
			format(premium_text_time, sizeof premium_text_time, " (%d ساعات)", hour);
		}
		else {
			format(premium_text_time, sizeof premium_text_time, " (%d دقائق)", minute);
		}
	}

	new jail_string[100], jail_reason_string[150];

	{	
		if(PlayerInfo[playerid][csjail] > 0)
		{
			format(jail_string, sizeof jail_string, "{F7C300}khedmat Ejtemaii (%d Adad)", PlayerInfo[playerid][jailed]);

			format(jail_reason_string, sizeof jail_reason_string, "{FF0000}%s", PlayerInfo[playerid][jail_reason]);
		}
		else if(PlayerInfo[playerid][jailed] > 0){
			if(PlayerInfo[playerid][jail] == 10) format(jail_string, sizeof jail_string, "{F7C300}إداري مسجون (%d ثوانٍ)", PlayerInfo[playerid][jailed]);
			else format(jail_string, sizeof jail_string, "{F7C300}السجن (%d ثوانٍ)", PlayerInfo[playerid][jailed]);

			format(jail_reason_string, sizeof jail_reason_string, "{FF0000}%s", PlayerInfo[playerid][jail_reason]);
			
		}else
		{
			format(jail_string, sizeof jail_string, c_white"لاne");
			format(jail_reason_string, sizeof jail_reason_string, c_white"لاne");
		}
	}

	new married_string[MAX_PLAYER_NAME];

	if(PlayerInfo[playerid][married_account_id] != -1) format(married_string, sizeof married_string, "%s", get_player_account_name(PlayerInfo[playerid][married_account_id]));
	else format(married_string, sizeof married_string, "Nadard");


	format(global_string, sizeof global_string, "\
	"c_grey"Name:				"c_white"%s\n\
	"c_grey"Account number:		"c_white"%d\n\
	"c_grey"Level:			"c_white"%d\n\
	"c_grey"Level EXP:			"c_white"%d Az %d\n\
	"c_grey"Age:			"c_white"%d\n\
	"c_grey"Hamsar:			"c_white"%s\n\
	"c_grey"Faction Punish:			"c_white"%d\n\
	"c_grey"Faction warns from admin:			"c_white"0\n\
	"c_grey"Warnings:		"c_white"%d\n\n\
	"c_grey"Rob Point:		"c_white"0\n\n\
	"c_grey"Phone number:		"c_white"%d\n\
	"c_grey"On the phone account:		"c_white"%d\n\n\
	"c_grey"Wanted level:		"c_white"%d\n\n\
	"c_grey"Jensiyat:				"c_white"%s\n\
	"c_grey"Work:				"c_white"%s\n\
	"c_grey"Organization:			"c_white"%s\n\
	"c_grey"Rank:				"c_white"%s\n\
	"c_grey"Accommodation:			"c_white"%s\n\
	"c_grey"Business:				"c_white"%s\n\
	"c_grey"VIP status:			"c_white"%s%s\n\
	"c_grey"Premium status:			"c_white"%s%s\n\
	"c_grey"Govahiname ranandegi:		"c_white"%s\n\
	"c_grey"Govahiname kashtirani:			"c_white"%s\n\
	"c_grey"Govahiname khalabani:			"c_white"%s\n\n\
	"c_grey"Time play in today:			"c_white"%02d:%02d:%02d\n\
	"c_grey"Afk in today:			"c_white"%02d:%02d:%02d\n\
	"c_grey"Total time play:			"c_white"%02d:%02d:%02d\n\
	"c_grey"Total AFK:			"c_white"%02d:%02d:%02d\n\
	"c_grey"Jail Status : %s\n\
	"c_grey"Jail Reason : %s\n\n\
	"c_grey"Device: "c_white"%s",

		PlayerInfo[playerid][name], 
		PlayerInfo[playerid][id], 
		PlayerInfo[playerid][level],  
		PlayerInfo[playerid][exp],
		(PlayerInfo[playerid][level] + 1) * 4,
		PlayerInfo[playerid][age],
		married_string,
		PlayerInfo[playerid][faction_punish],
		get_player_warn_count(playerid), 
		PlayerInfo[playerid][number],
		PlayerInfo[playerid][phone_balance],
		PlayerInfo[playerid][wanted],
		mm_gender[PlayerInfo[playerid][gender]],
		job_data,
		fraction_data,
		rank_data,
		house_data,
		business_date,
		(! PlayerInfo[playerid][vip] ? ("Nadarad") : (""c_gold"Gقديم")), vip_text_time,
		(! PlayerInfo[playerid][premium] ? ("Nadarad") : (""c_light_green"نعم")), premium_text_time,
		(PlayerInfo[playerid][drive_lic]) ? return_lic_day(playerid, 1) : (""c_orange_red"لاne"),
		(PlayerInfo[playerid][boat_lic]) ? return_lic_day(playerid, 3) : (""c_orange_red"لاne"),
		(PlayerInfo[playerid][fly_lic]) ? return_lic_day(playerid, 2) : (""c_orange_red"لاne"),
		today_hours, today_minutes, today_seconds,
		today_afk_hours, today_afk_minutes, today_afk_seconds,
		hours, minutes, seconds,
		afk_hours, afk_minutes, afk_seconds,
		jail_string,
		jail_reason_string,
		IsPlayerMobile(playerid) ? ("Android") : ("PC"));

	show_dialog(toid, d_none, DIALOG_STYLE_MSGBOX, !""scm_dialog"إحصائيات اللاعب", global_string, !"Bastan", !"");
	return 1;
}

stock show_security(playerid)
{
	global_string[0] = EOS;
	new number_string[150];

	if(!IsValidPhoneNumber(pPhoneNumber[playerid]))
	{
		fmt(number_string, c_orange_red"Ta'id لم يتمh");
	}else
	{
		fmt(number_string, c_green"Ta'id Shodeh : "c_yellow"%s", pPhoneNumber[playerid]);
	}

	format(global_string, sizeof global_string, "\
	"c_السيرفر"1."c_white" Avaz kardan ramz account\n\
	"c_السيرفر"2."c_white" Vasl kardan account be Google Authenticator | %s\n\
	"c_السيرفر"3."c_white" Taiid Shomare | %s\n\
	"c_السيرفر"4."c_white" Tanzim pin | %s\n\
	"c_السيرفر"5."c_white" Connection history",
	(! PlayerInfo[playerid][google_auth]) ? (""c_orange_red"Gheyr fa'al") : (""c_green"Fa'al"),
	number_string,
	(checkPIN(PlayerInfo[playerid][pin])) ? (""c_orange_red"Gheyr fa'al") : (""c_green"Fa'al"));
	show_dialog(playerid, d_mm_security, DIALOG_STYLE_LIST, ""c_server"الحساب Security Management", global_string, "Entekhab", "Bargasht");
	return 1;
}

stock show_settings(playerid)
{
    global_string[0] = EOS;

    new speedometer_status[20];
    if(PlayerInfo[playerid][settings][SPEEDOMETER_TYPE] == 0)
    	speedometer_status = ""c_green"#1";
    else if(PlayerInfo[playerid][settings][SPEEDOMETER_TYPE] == 1)
    	speedometer_status = ""c_green"#2";
    else if(PlayerInfo[playerid][settings][SPEEDOMETER_TYPE] == 2)
    	speedometer_status = ""c_orange_red"Dهوabled";

	format(global_string, 530, "\
	"c_السيرفر"1 |"c_white" Organization chat display\t%s\n\
	"c_السيرفر"2 |"c_white" Displaying player nicknames\t%s\n\
	"c_السيرفر"3 |"c_white" Display of administration actions\t%s\n\
	"c_السيرفر"4 |"c_white" Showing Player IDs in Chat\t%s\n\
	"c_السيرفر"5 |"c_white" Pacifist Mode\t%s\n\
	"c_السيرفر"6 |"c_white" Speedometer\t%s\n\
	"c_السيرفر"7 |"c_white" Kif Dasti (Pool)\t%s\n\
	"c_السيرفر"8 |"c_white" Auto login\t%s\n\
	"c_السيرفر"9 |"c_white" Walking style\tStyle [%d]\n\
	"c_السيرفر"10 |"c_white" Conversation Style\tStyle [%d]\n\
	"c_السيرفر"11 |"c_white" Loading a texture\t%s",
	(! PlayerInfo[playerid][settings][0]) ? (""c_orange_red"Dهوabled") : (""c_green"Enabled"),
	(! PlayerInfo[playerid][settings][1]) ? (""c_orange_red"Dهوabled") : (""c_green"Enabled"),
	(! PlayerInfo[playerid][settings][2]) ? (""c_orange_red"Dهوabled") : (""c_green"Enabled"),
	(! PlayerInfo[playerid][settings][3]) ? (""c_orange_red"Dهوabled") : (""c_green"Enabled"),
	! PlayerInfo[playerid][settings][PACIFIST_MODE] ? (""c_orange_red"Dهوabled") : (""c_green"Enabled"),
	speedometer_status,
	(! PlayerInfo[playerid][settings][CASH_BERIFCASE_HAND]) ? (""c_orange_red"Dهوabled") : (""c_green"Enabled"),
	(! PlayerInfo[playerid][settings][AUTO_LOGIN]) ? (""c_orange_red"Dهوabled") : (""c_green"Enabled"),
	PlayerInfo[playerid][walkstyle],
	PlayerInfo[playerid][textstyle],
	(! PlayerInfo[playerid][load_textures]) ? (""c_orange_red"Dهوabled") : (""c_green"Enabled"));
	show_dialog(playerid, d_mm_settings_2, DIALOG_STYLE_TABLIST, !""scm_dialog"Personal الإعدادات", global_string, !"Entekhab", !"Bargasht");
	return 1;
}

