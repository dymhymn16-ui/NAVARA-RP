					new query_string[138];
					format(query_string, sizeof(query_string), ""c_green"* "c_white"أنت rope شراءid | "c_green"%d/3"c_white". Vهمd konid "c_green"/tie"c_white" ta kasi ra bandid.", PlayerInfo[playerid][rope]);
					SendClientMessage(playerid, col_white, query_string);
