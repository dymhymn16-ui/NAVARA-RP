callback:check_hunger(playerid)
{
	PlayerInfo[playerid][hunger] -= 3;

	new Float:pl_health;
	GetPlayerHealth(playerid, pl_health);

	if(PlayerInfo[playerid][hunger] <= 35)
	{
		set_health(playerid, pl_health -4);
		SendInfo(playerid, "Shoma Kheyli ziad gorsne hastid. dar sorati ke ghaza nakhorid mimirid");
	}else
	{
		SendInfo(playerid, "Shoma kami gorsne hastid. dar sorati ke ghaza nakhorid mimirid");
	}

	SetPlayerProgressBarValue(playerid, satiety_progress_bar[playerid], PlayerInfo[playerid][hunger]);

	return 1;
}

public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
    if(response == EDIT_RESPONSE_UPDATE) {
    	return 1;
    }

    if(response == EDIT_RESPONSE_CANCEL) {
    	if(editing_object[playerid]) return cancel_created_gate(playerid);
    }

    if(response == EDIT_RESPONSE_FINAL)
    {
		if(editing_object[playerid]) return insert_created_gate(playerid, x, y, z, rx, ry, rz);

        if(p_t_info[playerid][p_listitem_int] == STATUS_ANTIDM_OBJECT)
        {
            AntiDMInfo[count_antidm][dmInfoX] = x;
            AntiDMInfo[count_antidm][dmInfoY] = y;
            AntiDMInfo[count_antidm][dmInfoZ] = z;
            AntiDMInfo[count_antidm][dmInfoRZ] = rz;
            CreateDMZ(playerid);
            DestroyDynamicObject(objectid);
        }
    }

    return 1;
}

public OnPlayerSelectDynamicObject(playerid, objectid, modelid, Float:x, Float:y, Float:z) {

	return 1;
}

