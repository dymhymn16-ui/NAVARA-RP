			if(strval(inputtext) + 1 >= PlayerInfo[playerid][family_rang]) 
				return show_dialog(playerid, d_offamily_pl_rank, DIALOG_STYLE_INPUT, !""scm_dialog"Changing the اللاعب's الرتبة", !""c_grey"لا يمكنك promote the الرتبة higher than yours\n"c_white"أدخل the الرتبة number you want to set for the اللاعب:", !"اختر", !"إلغاء");

