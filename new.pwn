cmd:leaders(playerid)
{
	new count_leaders = 0;
	global_string[0] = EOS;

    format(global_string, sizeof(global_string), "Faction\tالاسم\tالحالة\n");

	foreach(new i: logged_players)
	{
	    new line_string[150];
		if(playerLeaderStatus(i))
		{
			if(pl_afk_time[i] > 2)
			{
				format(line_string, sizeof(line_string), "{%s}%s\t%s[%d]\t"c_red"[AFK]\n", f_info[PlayerInfo[i][member]][f_chat_color], f_info[PlayerInfo[i][member]][f_name], PlayerInfo[i][name], i);
				strcat(global_string, line_string);
			}else
			{
				format(line_string, sizeof(line_string), "{%s}%s\t%s[%d]\t"c_green"[متصل]\n", f_info[PlayerInfo[i][member]][f_chat_color], f_info[PlayerInfo[i][member]][f_name], PlayerInfo[i][name], i);
				strcat(global_string, line_string);
			}

            count_leaders++;
            continue;
		}else
		{
			continue;
		}
	}

	if(!count_leaders) return SendError(playerid, "Hich القائدi dar السيرفر متصل nهوt.");
	else show_dialog(playerid, d_none, DIALOG_STYLE_TABLIST_HEADERS, !""scm_dialog"القائمة القائد", global_string, !"Entekhab", !"Bastan");
	return 1;
}

cmd:vacancy(playerid)
{
    new vacancies = 0;
    new string[6 + 28 + 16];
	global_string[0] = EOS;
	for(new i = 0; i < 10; i++)
	{
	    if(VacancyInfo[i][VacancyStatus]) {
			format(string, sizeof(string), ""c_white"%d. {%s}%s\n", vacancies + 1, f_info [VacancyInfo[i][VacancyFraction] -1][f_chat_color], f_info [VacancyInfo[i][VacancyFraction] -1][f_name]);
			strcat(global_string, string);
	        vacancies++;
	    }
	}
	if(vacancies != 10 && playerLeaderStatus(playerid))
	{
	    strcat(global_string, "Add vacancies");
	  	return show_dialog(playerid, d_vacancy, DIALOG_STYLE_LIST, ""c_server"Vacancies", global_string, "التالي", "Bastan");
	}
	if(vacancies == 0)
		return SendError(playerid, "There هم الحاليly لا vacancies متاح.");

	return show_dialog(playerid, d_vacancy, DIALOG_STYLE_LIST, ""c_server"Vacancies", global_string, "التالي", "Bastan");
}

