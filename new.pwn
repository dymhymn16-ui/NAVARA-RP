			{
				DeletePVar(playerid, "clothes_القائمةالعنصر");
				show_clothes(playerid);
				return 1;
			}

			new list = GetPVarInt(playerid, "clothes_القائمةالعنصر");
			
			new tId = -1;
			new countSkins;

			for(new j = 0; j < 5; j ++)
			{
				if(PlayerInfo[playerid][temp_skin][j] != 0) countSkins++;
				if(PlayerInfo[playerid][temp_skin][j] == PlayerInfo[playerid][temp_skin][list])
				{
					tId = j;
				}
			}

			if(tId == -1) return SendError(playerid, "Shoma in skin ra digar nadarid.");

			switch(listitem)
			{
				case 0:
				{
					if(PlayerInfo[playerid][skin] == PlayerInfo[playerid][temp_skin][list])
					{
						if(PlayerInfo[playerid][gender] == 0) set_skin(playerid, 252);
						else set_skin(playerid, 201);

						SendAccess(playerid, "Shoma ba movafaghiat in lebas ra dar ovordid.");
					}else
					{
						set_skin(playerid, PlayerInfo[playerid][temp_skin][list]);
						SendAccess(playerid, "Shoma ba movafaghiat in lebas ra poshidi.");
					}
				}
				case 1:
				{
					if(countSkins <= 1) return SendError(playerid, "Shoma faght 1 skin darid.");
					
					SendAccess(playerid, "Shoma ba movafaghiat in lebas ra door andakhtid.");

					PlayerInfo[playerid][temp_skin][list] = 0;

					save_temp_skin(playerid);

					if(PlayerInfo[playerid][gender] == 0) set_skin(playerid, 252);
					else set_skin(playerid, 201);
				}
			}
		}
