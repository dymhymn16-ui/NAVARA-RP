			    {
					if(PlayerInfo[playerid][money] < 5000) return SendError(playerid, "Shoma pool kafi nadarid.");
	                veh_info[_v_id -1][v_paint] = GetPVarInt(playerid, "paintالوظيفة_id");


                    give_money(playerid, -5000);
					insert_money_log(playerid, INVALID_PLAYER_ID, -5000, "tuning пеint");
					b_info[GetPVarInt(playerid, "tuning_فتحed")-1][b_money] += 15000;
					b_info[GetPVarInt(playerid, "tuning_فتحed")-1][b_cash_today] += 15000;
			    }
			    case 3: //EXHAUST
			    {
 					if(PlayerInfo[playerid][money] < 15000) return SendError(playerid, "Shoma pool kafi nadarid.");
                    PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
                    give_money(playerid, -15000);
        			insert_money_log(playerid, INVALID_PLAYER_ID, -15000, "tuning exhaust");
		            veh_info[_v_id -1][v_component][2] = exhaust_models[GetPVarInt(playerid, "component_id")-1];
					b_info[GetPVarInt(playerid, "tuning_فتحed")-1][b_money] += 15000;
					b_info[GetPVarInt(playerid, "tuning_فتحed")-1][b_cash_today] += 15000;
			    }
			    case 4: //BULLBARS
