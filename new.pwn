stock GetString(param1[], param2[])
{
	return !strcmp(param1, param2, false);
}

stock is_text_invalid(text[])
{
	if(strfind(text, "'", true)!= -1) return 1;
	if(strfind(text, "=", true)!= -1) return 1;
	if(strfind(text, "%", true)!= -1) return 1;
	if(strfind(text, "&", true)!= -1) return 1;
	if(strfind(text, "*", true)!= -1) return 1;
	if(strfind(text, "(", true)!= -1) return 1;
	if(strfind(text, ")", true)!= -1) return 1;
	if(strfind(text, ",", true)!= -1) return 1;
	if(strfind(text, "`", true)!= -1) return 1;
	if(strfind(text, ";", true)!= -1) return 1;
	if(strfind(text, "|", true)!= -1) return 1;
	return 0;
}

stock IsTextNums(string[], type_delimiter = -1, count_delimiter = 0)
{
    new count_del;
    for(new i, j = strlen(string); i < j; i++)
    {
        if(type_delimiter != -1)
        {
            if(type_delimiter == 0 && string[i] == ',')
            {
                count_del++;
                if(count_del > count_delimiter) return 0;
                continue;
            }
        }
        if(!('0' <= string[i] <= '9'))
            return 0;
    }
    return 1;
}

stock update_int_sql(playerid, field[], data)
{
	new query_string[200];
	format(query_string, sizeof(query_string), "UPالتاريخ `users` SET `%s` = '%d' WHERE `u_id` = '%d' LIMIT 1", field, data, PlayerInfo[playerid][id]);
	mysql_query(sql_connection, query_string);
	return 1;
}

stock update_str_sql(playerid, field[], data[])
{
	new query_string[400];
	format(query_string, sizeof(query_string), "UPالتاريخ `users` SET `%s` = '%s' WHERE `u_id` = '%d' LIMIT 1", field, data, PlayerInfo[playerid][id]);
	mysql_query(sql_connection, query_string);
	return 1;
}

stock give_weapon(playerid, weaponid, ammo, bool:give_save = true)
{
    new slot = WEAPON_Slot[weaponid];
    PlayerInfo[playerid][Weapon][slot] = weaponid;
    if(give_save == true) PlayerInfo[playerid][Ammo][slot] += ammo;
    ResetPlayerWeapons(playerid);
    for(new i; i < MAX_WEAPONS; i++) GivePlayerWeapon(playerid, PlayerInfo[playerid][Weapon][i], PlayerInfo[playerid][Ammo][i]);
	
	if(IsPlayerInAnyVehicle(playerid)) SetPlayerArmedWeapon(playerid, 0);

	return 1;
}

stock take_weapon(playerid, weaponid, ammo)
{
	new slot = WEAPON_Slot[weaponid];
    if(PlayerInfo[playerid][Weapon][slot] == weaponid)
    {
        if(PlayerInfo[playerid][Ammo][slot] > 0) PlayerInfo[playerid][Ammo][slot] -= ammo;
    }

	give_player_save_weapon(playerid);

	return 1;
}

stock set_player_ammo(playerid, weaponid, ammo)
{
	new slot = WEAPON_Slot[weaponid];
	PlayerInfo[playerid][Ammo][slot] = ammo;
	return SetPlayerAmmo(playerid, weaponid, ammo);
}

stock reset_player_weapon(playerid)
{
    for(new i; i < MAX_WEAPONS; i++) {
        PlayerInfo[playerid][Weapon][i] =
        PlayerInfo[playerid][Ammo][i] = 0;
    }
    ResetPlayerWeapons(playerid);

	return 1;
}

stock give_player_save_weapon(playerid)
{
	ResetPlayerWeapons(playerid);
    for(new a = 0; a < MAX_WEAPONS; a++) GivePlayerWeapon(playerid, PlayerInfo[playerid][Weapon][a], PlayerInfo[playerid][Ammo][a]);
    SetPlayerArmedWeapon(playerid, 0);

	return 1;
}

stock player_have_weapon(playerid)
{
	new gun_id = GetPlayerWeapon(playerid);
	
	if(!gun_id || PlayerInfo[playerid][Ammo][WEAPON_Slot[gun_id]] == 0) return 0;
	else return 1;
}

