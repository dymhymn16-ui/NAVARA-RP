	foreach(new i: logged_players) if(PlayerInfo[i][vip]) SendClientMessage(i, col_gray, scm_string);

	return 1;
}

cmd:gc(playerid, params[])
{
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(PlayerInfo[playerid][f_mute]) return SendMes(playerid, col_light_red, "Shoma az chat sazeman mahrum hastid | %d saniye", PlayerInfo[playerid][f_mute]);

	if(!gang_player(playerid)) return SendError(playerid, "In dastor braye shoma dar dastes nهوt.");

	if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /gc [Matn]");
	
	CheckForAdvTexts(playerid, params[0]);

	new scm_string[300];
	format(scm_string, sizeof scm_string, "{326EA1}[GC] {%s}[%s]{326EA1} %s %s[%d]: %s", f_info[PlayerInfo[playerid][member]][f_chat_color], f_info[PlayerInfo[playerid][member]][f_name], f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params[0]);
	SendGangMessage(col_gray, scm_string);

	return 1;
}

cmd:f(playerid, params[])
{
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(PlayerInfo[playerid][f_mute]) return SendMes(playerid, col_light_red, "Shoma az chat sazeman mahrum hastid | %d saniye", PlayerInfo[playerid][f_mute]);
	
	if(gang_player(playerid)|| mafia_player(playerid))
	{
		if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /f [Matn]");
		CheckForAdvTexts(playerid, params[0]);
		new scm_string[144],
			chat_color;

		switch(getPlayerFactionID(playerid))
		{
			case 22..25: chat_color = 0x326EA1FF;
			default: chat_color = 0x2B7FDBFF;
		}

		format(scm_string, sizeof scm_string, "[F] %s %s[%d]: %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params[0]);
		foreach(new i: logged_players) if((PlayerInfo[i][member] == PlayerInfo[playerid][member] || is_control_chat {i} == PlayerInfo[playerid][member]) && PlayerInfo[i][settings][0] != 0)SendClientMessage(i, chat_color, scm_string);
		return 1;
	}
	else if(cop_player(playerid))
	{
		if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /f [Matn]");
		CheckForAdvTexts(playerid, params[0]);
		new scm_string[144];

		format(scm_string, sizeof scm_string, "[F] %s %s[%d]: %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params[0]);
		foreach(new i: logged_players) if((cop_player(i)|| is_control_chat {i} == PlayerInfo[playerid][member] || player_ssf {playerid} == PlayerInfo[playerid][member]) && PlayerInfo[i][settings][0] != 0)SendClientMessage(i, 0x2B7FDBFF, scm_string);
		return 1;
	}
	else if(medic_player(playerid))
	{
		if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /f [Matn]");
		CheckForAdvTexts(playerid, params[0]);
		new scm_string[144];

		format(scm_string, sizeof scm_string, "[F] %s %s[%d]: %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params[0]);
		foreach(new i: logged_players) if((medic_player(i)|| is_control_chat {i} == PlayerInfo[playerid][member] || player_ssf {playerid} == PlayerInfo[playerid][member]) && PlayerInfo[i][settings][0] != 0)SendClientMessage(i, 0x2B7FDBFF, scm_string);
		return 1;
	}
	else if(army_player(playerid))
	{
		if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /f [Matn]");
		CheckForAdvTexts(playerid, params[0]);
		new scm_string[144];

		format(scm_string, sizeof scm_string, "[F] %s %s[%d]: %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], playerid, params[0]);
		foreach(new i: logged_players) if((army_player(i)|| is_control_chat {i} == PlayerInfo[playerid][member]) && PlayerInfo[i][settings][0] != 0)SendClientMessage(i, 0x2B7FDBFF, scm_string);
		return 1;
	}
	else return 1;
}
