//==============================================================================
stock SetupBossTD()
{
	TextDrawSetString(Boss_TD[5],"الصحة: 50000");
	return 1;
}
//==============================================================================

stock DestroyBossTD()
{
	for(new i=0;i<sizeof(Boss_TD);i++)
	{
		TextDrawDestroy(Boss_TD[i]);
	}
	foreach(new i:Player)
	{
		PlayerTextDrawDestroy(i,Boss_PTD[i]);
	}
	return 1;
}

//==============================================================================
stock CheckForAim(playerid)
{
	if(FCNPC_IsMoving(Boss))return 1;
	/*if(IsPlayerConnected(BossTarget)&&IsPlayerInRangeOfPoint(BossTarget, 70.0, BossCircleAreas[BossSpawnLocation][0], BossCircleAreas[BossSpawnLocation][1], BossCircleAreas[BossSpawnLocation][2]))
	{
	}*/
	if(!FCNPC_IsAimingAtPlayer(Boss, playerid)) FCNPC_AimAtPlayer(Boss,playerid,true,550,true);
	BossTarget=playerid;
	return 1;
}
//==============================================================================

stock MoveBoss()
{
	if(!FCNPC_IsValid(Boss))
	{
		KillTimer(BossMoveTimer);
		BossMoveTimer = -1;
		return 1;
	}

	new boss_tmp = RandomNumber(-80, 80), tmp2 = RandomNumber(-80, 80);
	FCNPC_StopAim(Boss);
	BossTarget=-1;
	FCNPC_GoTo(Boss, BossCircleAreas[BossSpawnLocation][0] + boss_tmp, BossCircleAreas[BossSpawnLocation][1] + tmp2, BossCircleAreas[BossSpawnLocation][2], FCNPC_MOVE_TYPE_SPRINT, FCNPC_MOVE_SPEED_SPRINT, .radius = 2.7);
	
	new const Quotes[][] = 
	{
		{"I'm here to conquer the world!"},
		{"What هم those toys? Show me real أسلحة!"},
		{"أنت لاthing!!!"},
		{"I'm gonna destroy you all!"},
		{"Come on, hit me!"},
		{"Say hello to your BOSS!!"},
		{"You all هم خسارةrs!!"},
		{"لاthing can beat me! لاTHING!!!"},
		{"I'm the BOSS!!"},
		{"Don't كانte your bullets, you can't قتل me!"},
		{"Get out of my sight before I slam you!"},
		{"هو that all you got you خسارةrs??"},
		{"If you step رجوع, I may have mercy on you!"}
	};

	UpdateDynamic3DTextLabelText(BossLabel, 0xFF0000FF, Quotes[random(sizeof(Quotes))]);
	return 1;
}
//==============================================================================
stock DestroyBoss()
{
	FCNPC_Destroy(Boss);
	Boss=-1;
	IsBossAsleep=true;
	return 1;
}
//==============================================================================
stock DestroyAngel()
{
	FCNPC_Destroy(Angel);
	Angel=-1;
	return 1;
}
//==============================================================================

stock BossDestroyer()
{
	DestroyDynamicArea(BossArea);
	BossArea=-1;
	DestroyDynamicArea(BossArea2);
	BossArea2=-1;
	DestroyDynamic3DTextLabel(BossLabel);
	BossLabel=Text3D:-1;
	DestroyDynamic3DTextLabel(AngelLabel);
	AngelLabel=Text3D:-1;
	DestroyBossTD();
	SetTimer("DestroyBoss",3000,false);
	SetTimer("DestroyAngel",3000,false);
	BossTimer=-1;
	SendClientMessageToAll(col_gray, ""scm_info"Boss Event تم إلغاءed By The السيرفر Because Of Insufficient Killers.");
	return 1;
}
//==============================================================================

stock ShowPlayerBossTD(playerid)
{
	for(new i=0;i<sizeof(Boss_TD);i++)
	{
		TextDrawShowForPlayer(playerid,Boss_TD[i]);
	}
	PlayerTextDrawShow(playerid,Boss_PTD[playerid]);
	BossTDShowed[playerid]=true;
	return 1;
}
//==============================================================================

stock HidePlayerBossTD(playerid)
{
	for(new i=0;i<sizeof(Boss_TD);i++)
	{
		TextDrawHideForPlayer(playerid,Boss_TD[i]);
	}
	PlayerTextDrawHide(playerid,Boss_PTD[playerid]);
	BossTDShowed[playerid]=false;
	return 1;
}

//==============================================================================
stock RandomNumber(min,max)return random(max-min+1)+min;
//==============================================================================

cmd:wita(playerid,params[])
{
	if(BossArea==-1) return SendClientMessage(playerid,0xFF0000FF, ""scm_error"The boss هو ليس الظهورed yet.");
	SetPlayerCheckpoint(playerid,AngelSpawns[BossSpawnLocation][0], AngelSpawns[BossSpawnLocation][1], AngelSpawns[BossSpawnLocation][2],5.0);
	SendClientMessage(playerid,-1, ""scm_info"[نظام الملاحة] - You may go to the نقطة المهمة to find the boss.");
	UsedWita[playerid] = true;
	return 1;
}

cmd:angel(playerid,params[])
{
	if(Boss==-1)return SendError(playerid, "The boss هو ليس in the world.");
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, AngelSpawns[BossSpawnLocation][0], AngelSpawns[BossSpawnLocation][1], AngelSpawns[BossSpawnLocation][2]))return SendError(playerid, "يجب عليك be near the angel.");
	show_dialog(playerid, d_angel, DIALOG_STYLE_LIST, "What can i do for you?", c_server"1 | "c_white"Best killers القائمة(R1-10)\n"c_server"2 | "c_white"Boss Slayer Gun Pack\n"c_server"3 | "c_white"Angelic revive\n"c_server"4 | "c_white"Angelic heal and armour", "اختر", "إلغاء");
	return 1;
}

cmd:spawnboss(playerid, params[])
{
	if(check_admin_rank(playerid , 4)) return 1;
	SpawnBossOnServer(playerid, params);
	return 1;
}
 
