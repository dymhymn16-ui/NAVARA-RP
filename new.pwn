		case d_truck_buy:
		{
			if(!response) return 1;
			if(strval(inputtext)< 1 || strval(inputtext)> 10000) return SendError(playerid, "لا يمكنك load less than 1 kg. and more than 10,000 kg.");
			new dorm_id = -1;
			if(used_area[playerid] == loading_area[DORM_SAWMILL]) dorm_id = 0;
			else if(used_area[playerid] == loading_area[DORM_MINE]) dorm_id = 1;
			else if(used_area[playerid] == loading_area[DORM_FACTORY]) dorm_id = 4;

			if(strval(inputtext)> dorm_count[dorm_id]) return  SendError(playerid, "We don't have that much in stock.");
			if(PlayerInfo[playerid][money] < strval(inputtext)* 10) return  SendError(playerid, "shoma pol kafi nadarid for purchasing.");
			if(player_trailer[playerid] != INVALID_VEHICLE_ID) return SendError(playerid, "You already have السيارةgo.");

			new queue_id = -1;
			if(dorm_id == 1)
			{
				for(new i = 9; i >= 0; i --)
				{
					if(dorm_queue[DORM_MINE][i] == playerid)
					{
						SendClientMessage(playerid, col_gray, "أنت already standing in line.");
						return 1;
					}
					if(i && dorm_queue[DORM_MINE][i] == INVALID_PLAYER_ID) continue;
					dorm_queue[DORM_MINE][i] = playerid;
					queue_id = i + 1;
					break;
				}
			}
			else if(dorm_id == 0)
			{
				for(new i = 9; i >= 0; i --)
				{
					if(dorm_queue[DORM_SAWMILL][i] == playerid)
					{
						SendClientMessage(playerid, col_gray, "أنت already standing in line.");
						return 1;
					}
					if(i && dorm_queue[DORM_SAWMILL][i] == INVALID_PLAYER_ID) continue;
					dorm_queue[DORM_SAWMILL][i] = playerid;
					queue_id = i + 1;
					break;
				}
			}
			else if(dorm_id == 4)
			{
				for(new i = 9; i >= 0; i --)
				{
					if(dorm_queue[DORM_FACTORY][i] == playerid)
					{
						SendClientMessage(playerid, col_gray, "أنت already standing in line.");
						return 1;
					}
					if(i && dorm_queue[DORM_FACTORY][i] == INVALID_PLAYER_ID) continue;
					dorm_queue[DORM_FACTORY][i] = playerid;
					queue_id = i + 1;
					break;
				}
			}

			if(queue_id == -1)
			{
				SendClientMessage(playerid, col_gray, "The queue هو full, يرجى try again later.");
				return 1;
			}

			SetPVarInt(playerid, "truck_waiting", dorm_id + 1);
			SetPVarInt(playerid, "truck_count", strval(inputtext));
			new _string[128];
			SendClientMessage(playerid, col_gray, "* لديك joined the queue to load the truck. Wait.");
			format(_string, sizeof(_string), "أنت الرقم %d in the queue.", queue_id);
			SendClientMessage(playerid, -1, _string);

			if(dorm_id == 1)
			{
				format(_string, sizeof(_string), "Bought: Metal %d kg. | $%d", strval(inputtext), strval(inputtext)* 10);
			}
			else if(dorm_id == 0)
			{
				format(_string, sizeof(_string), "Bought: Wood %d kg. | $%d", strval(inputtext), strval(inputtext)* 10);
			}
			else if(dorm_id == 4)
			{
				format(_string, sizeof(_string), "Bought: Blanks %d kg. | $%d", strval(inputtext), strval(inputtext)* 10);
			}

			SendClientMessage(playerid, col_succes, _string);
			give_money(playerid, -strval(inputtext)* 10);
			insert_money_log(playerid, INVALID_PLAYER_ID, strval(inputtext)* 10, "شراء سائق شاحنة");
		}
