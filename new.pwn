				SendClientMessage(seller_id[playerid], col_gray, ""c_orange_red"* "c_grey"A اللاعب لا يمكنك السيارةry more than "c_orange_red"500 "c_grey"gr. drugs.");
				buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
