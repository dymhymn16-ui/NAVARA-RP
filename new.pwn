stock return_lic_day(playerid, lic)
{
	new lic_day[50];
	switch(lic)
	{
		case 1: format(lic_day, sizeof lic_day, "(%d) دفعاليوم", PlayerInfo[playerid][drive_lic]);
		case 2: format(lic_day, sizeof lic_day, "(%d) دفعاليوم", PlayerInfo[playerid][fly_lic]);
		case 3: format(lic_day, sizeof lic_day, "(%d) دفعاليوم", PlayerInfo[playerid][boat_lic]);
	}

	return lic_day;
}
