    if(p_t_info[params[0]][p_dialog] != -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"ليس متاح at the moment.");
    if(PlayerInfo[params[0]][gun_lic] != 0) return SendError(playerid, "The اللاعب already has a gun الرخصة.");
    if(params[1] < 5000 || params[1] > 15000) return SendError(playerid, "Gheymat الرخصة must be set to "c_orange_red"5.00 0$"c_grey" о "c_orange_red"15.000 $"c_grey".");

    buyer_id[playerid] = params[0];
	sell_price[playerid] = params[1];
	seller_id[params[0]] = playerid;



	new dialog_string[109 + MAX_PLAYER_NAME + 32 + 1 + 6];

	format(dialog_string, sizeof(dialog_string ), "You offered "c_green"%s"c_white" to acquire a سلاح رخصة for "c_green"$%d",
