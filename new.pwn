cmd:referals(playerid)
{
	SetPVarInt(playerid, "ofm_القائمة_page", 1);
	new _text_string[128];
	format(_text_string, sizeof(_text_string), "اختر `u_الاسم` FROM `users` WHERE `u_referal`='%s'", PlayerInfo[playerid][name]);
	mysql_tquery(sql_connection, _text_string, "اتصالرجوع_referalالقائمة", "i", playerid);
	return 1;
}

cmd:texit(playerid)
{
	if(player_practice {playerid} == 0) return SendError(playerid, "Shoma dar markaz-e amozeshi nهوtid.");

	player_practice {playerid} = 0;
	KillTimer(player_practice_step_timer[playerid]);
	player_practice_step_timer[playerid] = -1;
	DestroyDynamicObject(player_practice_object[playerid]);
	player_practice_object[playerid] = 0;


	set_pos(playerid, 2049.470, -1908.065, 13.546, 270.0, 0, 0);
	SetPVarInt(playerid, "tp_همa_used", 1);

	player_practice_points[playerid] = 0;
	player_practice_timer[playerid] = 0;

	ResetPlayerWeapons(playerid);
	for(new i = 0; i < 12; i ++)
	{
		GivePlayerWeapon(playerid, duel_guns[playerid][i][0], duel_guns[playerid][i][1]);
		duel_guns[playerid][i][0] = 0;
		duel_guns[playerid][i][1] = 0;
	}

	SetPlayerArmedWeapon(playerid, 0);

	return 1;
}

cmd:bizwar(playerid)
{
  	if(timestamp_hour < 12 || timestamp_hour > 22) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"المشروع takeover هو only possible from 12:00 to 23:00.");
  	
	if(mafia_player(playerid))
	{
		if(PlayerInfo[playerid][rank] < 6) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"السيطرة هو only متاح from الرتبة 6.");

	    if(mw_biz != -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The الحرب for المشروع هو already underway.");

		if(mafia_cd > 0)
		{
			new text_str[78];
			format(text_str, sizeof(text_str), ""c_orange_red"* "c_grey"الحافلةiness السيطرة will be متاح through %s", convert_time(mafia_cd));
			return SendClientMessage(playerid, col_gray, text_str);
		}

		for(new b = 0; b < b_count; b ++)
		{
			if(IsPlayerInRangeOfPoint(playerid , 3.0 , b_info[b][b_position][0], b_info[b][b_position][1], b_info[b][b_position][2]))
			{
                if(b_info[b][b_type] == bizz_type_ammo)
                {
                    SendError(playerid, "لا يمكنك السيطرة thهو النوع of المشروع (السيطرة Ammunition can only أدخل).");
                    return 1;
                }
				if(b_info[b][b_mafia] == PlayerInfo[playerid][member])
				{
					SendError(playerid, "You can't بدء taking over your المشروع.");
					return 1;
				}
				if(b_info[b][b_mafia] <= 1)
				{
					b_info[b][b_mafia] = PlayerInfo[playerid][member];

					UpdateBusinessEnterLabel(b);

					new query_string[118];
					format(query_string, 118,"UPالتاريخ `المشروعes` SET `b_mafia` = '%d' WHERE `b_id` = '%d' LIMIT 1", getFactionDBID(b_info[b][b_mafia]), b_info[b][b_id]);
					mysql_tquery(sql_connection, query_string);

					SendClientMessage(playerid, col_white, ""c_green"* "c_white"المشروع taken under control.");
					return 1;
				}

				SendClientMessage(playerid, col_gray, ""c_server"* "c_grey"اختيار on the الخريطة a place for an arrow.");
				SendClientMessage(playerid, col_gray, ""c_server"* "c_grey"Thهو must be the المنطقة in the suburbs of Las Venturas.");
				SetPVarInt(playerid, "biz_الحرب_الخريطة", 1);
				return 1;
			}
		}
		SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Shoma Dar المشروع nهوtid.");
	}
	return 1;
}

cmd:bizlist(playerid, params[])
{
    if(!mafia_player(playerid)) return 1;
	new count_business = 0;

	global_string[0] = EOS;
	strcat(global_string, ""c_white"");
	new line_string[128];
	for(new b = 0; b < b_count; b ++)
	{
		if(b_info[b][b_mafia] != PlayerInfo[playerid][member]) continue;
		format(line_string, sizeof(line_string), ""c_server"%i |"c_white" %s\n", count_business + 1, b_info[b][b_name]);
		strcat(global_string, line_string);
		count_business ++;
	}
	if(count_business < 40)show_dialog(playerid, d_none, DIALOG_STYLE_LIST, !""scm_dialog"Mafia المشروع", global_string, !"Bastan", !"");
	else show_dialog(playerid, d_mw_list, DIALOG_STYLE_LIST, !""scm_dialog"Mafia المشروع", global_string, !"التالي", !"Bastan");
	return 1;
}

cmd:cover(playerid)
{
	if(!fbi_player(playerid)) return 1;

	global_string[0] = EOS;
	for(new j = 17; j < 17 + 5; j ++)
	{
		new line_string[64];
		format(line_string, 64, "{%s}%s\n", f_info[j][f_chat_color], f_info[j][f_name]);
		strcat(global_string, line_string);

	}
	strcat(global_string, "الشرطة\nArmy\nShahrvand");
	show_dialog(playerid, d_fbi_cover, DIALOG_STYLE_LIST, !""scm_dialog"Masking", global_string, !"Entekhab", !"Bastan");
	return 1;
}

cmd:kickout(playerid, params[])
{
	if(!gov_player(playerid)) return 1;

	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /طردout [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't طرد yourself out.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");
	if(is_tazered {params[0]} == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب must be shocked.");
	new scm_string[82];
	format(scm_string, 82, "%s[%d] طردed you out of the universe.",
	PlayerInfo[playerid][name], playerid);
	SendClientMessage(params[0], col_wavy, scm_string);

	format(scm_string, 82, "You طردed %s[%d] out of the universe.",
	PlayerInfo[params[0]][name], params[0]);
	SendClientMessage(playerid, col_wavy, scm_string);


	kickout_cooldown[params[0]] = timestamp + 300;

	set_pos(params[0], 1473.2272,-1766.5834,18.7949,326.2043, 0, 0);
	
	PlayerInfo[playerid][activity_afrad_kick_shode]++;
	update_int_sql(playerid, "u_activity_afrad_طرد_shode", PlayerInfo[playerid][activity_afrad_kick_shode]);

	return 1;
}

public OnGameModeInit()
{
    timestamp = gettime(timestamp_hour, timestamp_minute, timestamp_second)+10800;
    new syncunix = timestamp; 

    syncunix -= timestamp_minute*60; 
    syncunix -= timestamp_second;

    unix_hour = syncunix+3600;
    unix_5_min = syncunix+300;
    unix_10_min = syncunix+600;
    unix_min = syncunix+60;
    unix_sec = syncunix;
    unix_three_sec = syncunix+3;

    timers_unix = SetTimer("الوقتr_Unix", 500, true);

	//-----------------------------------------------------------

	SendRconCommand("hostالاسم Darحالة بدء...");

	new GameModeText[100];
	fmt(GameModeText, "MRP v%s Android/PC", project_version);
	SetGameModeText(GameModeText);

	global_weather = 1;

	new Year, Month, Day;
	getdate(Year, Month, Day);

    print("\n--------------------------------------------------");
    print("-- Mihan Role Play\n\n");
    print("-- المطور: Abolfazl Hosseini (Github : @inj3ct0r & Tel: @inject3r)\n");
    printf("-- Version: %s\n", project_version);
