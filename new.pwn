				strcat(global_string, line_string);
			}
			show_dialog(playerid, d_family_rank_list, DIALOG_STYLE_LIST, !""scm_dialog"Title الحالة", global_string, !"Entekhab", !"Bargasht");

			dlobal_string[0] = EOS;
			mysql_format(sql_connection, dlobal_string, sizeof(dlobal_string), "UPالتاريخ `العائلة` SET `fam_الرتبةs`='%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e|%e' WHERE `fam_id`='%d' LIMIT 1", family_rank[familyid][0], family_rank[familyid][1], family_rank[familyid][2], family_rank[familyid][3], family_rank[familyid][4], family_rank[familyid][5], family_rank[familyid][6], family_rank[familyid][7], family_rank[familyid][8], family_rank[familyid][9], family_rank[familyid][10], family_rank[familyid][11], family_rank[familyid][12], family_rank[familyid][13], family_rank[familyid][14], family_rank[familyid][15], family_rank[familyid][16], family_rank[familyid][17], family_rank[familyid][18], family_rank[familyid][19], getPlayerFamilyID(playerid));
			mysql_query(sql_connection, dlobal_string);
