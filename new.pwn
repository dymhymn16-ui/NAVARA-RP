cmd:phone(playerid)
{
	if(PlyayerIsGang && !PlayerInfo[playerid][phone_selected]) return SendError(playerid, "لا تملك هاتفًا محمولًا.");
    if(PlyayerIsGang && !PlayerInfo[playerid][number]) return SendError(playerid, " لا تملك a SIM السيارةd.");
	
	global_string[0] = EOS;
	format(global_string, 254, "\
"c_السيرفر"1. "c_white" Call emergency services\n\
"c_السيرفر"2. "c_white" Call number\n\
"c_السيرفر"3. "c_white" Send message\n\
"c_السيرفر"4. "c_white"List of contacts\n\
"c_السيرفر"5. "c_white"Add contact\n\
"c_السيرفر"6. %s "c_white"phone",
	(p_t_info[playerid][phone_toggled]) ? ""c_orange_red"Dهوable" : ""c_green"Dهوable");
	show_dialog(playerid, d_phone_main, DIALOG_STYLE_LIST, !""scm_dialog"الهاتف المحمول", global_string, !"Entekhab", !"Bastan");
	
	new phone_name[12], scm_string[57];

	switch(PlayerInfo[playerid][phone_selected])
	{
	    case 1: phone_name = "Samsung A53";
	    case 2: phone_name = "iالهاتف 16";
	}

	format(scm_string, sizeof(scm_string), "got %s out of pocket", phone_name);
	me_action(playerid, scm_string);
	
	return 1;
}

cmd:call(playerid, params[])
{
	if(GetPVarInt(playerid, "اللاعبCuffed")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"shoma cuff hastid.");
    if(GetPVarInt(playerid, "اللاعبTied")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت connected.");
    if(PlyayerIsGang && !PlayerInfo[playerid][number]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت الهاتف المحمول لا تملك.");
    if(!p_t_info[playerid][phone_toggled]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لديك dهوabled your mobile الهاتف.");
    if(p_t_info[playerid][phone_id] != INVALID_PLAYER_ID || is_ether_calling {playerid} != -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"End الحالي conversation.");
    if(PlayerInfo[playerid][phone_balance] < 1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Your الهاتف الرصيد هو zero.");
    if(is_ether {playerid} != -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey" ra.");
    if(sscanf(params, "d", params[0])) return SendInfo(playerid, "أدخل: /اتصال [number]");
    if(PlayerInfo[playerid][number] == params[0]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't اتصال yourself.");

    if(params[0] == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The given number does ليس exهوt.");

	if(params[0] == 911)
	{
		show_dialog(playerid, d_service, DIALOG_STYLE_LIST, ""c_server"Services", "الشرطة\nالطوارئ Service (Medic)\nتاكسي\nالميكانيكي\nالطعام التوصيل", "Entekhab", "Bargasht");
		return 1;
	}
	if(params[0] == f_info[25][f_materials]&& cas_price[0] != 0)
	{
		new scm_string[98];
		format(scm_string, sizeof scm_string, ""c_white"Gheymat اتصال: $%d.\n\nDo you really want to اتصال?",
		cas_price[0]);
		show_dialog(playerid, d_ether_calling, DIALOG_STYLE_MSGBOX, ""c_server"الاتصال بالبث المباشر", scm_string, "Bale", "Khyer");
		is_ether_calling {playerid} = 26;
		return 1;
	}

	if(params[0] == f_info[26][f_materials]&& cas_price[1] != 0)
	{
		new scm_string[98];
		format(scm_string, sizeof scm_string, ""c_white"Gheymat اتصال: $%d.\n\nDo you really want to اتصال?",
		cas_price[1]);
		show_dialog(playerid, d_ether_calling, DIALOG_STYLE_MSGBOX, ""c_server"الاتصال بالبث المباشر",scm_string, "Bale", "Khyer");
		is_ether_calling {playerid} = 27;
		return 1;
	}

	if(params[0] == f_info[27][f_materials]&& cas_price[2] != 0)
	{
		new scm_string[98];
		format(scm_string, sizeof scm_string, ""c_white"Gheymat اتصال: $%d.\n\nDo you really want to اتصال?",
		cas_price[2]);
		show_dialog(playerid, d_ether_calling, DIALOG_STYLE_MSGBOX, ""c_server"الاتصال بالبث المباشر", scm_string, "Bale", "Khyer");
		is_ether_calling {playerid} = 28;
		return 1;
	}

	foreach(new i: logged_players)
	{
		if(PlayerInfo[i][number] == params[0])
		{
			if(!p_t_info[i][phone_toggled]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب's mobile الهاتف هو turned off.");
			if(p_t_info[i][phone_id] != INVALID_PLAYER_ID) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The subscriber هو الحاليly talking to someone.");
			new scm_string[128];
			format(scm_string, 128, "You اتصال %s (%d). Waiting for a reply...", PlayerInfo[i][name], PlayerInfo[i][number]);
			SendClientMessage(playerid, -1, scm_string);

			format(scm_string, 128, "أنت اتصالed by %s (%d). Answer the اتصال...", PlayerInfo[playerid][name], PlayerInfo[playerid][number]);
			SendClientMessage(i, -1, scm_string);

			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USECELLPHONE);
			SetPlayerAttachedObject(playerid, 3, 18870, 6, 0.09, 0.019, -0.011, 88.90, -176.40, 0.49, 0.787, 0.753, 0.562);

			p_t_info[playerid][phone_caller] = 1;
			p_t_info[i][phone_id] = playerid;
			p_t_info[i][phone_caller] = 1;

			return 1;
		}
	}
	return 1;
}


cmd:p(playerid)
{
	if(GetPVarInt(playerid, "اللاعبCuffed")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"shoma cuff hastid.");
    if(GetPVarInt(playerid, "اللاعبTied")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت connected.");
    if(PlyayerIsGang && !PlayerInfo[playerid][number]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت الهاتف المحمول لا تملك.");
    if(!p_t_info[playerid][phone_toggled]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لديك dهوabled your mobile الهاتف.");
	if(p_t_info[playerid][phone_id] == INVALID_PLAYER_ID || p_t_info[playerid][phone_caller] == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا one هو اتصالing you.");
    if(!p_t_info[playerid][p_logged]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا one هو اتصالing you.");
	if(is_ether {playerid} != -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't talk on the الهاتف while on the air.");

	new scm_string[30 + MAX_PLAYER_NAME];
	format(scm_string, sizeof(scm_string), "%s Answered the اتصال.", PlayerInfo[playerid][name]);
	SendClientMessage(p_t_info[playerid][phone_id], col_yellow, scm_string);

	p_t_info[playerid][phone_caller] = 0;
	p_t_info[p_t_info[playerid][phone_id]][phone_caller] = 0;
	p_t_info[p_t_info[playerid][phone_id]][phone_id] = playerid;
	CreateVoicePhoneCallChannel(p_t_info[playerid][phone_id], playerid);

	PlayerInfo[p_t_info[playerid][phone_id]][phone_balance] --;

	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
	SetPlayerAttachedObject(playerid, 3, 18870, 6, 0.09, 0.019, -0.011, 88.90, -176.40, 0.49, 0.787, 0.753, 0.562);


	return 1;
}

cmd:h(playerid)
{
	if(PlyayerIsGang && !PlayerInfo[playerid][number]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت الهاتف المحمول لا تملك.");
	if(!p_t_info[playerid][phone_toggled]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Your mobile الهاتف هو turned off.");
	if(p_t_info[playerid][phone_id] == INVALID_PLAYER_ID && is_ether_calling {playerid} == -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لاbody اتصالs you.");


	if(is_ether_calling {playerid} != -1)
	{
		is_ether {playerid} = -1;
		is_ether_calling {playerid} = -1;
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
		RemovePlayerAttachedObject(playerid, 3);
		SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You turn off the air.");

		return 1;
	}
	new scm_string[20 + MAX_PLAYER_NAME];
	format(scm_string, sizeof(scm_string), "%s put the handset down.", PlayerInfo[playerid][name]);
	SendClientMessage(p_t_info[playerid][phone_id], col_light_purple, scm_string);
	SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لديك finهوhed the الحالي conversation.");


 	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
 	SetPlayerSpecialAction(p_t_info[playerid][phone_id], SPECIAL_ACTION_STOPUSECELLPHONE);
  	RemovePlayerAttachedObject(playerid, 3);
  	RemovePlayerAttachedObject(p_t_info[playerid][phone_id], 3);

  	new temp_stream_id = GetPlayerPhoneCallStreamVC(playerid);
	ResetVoicePhoneCallChannel(playerid);
	ResetVoicePhoneCallChannel(p_t_info[playerid][phone_id]);
	DeleteVoicePhoneCallChannel(temp_stream_id);

	p_t_info[p_t_info[playerid][phone_id]][phone_id] = INVALID_PLAYER_ID;
	p_t_info[p_t_info[playerid][phone_id]][phone_caller] = 0;

	p_t_info[playerid][phone_id] = INVALID_PLAYER_ID;
	p_t_info[playerid][phone_caller] = 0;

	return 1;
}
cmd:sms(playerid, params[])
{
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(GetPVarInt(playerid, "اللاعبCuffed")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"shoma cuff hastid.");
    if(GetPVarInt(playerid, "اللاعبTied")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت connected.");
    if(PlyayerIsGang && !PlayerInfo[playerid][number]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت الهاتف المحمول لا تملك.");
    if(!p_t_info[playerid][phone_toggled]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لديك dهوabled your mobile الهاتف.");
    if(PlayerInfo[playerid][phone_balance] < 5) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا تملك any means to send SMS.");
    if(sscanf(params, "ds[82]", params[0], params[1])) return SendInfo(playerid, "أدخل: /sms [number] [Matn]" );
    if(params[0] == 0) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The given number does ليس exهوt.");
	CheckForAdvTexts(playerid, params[1]);
	foreach(new i: logged_players)
	{
		if(PlayerInfo[i][number] == params[0])
		{
			if(i == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا يمكنك send SMS to yourself.");

			if(!p_t_info[i][phone_toggled])
			{
				return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The اللاعب's mobile الهاتف هو turned off.");
			}
			new scm_string[144];

			format(scm_string, sizeof(scm_string), "SMS: %s | Recipient: %s(%i) [t. %i]", params[1], PlayerInfo[i][name], i, PlayerInfo[i][number]);
			SendClientMessage(playerid, col_yellow, scm_string);
			format(scm_string, sizeof(scm_string), "SMS: %s | Sender: %s(%i) [t. %i]", params[1], PlayerInfo[playerid][name], playerid, PlayerInfo[playerid][number]);
			SendClientMessage(i,  col_yellow, scm_string);

			format(scm_string, sizeof(scm_string), "SMS: %s(%d) to %s(%d) | %s", PlayerInfo[playerid][name], playerid, PlayerInfo[i][name], i, params[1]);
			foreach(new j: admin_players)
			{
				if(big_ears {playerid} == 0) continue;
				SendClientMessage(j,  col_yellow, scm_string);
			}
			PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0);
			PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
			PlayerInfo[playerid][phone_balance] --;
			return 1;
		}
	}
	SendError(playerid, "Subscriber هو الحاليly غير متاح!");
	return 1;
}

cmd:togphone(playerid)
{
	if(GetPVarInt(playerid, "اللاعبCuffed")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"shoma cuff hastid.");
	if(GetPVarInt(playerid, "اللاعبTied")) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت connected.");
	if(PlyayerIsGang && !PlayerInfo[playerid][number]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت الهاتف المحمول لا تملك.");
	if(!p_t_info[playerid][phone_toggled])
	{
		p_t_info[playerid][phone_toggled] = true;
		SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You turned on your mobile الهاتف.");
	}
	else
	{
		p_t_info[playerid][phone_toggled] = false;
		SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You turned off your mobile الهاتف.");

	}
	return 1;
}

