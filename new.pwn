		case d_donate_accessories:
		{
			if(!response) return show_donate(playerid);

			new totalPages = (MAX_ACCESSORIES + ITEMS_PER_PAGE - 1) / ITEMS_PER_PAGE;

			switch (listitem) {
				case 0: // Next button
				{
					if(g_CurrentPage[playerid] + 1 >= totalPages) {
						ShowAccessoriesDialog(playerid, g_CurrentPage[playerid]);
						return SendError(playerid, "Shoma dar akharin safhe accessories القائمة hastid.");
					}
					return ShowAccessoriesDialog(playerid, g_CurrentPage[playerid] + 1);
				}
				case 1: // Previous button
				{
					if(g_CurrentPage[playerid] == 0) {
						ShowAccessoriesDialog(playerid, g_CurrentPage[playerid]);
						return SendError(playerid, "Shoma dar safe aval accessories القائمة hastid.");
					}
					return ShowAccessoriesDialog(playerid, g_CurrentPage[playerid] - 1);
				}
			}

			new selectedID = g_CurrentPage[playerid] * ITEMS_PER_PAGE + (listitem - 2);

			if(selectedID >= 0 && selectedID < MAX_ACCESSORIES) {
				SetPVarInt(playerid, "aID", selectedID);
				dialog_donate_accessories(playerid, selectedID);
			}

			return 1;
		}
		case d_donate_accessories_buy:
		{
			new ACID = GetPVarInt(playerid, "aID");
			DeletePVar(playerid, "aID");

			if(!response) return ShowAccessoriesDialog(playerid, ACID);

			if(ConvertToDonateCard(AccessoriesInfo[ACID][aPrice]) > get_player_donate(playerid)) return dialog_donate_accessories(playerid, ACID, "أنت M-Coin kafi baraye شراء in accessory لا تملك.");
			if(GetFreeSlotAccessories(playerid) == ALL_BUSY_SLOT_ACCESSORIES) return dialog_donate_accessories(playerid, ACID, "أنت hich eslat فارغ baraye accessories لا تملك.");
			
			SetFreeSlotAccessories(playerid, AccessoriesInfo[ACID][aID]);

			give_donate(playerid, -ConvertToDonateCard(AccessoriesInfo[ACID][aPrice]));

			SendInfo(playerid, "Shoma ba movafaghiyat accessory "c_yellow"%s"c_white" ro kharidari kardid.", AccessoriesInfo[ACID][aName]);

			return 1;
		}
		case d_donate_droul:
		{
			if(!response) return show_donate(playerid);
			if(50 > get_player_donate(playerid)) return dialog_donate_droul(playerid, "أنت M-Coin kafi baraye شراء in الخدمة لا تملك.");

			PlayerInfo[playerid][donate_roulette] += 1;

			RunQuery("UPالتاريخ `users` SET `u_donate` = `u_donate`-'50',`u_droulette`='%d' WHERE `u_id` = '%d' LIMIT 1", PlayerInfo[playerid][donate_roulette], PlayerInfo[playerid][id]);

			show_donate(playerid);

			SendAccess(playerid, "Your donation service تم تمت العملية بنجاحfully شراءd.");

			return 1;
		}
		case d_donate_jobinfo:
		{
			if(!response) return show_donate(playerid);

			if(50 > get_player_donate(playerid)) return dialog_donate_wbook(playerid, "أنت M-Coin kafi baraye شراء in الخدمة لا تملك.");

			give_donate(playerid, -50);

			clearWorkBook(playerid);

			show_donate(playerid);

			SendAccess(playerid, "Your donation service تم تمت العملية بنجاحfully شراءd.");

			return 1;
		}
		case d_donate_vipgold:
		{
			if(!response) return show_donate(playerid);
			if(PlyayerIsGang && !PlayerInfo[playerid][premium]) return show_donate(playerid), SendError(playerid, "الحساب shoma VIP "c_server"'Gقديم'"c_white" ast.");
			if(get_player_donate(playerid) < 150) return dialog_donate_wbook(playerid, "أنت M-Coin kafi baraye شراء in الخدمة لا تملك.");

			PlayerInfo[playerid][vip_time] = timestamp + (60 * 60 * 24 * 30);
			PlayerInfo[playerid][vip] = 1;

			UpdatePlayerName(playerid);

			RunQuery("UPالتاريخ `users` SET `u_vip` = '1', `u_vip_الوقت` = %d, `u_donate` = `u_donate` -'150', `u_maxveh` = '%d',`u_الجوعimmune` = '1' WHERE `u_id` = '%d' LIMIT 1", PlayerInfo[playerid][vip_time], PlayerInfo[playerid][max_veh], PlayerInfo[playerid][id]);

			SendAccess(playerid, "Shoma ba movafaghiyat VIP service "c_server"'Gقديم'"c_white" ro kharidari kardid.");

			return 1;
		}
		case d_donate_premium:
		{
			if(!response) return show_donate(playerid);
			if(PlayerInfo[playerid][premium]) return show_donate(playerid), SendError(playerid, "الحساب shoma "c_gold"Premium"c_white" ast.");
			if(get_player_donate(playerid) < 350) return dialog_donate_premium(playerid, "أنت M-Coin kafi baraye شراء in الخدمة لا تملك.");
		
			PlayerInfo[playerid][premium_time] = timestamp + (60 * 60 * 24 * 30);
			PlayerInfo[playerid][premium] = 1;
			Iter_Add(premium_players, playerid);
			SetPlayerPremiumTag(playerid);
			UpdatePlayerName(playerid);

			update_int_sql(playerid, "u_premium", PlayerInfo[playerid][premium]);
			update_int_sql(playerid, "u_premium_الوقت", PlayerInfo[playerid][premium_time]);

			SendAccess(playerid, "Shoma ba movafaghiyat "c_gold"Premium"c_white" service ro kharidari kardid.");
		}
		case d_donate_gender:
		{
			if(!response) return show_donate(playerid);
			if(get_player_donate(playerid) < 50) return dialog_donate_gender(playerid, "أنت M-Coin kafi baraye شراء in الخدمة لا تملك.");
		
			if(PlayerInfo[playerid][gender] == 0) PlayerInfo[playerid][gender] = 1;
			else PlayerInfo[playerid][gender] = 0;

			update_int_sql(playerid, "u_gender", PlayerInfo[playerid][gender]);

			SendAccess(playerid, "Shoma ba movafaghiat jensiyat khod ra taghyir dadid.");
		}
