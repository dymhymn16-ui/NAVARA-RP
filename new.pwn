alias:spawnchange("setالظهور", "changeالظهور");
cmd:spawnchange(playerid)
{
    new spawn_text[34];
    switch(PlayerInfo[playerid][spawnchange])
    {
        case 0: spawn_text = "هوtgah Ghatar";
        case 1: spawn_text = "Dakhel Khane";
        case 2: spawn_text = "Dakhel Faction";
        case 3: spawn_text = "Dakhel Yachat Shakhsi";
        case 4: spawn_text = "Dakhel Khoneh Ejهمh Shode";
        case 5: spawn_text = "Dakhel Khoneh العائلة";
        case 6: spawn_text = "Dakhel Journey Shakhsi";
    }
    dlobal_string[0] = EOS;

    new line_string[75];
    format(line_string, sizeof(line_string), ""c_white"Maحالة الظهور أنت: "c_server"%s\n", spawn_text);
    strcat(dlobal_string, line_string);

    strcat(dlobal_string, ""c_server"1 | "c_white"هوtgah Ghatar\n");
    strcat(dlobal_string, ""c_server"2 | "c_white"Dakhel Khane\n");
    strcat(dlobal_string, ""c_server"3 | "c_white"Dakhel Faction\n");
    strcat(dlobal_string, ""c_server"4 | "c_white"Dakhel Yachat Shakhsi\n");
    strcat(dlobal_string, ""c_server"5 | "c_white"Dakhel Khoneh Ejهمh Shode\n");
    strcat(dlobal_string, ""c_server"6 | "c_white"Dakhel Khoneh العائلة\n");
    strcat(dlobal_string, ""c_server"7 | "c_white"Dakhel Journey Shakhsi");

    return show_dialog(playerid, d_spawnchange, DIALOG_STYLE_LIST, !""scm_dialog"Avaz Kardan Mahal الظهور", dlobal_string, !"Entekhab", !"Bastan");
}


cmd:exitrace(playerid)
{
	if(!is_player_race_regged[playerid]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت ليس in the race.");
	is_player_race_regged[playerid] = 0;
	PlayerRaceCount--;
	if(StartRace == 2)
 	{
		DestroyVehicle(player_race_vehicle[playerid]);
		DisableRemoteVehicleCollisions(playerid, 0);
		DisablePlayerRaceCheckpoint(playerid);
		set_pos(playerid, 1298.1658, -1360.8027, 35.8113, 21.7293, 0, 5);
		player_race_cp[playerid] =
		player_race_vehicle[playerid] = 0;
	}
	SendClientMessage(playerid, col_white, !""c_green"* "c_white"Shoma Ba Movafghiat quit the race.");
	return 1;
}

cmd:exitpaint(playerid)
{
    if(!TeamPaint[playerid]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت ليس a عضو of PaintBall.");
	if(StartPaintBall == 2)
	{
 		set_health(playerid, 100);
		ResetPlayerWeapons(playerid);
		SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

		set_pos(playerid, 1298.1658, -1360.8027, 35.8113, 21.7293, 0, 5);
		TextDrawHideForPlayer(playerid, PaintTextDraws);
		PlayerTextDrawHide(playerid, PaintStats[playerid]);
		for(new j = 0; j < 5; j ++) SendDeathMessageToPlayer(playerid, 1001, 1001, 200);

		ResetPlayerWeapons(playerid);
        for(new a = 0; a < MAX_WEAPONS; a++) GivePlayerWeapon(playerid, PlayerInfo[playerid][Weapon][a], PlayerInfo[playerid][Ammo][a]);
        SetPlayerArmedWeapon(playerid, 0);
		
		KillPaint[playerid] =
		DeathPaint[playerid] = 0;
	}
	switch(TeamPaint[playerid])
	{
	    case 1: BluePlayer--;
	    case 2: RedPlayer--;
	}
	TeamPaint[playerid] = 0;
	SendClientMessage(playerid, col_white, !""c_green"* "c_white"Shoma Ba Movafghiat left PaintBall.");

	if(is_fraction_duty {playerid} == 1)SetPlayerColor(playerid, f_info[PlayerInfo[playerid][member]][f_radar_color]);
	else SetPlayerColor(playerid, 0xFFFFFF80); // col_white

	return 1;
}

cmd:startpaint(playerid)
{
	if(check_admin_rank(playerid , 6)) return 1;

	TimerPaintBall = 180;
	StartPaintBall = 1;
	RedScore = BlueScore = RedPlayer = BluePlayer = 0;

	if(++ PaintBallMap > 2)PaintBallMap = 1;

	foreach(new i: logged_players)
	{
		if(TeamPaint[i])
		{
			TeamPaint[i] = KillPaint[i] = DeathPaint[i] = 0;
			set_pos(i, 1298.1658, -1360.8027, 35.8113, 21.7293, 0, 5);
		}
	}

	SendClientMessageToAll(col_gray, ""c_server"[PaintBall]"c_white" Mosabeghe "c_yellow"\"PaintBall\""c_white" ta 3 daghighe digar bargozar mهوhe. Baraye raftan be paintball "c_server"/go"c_white" ra النوع konid.");
	return 1;
}

cmd:lc(playerid)
{
	if(!playerLeaderStatus(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Thهو command هو only متاح to organization القائدs.");
	if(p_t_info[playerid][lconnect] == true)
 	{
 		p_t_info[playerid][lconnect] = false;
 		SendClientMessage(playerid, -1, ""c_server"* L.المعلومات:"c_grey" لديك تمت العملية بنجاحfully dهوabled القائمةening to the القائد's chat!");
	}
	else
	{
		p_t_info[playerid][lconnect] = true;
		SendClientMessage(playerid, -1, ""c_server"* L.المعلومات:"c_grey" لديك تمت العملية بنجاحfully enabled القائمةening to the القائد's chat!");
	}
	return 1;
}
cmd:l(playerid, params[])
{
	if(!playerLeaderStatus(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Thهو command هو only متاح to organization القائدs.");
	if(p_t_info[playerid][lconnect] == false) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت dهوconnected from the القائد chat (/lc).");
	if(sscanf(params, "s[128]", params[0])) return SendInfo(playerid, "أدخل: /l [Matn]");
	new scm_string[144];
	format(scm_string, sizeof scm_string, "[L] %s %s[%d]: %s", f_info[PlayerInfo[playerid][member]][f_name], PlayerInfo[playerid][name], playerid, params[0]);
	foreach(new i: logged_players) if(playerLeaderStatus(i) && p_t_info[i][lconnect] != false)SendClientMessage(i, 0xFF8C00FF, scm_string);
	return 1;
}

cmd:rlock(playerid)
{
	if(player_rentcar[playerid] == INVALID_VEHICLE_ID) return SendError(playerid, "Shoma hich vasile naghlie ejهمh nmikonid.");

	if(player_rentcar[playerid] == GetPlayerVehicleID(playerid))
	{
		PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
		if(veh_info[player_rentcar[playerid] -1][v_locked])
		{
			new engine, lights, alarm, doors, bonnet, boot, objective;

			veh_info[player_rentcar[playerid] -1][v_locked] = false;
			GetVehicleParamsEx(player_rentcar[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(player_rentcar[playerid], engine, lights, alarm, false, bonnet, boot, objective);
			GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~ السيارة UNLOCK", 3000, 3);
			me_action(playerid, "مفتوح the النقل");
			return 1;
		}
		else
		{
			new engine, lights, alarm, doors, bonnet, boot, objective;

			veh_info[player_rentcar[playerid] -1][v_locked] = true;
			GetVehicleParamsEx(player_rentcar[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(player_rentcar[playerid], engine, lights, alarm, true, bonnet, boot, objective);
			GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ السيارة LOCK", 3000, 3);
			me_action(playerid, "مغلق the النقل");
			return 1;
		}
	}
	new Float:pl_pos_x,
		Float:pl_pos_y,
		Float:pl_pos_z;

	GetPlayerPos(playerid, pl_pos_x, pl_pos_y, pl_pos_z);

	if(IsVehicleInRangeOfPoint(player_rentcar[playerid], 2.5, pl_pos_x, pl_pos_y, pl_pos_z))
	{
		PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
		if(veh_info[player_rentcar[playerid] -1][v_locked])
		{
			new engine, lights, alarm, doors, bonnet, boot, objective;

			veh_info[player_rentcar[playerid] -1][v_locked] = false;
			GetVehicleParamsEx(player_rentcar[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(player_rentcar[playerid], engine, lights, alarm, false, bonnet, boot, objective);
			GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~ السيارة UNLOCK", 3000, 3);
			me_action(playerid, "مفتوح the النقل");
			return 1;
		}
		else
		{
			new engine, lights, alarm, doors, bonnet, boot, objective;

			veh_info[player_rentcar[playerid] -1][v_locked] = true;
			GetVehicleParamsEx(player_rentcar[playerid], engine, lights, alarm, doors, bonnet, boot, objective);
			SetVehicleParamsEx(player_rentcar[playerid], engine, lights, alarm, true, bonnet, boot, objective);
			GameTextForPlayer(playerid,"~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ السيارة LOCK", 3000, 3);
			me_action(playerid, "مغلق the النقل");
			return 1;
		}
	}
	return 1;
}

cmd:gomp(playerid)
{
	if(!GetSVarInt("Aidاللاعبون")) return SendError(playerid, "Gathering of اللاعبون هو ليس بدءed");
    
	if(!checkPlayerAllowed(playerid)) return 1;

	if(GetSVarInt("Aidاللاعبون") < 2)
    {
        SendClientMessage(playerid, col_white, !""c_server"* S.المعلومات:"c_grey" Event Baste Shod.");
        DeleteSVar("mp_pos_x");  DeleteSVar("mp_pos_y"); DeleteSVar("mp_pos_z");
		DeleteSVar("Aidاللاعبون");
		DeleteSVar("mp_int");  DeleteSVar("mp_virt");
		return 1;
    }
    SetSVarInt("Aidاللاعبون",GetSVarInt("Aidاللاعبون")-1);

	if(PlayerInfo[playerid][settings][PACIFIST_MODE])
		PacifistModeToggle(playerid, 0);

	p_t_info[playerid][gomp] = true;

    set_pos(playerid, GetSVarFloat("mp_pos_x") + random(5), GetSVarFloat("mp_pos_y") + random(5), GetSVarFloat("mp_pos_z"), 0.0, GetSVarInt("mp_int"), GetSVarInt("mp_virt"));

    return SendClientMessage(playerid, col_white, !""c_server"* S.المعلومات:"c_grey" You were teleported to the event, waiting for the إداريهوtration team.");
}

cmd:eject(playerid, params[])
{
	if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "يجب عليك be in transport.");
	else if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "يجب عليك be behind the wheelм.");
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /eject [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");

	if(playerid == params[0]) return SendError(playerid, "You can't throw yourself out.");
	if(!IsPlayerInVehicle(params[0],player_vehicle[playerid])) return SendError(playerid, "The اللاعب must be in your transport.");
	new string[100];
	format(string, sizeof(string), ""c_green"* "c_white"You threw out of the النقل "c_green"%s", PlayerInfo[params[0]][name]);
	SendClientMessage(playerid, col_white, string);
	format(string, sizeof(string), ""c_green"* %s"c_white" threw you out of the النقل", PlayerInfo[playerid][name]);
	SendClientMessage(params[0], col_white, string);
	format(string, sizeof(string), "thrown out of النقل %s", PlayerInfo[params[0]][name]);
	me_action(playerid, string);
	RemovePlayerFromVehicle(params[0]);
	return 1;
}

cmd:usecanister(playerid)
{
	if(GetPVarInt(playerid, "اللاعبCuffed"))
	{
		SendError(playerid, "Do ليس use the canهوter while handcuffed.");
		return 1;
	}
	if(PlyayerIsGang && !PlayerInfo[playerid][canister]) return SendError(playerid, "لا تملك a can of gasoline.");
	if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "يجب عليك be at the wheel of a المركبة.");
	if(GetVehicleSpeed(player_vehicle[playerid]) > 5) return SendError(playerid, "Do ليس use a can of gasoline while running.");

	new vehicle_id = GetPlayerVehicleID(playerid)-1;

	if(check_fuel_vehicle(playerid)) return 1;

	veh_info[vehicle_id][v_fuel] += 15;
	if(veh_info[vehicle_id][v_fuel] > 100)veh_info[vehicle_id][v_fuel] = 100;
    SendClientMessage(playerid, col_white, ""c_green"* "c_white"Shoma Ba Movafghiat reالوقودed their transport.");

	me_action(playerid, "reالوقودed hهو السيارة.");
	PlayerInfo[playerid][canister] -= 1;
	update_int_sql(playerid, "u_canهوter", PlayerInfo[playerid][canister]);
	return 1;
}

cmd:hotdog(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid,2,1497.3090,-1633.5553,14.0469) || IsPlayerInRangeOfPoint(playerid,2,1468.1287,-1678.5992,14.0469) || IsPlayerInRangeOfPoint(playerid,2,1811.2280,-1843.0420,13.5781))
	{
		if(PlayerInfo[playerid][hotdog] >= 10) return SendError(playerid, "Shoma nemitavanid bهوhtar az 10 hotdog be hamrah dashte bashid.");
		
		if(PlayerInfo[playerid][money] < 100) {
			return SendError(playerid, "Shoma pool kafi nadarid baraye kharid hotdog. [$100]");
		}

		give_money(playerid, -100);
		
		PlayerInfo[playerid][hotdog] += 1;
		update_int_sql(playerid, "u_hotdog", PlayerInfo[playerid][hotdog]);
		SendAccess(playerid, "Shoma yek hotdog kharidid va hala "c_red"%d"c_white" hotdog darid, Baraye khordan hotdog bezan: "c_gold"/eathotdog", PlayerInfo[playerid][hotdog]);
		return 1;
	}

	return SendError(playerid, "Shoma kenar dake hotdog foroshi nهوtid.");
}

cmd:eathotdog(playerid)
{
	if(PlyayerIsGang && !PlayerInfo[playerid][hotdog]) return SendError(playerid, "Shoma hotdog nadarid.");

	PlayerInfo[playerid][hotdog]--;
	update_int_sql(playerid, "u_hotdog", PlayerInfo[playerid][hotdog]);

	if((PlayerInfo[playerid][hunger] + 50) > 100) PlayerInfo[playerid][hunger] = 100;
	else PlayerInfo[playerid][hunger] += 50;

	new Float:pl_health;
	GetPlayerHealth(playerid, pl_health);
	if(pl_health + 50 > 160) set_health(playerid, 160);
	else set_health(playerid, pl_health + 50);

	SetPlayerProgressBarValue(playerid, satiety_progress_bar[playerid], PlayerInfo[playerid][hunger]);

	SendAccess(playerid, "Shoma hotdog khordid va hala "c_red"%d"c_white" hotdog darid.", PlayerInfo[playerid][hotdog]);
	ApplyAnimation(playerid, "الطعام", "EAT_Burger", 4.0, 0, 0, 0, 0, 0, 1);
	me_action(playerid, "hotdog khord.");

	return 1;
}

