			mysql_tquery(sql_connection, query_string);

			UpdateBusinessEnterLabel(b);

			DeletePVar(pl_id, "d_السعر");
			DeletePVar(pl_id, "d_pl_id");
			DeletePVar(playerid, "d_biz_بيعer");
			return 1;
		}

