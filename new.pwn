					show_dialog(playerid, d_family_omembers, DIALOG_STYLE_MSGBOX, !""scm_dialog"العائلة عضوs ["c_green"متصل"c_white"]", global_string, !"Bargasht", !"Bastan");
				}
				case 2:
				{
					if(PlayerInfo[playerid][family_rang] < family_info[PlayerInfo[playerid][family]][fam_settings][3])
					{
