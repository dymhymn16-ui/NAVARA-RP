		strcat(dlobal_string, line_string);
		
		show_dialog(playerid, d_b_story, DIALOG_STYLE_MSGBOX, !""scm_dialog"Gozهمsh daramad.", dlobal_string, !"Bargasht", !"");
	}
	return 1;
}


callback:callback_offmembers(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(!rows)
	{
		SendError(playerid, "لا اللاعبون with these parameters found.");
		ShowLeaderMenu(playerid);
		DeletePVar(playerid, "ofm_القائمة_page");
		return 1;
	}
	new rows_list = GetPVarInt(playerid, "ofm_القائمة_page")-1;
	SetPVarInt(playerid, "ofm_القائمة_rows", rows);
	new line_string[MAX_PLAYER_NAME + 37],
		pl_ofm_name[20],
		pl_ofm_rank,
		pl_ofm_online[16];

	new dialog_string[10 * sizeof(line_string) + 50];
	strcat(dialog_string, ""c_server"السابق page\n"c_server"التالي page\n");
	for(new i = rows_list * 10; i < rows_list * 10 + 10; i ++)
	{
		if(i >= rows) break;

		cache_get_field_content(i, "u_الاسم", pl_ofm_name, sql_connection, 20);
		pl_ofm_rank = cache_get_field_content_int(i, "u_الرتبة", sql_connection);
		cache_get_field_content(i, "u_last_متصل", pl_ofm_online, sql_connection, 16);

		new pvar_string[8];
		format(pvar_string, sizeof(pvar_string), "ofm_%d", i -rows_list * 10);
		SetPVarString(playerid, pvar_string, pl_ofm_name);

		format(line_string, sizeof(line_string), "%s"c_server"\t%s(%d)"c_white"\t%s\n", pl_ofm_name, f_rank[PlayerInfo[playerid][member]][pl_ofm_rank -1], pl_ofm_rank, pl_ofm_online);
		strcat(dialog_string, line_string);

	}

	show_dialog(playerid, d_offmembers_list, DIALOG_STYLE_TABLIST, ""c_server"Organizations عضوs غير متصل", dialog_string, "Entekhab", "Bargasht");
	return 1;
}

callback: callback_offmembers_info(playerid)
{
	new rows, fields;
	cache_get_data(rows, fields);
	if(rows)
	{
		new pl_rank, last_date[16], fraction_date[16];

		pl_rank = cache_get_field_content_int(0, "u_الرتبة", sql_connection);
		cache_get_field_content(0, "u_last_التاريخ", last_date, sql_connection, 16);
		cache_get_field_content(0, "u_fraction_التاريخ", fraction_date, sql_connection, 16);

		new pvar_string[20], pl_name[20];
		format(pvar_string, sizeof(pvar_string), "ofm_%d", GetPVarInt(playerid, "ofm_القائمةالعنصر"));
		GetPVarString(playerid, pvar_string, pl_name, 20);

		new dialog_string[186];
		format(dialog_string, sizeof(dialog_string), ""c_white"الاسم: "c_server"%s"c_white"\nالرتبة:"c_server"%s(%d)"c_white"\nIn Organizations with "c_server"%s"c_white"\nLast تسجيل الدخول: "c_server"%s"c_white"", pl_name, f_rank[PlayerInfo[playerid][member]][pl_rank -1], pl_rank, fraction_date, last_date);
		show_dialog(playerid, d_offmembers_pl_menu_info, DIALOG_STYLE_MSGBOX, ""c_server"اللاعب معلومات", dialog_string, "Bargasht", "");
	}
	if(!rows)
	{
		new query_string[128];
		DeletePVar(playerid, "ofm_القائمةالعنصر");
		if(!GetPVarInt(playerid, "ofm_النوع"))
		{
			mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الاسم`,`u_الرتبة`,`u_last_التاريخ` FROM `users` WHERE `u_عضو` = '%d' AND `u_متصل` = '0'", getPlayerFactionID(playerid));
			mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs", "i", playerid);
			return 1;
		}
		mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الاسم`,`u_الرتبة`,`u_last_التاريخ` FROM `users` WHERE `u_عضو` = '%d' AND `u_الرتبة` = '%d' AND `u_متصل` = '0'", getPlayerFactionID(playerid), GetPVarInt(playerid, "ofm_النوع"));
		mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs", "i", playerid);

	}
	return 1;
}


callback: ticket_list_callback(playerid)
{
	new 
		rows = cache_num_rows();

	if(!rows)
	{
		show_dialog(playerid, d_atm, DIALOG_STYLE_LIST, ""c_server"ATM", "Manage السيارةd\nالأفضل up الهاتف الرصيد\nدفعing fines", "التالي", "Bastan");
		return SendError(playerid, "لديك لا fines!"), DeletePVar(playerid, "ticket_القائمة_page");
	}
	new rows_list = GetPVarInt(playerid, "ticket_القائمة_page")-1;
	SetPVarInt(playerid, "ticket_القائمة_rows", rows);
	new pl_ticket_count,
		pl_ticket_id;

	new dialog_string[10 * 72];
	strcat(dialog_string, ""c_server"السابق page\n"c_server"التالي page\n");
	for(new i = rows_list * 10; i < rows_list * 10 + 10; i ++)
	{
		if(i >= rows) break;

		pl_ticket_id = cache_get_field_content_int(i, "t_id", sql_connection);
		pl_ticket_count = cache_get_field_content_int(i, "t_count", sql_connection);

		new pvar_string[8];

		strcat(dialog_string, "Fine "c_server"#-");
		valstr(pvar_string, pl_ticket_id);
		strcat(dialog_string, pvar_string);
		strcat(dialog_string, " "c_white" | Sum:"c_server" ");
		valstr(pvar_string, pl_ticket_count);
		strcat(dialog_string, pvar_string);
		strcat(dialog_string, "$\n");

		format(pvar_string, sizeof(pvar_string), "tlc_%d", i -rows_list * 10);
		SetPVarInt(playerid, pvar_string, pl_ticket_id);
	}
	show_dialog(playerid, d_ticket_list, DIALOG_STYLE_TABLIST, ""c_server"Fines", dialog_string, "Entekhab", "Bargasht");
	return 1;
}



callback: callback_ticket_info(playerid)
{
