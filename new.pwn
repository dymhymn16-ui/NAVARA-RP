			if(is_text_invalid(inputtext) || is_russian_text(inputtext) || !IsAlphaNumeric(inputtext)) return show_dialog(playerid, d_family_rename, DIALOG_STYLE_INPUT, !""scm_dialog"Reالاسم العائلة", !""c_grey"The العائلة title contains غير صالح characters\n"c_white"التكلفة for making المعلومات amendments to the archive هو "c_green"750.000$\n"c_white"أدخل your جديد العائلة الاسم:", !"التالي", !"إلغاء");
