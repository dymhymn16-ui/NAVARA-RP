		case d_donate_custom_car_plate:
		{
			if(!response) return show_donate(playerid);

			if(isnull(inputtext)) return show_custom_plate_dialog(playerid, ""c_red"- يرجى pelak ra sahih vهمd konid!");

			if(strlen(inputtext) != 6) return show_custom_plate_dialog(playerid, ""c_red"- يرجى pelak ra sahih vهمd konid!");

			if(!(
				(
					inputtext[0] == CustomPelakAllowedCharacters[0][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[1][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[2][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[3][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[4][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[5][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[6][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[7][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[8][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[9][0] || 
					inputtext[0] == CustomPelakAllowedCharacters[10][0]
				) && //X
				('0' <= inputtext[1] <= '9') && //3
				('0' <= inputtext[2] <= '9') && //3
				('0' <= inputtext[3] <= '9') && //3
				(
					inputtext[4] == CustomPelakAllowedCharacters[0][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[1][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[2][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[3][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[4][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[5][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[6][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[7][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[8][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[9][0] || 
					inputtext[4] == CustomPelakAllowedCharacters[10][0]
				) && //X
				(
					inputtext[5] == CustomPelakAllowedCharacters[0][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[1][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[2][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[3][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[4][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[5][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[6][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[7][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[8][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[9][0] || 
					inputtext[5] == CustomPelakAllowedCharacters[10][0]
				) //X
				))
			{
				return show_custom_plate_dialog(playerid, ""c_red"- يرجى pelak ra sahih vهمd konid!");
			}

			new logsCount = 0;

			new query[256];
			mysql_format(sql_connection, query, sizeof(query), "اختر * FROM `users_المركبات` WHERE `v_plate`='%s' LIMIT 1", inputtext);

			new Cache:result = mysql_query(sql_connection, query);

			logsCount = cache_num_rows();

			cache_delete(result);

			if(logsCount != 0)
				return show_custom_plate_dialog(playerid, ""c_red"- In pelak gablan sabt shode ast.");

			new string[128];

			p_t_info[playerid][buy_custom_pelak_price] = 0;
			p_t_info[playerid][buy_custom_pelak_string][0] = EOS;

			if(
				inputtext[0] == inputtext[4] &&
				inputtext[0] == inputtext[5] &&
				inputtext[4] == inputtext[0] &&
				inputtext[4] == inputtext[5] &&
				inputtext[5] == inputtext[0] &&
				inputtext[5] == inputtext[4] 
				) 
			{
				p_t_info[playerid][buy_custom_pelak_price] += 300;
			}

			if(
					inputtext[1] == inputtext[2] &&
					inputtext[1] == inputtext[3] &&
					inputtext[2] == inputtext[1] &&
					inputtext[2] == inputtext[3] &&
					inputtext[3] == inputtext[1] &&
					inputtext[3] == inputtext[2] 
				)
			{
				p_t_info[playerid][buy_custom_pelak_price] += 100;
			}


			format(string, 11, "%d%d%d", strval(inputtext[1]), strval(inputtext[2]), strval(inputtext[3]));
			new round_number_check = strval(string);

			for (new i = 0; i < sizeof(CustomPelakRoundNumbers); i++) 
			{
				if(round_number_check == CustomPelakRoundNumbers[i]) 
				{
					if(i <= 8) 
						p_t_info[playerid][buy_custom_pelak_price] += 50;
					else
						p_t_info[playerid][buy_custom_pelak_price] += 80;

					break;
				}
			}

			if(p_t_info[playerid][buy_custom_pelak_price] == 0)
				p_t_info[playerid][buy_custom_pelak_price] = RandomEx(100, 200);

			strcat(p_t_info[playerid][buy_custom_pelak_string], inputtext);

			format(string, sizeof(string), 
				""c_white"أنتre pelaki ke mikhahid: "c_light_green"%s\n\
				"c_white"- Gheymat: "c_gقديم"%d M-Coin", 

			inputtext,
			p_t_info[playerid][buy_custom_pelak_price]);

			show_dialog(playerid, d_donate_custom_car_plate_2, DIALOG_STYLE_MSGBOX, ""c_server"Shomهم pelak custom",
				string,
				"Kharid", "Bargasht");
			return 1;
		}
		case d_donate_custom_car_plate_2:
		{
			if(!response) return show_custom_plate_dialog(playerid);

			new veh_id = GetPlayerVehicleID(playerid);
			
			if(IsPlayerInAnyVehicle(playerid) && veh_info[veh_id -1][v_owner] != PlayerInfo[playerid][id] || veh_info[veh_id -1][v_type] != vehicle_type_player)
				return SendError(playerid, "Shoma bayad savar mashin shakhsi bashid.");

			if(p_t_info[playerid][buy_custom_pelak_price] > get_player_donate(playerid))
				return SendError(playerid, "Shoma %d M-Coin nadarid.", p_t_info[playerid][buy_custom_pelak_price]);

			format(veh_info[veh_id -1][v_plate], 32, "%s", p_t_info[playerid][buy_custom_pelak_string]);
