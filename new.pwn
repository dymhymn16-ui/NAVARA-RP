			b_types[b_info[biz_id][b_type]], b_info[biz_id][b_id], b_info[biz_id][b_name_edit], b_info[biz_id][b_owner_name], convert_money(b_info[biz_id][b_price]), b_info[biz_id][b_days], mafia_owner_name[b_info[biz_id][b_mafia]],(! b_info[biz_id][b_close]) ? ("{1a9616}فتح") : ("{e11010}إغلاقd"));
