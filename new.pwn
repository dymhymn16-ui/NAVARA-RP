			if(p_t_info[playerid][campfire_time] < (10 * 60)) {
				SendClientMessage(playerid, col_white, ""scm_error"Ghaza haلاz amade nهوt.");
				return 1;
			}
	        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 500);
			me_action(playerid, "steak pokhte ra bardasht");
	        DestroyDynamicObject(p_t_info[playerid][campfire_object]);
			DestroyDynamicObject(p_t_info[playerid][campfire_object_steak]);
			DestroyDynamic3DTextLabel(p_t_info[playerid][campfire_label]);
			p_t_info[playerid][campfire_object] = 0;
			p_t_info[playerid][campfire_object_steak] = 0;
			p_t_info[playerid][campfire_time] = 0;
			p_t_info[playerid][campfire_label] = Text3D:INVALID_3DTEXT_ID;
			PlayerInfo[playerid][steak_cooked] += 1;
			update_int_sql(playerid,"u_steak_cooked",PlayerInfo[playerid][steak_cooked]);
			return 1;
		}
		case d_campfire_put_food: {
			if(!response) {
				return 1;
			}
			if(PlayerInfo[playerid][steak] <= 0) {
				SendClientMessage(playerid, col_white, ""scm_error"Shoma Steak (Gosht) nadarid. Az 24/7 bekharid.");
				return 1;
			}
			new Float:x, Float:y, Float:z;
	        Streamer_GetFloatData(
	        	STREAMER_TYPE_OBJECT,
	        	p_t_info[playerid][campfire_object],
	        	E_STREAMER_X,
	        	x);
	        Streamer_GetFloatData(
	        	STREAMER_TYPE_OBJECT,
	        	p_t_info[playerid][campfire_object],
	        	E_STREAMER_Y,
	        	y);
	        Streamer_GetFloatData(
	        	STREAMER_TYPE_OBJECT,
	        	p_t_info[playerid][campfire_object],
	        	E_STREAMER_Z,
	        	z);
	        z += 0.3;
	        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 500);
			p_t_info[playerid][campfire_object_steak] = CreateDynamicObject(19582, x, y, z, 0.00, 0.00, 0.00, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
			me_action(playerid, "steak roye chob ha gozasht");
			PlayerInfo[playerid][steak] -= 1;
			update_int_sql(playerid,"u_steak",PlayerInfo[playerid][steak]);
			return 1;
		}
		case d_campfire_fuel: {
			if(!response) {
				return 1;
			}
			if(PlayerInfo[playerid][canister] <= 0) {
				SendClientMessage(playerid, col_white, ""scm_error"Shoma Galon Benzin (canهوter) nadarid. Az Pomp Benzin bekharid.");
				return 1;
			}
			SetPlayerAttachedObject(playerid, 6, 1650, 6, 0.101999, 0.018000, 0.052000, 0.399999, -98.399978, -3.200000);
			ApplyAnimation(playerid, "BD_FIRE", "كانh_up", 4.1, 0, 0, 0, 0, 2000, 0);
			// p_t_info[playerid][has_galon_benzin] = false;
			// RemovePlayerAttachedObject(playerid, 1);
			p_t_info[playerid][campfire_time] = 0;
			p_t_info[playerid][campfire_benzin] = true;
			SetTimerEx("PutGalonBenziلاnWoods", 2000, false, "d", playerid);
			return 1;
		}
		case d_campfire_create: {
			if(!response) {
				return 1;
			}
			if(PlayerInfo[playerid][wood] <= 0) {
				SendClientMessage(playerid, col_white, ""scm_error"Shoma chob nadarid. Az 24/7 bekharid.");
				return 1;
			}
			new string[72];
			new Float:x, Float:y, Float:z;
			new FLoat:angle;
			GetPlayerPos(playerid, x, y, z);
			GetPlayerFacingAngle(playerid, angle);
			x += 0.0;
			y += 0.5;
			z -= 1.0;
	        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 500);
			p_t_info[playerid][campfire_benzin] = false;
			p_t_info[playerid][campfire_time] = 0;
			p_t_info[playerid][campfire_object_steak] = 0;
			p_t_info[playerid][campfire_object] = CreateDynamicObject(19632, x, y, z, 0.00, 0.00, angle, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
			format(string, sizeof string, "%s's "c_orange"Campfire\n"c_white"الحالة : Off", PlayerInfo[playerid][name]);
			p_t_info[playerid][campfire_label] = CreateDynamic3DTextLabel(string, col_white, x, y, z, 12.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
			Streamer_Update(playerid, STREAMER_TYPE_OBJECT);
			Streamer_Update(playerid, STREAMER_TYPE_3D_TEXT_LABEL);
			me_action(playerid, "campfire gozasht");
			PlayerInfo[playerid][wood] -= 1;
	        update_int_sql(playerid,"u_wood",PlayerInfo[playerid][wood]);
			return 1;
		}
    	case d_unban_player_with_coin: {
    		if(!response) {
    			kick_player(playerid);
				return 1;
			}

			new query_string[100];
			format(query_string, sizeof query_string, "اختر `u_donate` FROM `users` WHERE `u_الاسم`='%s'", PlayerInfo[playerid][name]);
			mysql_tquery(sql_connection, query_string, "UnbanPermanetBan", "d", playerid);

			return 1;
		}
		case d_unban_player_with_coin_2: {
			if(!response) {
    			kick_player(playerid);
				return 1;
			}

			if(!(6 <= strlen(inputtext)<= 31)|| is_text_invalid(inputtext))
			{
				SendClientMessage(playerid, col_white, ""scm_error"خاطئ كلمة المرور أدخلed.");
    			kick_player(playerid);
				return 1;
			}

			new query_string[128];

			mysql_format(sql_connection, query_string, sizeof(query_string), "اختر * FROM `users` WHERE `u_الاسم` = '%s' AND `u_كلمة المرور` = MD5('%e') LIMIT 1", PlayerInfo[playerid][name], inputtext);
			mysql_tquery(sql_connection, query_string, "UnbanPermanetBan2", "i", playerid);
			return 1;
    	}
        case d_lobby:
        {
            if(!response) return 1;
            switch(listitem)
            {
                case 0: ShowLobbyList(playerid);
                case 1: ShowLobbyCreate(playerid);
            }
            return 1;
        }
        case d_lobby_list:
        {
            if(!response) return ShowLobby(playerid);
            ShowLobbyCreatedList(playerid, listitem + 1);
            return 1;
        }
		case d_lobby_created_list:
		{
			if(!response) return ShowLobbyList(playerid);
			if(listitem == -1) return SendError(playerid, "Chizi eshkal dasht, lotfan dobهم sabt konid ya version-e client ra be rooz konid.");
			new idx = p_t_info[playerid][p_listitem][listitem];
			if(idx == -1) return SendError(playerid, "Eshkal na-mashkhus, lotfan dobهم talash konid.");
			for(new i; i < 100; i++) p_t_info[playerid][p_listitem][i] = -1;
			if(LobbyInfo[idx][LobbyPassword] != 0)
			{
				SetPVarInt(playerid, "LobbyIDx", idx);
				show_dialog(playerid, d_lobby_created_list_password, DIALOG_STYLE_INPUT, ""c_server"Ramz-e Lobby", c_white"Ramz-e lobby ra vهمd konid:", "التالي", "إلغاء");
			}
			else SetPlayerFreeSlotLobby(playerid, idx);
			return 1;
		}
		case d_lobby_created_list_password:
		{
			if(!response) return ShowLobbyList(playerid), DeletePVar(playerid, "LobbyIDx");
			if(!strlen(inputtext)) return show_dialog(playerid, d_lobby_created_list_password, DIALOG_STYLE_INPUT, ""c_server"Ramz-e Lobby", c_white"Ramz-e lobby ra vهمd konid:", "التالي", "إلغاء"), SendError(playerid, "Shoma hich chizi vهمd nakardid.");
			if(strval(inputtext) < 0 || strval(inputtext) > 999999) return show_dialog(playerid, d_lobby_created_list_password, DIALOG_STYLE_INPUT, ""c_server"Ramz-e Lobby", c_white"Ramz-e lobby ra vهمd konid:", "التالي", "إلغاء"), SendError(playerid, "Ramz bayad beyn 0 ta 999999 bashad.");
			new idx = GetPVarInt(playerid, "LobbyIDx");
			if(strval(inputtext) != LobbyInfo[idx][LobbyPassword]) return show_dialog(playerid, d_lobby_created_list_password, DIALOG_STYLE_INPUT, ""c_server"Ramz-e Lobby", c_white"Ramz-e lobby ra vهمd konid:", "التالي", "إلغاء"), SendError(playerid, "Shoma ramz-e ghalat vهمd kardid.");
			DeletePVar(playerid, "LobbyIDx");
			SetPlayerFreeSlotLobby(playerid, idx);
			return 1;
		}
        case d_lobby_create:
        {
            if(!response) return ShowLobby(playerid);
            switch(listitem)
            {
                case 0:
                {
                    STRING_GLOBAL[0] = EOS;
                    for(new i = 0; i < sizeof(LobbyTypeName); i++)
                    {
        				new line_string[150];
                        format(line_string, sizeof(line_string), ""c_server"[%d]"c_white" %s\n", i + 1, LobbyTypeName[i]);
                        strcat(STRING_GLOBAL, line_string);
                    }
                    show_dialog(playerid, d_lobby_create_type, DIALOG_STYLE_LIST, ""c_server"النوع", STRING_GLOBAL, "التالي", "إلغاء");
                }
                case 1: show_dialog(playerid, d_lobby_create_capacity, DIALOG_STYLE_INPUT, ""c_server"Capacity", c_white"أدخل the maximum number of اللاعبون from 2 to 20:", "التالي", "إلغاء");
                case 2: show_dialog(playerid, d_lobby_create_time, DIALOG_STYLE_INPUT, ""c_server"الوقت", c_white"أدخل the number of دقائق from 1 to 10:", "التالي", "إلغاء");
                case 3:
                {
                    switch(player_lobby_settings[playerid][0])
                    {
                        case LOBBY_TYPE_DEATHMATCH - 1: show_dialog(playerid, d_lobby_create_subject, DIALOG_STYLE_INPUT, ""c_server"Parameter", c_white"أدخل سلاح ID from 0 to 46:", "التالي", "إلغاء");
                        case LOBBY_TYPE_RACE - 1, LOBBY_TYPE_DERBY - 1, LOBBY_TYPE_STUNT -1: show_dialog(playerid, d_lobby_create_subject, DIALOG_STYLE_INPUT, ""c_server"Parameter", c_white"أدخل المركبة ID from 400 to 610:", "التالي", "إلغاء");
                        case LOBBY_TYPE_PARKOUR - 1: show_dialog(playerid, d_lobby_create_subject, DIALOG_STYLE_INPUT, ""c_server"Parameter", c_white"أدخل skin ID from 0 to 311:", "التالي", "إلغاء");
                    }
                }
                case 4:
                {
                    STRING_GLOBAL[0] = EOS;
                    new idx;
                    for(new i = 0; i < 5; i++)
                    {
        				new line_string[150];
                        idx = player_lobby_settings[playerid][0];
                        if(!strcmp(LobbyMapName[idx][i], "لاne", false)) continue;
                        format(line_string, sizeof(line_string), ""c_server"[%d]"c_white" %s\n", i + 1, LobbyMapName[idx][i]);
                        strcat(STRING_GLOBAL, line_string);
                    }
                    show_dialog(playerid, d_lobby_create_map, DIALOG_STYLE_LIST, ""c_server"الخريطة", STRING_GLOBAL, "التالي", "إلغاء");
                }
                case 5:
                {
                    STRING_GLOBAL[0] = EOS;
                    for(new i = 0; i < sizeof(LobbyDeviceName); i++)
                    {
        				new line_string[150];
                        format(line_string, sizeof(line_string), ""c_server"[%d]"c_white" %s\n", i + 1, LobbyDeviceName[i]);
