const VehicleDestroyed = 136;
IRPC:VehicleDestroyed(playerid, BitStream:bs)
{
    new vehicleid;
    BS_ReadUint16(bs, vehicleid);
    if(GetVehicleModel(vehicleid) < 400) return 0;
    return OnVehicleRequestDeath(vehicleid, playerid);
}

forward OnVehicleRequestDeath(vehicleid, killerid);
public OnVehicleRequestDeath(vehicleid, killerid)
{
    new Float:vhealth;// Float:depth, Float:vehicledepth;
    GetVehicleHealth(vehicleid, vhealth);
    if(vhealth >= 250.0/* && !CA_IsVehicleInWater(vehicleid, depth, vehicledepth)*/) return 0;
    return 1;
}

const ID_PLAYER_SYNC = 207;
public OnIncomingPacket(playerid, packetid, BitStream:bs)
{
    if(playerid == INVALID_PLAYER_ID) return 1;
    if(packetid == ID_PLAYER_SYNC)
    {
        new onFootData[PR_OnFootSync];
        BS_IgnoreBits(bs, 8);
        BS_ReadOnFootSync(bs, onFootData);
        if(onFootData[PR_specialAction] == SPECIAL_ACTION_ENTER_VEHICLE)
        {
            if(onFootData[PR_keys] & KEY_SPRINT)
            {
                onFootData[PR_keys] = onFootData[PR_keys] & ~KEY_SPRINT;
                BS_SetWriteOffset(bs, 8);
                BS_WriteOnFootSync(bs, onFootData);
            }
        }
    }
    return 1;
}

stock show_fon_player(playerid)
{
	if(!player_fon_box[playerid])
	{
	    Loading_PTD[playerid][0] = CreatePlayerTextDraw(playerid, 242.5672, 242.4110, "LD_SPAC:white"); // Progress
		PlayerTextDrawTextSize(playerid, Loading_PTD[playerid][0], 0.6, 6.1799);
		PlayerTextDrawAlignment(playerid, Loading_PTD[playerid][0], 1);
		PlayerTextDrawColor(playerid, Loading_PTD[playerid][0], 1234959871);
		PlayerTextDrawBackgroundColor(playerid, Loading_PTD[playerid][0], 255);
		PlayerTextDrawFont(playerid, Loading_PTD[playerid][0], 4);
		PlayerTextDrawSetProportional(playerid, Loading_PTD[playerid][0], 0);
		PlayerTextDrawSetShadow(playerid, Loading_PTD[playerid][0], 0);

        PlayerTextDrawShow(playerid, Loading_PTD[playerid][0]);

		for(new j = 0; j < sizeof td_logo; j ++)
		{
			TextDrawHideForPlayer(playerid, td_logo[j]);
		}

		for(new i; i < 28; i ++)
			TextDrawShowForPlayer(playerid, Loading_TD[i]);

		player_fon_box[playerid] = 1;
		player_fon_timer[playerid] = SetTimerEx("الوقتr_fon_اللاعب", true, 100, "ii", playerid, 1);
	}
}

stock hide_fon_player(playerid)
{
    if(player_fon_box[playerid] > 0)
    {
        player_fon_box[playerid] = 0;
        player_fon_timer[playerid] = SetTimerEx("الوقتr_fon_اللاعب", true, 100, "ii", playerid, 2);
    }
}

callback: timer_fon_player(playerid, type)
{
	PlayerTextDrawTextSize(playerid, Loading_PTD[playerid][0], 0.6 * player_fon_box[playerid], 6.1799);
	PlayerTextDrawHide(playerid, Loading_PTD[playerid][0]);
	PlayerTextDrawShow(playerid, Loading_PTD[playerid][0]);

    if(1 == type)
    {
        player_fon_box[playerid] ++;
        if(player_fon_box[playerid] >= 255)
        {
        	KillTimer(player_fon_timer[playerid]);
        	hide_fon_player(playerid);
        }
    }
    else
    {
        if(player_fon_box[playerid] == 0)
        {
        	for(new i; i < 28; i ++)
				TextDrawHideForPlayer(playerid, Loading_TD[i]);

			for(new j = 0; j < sizeof td_logo; j ++)
			{
				TextDrawShowForPlayer(playerid, td_logo[j]);
			}

			if(PlayerInfo[playerid][admin] > 0)
			
            PlayerTextDrawDestroy(playerid, Loading_PTD[playerid][0]);
            KillTimer(player_fon_timer[playerid]);
        }
    }
    return true;
}

forward BonusLoad();
public BonusLoad() {
	BONUSLVL = cache_get_field_content_int(0, "المستوى", sql_connection);
	BONUSMONEY = cache_get_field_content_int(0, "المال", sql_connection);
	BONUSDONATE = cache_get_field_content_int(0, "donate", sql_connection);
	printf("Bonus المستوى:      		%d",BONUSLVL);
	printf("Bonus المال:      		%d",BONUSMONEY);
	printf("Bonus DONATE:      		%d",BONUSDONATE);
	return true;
}

static ClientTags[][7] = {
    {"[PC]"},
    {"[VIP]"},
    {"[A]"},
    {"[L]"},
    {"[H]"}
};

public DeleteTagFromPlayerName(playerid)
{
	new playerTempName[MAX_PLAYER_NAME + 1], idx = 0;
	GetPlayerName(playerid, playerTempName, sizeof(playerTempName));
	if(strfind(playerTempName, "[") == -1 || strfind(playerTempName, "]") == -1) return 0;
	for(new i; i < sizeof(ClientTags); i++)
	{
        if(isnull(ClientTags[i])) continue;
		idx = strfind(playerTempName, ClientTags[i]);
		if(idx != -1)
		{
			strdel(playerTempName, idx, idx + strlen(ClientTags[i]) + 1);
			if(strlen(playerTempName) < 3) return 0;
			SetPlayerName(playerid, playerTempName);
			return 1;
		}
	}
	return 1;
}

public UpdatePlayerName(playerid)
{
	new new_nick[MAX_PLAYER_NAME];
	new mobile_text[6];
	new status_text[6];
	new status_vip[6];

	format(mobile_text, 6, IsPlayerUsingSampMobile(playerid) ? ("") : ("[PC]"));
	format(status_vip, 6, !PlayerInfo[playerid][vip] ? ("") : ("[VIP]"));

	format(status_text, 6, PlayerInfo[playerid][admin] ? ("[A]") : playerLeaderStatus(playerid) ? ("[L]") : PlayerInfo[playerid][helper] ? ("[H]") : (""));

    strins(new_nick, PlayerInfo[playerid][name], strlen(new_nick));
    strins(new_nick, mobile_text, strlen(new_nick));
    strins(new_nick, status_vip, strlen(new_nick));
    strins(new_nick, status_text, strlen(new_nick));

	UpdateNameNDP(playerid);

    return SetPlayerName(playerid, new_nick);
}

SendPressALTMessage(playerid) {
	GameTextForPlayer(playerid, "~n~~n~~g~PRESS ~b~ALT", 2500, 6);
}

OnPlayerPressedALT(playerid) {
	new playerstate = GetPlayerState(playerid);

	{
		if(p_t_info[playerid][parking_id] == -1 && (playerstate == PLAYER_STATE_ONFOOT || playerstate == PLAYER_STATE_DRIVER) && check_parking(playerid) != -1)
		{
			new park_id = check_parking(playerid);
				
			if(ParkData[park_id][p_faction] != PlayerInfo[playerid][member] && ParkData[park_id][p_faction] != -1) return SendError(playerid, "In parking baraye shoma dar dastres nهوt.");

			if(playerstate == PLAYER_STATE_DRIVER)
			{
				new vehicleid = GetPlayerVehicleID(playerid);
				TeleportVehicleToPos(vehicleid, 1625.9551, 2201.6763, 1022.0529+0.2, 270.0, park_id+5500, park_id+5500);
			}
			else
			{
				set_pos(playerid, 1634.0942, 2201.4160, 1022.3360, 90.0, park_id+5500, park_id+5500);
			}

			p_t_info[playerid][parking_id] = park_id;
				
			return 1;
		}

		if(p_t_info[playerid][parking_id] != -1 && (playerstate == PLAYER_STATE_ONFOOT || playerstate == PLAYER_STATE_DRIVER) && check_parking(playerid) != -1)
		{
			new h = p_t_info[playerid][parking_id];

			if(playerstate == PLAYER_STATE_DRIVER)
			{
				if(IsPlayerInRangeOfPoint(playerid, 6.0, 1625.9551, 2201.6763, 1022.0529))
				{
					new vehicleid = GetPlayerVehicleID(playerid);
					TeleportVehicleToPos(vehicleid, ParkData[h][p_enter][0], ParkData[h][p_enter][1], ParkData[h][p_enter][2], ParkData[h][p_enter][3], 0, 0);
				}
			}
			else
			{
				if(IsPlayerInRangeOfPoint(playerid, 3.0, 1625.9551, 2201.6763, 1022.0529))
				{
					set_pos(playerid, ParkData[h][p_enter][0], ParkData[h][p_enter][1], ParkData[h][p_enter][2], ParkData[h][p_enter][3], 0, 0);
				}
			}

			return 1;
		}
	}

	#if defined _metro_stop_included
	for (new ms_id = 0; ms_id < MAX_METRO_STOP; ms_id++) {
		if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT &&
			IsPlayerInRangeOfPoint(playerid, METRO_STATION_DISTANCE,
				MetroStationInfo[ms_id][msPos][0], MetroStationInfo[ms_id][msPos][1], MetroStationInfo[ms_id][msPos][2]
			)
		) return ms_SelectStop(playerid);
	}
	#endif

	for(new h = 0; h < house_count; h ++)
	{
		if(!IsPlayerInRangeOfPoint(playerid, 2.0, h_info[h][h_pos][0], h_info[h][h_pos][1], h_info[h][h_pos][2])) continue;

		slobal_string[0] = format_string[0] = EOS;

		new enter_label_price[24];

		if(h_info[h][h_price] <= 15000)
			format(enter_label_price, sizeof enter_label_price, "{FFDC33}%d M-Coin", h_info[h][h_price]);
		else
			format(enter_label_price, sizeof enter_label_price, ""c_server"$%s", convert_money(h_info[h][h_price]));

		if(h_info[h][h_owner] == -1)
		{
			format(format_string, sizeof(format_string), "\n"c_white"أنتre Khane: \t"c_server"#%d\n", h_info[h][h_id]);
			strcat(slobal_string, format_string);
			format(format_string, sizeof(format_string), ""c_white"النوع / الاسم: \t\t"c_server"%s\n", house_classes[h_info[h][h_int] -1]);
			strcat(slobal_string, format_string);
			format(format_string, sizeof(format_string), ""c_white"Shahr/Ostand: \t\t"c_server"%s\n", GetTownName(h_info[h][h_pos][0], h_info[h][h_pos][1]));
			strcat(slobal_string, format_string);
			format(format_string, sizeof(format_string), ""c_white"Mantaghe: \t\t\t"c_server"%s\n", GetAreaName(h_info[h][h_pos][0], h_info[h][h_pos][1]));
			strcat(slobal_string, format_string);
			format(format_string, sizeof(format_string), ""c_white"Gheymat: \t\t\t%s\n", enter_label_price);
			strcat(slobal_string, format_string);
			format(format_string, sizeof(format_string), ""c_white"Hagh Tamdid: \t\t"c_server"$%s\n", convert_money(house_int[h_info[h][h_int] -1][hint_extension]));
			strcat(slobal_string, format_string);
			if(h_info[h][h_garage] > 0) {
				format(format_string, sizeof(format_string), "\n"c_grey"* Khane الكراج Janebi Darad.");
				strcat(slobal_string, format_string);						
			}
	
			show_dialog(playerid, d_house, DIALOG_STYLE_MSGBOX, ""c_server"Malkiyat Baraye Forush", slobal_string, "Kharid", "إلغاء");
			SetPVarInt(playerid, "المنزل_dialog", 1);
		}
		else
		{
			if(h_info[h][h_rent_price] == 0)
			{

				format(format_string, sizeof(format_string), "\n"c_white"أنتre Khane: \t"c_server"#%d\n", h_info[h][h_id]);
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Saheb Khane: \t\t\t"c_server"%s\n", h_info[h][h_owner_name]);
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"النوع / الاسم: \t\t"c_server"%s\n", house_classes[h_info[h][h_int] -1]);
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Shahr/Ostand: \t\t"c_server"%s\n", GetTownName(h_info[h][h_pos][0], h_info[h][h_pos][1]));
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Mantaghe: \t\t\t"c_server"%s\n", GetAreaName(h_info[h][h_pos][0], h_info[h][h_pos][1]));
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Gheymat: \t\t\t%s\n", enter_label_price);
				strcat(slobal_string, format_string);
    			format(format_string, sizeof(format_string), ""c_white"Vaziyat Tamdid Khane: \t\t"c_server"%d/30 اليومs\n", h_info[h][h_days]);
    			strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Hagh Tamdid: \t\t"c_server"$%s\n", convert_money(house_int[h_info[h][h_int] -1][hint_extension]));
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Vaziyat Khane: \t\t%s\n", h_info[h][h_closed] ? (""c_red"إغلاقd") : (""c_green"فتح"));
				strcat(slobal_string, format_string);
				if(h_info[h][h_garage] > 0) {
					format(format_string, sizeof(format_string), "\n"c_grey"* Khane الكراج Janebi Darad.");
					strcat(slobal_string, format_string);						
				}
				SetPVarInt(playerid, "المنزل_dialog", 2);
				show_dialog(playerid, d_house, DIALOG_STYLE_MSGBOX, ""c_server"In Khane Malek Dard", slobal_string, "Vorood", "إلغاء");
			}
			else
			{
				format(format_string, sizeof(format_string), "\n"c_white"أنتre Khane: \t"c_server"#%d\n", h_info[h][h_id]);
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Saheb Khane: \t\t\t"c_server"%s\n", h_info[h][h_owner_name]);
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"النوع / الاسم: \t\t"c_server"%s\n", house_classes[h_info[h][h_int] -1]);
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Shahr/Ostand: \t\t"c_server"%s\n", GetTownName(h_info[h][h_pos][0], h_info[h][h_pos][1]));
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Mantaghe: \t\t\t"c_server"%s\n", GetAreaName(h_info[h][h_pos][0], h_info[h][h_pos][1]));
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Ejهمh: \t\t\t$%d\n", h_info[h][h_rent_price]);
				strcat(slobal_string, format_string);
    			format(format_string, sizeof(format_string), ""c_white"Vaziyat Tamdid Khane: \t\t"c_server"%d/30 اليومs\n", h_info[h][h_days]);
    			strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Hagh Tamdid: \t\t"c_server"$%s\n", convert_money(house_int[h_info[h][h_int] -1][hint_extension]));
				strcat(slobal_string, format_string);
				format(format_string, sizeof(format_string), ""c_white"Vaziyat Khane: \t\t%s\n", h_info[h][h_closed] ? (""c_red"إغلاقd") : (""c_green"فتح"));
				strcat(slobal_string, format_string);
				if(h_info[h][h_garage] > 0) {
					format(format_string, sizeof(format_string), "\n"c_grey"* Khane الكراج Janebi Darad.");
					strcat(slobal_string, format_string);						
				}
				show_dialog(playerid, d_house, DIALOG_STYLE_MSGBOX, ""c_server"Emlak Ve Mosteghlat", slobal_string, "Vorood", "إلغاء");
				SetPVarInt(playerid, "المنزل_dialog", 2);
			}
		}
		p_t_info[playerid][house] = h;
		SetPVarInt(playerid, "tp_همa_used", 1);
		break;
	}

	{
		new house_id = p_t_info[playerid][house];
		
		if(house_id != -1)
		{
			new hint = h_info[house_id][h_int] -1;
			
			if(IsPlayerInRangeOfPoint(playerid, 0.5, house_int[hint][hint_position][0], house_int[hint][hint_position][1], house_int[hint][hint_position][2]))
			{
				show_dialog(playerid,d_house_exit,DIALOG_STYLE_LIST, ""scm_dialog"خروج Menu",
				"1. Biron\n\
				2. Garage\n\
				3. Zir Zamin\n\
				4. Mining Room\n", "Entekhab", "Bastan");

			}
		}

	}

	if(gang_player(playerid) || mafia_player(playerid))
	{
		for(new i; i < sizeof(dorm_pos); i ++)
		{
			if(IsPlayerInRangeOfPoint(playerid, 0.5, dorm_pos[i][0], dorm_pos[i][1], dorm_pos[i][2]) && i == (getPlayerFactionID(playerid) -18))
			{
				show_dialog(playerid, d_dorm, DIALOG_STYLE_LIST, ""c_server"Cloud", "Apply drugs\nApply الذخيرة\nApply nuke\nApply المال\nTake drugs\nTake الذخيرة\nTake الأسلحة\nTake المال", "Entekhab", "Bargasht");
				return 1;
			}
		}
	}

    new pickupid = p_t_info[playerid][pickup_time];

    if(pickupid == -1) return 0;

    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);

    new Float:pickup_x, Float:pickup_y, Float:pickup_z;

	// ---------------

	for(new rent_id = 0; rent_id < rents_count; rent_id++)
	{
		if(pickupid != rent_info[rent_id][rent_pickup]) continue;

		SetPVarInt(playerid, "استئجار_id", rent_id);

		new playerMoney = PlayerInfo[playerid][money];

		new text[2048];
		format(text, sizeof(text), 
			"[#]\tالمركبة الاسم\tالسعر\tالمستوى\n");

		new const vehicleNames[][32] = {"BMX", "Bike", "Mountain", "Faggio", "Sanchez", "Emperor"};
		new const vehiclePrices[] = {5, 15, 20, 50, 90, 120};
		new const vehicleLevels[] = {1,1,1,2,5,5};

		for(new i = 0; i < 6; i++)
		{
			new priceText[32];
			if(playerMoney < 20 && i < 3)
			{
				format(priceText, sizeof(priceText), "مجاني");
			}
			else
			{
				format(priceText, sizeof(priceText), "${43CD80}%d", vehiclePrices[i]);
			}

			format(text, sizeof(text), "%s"c_server"[%d]\t"c_white"%s\t%s\t"c_yellow"lvl %d\n",
				text, i+1, vehicleNames[i], priceText, vehicleLevels[i]);
		}

		if(PlayerInfo[playerid][admin] >= 8)
		{
			format(text, sizeof(text), "%s"c_server"[إداري]\t"c_red"حذف استئجار", text);
		}

		show_dialog(playerid, d_rent_vehicle, DIALOG_STYLE_TABLIST_HEADERS,
			!""c_server"استئجار المركبة", text, !"استئجار", !"إلغاء");

		return 1;
	}


	for(new i = 0; i < HGARAGES_COUNT; i ++) {
		if(GetDistanceBetweenPoints(x, y, z, house_garage_player_enter[i][0], house_garage_player_enter[i][1], house_garage_player_enter[i][2]) <= 2.0) 
		{
			if(p_t_info[playerid][house] > 0)
			{
				new h = p_t_info[playerid][house];
				new hint = h_info[h][h_int] -1;
				set_pos(playerid, house_int[hint][hint_position][0], house_int[hint][hint_position][1], house_int[hint][hint_position][2], house_int[hint][hint_position][3], house_int[hint][hint_int], h_info[h][h_id]);
				SetPVarInt(playerid, "tp_همa_used", 1);
			}
			else if(GetPVarInt(playerid, "cellar_id")> 0)
			{
				new h = GetPVarInt(playerid, "cellar_id")-1;
				set_pos(playerid, cellar_info[h][cl_pos][0], cellar_info[h][cl_pos][1], cellar_info[h][cl_pos][2], cellar_info[h][cl_pos][3], 0, 0);
				SetPVarInt(playerid, "tp_همa_used", 1);
				DeletePVar(playerid, "cellar_id");
			}
			return 1;
		}
	}

	// ---------------

    Streamer_GetFloatData(STREAMER_TYPE_PICKUP, PickupAreaGetDriveLic, E_STREAMER_X, pickup_x);
	Streamer_GetFloatData(STREAMER_TYPE_PICKUP, PickupAreaGetDriveLic, E_STREAMER_Y, pickup_y);
	Streamer_GetFloatData(STREAMER_TYPE_PICKUP, PickupAreaGetDriveLic, E_STREAMER_Z, pickup_z);
	if(GetDistanceBetweenPoints(x, y, z, pickup_x, pickup_y, pickup_z) <= 2.0) 
	{
		show_dialog(playerid, d_auto_exam_1, DIALOG_STYLE_MSGBOX, ""c_server"Amoozeshgah Ranandegi",""c_server"\t\t\t\tAmoozeshgah Ranandegi\n\n"c_white"Be Amoozeshgah Ranandegi Khosh Omadi.\nBaraye gereftan govahiالاسم bayad in kar haro bokoni:\n\n"c_grey"* Balad shodan ghavanin ranndegi\n* Pardakht "c_server"1000$\n"c_grey"* Ghaboli toye azmon ranndegi\n* Ghaboli toye emtehan amali", "Bهوhtar", "Bargasht");
		return 1;
	}

    // ---------------

    Streamer_GetFloatData(STREAMER_TYPE_PICKUP, pickupid, E_STREAMER_X, pickup_x);
    Streamer_GetFloatData(STREAMER_TYPE_PICKUP, pickupid, E_STREAMER_Y, pickup_y);
    Streamer_GetFloatData(STREAMER_TYPE_PICKUP, pickupid, E_STREAMER_Z, pickup_z);

    if(GetDistanceBetweenPoints(x, y, z, pickup_x, pickup_y, pickup_z) > 3.0) return 0;


	switch(pick_info[pickupid][pick_type])
	{
		case pick_type_bexit:
		{
			new t = p_t_info[playerid][business] -1;
			p_t_info[playerid][business] = -1;
			set_pos(playerid, b_info[t][b_position][0], b_info[t][b_position][1], b_info[t][b_position][2], b_info[t][b_position][3], 0, 0);
			SetPVarInt(playerid, "tp_همa_used", 1);
			return 1;
		}
		case pick_type_bentrance:
		{
			for(new t = 0; t < b_count; t ++)
			{
				if(b_info[t][b_pickup] == pickupid)
				{
					new dialog_string[230 + MAX_PLAYER_NAME + 7 + 32 + 1];

					new business_status[19 + 1] = ""c_orange_red"إغلاقd";
					if(!b_info[t][b_close]) business_status = ""c_green"فتح";

					if(b_info[t][b_owner_inc] == -1)
					{
					    format(dialog_string, sizeof(dialog_string),
						""c_white"المشروع بيعing:\n\n\
						"c_white"Title:"c_السيرفر" %s\n\
						"c_white"Control:"c_السيرفر" %s\n\
						"c_white"Price:"c_green" $%d\n\
						"c_white"Status: %s", b_المعلومات[t][b_الاسم], mafia_المالك_الاسم[b_المعلومات[t][b_mafia]], b_المعلومات[t][b_السعر], المشروع_الحالة);

						show_dialog(playerid, d_b_buy, DIALOG_STYLE_MSGBOX, !""scm_dialog"المشروع المعلومات", dialog_string, !"Kharid", !"Vorood");
					}
					else
					{
						new bis_int = b_info[t][b_int];
						if(bis_int == -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"An خطأ occurred while logging into the المشروع!");
						if(b_info[t][b_close] == 1 ||  b_info[t][b_owner_inc] == -1) return GameTextForPlayer(playerid, "~r~BUSINES إغلاقD", 2000, 4);
						
						if(b_info[t][b_fee] > 0)
						{
