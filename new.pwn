				InterpolateCameraPos(playerid, 2701.9277, -2378.6743, 17.4182, 2814.8062, -2420.0977, 24.6413, 10000, CAMERA_MOVE);
				InterpolateCameraLookAt(playerid, 2701.5447, -2377.7532, 17.2832, 2814.0027, -2420.6921, 24.2813, 10000, CAMERA_MOVE);

				show_dialog(playerid, d_port_help_1, DIALOG_STYLE_MSGBOX, ""c_server"المساعدة with work", "\
				"c_grey"Working on a forklift:\n\
				"c_white"After renting a forklift, you need to drive up to one of the cranes that lower containers from the ship.\n\
				It is necessary to wait until the container is on the ground.\n\
