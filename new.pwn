					mysql_format(sql_connection, query_string, sizeof(query_string), "UPالتاريخ `العائلة` SET `fam_chat_color`='%s' WHERE `fam_id`='%d' LIMIT 1", family_info[familyid][fam_chat_color], getPlayerFamilyID(playerid));
					mysql_tquery(sql_connection, query_string);
					
