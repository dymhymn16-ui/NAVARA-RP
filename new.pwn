		SendClientMessage(playerid, col_white, __t_string);
		PlayerInfo[playerid][salary] = 0;

		if(is_fraction_duty {playerid} == 1) SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);

		hide_payment(playerid);

		PlayerInfo[playerid][timejob] = job_none;

		DeletePVar(playerid, "mining_ex");
		DeletePVar(playerid, "عامل منجم_cp");

		DisablePlayerCheckpoint(playerid);

		if(IsPlayerAttachedObjectSlotUsed(playerid, 1)) RemovePlayerAttachedObject(playerid, 1);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
	}
	else if(getTimeJobFactionID(playerid) == job_sawmil && ! IsPlayerInRangeOfPoint(playerid, 150.0, -1092.1349, -1643.6737, 76.3739))
	{
		give_money(playerid, PlayerInfo[playerid][salary]);

		SendClientMessage(playerid, col_white, ""c_green"* "c_white"You left the المنطقة of the sawmill and مكتمل your work shift.");
		new __t_string[72];
		format(__t_string, sizeof(__t_string), ""c_green"* "c_white"المكتسب: "c_green"$%d", PlayerInfo[playerid][salary]);
		SendClientMessage(playerid, col_white, __t_string);
		PlayerInfo[playerid][salary] = 0;

		if(is_fraction_duty {playerid} == 1)SetPlayerSkin(playerid, PlayerInfo[playerid][org_skin]);
		else SetPlayerSkin(playerid, PlayerInfo[playerid][skin]);


		hide_payment(playerid);

		PlayerInfo[playerid][timejob] = job_none;

		RemovePlayerAttachedObject(playerid, 0);
		DisablePlayerCheckpoint(playerid);

		DeletePVar(playerid, #LessProc);
		DeletePVar(playerid, #LessStatus);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
	}
	return 1;
}

callback: UpdateTruckerTrailerMinute(playerid)
{
	for(new j = 0; j < 3; j ++)
	{
		if(dorm_queue[j][0] == playerid)
		{
			dorm_queue[j][0] = INVALID_PLAYER_ID;
		}
	}
}
callback: drop_tree(playerid)
{
	SetPVarInt(playerid, #LessProc, 0);
	KillTimer(GetPVarInt(playerid, #jobTimer));
	DeletePVar(playerid, #jobTimer);
	DestroyDynamicObject(tree_object[GetPVarInt(playerid, #Derevo)]);
	tree_object [GetPVarInt(playerid, #Derevo)] = -1;
	DisablePlayerCheckpoint(playerid);
	tree_pick[GetPVarInt(playerid, #Derevo)] = CreateDynamicPickup(1463,3, tree_positions[GetPVarInt(playerid, #Derevo)][0], tree_positions[GetPVarInt(playerid, #Derevo)][1], tree_positions[GetPVarInt(playerid, #Derevo)][2] +1.5,-1,-1,playerid);
	pick_info[tree_pick[GetPVarInt(playerid, #Derevo)]][pick_type] = pick_type_server;
	return 0;
}

stock convert_time(seconds)
{
	new time_string[12],
		minutes = floatround(seconds / 60);

	seconds -= minutes * 60;

	format(time_string, sizeof(time_string), "%02d:%02d", minutes, seconds);
	return time_string;
}

ConvertTime(ct_seconds, ct_type = 0)
{
    new ct_time[64], ct_h, ct_m, ct_s;
    ct_h = ct_seconds / 3600;
    ct_m = (ct_seconds - ct_h * 3600) / 60;
    ct_s = ct_seconds  - (ct_h * 3600) - (ct_m * 60);
    if(ct_type)
    {
        if(ct_h > 0) format(ct_time, sizeof(ct_time), "%02d:%02d:%02d", ct_h, ct_m, ct_s);
        else format(ct_time, sizeof(ct_time), "%02d:%02d", ct_m, ct_s);
    }
    else format(ct_time, sizeof(ct_time), "%d h %d min %d sec", ct_h, ct_m, ct_s);
    return ct_time;
}

stock pay_day_time()
{
	#if defined PROFILER_PROFILER_INC
		Profiler_Dump();
	#endif

	for(new j = 0; j < gz_count; j ++)
	{
		if(gz_info[j][gz_owner] == 0) continue;
		f_info[gz_info[j][gz_owner]][f_money] += 1000;
	}

	for(new b = 0; b < b_count; b ++)
	{
		if(getFactionDBID(b_info[b][b_mafia]) > 20)
		{
			f_info[b_info[b][b_mafia]][f_money] += 2000;
			UpdateGangDormLabel(b_info[b][b_mafia]);
		}
	}

	foreach(new i: logged_players)
	{
		{
			if(PlayerInfo[i][drive_lic] >= 1) PlayerInfo[i][drive_lic]-=1;
			if(PlayerInfo[i][boat_lic] >= 1) PlayerInfo[i][boat_lic]-=1;
			if(PlayerInfo[i][fly_lic] >= 1) PlayerInfo[i][fly_lic]-=1;
		}

		switch(p_t_info[i][p_data][1])
		{
			case 0:
			{
				SetPlayerTime(i, timestamp_hour, timestamp_minute);
				SetPlayerWeather(i, global_weather);
			}
			case 1..9:
			{
				SetPlayerWeather(i, 4);
				SetPlayerTime(i, 18, 0);
			}
			case 10:
			{
				SetPlayerTime(i, 12, 0);
				SetPlayerWeather(i, global_weather);
			}
		}

		if(p_t_info[i][business] != -1)
		{
			SetPlayerWeather(i, 4);
			SetPlayerTime(i, 18, 0);
		}

		if(PlayerInfo[i][faction_punish] > 0) 
		{
			PlayerInfo[i][faction_punish]--;
			update_int_sql(i, "u_faction_punهوh", PlayerInfo[i][faction_punish]);
		}

		if(PlayerInfo[i][hour_played] + floatround(NetStats_GetConnectedTime(i) / 1000) < 1680)
		{
			SendError(i, "Baraye gerftan دفع اليوم lazeme "c_orange_red"28"c_white" daghighe bazi konid.");
			continue;
		}

		if(playerFactionStatus(i))
		{
			if(!radio_player(i) && !gang_player(i))
			{
				if(f_info[PlayerInfo[i][member]][f_money] > f_info[PlayerInfo[i][member]][f_rank_salary][PlayerInfo[i][rank] -1])
				{
					PlayerInfo[i][salary] += f_info[PlayerInfo[i][member]][f_rank_salary][PlayerInfo[i][rank] -1];
					f_info[PlayerInfo[i][member]][f_money] -= f_info[PlayerInfo[i][member]][f_rank_salary][PlayerInfo[i][rank] -1];
				}
			}
			else
			{
				PlayerInfo[i][salary] += f_info[PlayerInfo[i][member]][f_rank_salary][PlayerInfo[i][rank] -1];
			}
		}

		if(PlayerInfo[i][wanted] > 0)
		{
			if(PlayerInfo[i][enhancement][1] && PlayerInfo[i][wanted] >= 2)
				PlayerInfo[i][wanted] -= 2;
			else
				PlayerInfo[i][wanted] --;
			update_int_sql(i, "u_مطلوب", PlayerInfo[i][wanted]);
		}

		SendClientMessage(i, col_white, "");
		SendClientMessage(i, col_white, "------ "c_gold"البنك check"c_white" ------");

		new newban_count = PlayerInfo[i][bank] + PlayerInfo[i][salary];
		new count_vip = floatround(newban_count * 0.015);
		if(PlayerInfo[i][vip]) newban_count += count_vip;

        new _text_string[128];
        format(_text_string, sizeof(_text_string), "Hoghogh: "c_green"$%s", convert_money(PlayerInfo[i][salary]));
        SendClientMessage(i, col_white, _text_string);

        if(PlayerInfo[i][vip])
		{
	        format(_text_string, sizeof(_text_string), "Vajeh استلامi az seممتلئdehaye البنكi: "c_green"$%s", convert_money(newban_count));
	        SendClientMessage(i, col_white, _text_string);
	    }

        if(PlayerInfo[i][rent_house] != -1)
        {
            new h = PlayerInfo[i][rent_house];
            new _rent_price = h_info[h][h_rent_price];
            if(PlayerInfo[i][bank] >= _rent_price)
            {
                PlayerInfo[i][bank] -= _rent_price;

                format(_text_string, sizeof(_text_string), "Ejهمh maska: "c_orange_red"-$%s", convert_money(_rent_price));
                SendClientMessage(i, col_white, _text_string);

                h_info[h][h_safe_data][1] += _rent_price;

                new query_string[145];
                format(query_string, sizeof(query_string), "UPالتاريخ `المنزلs` SET `h_safe_data`='%d|%d|%d|%d|%d|%d|%d|%d' WHERE `h_id`='%d' LIMIT 1", h_info[h][h_safe_data][0], h_info[h][h_safe_data][1], h_info[h][h_safe_guns][0], h_info[h][h_safe_guns][1], h_info[h][h_safe_guns][2], h_info[h][h_safe_guns][3], h_info[h][h_safe_guns][4], h_info[h][h_safe_guns][5], h_info[h][h_id]);
                mysql_query(sql_connection, query_string);
            }
            else
            {
                PlayerInfo[i][rent_house] = -1;
                update_int_sql(i, "u_استئجارالمنزل", getPlayerRentHouseID(i));
                SendError(i, "Have you been evicted from a الإيجار property.");
            }
        }

        format(_text_string, sizeof(_text_string), "Hesab asli: "c_green"$%s", convert_money(newban_count));
        SendClientMessage(i, col_white, _text_string);

		PlayerInfo[i][salary] = 0;
		PlayerInfo[i][bank] = newban_count;

		new admin_lvl = PlayerInfo[i][admin];
		if((1 <= admin_lvl <= 8))
		{
			new salary_admin = salary_administrators[admin_lvl -1];
			format(_text_string, sizeof(_text_string), "Hoghoogh baraye إداريهوtration: "c_green"$%s", convert_money(salary_admin));
			SendClientMessage(i, col_white, _text_string);

			give_money(i, salary_admin);
			insert_money_log(i, INVALID_PLAYER_ID, salary_admin, "إداريهوtration الراتب");
		}

		SendClientMessage(i, col_white, "-----------------------");

		PlayerInfo[i][exp] += 1 * server_bonus;
		PlayerLevelUpdateCheck(i);

		if(PlayerInfo[i][level] >= 3 && PlayerInfo[i][promocode_money] > 0)
		{
			give_money(i, PlayerInfo[i][promocode_money]);
			insert_money_log(i, INVALID_PLAYER_ID, PlayerInfo[i][promocode_money], "promo code bonus");

			PlayerInfo[i][promocode_money] = 0;
			update_int_sql(i, "u_promoالمال", PlayerInfo[i][promocode_money]);

			SendClientMessage(i, col_white, !""scm_info"You received a النقد bonus for أدخلing the Promo code.");
		}

		new query_string[130];
		format(query_string, sizeof(query_string), "UPالتاريخ `users` SET `u_الخبرة`='%d',`u_البنك`='%d' WHERE `u_id`='%d' LIMIT 1", PlayerInfo[i][exp], PlayerInfo[i][bank], PlayerInfo[i][id]);
		mysql_query(sql_connection, query_string);

		PlayerInfo[i][hour_played] = 0;
	}
	return 1;
}

callback:Timer_Unix()
{
    timestamp = gettime(timestamp_hour, timestamp_minute, timestamp_second)+10800;
    
	if(unix_hour <= timestamp)
    {
        unix_hour = timestamp+3600;
    }

    if(unix_5_min <= timestamp)
    {
        unix_5_min = timestamp+300;
    }

    if(unix_10_min <= timestamp)
    {
        unix_5_min = timestamp+300;
    }
    if(unix_10_min <= timestamp)
    {
        unix_10_min = timestamp+600;
    }
    if(unix_min <= timestamp)
    {
		minute_timer();
        unix_min = timestamp+60;
    }
    if(unix_sec <= timestamp)
    {
		second_timer();
        unix_sec = timestamp+1;
    }
    if(unix_three_sec <= timestamp)
    {
        unix_three_sec = timestamp + 3;
    }

    return 1;
}

stock second_timer()
{	
	// -----------------
	MRP_OneSecondTimer();
	BossTimerSecond();
	ms_Timer();
	// -----------------

	////////////////////////////


	for(new idx; idx < PANEL_LINE; idx++)
    {
        if(warningTime[idx] > 0)
        {
            warningTime[idx] -= 5;
            if(warningTime[idx] <= 0)
            {
                warningTime[idx] = 0;
                warningText[idx] = "_";
                TextDrawSetString(warningDraw[idx], "_");
            }
        }
        if(connectTime[idx] > 0)
        {
            connectTime[idx] -= 5;
            if(connectTime[idx] <= 0)
            {
                connectTime[idx] = 0;
                connectText[idx] = "_";
                TextDrawSetString(connectDraw[idx], "_");
            }
        }
    }

	foreach(new i: Player)
    {

		if(player_lobby_status[i] == true && player_lobby_idx[i] != -1)
		{
			new idx = player_lobby_idx[i], type = LobbyInfo[idx][LobbyType] - 1, map = LobbyInfo[idx][LobbyMap];
			if(player_lobby_type[i] >= LOBBY_TYPE_RACE && player_lobby_type[i] <= LOBBY_TYPE_STUNT)
			{
				if(GetPlayerState(i) != PLAYER_STATE_DRIVER)
				{
					for(new x = 0; x < MAX_PLAYERS_LOBBY; x++)
					{
						if(LobbyInfo[idx][LobbyPlayers][x] == i)
						{
							if(LobbyInfo[idx][LobbyVehicles][x] != INVALID_VEHICLE_ID)
							{
								RepairVehicle(LobbyInfo[idx][LobbyVehicles][x]);
								SetVehiclePos(LobbyInfo[idx][LobbyVehicles][x], LobbyPos[type][map][x][0], LobbyPos[type][map][x][1], LobbyPos[type][map][x][2]);
								SetVehicleZAngle(LobbyInfo[idx][LobbyVehicles][x], LobbyPos[type][map][x][3]);
								PutPlayerInVehicle(i, LobbyInfo[idx][LobbyVehicles][x], 0);
								SetCameraBehindPlayer(i);
								set_health(i, 100.0);
								break;
							}
							else OnPlayerLeaveLobby(i, idx, "لا النقل found.");
						}
					}
				}
				else
				{
					new vehicleid = GetPlayerVehicleID(i);
					new Float:veh_hp;
					GetVehicleHealth(vehicleid, veh_hp);
					if(veh_hp <= 300)
					{
						OnPlayerLeaveLobby(i, player_lobby_idx[i], "المركبة less than 300 HP.");
					}
				}
			}
			else if(player_lobby_type[i] == LOBBY_TYPE_PARKOUR)
			{
				new Float:pos[3], sidx = random(20);
				GetPlayerPos(i, pos[0], pos[1], pos[2]);
				if(pos[2] < LobbyPos[type][map][sidx][2] - 2.5)
				{
					SetPlayerPos(i, LobbyPos[type][map][sidx][0], LobbyPos[type][map][sidx][1], LobbyPos[type][map][sidx][2]);
					SetPlayerFacingAngle(i, LobbyPos[type][map][sidx][3]);
					SetCameraBehindPlayer(i);
					set_health(i, 100.0);
				}
			}
		}
	}

	if(g_SpawnAutoAllCarsTime == 1) {
		g_SpawnAutoAllCarsTime = 20 * 60;
		respawn_all_unoccupied_cars();
		SendClientMessageToAll(col_white, ""c_server"* MRP-Optimizer: "c_white"Mashin haye bi sar neshin pak shod.");
	}
	if(g_SpawnAutoAllCarsTime == 600) {
		SendClientMessageToAll(col_white, ""c_server"* MRP-Optimizer: "c_white"Mashin haye bi sar neshin ta 10 daghighe digar pak mهوhavand.");
	}
	if(g_SpawnAutoAllCarsTime == 30) {
		SendClientMessageToAll(col_white, ""c_server"* MRP-Optimizer: "c_white"Mashin haye bi sar neshin ta 30 sanie digar pak mهوhavand.");
	}
	if(g_SpawnAutoAllCarsTime > 1) {
		g_SpawnAutoAllCarsTime--;
	}

	if(TimeRandMsgSoal == 1)
	{
		TimeRandMsgSoal = 3600;
		SendClientMessageToAll(col_gold, "Soal Dari ya Komak Mikhay? Hatman dar /ask az ma beporsid");
	}

	if(TimeRandMsgSoal > 1) TimeRandMsgSoal--;

	if(GhorekeshiTime == 1)
	{
		GhorekeshiTime = 0;

		new GhorekeshiWinner = Iter_Random(logged_players);

		new string_fe[300];
		format(string_fe, sizeof string_fe, "{FF0000}[GHOREKESHI]: {FFFF00}اللاعب {228B22}%s {FFFF00}dar ghorekeshi [%s] barande shod! :D", Name(GhorekeshiWinner), GhorekeshiPrizeName);
		SendClientMessageToAll(col_gray, string_fe);

		foreach(new i: logged_players)
		{
			PlayerPlaySound(i, 5205, 0.0, 0.0, 0.0);
		}
		
		SendMes(GhorekeshiWinner, col_gray, "{FF0000}[GHOREKESHI]: {FFFF00}shoma dar ghorekeshi [%s] barande shodid!", GhorekeshiPrizeName);

		GhorekeshiPrizeName[0] = EOS;
	}
	if(GhorekeshiTime > 1) GhorekeshiTime--;

	foreach(new i: logged_players)
	{
		new player_state = GetPlayerState(i);

        if(gang_player(i) && player_state == PLAYER_STATE_ONFOOT && GetPlayerWeapon(i) == 41)
        {
            for(new x = 1; x < totalgraffiti + 1; x++)
            {
                if(x < MAX_GRAFFITI && IsPlayerInRangeOfPoint(i, 5.0, GRAFFITIInfo[x][gX], GRAFFITIInfo[x][gY], GRAFFITIInfo[x][gZ]))
                {
                    new fGun, fAmmo;
                    GetPlayerWeaponData(i, 9, fGun, fAmmo);
                    if(p_t_info[i][GraffitiIDx] != x)
                    {
                        p_t_info[i][GraffitiIDx] = x;
                        p_t_info[i][GraffitiExtingCount] = 0;
                        p_t_info[i][GraffitiAmmo] = fAmmo;
                    }
                    if(fAmmo < p_t_info[i][GraffitiAmmo])
                    {
                        p_t_info[i][GraffitiExtingCount]++;
                        p_t_info[i][GraffitiAmmo] = fAmmo;
                    }
                    if(p_t_info[i][GraffitiExtingCount] == 5)
                    {
                        if(GRAFFITIInfo[x][gMember] == PlayerInfo[i][member]) return SendError(i, "To graffiti ra eshtebah gerefti, in ghablan mal-e baradarhaye to ast.");
                        if(GRAFFITIInfo[x][gTime] > timestamp) return SendError(i, "Rang kheyli taze ast, nemitavanid haلاoz an ra taghyir dahid.");

                        new member_idx[2];
                        member_idx[0] = GRAFFITIInfo[x][gMember];
                        member_idx[1] = PlayerInfo[i][member];

                        gang_graffiti[member_idx[0]-18]--;
                        GRAFFITIInfo[x][gMember] = member_idx[1];

                        STRING_GLOBAL[0] = EOS;
                        mysql_format(con_bd, STRING_GLOBAL, sizeof(STRING_GLOBAL), "UPالتاريخ `graffiti` SET `عضو` = %d WHERE `id` = %d",
                        member_idx[1], GRAFFITIInfo[x][gID]);
                        mysql_tquery(con_bd, STRING_GLOBAL);

                        GRAFFITIInfo[x][gTime] = timestamp + 900;
                        gang_graffiti[member_idx[1]-18]++;

						foreach (new pl_id : logged_players) 
						{
							if(PlayerInfo[pl_id][member] == member_idx[0])
							{
								SendMes(pl_id, 0x33CC66FF, "[F] Mardom gozهمsh midahand ke yeki az graffiti-haye shoma ra raghaba taghyir dadand.");
							}

							if(PlayerInfo[pl_id][member] == member_idx[1])
							{
								SendMes(pl_id, 0x33CC66FF, "[F] %s [%d] graffiti ra rang zad, mardom be shoma ehteram gozashteand.", get_name(i), i);
							}
						}

                        SendAccess(i, "To ehteram baray-e khodetan va band-e khod kasb kardid! Hala shoma %d graffiti ra dari.", gang_graffiti[member_idx[1]-10]);

                        new money_graffiti = RandomEx(250, 500);
                        SendInfo(i, "Be onvane jayeze $%d migiri.", money_graffiti);
                        give_money(i, money_graffiti);

                        if(GRAFFITI[x] != INVALID_OBJECT_ID) DestroyDynamicObject(GRAFFITI[x]);
                        GRAFFITI[x] = CreateDynamicObject(GraffitiObject[GRAFFITIInfo[x][gMember]-18], GRAFFITIInfo[x][gX], GRAFFITIInfo[x][gY], GRAFFITIInfo[x][gZ], GRAFFITIInfo[x][grX], GRAFFITIInfo[x][grY], GRAFFITIInfo[x][grZ]);

                        p_t_info[i][GraffitiIDx] = x;
                        p_t_info[i][GraffitiExtingCount] = 0;
                        p_t_info[i][GraffitiAmmo] = 0;
                    }
                }
            }
        }

        if(getTimeJobFactionID(i) == job_fireman)
        {
            if(p_t_info[i][FireStatus] == 0 && p_t_info[i][FireTimer] > 0)
            {
                p_t_info[i][FireTimer]--;
                if(p_t_info[i][FireTimer] == 0)
                {
                    if(player_state == PLAYER_STATE_DRIVER && player_rentcar[i] != INVALID_VEHICLE_ID)
                    {
                        if(veh_info[player_rentcar[i]-1][v_owner] == job_fireman)
                        {
                            CreateFire(i);
                        }
                    }
                    else p_t_info[i][FireTimer] = 30;
                }
            }
            else if(p_t_info[i][FireStatus] > 0 && p_t_info[i][FireTimer] > 0)
            {
                p_t_info[i][FireTimer]--;
                if(p_t_info[i][FireTimer] == 0)
                {
                    SendMes(i, col_light_red, "Shoma be moghe be atashsozi nهمsidid. Montazere tamas jadid bashid.");
                    DestroyFire(i);
                    p_t_info[i][FireStatus] = 0;
                    p_t_info[i][FireTimer] = 60 + random(60);
                }
            }
			
            if(p_t_info[i][FireStatus] > 0 && player_state == PLAYER_STATE_ONFOOT && GetPlayerWeapon(i) == 42)
            {
                new idx = p_t_info[i][FireStatus] - 1;
                for(new x = 0; x < 5; x++)
                {
                    if(FireInfo[idx][fObject][x] == -1) continue;
                    if(IsPlayerInRangeOfPoint(i, 2.5, FireInfo[idx][fPos][x * 3 + 0], FireInfo[idx][fPos][x * 3 + 1], FireInfo[idx][fPos][x * 3 + 2]))
                    {
                        if(p_t_info[i][FireExting] != x)
                        {
                            p_t_info[i][FireExting] = x;
                            p_t_info[i][FireExtingCount] = 0;
                            continue;
                        }
                        new slot = WEAPON_Slot[GetPlayerWeapon(i)];
                        GetPlayerWeaponData(i, 9, PlayerInfo[i][Weapon][slot], PlayerInfo[i][Ammo][slot]);
                        if(PlayerInfo[i][Ammo][slot] < p_t_info[i][FireAmmo])
                        {
                            p_t_info[i][FireExtingCount]++;
                            p_t_info[i][FireAmmo] = PlayerInfo[i][Ammo][slot];
                        }
                        if(p_t_info[i][FireAmmo] < 500)
                        {
                            give_weapon(i, 42, 9999 - p_t_info[i][FireAmmo]);
                            p_t_info[i][FireAmmo] = 9999;
                        }
                        if(p_t_info[i][FireExtingCount] == 5)
                        {
                            p_t_info[i][FireExtingCount] = 0;
