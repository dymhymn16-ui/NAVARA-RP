	        format(text_string, sizeof(text_string), "لديك declهمd %s مطلوب. السبب: %s. الحالي مطلوب المستوى: %d", PlayerInfo[targetid][name], wanted_search_list[listitem][wanted_reason], PlayerInfo[targetid][wanted]);
