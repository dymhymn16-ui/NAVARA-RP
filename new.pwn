			SendClientMessage(playerid, col_white, _text_string);
			format(_text_string, sizeof(_text_string), ""c_green"* "c_white"You sقديم control of the الحافلةiness "c_green"%s"c_white" for "c_green"$%d"c_white".", PlayerInfo[playerid][name], sell_price[seller_id[playerid]]);
			SendClientMessage(seller_id[playerid], col_white, _text_string);

