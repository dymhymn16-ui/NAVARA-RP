	if(getLeaderFactionID(playerid) != 11) return 1;
	show_dialog(playerid, d_economy, DIALOG_STYLE_LIST, ""c_server"Ecoلاmics", "الحالة of organizations\nتحويل of funds\nSalaries of organizations", "Entekhab", "Bastan");
	return 1;
}


cmd:free(playerid, params[])
{
	if(getPlayerFactionID(playerid) != 11) return 1;
	if(PlayerInfo[playerid][rank] != 3) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Thهو team هو متاح as a lawyer.");
	if(sscanf(params, "ud", params[0], params[1])) return SendInfo(playerid, "أدخل: /مجاني [id/الاسم] [Gheymat]");

	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't apply thهو to yourself.");
	if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");
	if(p_t_info[params[0]][p_dialog] != -1) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"ليس متاح at the moment.");
    if(PlayerInfo[params[0]][jail] < 1) return SendError(playerid, "The اللاعب هو ليس in custody.");
	if(params[2] < 1 || params[2] > 100000) return SendError(playerid, "Gheymat service must be from "c_orange_red"1$"c_grey" to "c_orange_red"100.000$"c_grey".");


	buyer_id[playerid] = params[0];
	sell_price[playerid] = params[1];
	seller_id[params[0]] = playerid;


	new dialog_string[90 + MAX_PLAYER_NAME + 32 + 1 + 6];
	format(dialog_string, sizeof(dialog_string ), "You offered "c_green"%s"c_white" the الخدمات of a lawyer for "c_green"$%d",
	PlayerInfo[params[0]][name], params[1]);
	SendClientMessage(params[0], -1, dialog_string);

	format(dialog_string, sizeof(dialog_string ), ""c_server"%s "c_white"offers you the الخدمات of a lawyer for "c_server"$%d\n\n"c_grey"* Your term of termination will be shortened by 65 percent.",
	PlayerInfo[playerid][name], params[1]);
	show_dialog(params[0], d_free_accept, DIALOG_STYLE_MSGBOX, ""c_server"Lawyer services", dialog_string, "قبول", "إلغاء");
	return 1;
}
cmd:sellgunlic(playerid, params[])
{
	if(!cop_player(playerid)) return 1;
	if(PlayerInfo[playerid][rank] < 4) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Thهو command هو متاح from الرتبة 4.");
	if(sscanf(params, "ud", params[0], params[1])) return SendInfo(playerid, "أدخل: /بيعgunlic [id/имя] [Gheymat]");
