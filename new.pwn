			SendAccess(playerid, "Shoma ba movafghiat pelak "c_grey"[%s]"c_white" ra be mablagh "c_gold"%d M-Coin"c_white" kharidid.", veh_info[veh_id -1][v_plate], p_t_info[playerid][buy_custom_pelak_price]);

			RunQuery("UPالتاريخ `users_المركبات` SET `v_plate` = '%s' WHERE `v_id` = '%d' LIMIT 1", veh_info[veh_id -1][v_plate], veh_info[veh_id -1][v_id]);

			RunQuery("UPالتاريخ `users` SET `u_donate` = `u_donate`-'%d' WHERE `u_id` = '%d' LIMIT 1", p_t_info[playerid][buy_custom_pelak_price], PlayerInfo[playerid][id]);

