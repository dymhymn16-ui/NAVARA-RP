cmd:ame(playerid, params[])
{
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

  	if(sscanf(params, "s[108]", params[0])) return SendInfo(playerid, "أدخل: /ame [Matn]");
	new scm_string[128];
	format(scm_string, sizeof(scm_string ),">> %s", params[0]);
	SendClientMessage(playerid, col_light_purple, scm_string);
	SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 7000);
	// update_activity(playerid);
	return 1;
}
cmd:ado(playerid, params[])
{
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

  	if(sscanf(params, "s[108]", params[0])) return SendInfo(playerid, "أدخل: /ado [Matn]");
	new scm_string[128];
	format(scm_string, sizeof(scm_string ),">> %s", params[0]);
	SendClientMessage(playerid, col_light_purple, scm_string);
	SetPlayerChatBubble(playerid, scm_string, col_light_purple, 13.0, 7000);
	return 1;
}
cmd:todo(playerid, params[])
{
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	new text[64], pldo[64];
	if(sscanf(params, "p<*>s[64]s[64]", text, pldo)) return SendInfo(playerid, "أدخل: /todo [Speech in chat*action]");
	new scm_string[128];
	format(scm_string, sizeof(scm_string ), "{C2A2DA}-"c_white"%s {C2A2DA}-said %s, {C2A2DA}%s", text, PlayerInfo[playerid][name], pldo);
	send_world_message(playerid, 50.0, scm_string, col_white, col_white, col_gray, true);
	SetPlayerChatBubble(playerid, scm_string, col_white, 50, 5000);
	return 1;
}

cmd:pay(playerid, params[])
{
	if(duel_opponent[playerid] != INVALID_PLAYER_ID) return 1;

 	if(sscanf(params, "dd", params[0], params[1])) return SendInfo(playerid, "أدخل: /دفع [id] [meghdar]");
	if(!IsPlayerConnected(params[0])  || params[0] == playerid) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"bazikon kheyli door ast.");


	if(PlayerInfo[params[0]][level] < 2 && params[1] > 500) return SendError(playerid, "لا يمكنك تحويل المال to a المستوى 1 اللاعب more than $500");
	if(params[1] < 1 || params[1] > 50000) return SendError(playerid, "Shoma mitavanid az $1 ta $50,000 enteqal dahid.");
	if(params[1] > PlayerInfo[playerid][money]) return SendError(playerid, "Pol Kafi baraye enteghal nadarid.");

	if(GetString(p_t_info[params[0]][p_ip], p_t_info[playerid][p_ip]))
	{
		AdminMes(""c_orange_red"* A.تحذير: "c_grey"%s[%d] entegحالة mablagh %s[%d] | IP moshtarak", PlayerInfo[playerid][name], playerid, PlayerInfo[params[0]][name], params[0]);

		SendError(playerid, "Nemitavanid mablagh ra be in bazi konande enteqal dahid.");
		return 1;
	}

	give_money(playerid, -params[1]);
	give_money(params[0], params[1]);

	new scm_string[128];
	format(scm_string, sizeof(scm_string), ""c_green"* "c_white"%s be أنت {66CC00}$%s{FFFFFF} المال dad.", PlayerInfo[playerid][name], convert_money(params[1]));

	SendClientMessage(params[0], col_white, scm_string);

	format(scm_string, sizeof(scm_string), ""c_green"* "c_white"be اللاعب %s {66CC00}$%s{FFFFFF} dadi.", PlayerInfo[params[0]][name], convert_money(params[1]));
	SendClientMessage(playerid, col_white, scm_string);

	format(scm_string, sizeof(scm_string), "be %s المال dad", PlayerInfo[params[0]][name]);
	me_action(playerid, scm_string);

	insert_money_log(params[0], playerid, params[1], "team /دفع");
	return 1;
}

cmd:findbiz(playerid, params[])
{
	if(is_gps_used {playerid})
	{
		DisablePlayerRaceCheckpoint(playerid);
		is_gps_used {playerid} = 0;
		is_searching_player_used[playerid] = INVALID_PLAYER_ID;
	}

    if(PlayerInfo[playerid][money] < 5000) return SendClientMessage(playerid, col_white, ""scm_error"أنت 5000$ لا تملك.");

	new
		bizId;

	if(sscanf(params, "d", bizId)) 
		return SendInfo(playerid, "أدخل: /findbiz [biz id]");

    if(!(0 <= bizId < b_count))
        return SendClientMessage(playerid, col_white, ""scm_error"غير صالح المشروع ID.");

    give_money(playerid, -5000);

    SetPlayerRaceCheckpoint(playerid, 1, b_info[bizId -1][b_position][0], b_info[bizId -1][b_position][1], b_info[bizId-1][b_position][2], 0.0, 0.0, 0.0, 5.0);

	SendMes(playerid, col_white, "\"Business #%d\" Roye نظام الملاحة Set Shod: %.0f Meter Dهوtance.", bizId, GetPlayerDistanceFromPoint(playerid, b_info[bizId][b_position][0], b_info[bizId][b_position][1], b_info[bizId][b_position][2]));

	is_gps_used{playerid} = 1;

	return 1;
}

cmd:changehouse(playerid, params[])
{
	if(PlayerInfo[playerid][house] == -1) return  SendError(playerid, "Shoma Khone nadarid.");
	if(sscanf(params, "dd", params[0], params[1])) return SendInfo(playerid, "أدخل: /changeالمنزل [id] [Gheymat]");
	if(!IsPlayerConnected(params[0])) return  SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[1] < 1 || params[1] > 25000000) return  SendError(playerid, "Gheymat nemitavanad kamtar az 1$ va bهوhtar az 25.000.000$ bashad.");
	if(!IsPlayerInRangeOfPoint(params[0], 5, p_t_info[playerid][p_pos][0],
													p_t_info[playerid][p_pos][1],
													p_t_info[playerid][p_pos][2])) return  SendError(playerid, "Bazikon Kheyli door ast.");
	if(params[0] == playerid) return 	SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Shoma nemitavanid khane'i be khodetan be' forushid.");

	SetPVarInt(playerid, "h_بيع_id", params[0]);
	SetPVarInt(params[0], "h_بيعer_id", playerid);
	SetPVarInt(params[0], "h_بيعer_السعر", params[1]);

	new dialog_string[90 + MAX_PLAYER_NAME + 32 + 1 + 6];
	format(dialog_string, sizeof(dialog_string ), ""c_server"%s "c_white"offers you a hoاستخدام الرقم "c_server"%d"c_white" for "c_server"$%d", PlayerInfo[playerid][name], getPlayerHouseID(playerid), params[1]);
	show_dialog(params[0], d_h_sell_accept, DIALOG_STYLE_MSGBOX, ""c_server"شراءing real estate", dialog_string, "Kharid", "إلغاء");

	format(dialog_string, 118, ""c_green"* "c_white"You suggested "c_green"%s"c_white" شراء your home $%d",
	PlayerInfo[params[0]][name], params[1]);
	SendClientMessage(playerid, col_white, dialog_string);


	return 1;
}

cmd:buygas(playerid, params[])
{
	if(PlayerInfo[playerid][business] != -1) return SendError(playerid, "Shoma darhal hazer yek المشروع darid.");
	new bool:_gas = false;
	for(new b = 0; b < b_count; b ++)
	{
		if(b_info[b][b_type] != bizz_type_gas) continue;
		if(b_info[b][b_owner_inc] != -1) continue;

		if(!IsPlayerInRangeOfPoint(playerid, 5, b_info[b][b_position][0], b_info[b][b_position][1], b_info[b][b_position][2])) continue;
		_gas = true;
		p_t_info[playerid][business] = b + 1;
		new dialog_string[120];
		format(dialog_string, sizeof(dialog_string ),
		""c_white"Title: %s\n\
		Control: Mafia\n\
		Price: $%s", b_المعلومات[b][b_الاسم], convert_المال(b_المعلومات[b][b_السعر]));

		show_dialog(playerid, d_b_buy, DIALOG_STYLE_MSGBOX, ""c_server"ABOS المعلومات", dialog_string, "Kharid", "Bastan");
		SetPVarInt(playerid, "اللاعبUseCMDشراء", 1);
	}

	if(_gas == false) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت ليس near a محطة الوقود that can be filled.");
	
	return 1;
}

cmd:buytune(playerid, params[])
{
	if(PlayerInfo[playerid][business] != -1) return SendError(playerid, "Shoma darhal hazer yek المشروع darid.");
	new bool:_gas = false;
	for(new b = 0; b < b_count; b ++)
	{
		if(b_info[b][b_type] != bizz_type_tune) continue;
		if(b_info[b][b_owner_inc] != -1) continue;
		if(!IsPlayerInRangeOfPoint(playerid, 5, b_info[b][b_position][0], b_info[b][b_position][1], b_info[b][b_position][2])) continue;
		_gas = true;
		p_t_info[playerid][business] = b + 1;
		new dialog_string[120];
		format(dialog_string, sizeof(dialog_string ),
		""c_white"Title: %s\n\
		Control: Mafia\n\
		Gheymat: $%d", b_المعلومات[b][b_الاسم], b_المعلومات[b][b_السعر]);
		show_dialog(playerid, d_b_buy, DIALOG_STYLE_MSGBOX, ""c_server"المعلومات about the Vorood المنطقة", dialog_string, "Kharid", "Bastan");
		SetPVarInt(playerid, "اللاعبUseCMDشراء", 1);
	}
	if(_gas == false) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت ليس near a محطة الوقود that can be filled.");
	return 1;
}

