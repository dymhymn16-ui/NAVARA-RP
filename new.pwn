			if(!IsPlayerConnected(targetid)|| p_t_info[targetid][p_logged] == false || targetid == playerid) return show_dialog(playerid, d_h_rent_invite, DIALOG_STYLE_INPUT, ""c_server"Subletting", ""c_grey"* أدخلed اللاعب ID هو inصحيح.\n\n"c_white"أدخل the اللاعب ID you want to sublet in the المنزل:", "قبول", "إلغاء");

