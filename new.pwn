			SetPlayerSkin(pl_id, PlayerInfo[pl_id][org_skin]);
			new text_string[98];
			format(text_string, sizeof(text_string), ""c_green"* "c_white"لقد نجحت في joined the organization \"%s\".", f_info[PlayerInfo[pl_id][member]][f_name]);
			SendClientMessage(pl_id, col_white, text_string);
