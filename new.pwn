				{
					show_dialog(playerid, d_truck_buy, DIALOG_STYLE_INPUT, ""c_server"شراء Voroodla", ""c_white"أدخل the number of kilograms you want to شراء.\nالدعمs tractor: 10.000 kg.\n1 kg -10$", "Kharid", "إلغاء");
				}
				else if(used_area[playerid] == factory_unloading_area)
				{
					if(getJobFactionID(playerid) == job_trucker && player_trailer[playerid] !=INVALID_VEHICLE_ID && GetVehicleTrailer(GetPlayerVehicleID(playerid)) == player_trailer[playerid])
					{
						new _trailer_id = player_trailer[playerid] -1;
						if(trailer_type[_trailer_id] == DORM_FACTORY) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't unload Blanks at المصنع, go to Port.");
						player_trailer[playerid] = INVALID_VEHICLE_ID;
						static const trailer_type_name[][] = {
						"wood",
						"Voroodla",
						"blanks"};

						switch(trailer_type[_trailer_id])
						{
							case DORM_SAWMILL:
							{
								dorm_count[DORM_FACTORY_WOOD] += trailer_count[_trailer_id];
							}
							case DORM_FACTORY:
							{
								dorm_count[DORM_FACTORY_GUNS] += trailer_count[_trailer_id];
							}
							case DORM_MINE:
							{
								dorm_count[DORM_FACTORY_MINE] += trailer_count[_trailer_id];
							}
						}
						DestroyVehicle(_trailer_id + 1);
						for(new j = 1; j < 4; j ++)
						{
							PlayerTextDrawDestroy(playerid, td_db[playerid][j]);
							td_db[playerid][j] = PlayerText:-1;
						}
						PlayerInfo[playerid][truck_skill] += trailer_count[_trailer_id];
						update_int_sql(playerid, "u_tskill", PlayerInfo[playerid][truck_skill]);

						SendClientMessage(playerid, col_white, ""c_green"* "c_white"Shoma Ba Movafghiat unloaded.");
						SendClientMessage(playerid, -1, "Order المعلومات:");
						new _text_string[128];
						format(_text_string, 128, ""c_green"* "c_white"Unloaded %s: "c_green"%i kg"c_white".", trailer_type_name[trailer_type[_trailer_id]], trailer_count[_trailer_id]);
						SendClientMessage(playerid, -1, _text_string);

						new db_endmoney;
						db_endmoney = trailer_count[_trailer_id]* 10 + floatround((trailer_count[_trailer_id]* 10)* 0.10);

						format(_text_string, 128, ""c_green"* "c_white"المكتسب: "c_green"$%i"c_white".", db_endmoney);
						SendClientMessage(playerid, -1, _text_string);
						give_money(playerid, db_endmoney);
						insert_money_log(playerid, INVALID_PLAYER_ID, db_endmoney, "التوصيل سائق شاحنة");
						trailer_count[_trailer_id] = 0;
						trailer_type[_trailer_id] = -1;

						return 1;
					}
				}
				else if(used_area[playerid] == port_unloading_area)
				{
					if(getJobFactionID(playerid) == job_trucker && player_trailer[playerid] != INVALID_VEHICLE_ID && GetVehicleTrailer(GetPlayerVehicleID(playerid)) == player_trailer[playerid])
					{
						new _trailer_id_ = player_trailer[playerid] -1;
						player_trailer[playerid] = INVALID_VEHICLE_ID;
						static const _trailer_type_name[][] = {
						"wood",
						"Voroodla",
						"blanks"};

						DestroyVehicle(_trailer_id_ + 1);
						for(new j = 1; j < 4; j ++)
						{
							PlayerTextDrawDestroy(playerid, td_db[playerid][j]);
							td_db[playerid][j] = PlayerText:-1;
						}

						PlayerInfo[playerid][truck_skill] += trailer_count[_trailer_id_];
						update_int_sql(playerid, "u_tskill", PlayerInfo[playerid][truck_skill]);


						SendClientMessage(playerid, col_white, ""c_green"* "c_white"Shoma Ba Movafghiat unloaded.");
						SendClientMessage(playerid, -1, "Информация по заказу:");
						new _text_string[128];
						format(_text_string, 128, ""c_green"* "c_white"Unloaded %s: "c_green"%i kg"c_white".", _trailer_type_name[trailer_type[_trailer_id_]], trailer_count[_trailer_id_]);
						SendClientMessage(playerid, -1, _text_string);

						new db_endmoney;
						db_endmoney = trailer_count[_trailer_id_]* 10 + floatround((trailer_count[_trailer_id_]* 10)* 0.10);

						format(_text_string, 128, ""c_green"* "c_white"المكتسب: "c_green"$%i"c_white".", db_endmoney);
						SendClientMessage(playerid, -1, _text_string);
						give_money(playerid, db_endmoney);
						insert_money_log(playerid, INVALID_PLAYER_ID, db_endmoney, "التوصيل سائق شاحنة");
						trailer_count[_trailer_id_] = 0;
						trailer_type[_trailer_id_] = -1;

						for(new j = 0; j < 13; j ++)
						{
							if(port_trailer_status[j] == false)
							{
								port_trailer_status[j] = true;

								new tmpobjid = CreateDynamicObject(3569,
															port_trailer_pos[j][0],
															port_trailer_pos[j][1],
															port_trailer_pos[j][2],
															port_trailer_pos[j][3],
															port_trailer_pos[j][4],
															port_trailer_pos[j][5], -1, -1, -1, 300.0, 300.0);
								SetDynamicObjectMaterial(tmpobjid, 0, 3564, "dockالسيارةgo2_las", "lastrk1", 0xFFF0FFFF);
								SetDynamicObjectMaterial(tmpobjid, 3, 3564, "dockالسيارةgo2_las", "lastrk1", 0x00000000);

								SetTimerEx("clear_trailer", 300000, false, "dd", j, tmpobjid);
								break;
							}
						}
						return 1;
					}
				}

				tunes_check(playerid);
			}
		}

	}
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
	#if defined debug_mode
		printf("[DEخلل] [Onاللاعبينtateتغيير] اللاعبid:%d | جديدالدولة:%d | قديمالدولة:%d", playerid, newstate, oldstate);
	#endif

	if(eev_called {playerid} == 0 && newstate == PLAYER_STATE_DRIVER)
	{
		new vehicle_id = GetPlayerVehicleID(playerid);
		SetVehiclePos(vehicle_id, veh_info[vehicle_id -1][v_pos][0], veh_info[vehicle_id -1][v_pos][1], veh_info[vehicle_id -1][v_pos][2]);
 	}

	if(oldstate == 2 || oldstate == 3)
	{
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid, x, y, z);
		new Float:dif = GetDistanceBetweenPoints(x, y, 0.0, p_t_info [playerid][old_pos][0], p_t_info [playerid][old_pos][1], 0.0);
		if(dif < 100)
		{
			p_t_info[playerid][old_pos][0] = x;
			p_t_info[playerid][old_pos][1] = y;
			p_t_info[playerid][old_pos][2] = z;
		}
	}
	
	if(newstate == PLAYER_STATE_PASSENGER && (GetPlayerWeapon(playerid) ==  24 || GetPlayerWeapon(playerid) ==  25)) SetPlayerArmedWeapon(playerid, 0);

	foreach(new i: admin_players)
	{
		if(GetPVarInt(i, "spectate_الحالة")-1 == playerid)
		{
			switch(GetPlayerState(playerid))
			{
				case 1:
				{
					SetPlayerInterior(i, p_t_info[playerid][p_data][0]);
					SetPlayerVirtualWorld(i, p_t_info[playerid][p_data][1]);
					TogglePlayerSpectating(i, true);
					PlayerSpectatePlayer(i, playerid);
				}
				case 2:
				{
					SetPlayerInterior(i, p_t_info[playerid][p_data][0]);
					SetPlayerVirtualWorld(i, p_t_info[playerid][p_data][1]);
					new veh_id = GetPlayerVehicleID(playerid);
					TogglePlayerSpectating(i, true);
					PlayerSpectateVehicle(i, veh_id);
				}
				case 3:
				{
					SetPlayerInterior(i, p_t_info[playerid][p_data][0]);
					SetPlayerVirtualWorld(i, p_t_info[playerid][p_data][1]);
					new veh_id = GetPlayerVehicleID(playerid);
					TogglePlayerSpectating(i, true);
					PlayerSpectateVehicle (i, veh_id);
				}
			}
		}
	}

	if(oldstate == PLAYER_STATE_DRIVER && (newstate == PLAYER_STATE_ONFOOT || newstate == PLAYER_STATE_WASTED)) {
        if(griderObjectFire[playerid][0]) {
            DestroyDynamicObject(griderObjectFire[playerid][0]);
            DestroyDynamicObject(griderObjectFire[playerid][1]);
            DestroyDynamicObject(griderObjectFire[playerid][2]);
            griderObjectFire[playerid][0] = 0;
            griderObjectFire[playerid][1] = 0;
            griderObjectFire[playerid][2] = 0;
        }
    }

    if(newstate == PLAYER_STATE_DRIVER && !bicycles(GetPlayerVehicleID(playerid)))
    {
        if(pRadioLinkID[playerid] != 0 || strlen(RadioCustomURL[playerid]) >= 6)
        {
            if(strlen(RadioCustomURL[playerid]) >= 6 && RadioLink_Custom_ON[playerid]) PlayAudioStreamForPlayer(playerid, RadioCustomURL[playerid]);
            else if(pRadioLinkID[playerid] != 0) PlayAudioStreamForPlayer(playerid, RadioStations[pRadioLinkID[playerid]][RadioLink]);
        }
    }

    if(newstate == PLAYER_STATE_PASSENGER && !bicycles(GetPlayerVehicleID(playerid)))
    {
        new veh_driver_id = GetVehicleDriver(GetPlayerVehicleID(playerid));
        if(veh_driver_id != INVALID_PLAYER_ID) {
            if(pRadioLinkID[veh_driver_id] != 0 || strlen(RadioCustomURL[playerid]) >= 6)
            {
                if(strlen(RadioCustomURL[playerid]) >= 6 && RadioLink_Custom_ON[veh_driver_id]) PlayAudioStreamForPlayer(playerid, RadioCustomURL[playerid]);
                else if(pRadioLinkID[veh_driver_id] != 0) PlayAudioStreamForPlayer(playerid, RadioStations[pRadioLinkID[veh_driver_id]][RadioLink]);
            }
        }
    }

	switch(newstate)
	{
		case PLAYER_STATE_PASSENGER:
		{
			DeletePVar(playerid,"removeالوقتr");
			new _v_id = GetPlayerVehicleID(playerid);
			
			if(veh_info[_v_id -1][v_type] == vehicle_type_job && veh_info[_v_id -1][v_owner] == job_taxi && veh_info[_v_id -1][v_driver] != INVALID_PLAYER_ID)
			{
				new driverid = veh_info[_v_id -1][v_driver];
				if(player_rentcar[driverid] != _v_id || ! p_t_info[driverid][pTaxiPrice]) return 1;
				if(p_t_info [driverid][pTaxiPass] == INVALID_PLAYER_ID)
				{
					if(PlayerInfo[playerid][money] < p_t_info [driverid][pTaxiPrice])
					{
						SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"لا تملك eلاugh المال to take a تاكسي.");
						return RemovePlayerFromVehicle(playerid);
					}
					p_t_info [driverid][pTaxiStart] = veh_info[_v_id -1][v_millage];
					p_t_info [driverid][pTaxiPass] = playerid;
					p_t_info [driverid][pTaxiGoing] = true;
					SetPVarInt(playerid, "تاكسي_السائق_id", driverid);
					show_dialog(playerid, d_taxi_mark, DIALOG_STYLE_LIST, ""c_server"Navigator Ranandeh تاكسي", ""c_server"1. "c_white"Place a marker on the الخريطة\n"c_server"2. "c_white"Set a mark from a نظام الملاحة navigator\n"c_grey"متابعة the trip without a navigator", "Entekhab", "Bastan");
				}
				else
				{
					if(p_t_info [driverid][pTaxiTurn][0] == INVALID_PLAYER_ID) p_t_info [driverid][pTaxiTurn][0] = playerid;
					else if(p_t_info [driverid][pTaxiTurn][1] == INVALID_PLAYER_ID) p_t_info [driverid][pTaxiTurn][1] = playerid;
					else
					{
						if(!IsPlayerConnected(p_t_info [driverid][pTaxiTurn][0]) || GetPlayerVehicleID(p_t_info [driverid][pTaxiTurn][0]) != _v_id)
						{
							if(p_t_info [driverid][pTaxiTurn][1] != INVALID_PLAYER_ID)
							{
								p_t_info [driverid][pTaxiTurn][0] = p_t_info [driverid][pTaxiTurn][1];
								p_t_info [driverid][pTaxiTurn][1] = playerid;
							}
							else p_t_info [driverid][pTaxiTurn][0] = playerid;
						}
						else if(!IsPlayerConnected(p_t_info [driverid][pTaxiTurn][1]) || GetPlayerVehicleID(p_t_info [driverid][pTaxiTurn][1]) != _v_id)
						{
							p_t_info [driverid][pTaxiTurn][1] = playerid;
						}
						else
						{
							SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"Get in a تاكسي again, an خطأ has occurred.");
							RemovePlayerFromVehicle(playerid);
						}
					}
				}
			}
			if(veh_info[_v_id -1][v_type] == vehicle_type_job && veh_info[_v_id -1][v_owner] == job_bus && veh_info[_v_id -1][v_driver] != INVALID_PLAYER_ID)
			{
				new driverid = veh_info[_v_id -1][v_driver];
				if(player_rentcar[driverid] != _v_id || ! p_t_info[driverid][pTaxiPrice]) return 1;
				new price = p_t_info[driverid][pBusPrice];

				if(PlayerInfo[playerid][money] < price) return me_action(playerid, "showed a passing السائق");
				give_money(driverid, price);
				give_money(playerid, -price);
				insert_money_log(driverid, playerid, price, "سائق حافلة");

				new string[9];
				format(string, sizeof(string), "~b~+$%i", price);
				GameTextForPlayer(driverid, string, 1000, 1);
				format(string, sizeof(string), "~r~-$%i", price);
				GameTextForPlayer(playerid,string,1000, 1);
			}

		}
		case PLAYER_STATE_DRIVER:
		{
			SetPlayerArmedWeapon(playerid, 0);
			DeletePVar(playerid,"removeالوقتr");
			new veh_id = GetPlayerVehicleID(playerid);

			if(veh_id != 0) {
				new carEngine = veh_info[veh_id -1][v_engine_status];
				new engine,lights,alarm,doors,bonnet,boot,objective;
				GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
				SetVehicleParamsEx(veh_id, carEngine, lights, alarm, doors, bonnet, boot, objective);
			}

			player_vehicle[playerid] = veh_id;

			veh_info[veh_id -1][v_driver] = playerid;

			new exam_vehicle_id = GetPVarInt(playerid, "exam_المركبة");
			
			if(exam_vehicle_id > 0)
			{
				is_leave_exam_vehicle {playerid} = 0;
				DeletePVar(playerid, "مغادرةd_ex_المركبة");
			}

			if(veh_info[veh_id - 1][v_type] == vehicle_type_job &&
				(veh_info[veh_id - 1][v_model] == 481 ||
				veh_info[veh_id - 1][v_model] == 509 ||
				veh_info[veh_id - 1][v_model] == 510 ||
				veh_info[veh_id - 1][v_model] == 462 ||
				veh_info[veh_id - 1][v_model] == 468 ||
				veh_info[veh_id - 1][v_model] == 585) &&
				player_rentcar[playerid] != veh_id)
			{
   				SendError(playerid, "In vasile naghlie tavasote bazikon digari ejهمh shode ast.");
				RemovePlayerFromVehicle(playerid);
				return 1;

			}

	  		if(v_boat(veh_id) && PlayerInfo[playerid][boat_lic] == 0 && exam_vehicle_id == 0)
			{
   				SendError(playerid, "Shoma govahiالاسم ghaayeq raani nadarid.");
				RemovePlayerFromVehicle(playerid);
				return 1;
			}
			if(PlayerInfo[playerid][fly_lic] == 0 && v_plane(veh_id) && exam_vehicle_id == 0)
			{
			    SendError(playerid, "Shoma govahiالاسم havaei nadarid.");
				RemovePlayerFromVehicle(playerid);
				return 1;
			}
			if(driving_license(veh_id) && PlayerInfo[playerid][drive_lic] == 0 && exam_vehicle_id == 0)
			{
			    SendError(playerid, "Shoma govahiالاسم raanandegi nadarid.");
				RemovePlayerFromVehicle(playerid);
				return 1;
			}

			if(GetVehicleModel(veh_id) ==  420 && veh_info[veh_id -1][v_type] == 0)
			{
				RemovePlayerFromVehicle(playerid);
				SendError(playerid, "In vasileye naqliye baraye shoma dar dastres nهوt.");
				return 1;
			}
			if(veh_info[veh_id -1][v_type] == vehicle_type_server)
			{
				if(veh_info[veh_id -1][v_owner] != PlayerInfo[playerid][member])
				{
					RemovePlayerFromVehicle(playerid);
					SendError(playerid, "In vasileye naqliye baraye shoma dar dastres nهوt.");
					return 1;
				}
				if(veh_info[veh_id -1][v_rank] > PlayerInfo[playerid][rank])
				{
					RemovePlayerFromVehicle(playerid);
					SendError(playerid, "In vasileye naqliye baraye الرتبة "c_orange_red"%d"c_grey" dar dastres ast.", veh_info[veh_id -1][v_rank]);
					return 1;
				}
			}

			else if(veh_info[veh_id -1][v_type] == vehicle_type_family)
			{
				if(veh_info[veh_id -1][v_owner] != PlayerInfo[playerid][family])
				{
					RemovePlayerFromVehicle(playerid);
					SendError(playerid, "In vasileye naqliye baraye shoma dar dastres nهوt.");
					return 1;
				}
			}
			else if(veh_info[veh_id -1][v_type] == vehicle_type_job)
			{
				if(veh_info[veh_id -1][v_owner] != PlayerInfo[playerid][job] && veh_info[veh_id -1][v_owner] != PlayerInfo[playerid][timejob] && veh_info[veh_id -1][v_model] != 462)
				{
					if(veh_info[veh_id -1][v_owner] != job_forklift && veh_info[veh_id -1][v_owner] != job_pizzaboy)
						SendError(playerid, "Shoma dar "c_orange_red"%s"c_white" kar nemikonid.", jobs_name[veh_info[veh_id -1][v_owner] -1]);
					else if(veh_info[veh_id -1][v_owner] == job_forklift && veh_info[veh_id -1][v_owner] != job_pizzaboy) 
						SendError(playerid, "Shoma dar "c_orange_red"Ranande Lifttrac"c_white" kar nemikonid.");
					else if(veh_info[veh_id -1][v_owner] == job_pizzaboy)
						SendError(playerid, "Shoma dar "c_orange_red"Pizzaboy"c_white" kar nemikonid.");
					else
						SendError(playerid, "In vasileye naqliye baraye shoma dar dastres nهوt.");

					RemovePlayerFromVehicle(playerid);

					return 1;
				}
				else if(veh_id != player_rentcar[playerid] && (veh_info[veh_id -1][v_owner] == PlayerInfo[playerid][job] || veh_info[veh_id -1][v_owner] == PlayerInfo[playerid][timejob]))
				{
					show_dialog(playerid, d_rent_car, DIALOG_STYLE_MSGBOX, ""c_server"Ejهمh vasileye naqliye", ""c_white"Gheymat ejهمh - "c_green"$250\n\n"c_grey"* Aya vaghean mikhahid in vasileye naqliye ra ejهمh konid?", "Ejهمh", "Bastan");
				}
			}
			else if(veh_info[veh_id -1][v_type] == vehicle_type_player)
			{
				if(veh_info[veh_id -1][v_sell_price] > 0)
				{
					if(veh_info[veh_id -1][v_owner] != PlayerInfo[playerid][id])
					{
						format(global_string, sizeof(global_string),
						""c_server"شراء of transport:\n\n\
						"c_السيرفر"* "c_grey"Model: "c_white"%s\n\
						"c_السيرفر"* "c_grey"Gheymat: "c_white"$%d\n\
						"c_السيرفر"* "c_grey"Number: "c_white"%s\n\
						"c_السيرفر"* "c_grey"Mileage: "c_white"%d\n\n\
						"c_السيرفر"Installed improvements:\n",
						vehicle_name[GetVehicleModel(veh_id)-400],
						veh_info[veh_id -1][v_sell_price],
						veh_info[veh_id -1][v_plate],
						floatround(veh_info[veh_id -1][v_millage]));
						for(new j = 0; j < 5; j ++)
						{
							if(veh_info[veh_id -1][v_pt_engine][j] == 0) continue;
							strcat(global_string, engine_ptune[j]);
							strcat(global_string, "\n");
						}
						for(new j = 0; j < 5; j ++)
						{
							if(veh_info[veh_id -1][v_pt_brake][j] == 0) continue;
							strcat(global_string, brake_ptune[j]);
							strcat(global_string, "\n");
						}
						for(new j = 0; j < 5; j ++)
						{
							if(veh_info[veh_id -1][v_pt_stability][j] == 0) continue;
							strcat(global_string, stability_ptune[j]);
							strcat(global_string, "\n");
						}
						strcat(global_string, "\n\n");
						strcat(global_string, ""c_grey"Aya vaghean mikhahid in المركبةye naqliye ra شراءari konid?");
						show_dialog(playerid, d_carmarket_buy, DIALOG_STYLE_MSGBOX, ""c_server"السيارة Market", global_string, "Kharid", "إلغاء");

					}
					else if(veh_info[veh_id -1][v_owner] == PlayerInfo[playerid][id])
					{
						show_dialog(playerid, d_carmarket_buy, DIALOG_STYLE_MSGBOX, ""c_server"المركبة for sale", ""c_white"Your المركبة هو for sale, you really want to take it off sale?\n\n"c_grey"* Gheymat السيارة market service will ليس be returned.", "قبول", "إلغاء");
					}
					return 1;
				}
			}

			if(v_velo(veh_id)|| v_plane(veh_id)|| v_boat(veh_id)) return 1;

			if((veh_info[veh_id - 1][v_model] == 481 ||
				veh_info[veh_id - 1][v_model] == 509 ||
				veh_info[veh_id - 1][v_model] == 510 ||
				veh_info[veh_id - 1][v_model] == 462 ||
				veh_info[veh_id - 1][v_model] == 468 ||
				veh_info[veh_id - 1][v_model] == 585) &&
				veh_info[veh_id - 1][v_type] == vehicle_type_job) return 1;

			speedometr_status(playerid, true);

			if(PlayerInfo[playerid][settings][SPEEDOMETER_TYPE] != 2) speed_timer[playerid] = SetTimerEx("Upالتاريخاللاعبونpeedometr", 200, 1, "i", playerid);
			SendClientMessage(playerid, col_white,c_server"* "c_white"Baraye بدء Zadan Mashin Az Dokme "c_server"CTRL"c_white" Ya CMD "c_server"[/en]"c_white".");
			SendClientMessage(playerid, col_white,c_server"* "c_white"Baraye Baz Kardan الراديو "c_server"[/play]"c_white".");
			SendClientMessage(playerid, col_white,c_server"* "c_white"Turn headlight on/off "c_server"[/light]"c_white"."c_white" On/Off cruهوe control "c_server"[/slimit]"c_white".");
			SendClientMessage(playerid, col_white,c_server"* "c_white"Baraye Baz Ya Baste Kardan Kamarband "c_server"[/kamarband]"c_white" Ya Dokme "c_server"[2]"c_white".");
		}
	}

	if(oldstate == PLAYER_STATE_DRIVER)
    {
		if(StartRace == 2)
		{
			if(is_player_race_regged[playerid])
			{
				DestroyVehicle(player_race_vehicle[playerid]);
				new ch = (player_race_cp[playerid] -2);
				if(ch >= 0)
				{
					switch(RaceMap)
					{
						case 1:
						{
							set_race_pos(playerid, Race_Treck_Checkpoint_0[ch][0], Race_Treck_Checkpoint_0[ch][1], Race_Treck_Checkpoint_0[ch][2], 0.0, 0, 44);
							player_race_vehicle[playerid] = CreateVehicle(RaceVehicle, Race_Treck_Checkpoint_0[ch][0], Race_Treck_Checkpoint_0[ch][1], Race_Treck_Checkpoint_0[ch][2], Race_Treck_Checkpoint_0[ch][3], random(126), random(126), -1);
						}
						case 2:
