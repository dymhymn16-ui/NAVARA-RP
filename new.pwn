				b_info[b][b_cost]);
				show_dialog(playerid, d_carmarket_price, DIALOG_STYLE_INPUT, ""c_server"السيارة Market", d_string, "قبول", "Bargasht");
				return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"The السعر must be between $1 and $5,000,000.");
			}


			new current_slot = -1,
				carmarket_id;

