			if(PlayerInfo[playerid][bank] < strval(inputtext)) return show_dialog(playerid, d_atm_take, DIALOG_STYLE_INPUT, ""c_server"سحب المال", ""c_white"أدخل the المبلغ you want to سحب from your الحساب:", "قبول", "Bargasht"),
