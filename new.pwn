{
	show_dialog(playerid, d_help, DIALOG_STYLE_LIST, ""c_server"komak darbهم bazi", ""c_server"1. "c_white"dar mored poroje\n"c_server"2. "c_white"Security\n"c_server"3. "c_white"Role Play\n"c_server"4. "c_white"Game Basics\n"c_server"5. "c_white"First Steps\n"c_server"6. "c_white"Transport\n"c_server"7. "c_white"Dهوplay\n"c_server"8. "c_white"Housing\n"c_server"9. "c_white"Dهوplay\n"c_server"10. "c_white"البنكing and المخزن\n"c_server"11. "c_white"Work\n"c_server"12. "c_white" Organization", "Entekhab", "Bastan");
