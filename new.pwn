  		case d_reg_race:
		{			    
    		if(!response) return show_dialog(playerid, d_reg_gender, DIALOG_STYLE_LIST, !""scm_dialog"Entekhab Jensiyat", !"Mard\nZan", !"التالي", !"");

			reg_info[playerid][reg_skin] = 0;
