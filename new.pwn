			veh_info[vehicle_id -1][v_sell_price] = price;
			veh_info[vehicle_id -1][v_sell_slot] = current_slot;
			veh_info[vehicle_id -1][v_sell_carmarket] = carmarket_id;

			car_market_slotes_toggled[carmarket_id][current_slot] = true;

			new msg_text[150];
			format(msg_text, sizeof msg_text, ""scm_sucess"أنت ba movafaghiat "c_yellow"%s["c_grey"%s"c_yellow"]"c_white" ra be gheymat "c_green"$%d"c_white" baraye forush gozashtid.", vehicle_name[veh_info[vehicle_id -1][v_model]-400], veh_info[vehicle_id -1][v_plate], price);
			SendClientMessage(playerid, col_white, msg_text);

			new query_string[136];
			format(query_string, sizeof(query_string), "UPالتاريخ `users_المركبات` SET `v_بيع_slot`='%d',`v_بيع_السعر`='%d',`v_بيع_السيارةmarket`='%d' WHERE `v_id` = '%d'",
			veh_info[vehicle_id -1][v_sell_slot],
			veh_info[vehicle_id -1][v_sell_price],
			veh_info[vehicle_id -1][v_sell_carmarket],
			veh_info[vehicle_id -1][v_id]);
			mysql_tquery(sql_connection, query_string);
			format(query_string, sizeof(query_string),"اختر * FROM `users_المركبات` WHERE `v_id` = '%d' LIMIT 1",
			veh_info[vehicle_id -1][v_id]);
			mysql_tquery(sql_connection, query_string, "users_المركبات_جاري التحميل");

			DestroyVehicle(vehicle_id);

		}
		case d_carmarket_buy:
		{
			new veh_id = GetPlayerVehicleID(playerid);
