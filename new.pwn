			}
			veh_info[veh_id -1][v_fuel] = 60.0;
			car_market_slotes_toggled[veh_info[veh_id -1][v_sell_carmarket]][veh_info[veh_id -1][v_sell_slot]] = false;

			if(targetid != INVALID_PLAYER_ID)
