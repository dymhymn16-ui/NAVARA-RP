cmd:ash(playerid)
{
	if(GetPVarInt(playerid,"AutoExam")) return 1;
	show_dialog(playerid,d_auto_exam_1,0,"مدرسة القيادة",""c_white"\t\t\t\t\t\tDrive School\n\nقبول Driving School. In order to surrender, تحتاج إلى to do the following\n1. Read and memorize PDA\n2. Take a PAL kلاwledge test\n3. Pass the practical exam to the instructor","التالي","خروج");
	SetPVarInt(playerid,"AutoExam", true);
	return 1;
}

cmd:licenses(playerid)
{
    global_string[0] = EOS;
    format(global_string, 400, "%s"c_white"السائق: %s\n",global_string,(PlayerInfo[playerid][drive_lic]) ? return_lic_day(playerid, 1) : (""c_orange_red"لاne") );
    format(global_string, 400, "%s"c_white"Pilot رخصة: %s\n",global_string,(PlayerInfo[playerid][fly_lic]) ? return_lic_day(playerid, 2) : (""c_orange_red"لاne") );
    format(global_string, 400, "%s"c_white"Boat رخصة: %s\n", global_string,(PlayerInfo[playerid][boat_lic]) ? return_lic_day(playerid, 3) : (""c_orange_red"لاne"));
    format(global_string, 400, "%s"c_white"Gun رخصة: %s\n", global_string,(PlayerInfo[playerid][gun_lic]) ? (""c_green"نعم") : (""c_orange_red"لاne" ));
    show_dialog(playerid, d_none, 0, ""c_server"الرخصةs", global_string, "Bastan", "");
    me_action(playerid, "views its رخصةs");
	return 1;
}

cmd:myactivity(playerid, params[])
{
	if(!army_player(playerid) && !cop_player(playerid) && !fbi_player(playerid) && !nopo_player(playerid) && !medic_player(playerid) && !gov_player(playerid)) {
		SendError(playerid, "In Command Baraye Faction Haye Nezami Va Medic Va Shahrdari Ast.");
		return 1;
	}

	new targetid;
	if(sscanf(params, "u", targetid)) return SendInfo(playerid, "أدخل: /myactivity [id/الاسم]");
	if(!IsPlayerConnected(targetid)) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[targetid][p_pos][0], p_t_info[targetid][p_pos][1], p_t_info[targetid][p_pos][2]) || GetPlayerVirtualWorld(targetid) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");

	global_string[0] = EOS;

	new fraction_data[32];
	if(playerFactionStatus(playerid))
		format(fraction_data, sizeof(fraction_data), "%s", f_info[PlayerInfo[playerid][member]][f_name]);
	else
		format(fraction_data, sizeof(fraction_data), "mهوsing");

	new rank_data[32];
	if(PlayerInfo[playerid][rank])
		format(rank_data, sizeof(rank_data), "%s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1]);
	else
		format(rank_data, sizeof(rank_data), "mهوsing");

	new hours=0, minutes=0, seconds=0;
	ToHHMMSS(PlayerInfo[playerid][timeplaytoday], hours, minutes, seconds);
	new afk_hours=0, afk_minutes=0, afk_seconds=0;
	ToHHMMSS(PlayerInfo[playerid][timeplaytoday_afk], afk_hours, afk_minutes, afk_seconds);

	new year,
		month,
		day;

	getdate(year, month, day);

	format(
		global_string, 
		sizeof global_string,
		"\
		"c_white"Name : "c_السيرفر"%s\n\
		"c_white"Organization : "c_السيرفر"%s\n\
		"c_white"Rank : "c_السيرفر"%s\n\
		"c_white"Total time play today : "c_السيرفر"%02d:%02d:%02d\n\
		"c_white"Total afk today : "c_السيرفر"%02d:%02d:%02d\n\
		"c_white"Today's date : "c_السيرفر"    %d/%02d/%02d\n\
		"c_white"Current time : "c_السيرفر"    %d/%02d/%02d\n\
		\n\
		",
		PlayerInfo[playerid][name],
		fraction_data,
		rank_data,
		hours, minutes, seconds,
		afk_hours, afk_minutes, afk_seconds,
		year, month, day,
		timestamp_hour, timestamp_minute, timestamp_second);

	if(army_player(playerid) || cop_player(playerid) || fbi_player(playerid)) {
		format(
			global_string, 
			sizeof global_string,
			"%s\
			"c_white"Jails : "c_السيرفر"%d\n\
			"c_white"Killed and Jailed : "c_السيرفر"%d\n\
			"c_white"Cuffs : "c_السيرفر"%d\n\
			"c_white"Wanted haye dade shode : "c_السيرفر"%d Nafar\n\
			"c_white"Tedad /frisk : "c_السيرفر"%d\n\
			"c_white"Tedad /uncuff : "c_السيرفر"%d\n\
			"c_white"Tedad wanted haye dade shode : "c_السيرفر"%d wanted\n\
			"c_white"Tedad wanted haye pak shode : "c_السيرفر"%d Nafar\n\
			"c_white"Tedad license naghlie gerefte shode : "c_السيرفر"%d\n\
			"c_white"Tedad license gun gerefte shode : "c_السيرفر"%d\n\
			"c_white"Tedad material va cartridge gerefte shode : "c_السيرفر"%d\n\
			"c_white"Tedad drug haye gerefte shode : "c_السيرفر"%d\
			",
			global_string,
			PlayerInfo[playerid][activity_jails],
			PlayerInfo[playerid][activity_killed_and_jails],
			PlayerInfo[playerid][activity_cuffs],
			PlayerInfo[playerid][activity_wanted_give_players],
			PlayerInfo[playerid][activity_frisk],
			PlayerInfo[playerid][activity_uncuff],
			PlayerInfo[playerid][activity_wanted_give_count],
			PlayerInfo[playerid][activity_unwanted],
			PlayerInfo[playerid][activity_take_drive_license],
			PlayerInfo[playerid][activity_take_gun_license],
			PlayerInfo[playerid][activity_take_materials],
			PlayerInfo[playerid][activity_take_drugs]
			);
	}
	else if(medic_player(playerid)) {
		format(
			global_string, 
			sizeof global_string,
			"%s\
			"c_white"Heals : "c_السيرفر"%d\n\
			"c_white"Drug heals : "c_السيرفر"%d\n\
			"c_white"Cart salamat dade shode : "c_السيرفر"%d Nafar\
			",
			global_string,
			PlayerInfo[playerid][activity_heals],
			PlayerInfo[playerid][activity_drug_heals],
			PlayerInfo[playerid][activity_give_heal_cart]
			);
	}
	else if(gov_player(playerid)) {
		format(
			global_string, 
			sizeof global_string,
			"%s\
			"c_white"Tedad afrad biron andakhte shode : "c_السيرفر"%d Nafar\n\
			"c_white"Tedad /free haye dade shode : "c_السيرفر"%d\n\
			"c_white"Mablagh be dast amade az /free : "c_السيرفر"$%d\
			"c_white"Meghdar gun bardashte shode az faction : "c_السيرفر"$%d\
			",
			global_string,
			PlayerInfo[playerid][activity_afrad_kick_shode],
			PlayerInfo[playerid][activity_give_free],
			PlayerInfo[playerid][activity_give_free_money],
			PlayerInfo[playerid][activity_taked_guns_faction]
			);
	}

    show_dialog(targetid, d_none, DIALOG_STYLE_MSGBOX, ""c_server"Toاليوم Faction Duty", global_string, "Bastan", "");

	if(targetid != playerid)
	{
		new _scm_string[64];
		format(_scm_string, 64, "showed activity to %s.", PlayerInfo[targetid][name]);
		me_action(playerid, _scm_string);
	}
	else
	{
		me_action(playerid, "showed activity");
	}
	return 1;
}

cmd:lic(playerid, params[])
{
	if(sscanf(params, "u", params[0])) return SendInfo(playerid, "أدخل: /lic [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
    if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2]) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");

	global_string[0] = EOS;

    format(global_string, 400, "%s"c_white"السائق: %s\n",global_string,(PlayerInfo[playerid][drive_lic]) ? return_lic_day(playerid, 1) : (""c_orange_red"لاne") );
    format(global_string, 400, "%s"c_white"Pilot رخصة: %s\n",global_string,(PlayerInfo[playerid][fly_lic]) ? return_lic_day(playerid, 2) : (""c_orange_red"لاne") );
    format(global_string, 400, "%s"c_white"Boat رخصة: %s\n", global_string,(PlayerInfo[playerid][boat_lic]) ? return_lic_day(playerid, 3) : (""c_orange_red"لاne"));
    format(global_string, 400, "%s"c_white"Gun رخصة: %s\n", global_string,(PlayerInfo[playerid][gun_lic]) ? (""c_green"نعم") : (""c_orange_red"لاne" ));
    show_dialog(params[0], d_none, 0, ""c_server"الرخصةs", global_string, "Bastan", "");

	if(params[0] != playerid)
	{
		new _scm_string[64];
		format(_scm_string, 64, "showed رخصةs to %s.", PlayerInfo[params[0]][name]);
		me_action(playerid, _scm_string);
	}
	else
	{
		me_action(playerid, "showed رخصةs");
	}
	return 1;
}
//===================================================================================================================

cmd:route(playerid)
{
	if(getJobFactionID(playerid) != job_bus) return 1;
	if(player_rentcar[playerid] == INVALID_VEHICLE_ID || player_rentcar[playerid] != player_vehicle[playerid]) return 1;
	if(veh_info[player_rentcar[playerid] -1][v_type] != vehicle_type_job || veh_info[player_rentcar[playerid] -1][v_owner] != job_bus) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت ليس in the service transport!");
	show_dialog (playerid,d_bus_route,2,""c_server"اختر route:", "1. Los Santos - المصنع ($3000/reهو)\n2. Los Santos - Lumber Mill ($3400/reهو)\n3. Los Santos - mine ($3800/reهو)\n4. Los Santos - driving school ($3200/reهو)\n5. Los Santos - Port ($2800/reهو)", "Entekhab", "إلغاء");
	return 1;
}

cmd:delivery(playerid)
{
	if(getJobFactionID(playerid) != job_delivery && getJobFactionID(playerid) != job_fuel_delivery) return 1;
	if(GetPlayerState(playerid)!= PLAYER_STATE_DRIVER) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت ليس in the service transport.");

	if(player_rentcar[playerid] == INVALID_VEHICLE_ID) return 1;
	if(veh_info[player_vehicle[playerid] -1][v_type] != vehicle_type_job || (veh_info[player_vehicle[playerid] -1][v_owner] != job_fuel_delivery && veh_info[player_vehicle[playerid] -1][v_owner] != job_delivery)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت ليس in the service transport.");

	return show_delivery_menu(playerid);
}

cmd:stoprent(playerid)
{
	if(player_rentcar[playerid] == INVALID_VEHICLE_ID) return  SendError(playerid, "Shoma hich vasile naghliye ejهمh nakardid.");
	show_dialog(playerid, d_end, 0, ""c_server"Faskh Gharardad Ejهمh", ""c_white" Shoma mikhaid vasile naghliye ke ejهمh kardid ro az pass bedid?\n\n"c_grey"* Ejهمh mostard nakhahod shod.","Bale","Bastan");
	return 1;
}

cmd:end(playerid)
{
	if(getJobFactionID(playerid) != job_bus && getJobFactionID(playerid) != job_taxi && getJobFactionID(playerid) != job_mechanic && getJobFactionID(playerid) != job_trucker && getJobFactionID(playerid) != job_fireman) return 1;
	if(player_rentcar[playerid] == INVALID_VEHICLE_ID) return 1;
	if(veh_info[player_rentcar[playerid] -1][v_type] != vehicle_type_job || veh_info[player_rentcar[playerid] -1][v_owner] != PlayerInfo[playerid][job]) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"أنت ليس in the service transport!");

	show_dialog(playerid, d_end,0, ""c_server"End of المشروع اليوم", ""c_white" Do you really want to end your transport lease?\n\n"c_grey"* Ejهمh mostard nakhahod shod.","Bale","Bastan");
	return 1;
}

