		    family_info[family_count][fam_settings][5] = 3;
		    family_info[family_count][fam_settings][6] = 3;
		    family_info[family_count][fam_settings][7] = 3;
		    family_info[family_count][fam_settings][8] = 3;

		    family_info[family_count][fam_rating] = 0;
		    family_info[family_count][fam_ticket] = 0;

		    family_info[family_count][fam_max_car] = 2;
