callback: EatSteakRemoveAttach(playerid) {
	RemovePlayerAttachedObject(playerid, 6);
}

cmd:eat(playerid) {
	if(PlayerInfo[playerid][steak_cooked] <= 0) {
		SendClientMessage(playerid, col_white, ""scm_error"Shoma Steak Pokhte Shode Nadarid.");
		return 1;
	}

	new Float:health;
	GetPlayerHealth(playerid, health);

	health += 20.0;

	if(health >= 100.0) {
		health = 100.0;
	}

	// SetPlayerAttachedObject(playerid, 6, 19346, 6, 0.052999, 0.058999, 0.023999, -80.099960, -90.900001, -0.400000);

	SetPlayerAttachedObject(playerid, 6, 19882, 6, 0.054000, 0.000000, 0.042000);

    ApplyAnimation(playerid, "الطعام", "EAT_Burger", 3.0, 0, 0, 0, 0, 0, 1); // Eat Burger
	
	me_action(playerid, "steak khord");

	PlayerInfo[playerid][hunger] += 40;

	set_health(playerid, health);

	SetPlayerProgressBarValue(playerid, satiety_progress_bar[playerid], PlayerInfo[playerid][hunger]);

	SetTimerEx("EatSteakRemoveAttach", 4000, false, "d", playerid);

	PlayerInfo[playerid][steak_cooked] -= 1;
	update_int_sql(playerid,"u_steak_cooked",PlayerInfo[playerid][steak_cooked]);
	return 1;
}

CMD:campfire(playerid) {
	if(p_t_info[playerid][campfire_object] == 0) {
		show_dialog(playerid, d_campfire_create, DIALOG_STYLE_LIST, ""c_orange"Campfire",
			"\
			"c_orange_red"1. "c_white"Gozashtan Campfire Roye Zamin\n\
			",
		"اختر", "إلغاء");
		return 1;
	}
	new Float:x, Float:y, Float:z;
    Streamer_GetFloatData(
    	STREAMER_TYPE_OBJECT,
    	p_t_info[playerid][campfire_object],
    	E_STREAMER_X,
    	x);
    Streamer_GetFloatData(
    	STREAMER_TYPE_OBJECT,
    	p_t_info[playerid][campfire_object],
    	E_STREAMER_Y,
    	y);
    Streamer_GetFloatData(
    	STREAMER_TYPE_OBJECT,
    	p_t_info[playerid][campfire_object],
    	E_STREAMER_Z,
    	z);
    if(!IsPlayerInRangeOfPoint(playerid, 2.2, x, y, z)) {
		SendClientMessage(playerid, col_white, ""scm_error"Shoma kenar campfire nهوtid.");
		return 1;
	}
	if(!p_t_info[playerid][campfire_benzin]) {
		show_dialog(playerid, d_campfire_fuel, DIALOG_STYLE_LIST, ""c_orange"Campfire",
			"\
			"c_orange_red"1. "c_white"Rikhtan Benzin Roye Chob ha\n\
			",
		"اختر", "إلغاء");
		return 1;
	}
	if(p_t_info[playerid][campfire_object_steak] == 0) {
		show_dialog(playerid, d_campfire_put_food, DIALOG_STYLE_LIST, ""c_orange"Campfire",
			"\
			"c_orange_red"1. "c_white"Gozashtan Steak Roye Chob\n\
			",
		"اختر", "إلغاء");
		return 1;
	}
	show_dialog(playerid, d_campfire_take_food, DIALOG_STYLE_LIST, ""c_orange"Campfire",
		"\
		"c_orange_red"1. "c_white"Bardashtan Ghaza\n\
		",
	"اختر", "إلغاء");
	return 1;
}

stock CampfirePlayerTimer(playerid) {
	if(p_t_info[playerid][campfire_object] != 0 && p_t_info[playerid][campfire_object_steak] != 0) {
		if(p_t_info[playerid][campfire_time] < (13 * 60)) {
			p_t_info[playerid][campfire_time]++;
		}
		if(p_t_info[playerid][campfire_time] == (10 * 60)) {
			Streamer_SetIntData(STREAMER_TYPE_OBJECT, p_t_info[playerid][campfire_object_steak], E_STREAMER_MODEL_ID, 19882);
			new string[72];
			format(string, sizeof string, "%s's "c_orange"Campfire\n"c_white"الحالة : "c_light_green"الطعام Ready", PlayerInfo[playerid][name]);
			UpdateDynamic3DTextLabelText(p_t_info[playerid][campfire_label], col_white, string);
		}
		if(p_t_info[playerid][campfire_time] == (13 * 60)) {
			DestroyDynamicObject(p_t_info[playerid][campfire_object]);
			DestroyDynamicObject(p_t_info[playerid][campfire_object_steak]);
			DestroyDynamic3DTextLabel(p_t_info[playerid][campfire_label]);
			p_t_info[playerid][campfire_object] = 0;
			p_t_info[playerid][campfire_object_steak] = 0;
			p_t_info[playerid][campfire_time] = 0;
			p_t_info[playerid][campfire_label] = Text3D:INVALID_3DTEXT_ID;
		}
	}
}

forward PutGalonBenzinOnWoods(playerid);
public PutGalonBenzinOnWoods(playerid) {
	new string[72];
	format(string, sizeof string, "%s's "c_orange"Campfire\n"c_white"الحالة : "c_red"Fire", PlayerInfo[playerid][name]);
	UpdateDynamic3DTextLabelText(p_t_info[playerid][campfire_label], col_white, string);
	me_action(playerid, "be chob ha البنزين zad va atash roshan shod");
	RemovePlayerAttachedObject(playerid, 6);
	PlayerInfo[playerid][canister] -= 1;
	update_int_sql(playerid, "u_canهوter", PlayerInfo[playerid][canister]);
}

stock RemovePlayerWeapon(playerid, weaponid)
{
	new Weapons[12], pAmmo[12];
	new weap, ammo;
	for(new slot = 0; slot != 12; slot++)
	{
		GetPlayerWeaponData(playerid, slot, weap, ammo);
		if(weap != weaponid)
		{
			GetPlayerWeaponData(playerid, slot, Weapons[slot], pAmmo[slot]);
		}
	}
	ResetPlayerWeapons(playerid);
	for(new slot = 0; slot != 12; slot++)
	{
		give_weapon(playerid, Weapons[slot], pAmmo[slot]);
	}
}

stock SetPlayerHospital(playerid)
{
	if(IsPlayerToSquare(playerid, -891.3302, -2950.0190,2915.9917,560.3257)) SetPVarInt(playerid, "p_dead", 1);	 // LS
	else if(IsPlayerToSquare(playerid,-2929.6589,-2889.1660,-1326.9077,1493.1770)) SetPVarInt(playerid, "p_dead", 2); // SF
	else SetPVarInt(playerid, "p_dead", 3);	 // LV
	if(army_player(playerid)) SetPVarInt(playerid, "p_dead", 4);
	if(gang_player(playerid) && IsPlayerToSquare(playerid,1843.9275,-2205.1902,2960.9487,-954.5435)) SetPVarInt(playerid, "p_dead", 5);
}

ShowPlayerHealthCardMembers(playerid)
{
	new page = player_mysql_page[playerid];
	new query_string[188];
    format(query_string, sizeof query_string, "اختر `u_الاسم`,`u_الصحة_السيارةd_الخبرةire_الوقت` FROM `users` WHERE `u_عضو`= %d ORDER BY `u_الرتبة` ASC LIMIT %d, 20", getPlayerFactionID(playerid), page*20);
    mysql_tquery(sql_connection, query_string, "OnالصحةالسيارةdQuery", "d", playerid);
}

callback: OnHealthCardQuery(playerid)
{
	new rows = cache_num_rows();
    if(!rows) return SendError(playerid, "لا عضو هو found.");
	
	new page = player_mysql_page[playerid];

	new str[96];
	new String[2000];

    new namepl[MAX_PLAYER_NAME], unix_timestamp;
    new year, month, day, hour, minute, second;

	for(new i; i < rows; ++i)
	{
		cache_get_field_content(i, "u_الاسم", namepl, sql_connection, MAX_PLAYER_NAME);
		unix_timestamp = cache_get_field_content_int(i, "u_الصحة_السيارةd_الخبرةire_الوقت", sql_connection);

		if(unix_timestamp == 0) {
			format(str, 96,"الاسم: [%s]\tTarikh Enghza: [{FF0000}السيارةt لا يملك{FFFFFF}]\n", namepl);
		} else {
			TimestampToDate(unix_timestamp, year, month, day, hour, minute, second, 3, 30);
			format(str, 96,"الاسم: [%s]\tTarikh Enghza: [{%s}%d-%02d-%02d{FFFFFF}]\n", namepl, 
				unix_timestamp < timestamp ? "FF0000" : "FFFFFF", year, month, day);
		}
		strcat(String, str);
	}

	if(rows == 20) strcat(String, "التالي\n");
    if(page > 0) strcat(String, "رجوع\n");

	show_dialog(playerid,DIALOG_SEE_MEDIC_HEALTH_CARD,DIALOG_STYLE_TABLIST, ""c_server"السيارةt Salamat Afrad",String,"إغلاق","");
	return 1;
}

