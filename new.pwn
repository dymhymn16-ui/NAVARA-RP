		{
			if(!response) return family_settings(playerid);

			new rank_count = strval(inputtext);
			if(rank_count < 3 || rank_count > 20) return show_dialog(playerid, d_family_settings_c, DIALOG_STYLE_INPUT, !""scm_dialog"Number of الرتبةs", !""c_white"أدخل the number of العائلة الرتبةs you wهوh to set:\n"c_grey"The number of الرتبةs لا يمكنك be less than 3 and more than 20", !"التالي", !"Bargasht");

			PlayerInfo[playerid][family_rang] = rank_count;
			family_info[PlayerInfo[playerid][family]][fam_settings][8] = rank_count;

			family_settings(playerid);
			family_sql(PlayerInfo[playerid][family]);

			update_int_sql(playerid, "u_العائلة_الرتبة", PlayerInfo[playerid][family_rang]);
		}
		case d_family_settings_select:
		{
			if(!response) return family_settings(playerid);

			family_info[PlayerInfo[playerid][family]][fam_settings][GetPVarInt(playerid, !"اختر_id")] = listitem + 1;
			DeletePVar(playerid, !"اختر_id");

			family_settings(playerid);
			family_sql(PlayerInfo[playerid][family]);
		}
		case d_family_invite:
		{
			if(!response) return 1;

			new player_family_id = GetPVarInt(playerid, !"العائلة_اللاعب"), family_id = GetPVarInt(playerid, !"العائلة_id");
			DeletePVar(playerid, !"العائلة_اللاعب");
			DeletePVar(playerid, !"العائلة_id");

			PlayerInfo[playerid][family] = family_id;
			PlayerInfo[playerid][family_rang] = 1;

			Iter_Add(family_players[family_id], playerid);

			new text_string[125];
			format(text_string, sizeof(text_string), "{%s}[العائلة]"c_silver" %s[%d] joined the العائلة", family_info[family_id][fam_chat_color], PlayerInfo[playerid][name], playerid);
			family_message(family_id, col_silver, text_string);

			new query_string[130];
			format(query_string, sizeof(query_string), "UPالتاريخ `users` SET `u_العائلة`='%d',`u_العائلة_الرتبة`='1',`u_العائلة_التاريخ`=لاW() WHERE `u_id`='%d' LIMIT 1", getPlayerFamilyID(playerid), PlayerInfo[playerid][id]);
			mysql_query(sql_connection, query_string);

			family_info[family_id][fam_members] ++;

			format(query_string, sizeof(query_string), "UPالتاريخ `العائلة` SET `fam_عضوs`='%d' WHERE `fam_id`='%d' LIMIT 1", family_info[family_id][fam_members], getPlayerFamilyID(playerid));
			mysql_query(sql_connection, query_string);

			format(query_string, sizeof(query_string), "%s موافقed %s into the العائلة", PlayerInfo[player_family_id][name], PlayerInfo[playerid][name]);
			write_family(player_family_id, family_id, TYPE_LOG_INVITE, query_string);

			if(PlayerInfo[playerid][family_text] != Text3D:INVALID_3DTEXT_ID) {
				format(text_string, sizeof(text_string), "{%s}%s "c_white"العائلة", family_info[family_id][fam_chat_color], family_info[family_id][fam_name]);
				UpdateDynamic3DTextLabelText(PlayerInfo[playerid][family_text], -1, text_string);
			} else {
				format(text_string, sizeof text_string, "{%s}%s "c_white"العائلة", family_info[PlayerInfo[playerid][family]][fam_chat_color], family_info[PlayerInfo[playerid][family]][fam_name]);
				PlayerInfo[playerid][family_text] = CreateDynamic3DTextLabel(text_string, col_white, 0.0, 0.0, 0.7, 10.0, playerid, INVALID_VEHICLE_ID, 1);
			}
		}
		case d_family_rank:
		{
			if(!response) return DeletePVar(playerid, !"pl_setالرتبة_id");
			new _pl_id = GetPVarInt(playerid, !"pl_setالرتبة_id");

			if(!IsPlayerConnected(_pl_id)  || _pl_id == playerid) return SendError(playerid, "اللاعب ليس found.");
			if(PlayerInfo[_pl_id][family] != PlayerInfo[playerid][family]) return SendError(playerid, "The اللاعب هو ليس in your العائلة.");
			if(listitem + 1 >= PlayerInfo[playerid][family_rang] || PlayerInfo[playerid][family_rang] <= PlayerInfo[_pl_id][family_rang])
			{
				global_string[0] = EOS;
				for(new i = 0; i < family_info[PlayerInfo[playerid][family]][fam_settings][3]; i ++)
				{
					new line_string[80];
					format(line_string, sizeof(line_string), ""c_server"%d | "c_white"%s\n", i + 1, family_rank[PlayerInfo[playerid][family]][i]);
					strcat(global_string, line_string);
				}
				show_dialog(playerid, d_family_rank, DIALOG_STYLE_LIST, !""scm_dialog"العائلة الرتبة", global_string, !"اختر", !"إلغاء");
				return SendError(playerid, "لا يمكنك assign a اللاعب a الرتبة higher than yours.");
			}
			PlayerInfo[_pl_id][family_rang] = listitem + 1;
			update_int_sql(_pl_id, "u_العائلة_الرتبة", PlayerInfo[_pl_id][family_rang]);

			new text_string[144];
			format(text_string, sizeof(text_string), ""scm_info"You assigned "c_server"%s"c_white" to الرتبة "c_gold"%s (%d)", PlayerInfo[_pl_id][name], family_rank[PlayerInfo[_pl_id][family]][listitem], listitem + 1);
			SendClientMessage(playerid, col_white, text_string);

			format(text_string, sizeof(text_string), ""scm_info""c_server"%s"c_white" assigned you to الرتبة "c_gold"%s (%d)", PlayerInfo[playerid][name], family_rank[PlayerInfo[_pl_id][family]][listitem], listitem + 1);
			SendClientMessage(_pl_id, col_succes, text_string);

			format(text_string, sizeof(text_string), "%s assigned %s to الرتبة %s", PlayerInfo[playerid][name], PlayerInfo[_pl_id][name], family_rank[PlayerInfo[_pl_id][family]][listitem]);
			write_family(playerid, PlayerInfo[playerid][family], TYPE_LOG_AGIVERANK, text_string);
		}
        case d_offamily_list:
        {
			if(!response)
			{
				for(new i = 0; i < 10; i ++)
				{
					new pvar_string[8];
					format(pvar_string, sizeof(pvar_string), "ofm_%d", i);
					DeletePVar(playerid, pvar_string);
				}
				DeletePVar(playerid, !"ofm_القائمة_page");
				DeletePVar(playerid, !"ofm_القائمة_rows");
				DeletePVar(playerid, !"ofm_القائمةالعنصر");
				return DeletePVar(playerid, !"ofm_النوع");
			}

			switch(listitem)
			{
				case 0:
				{
					new page_id = GetPVarInt(playerid, !"ofm_القائمة_page") -1;
					if(page_id == 0)
					{
						SendError(playerid, "أنت on the first page of the العائلة عضوs القائمة.");
						if(!GetPVarInt(playerid, !"ofm_النوع"))
						{
							new query_string[100];
							mysql_format(sql_connection, query_string, sizeof(query_string), "اختر `u_الاسم`,`u_last_التاريخ`,`u_العائلة_الرتبة` FROM `users` WHERE `u_العائلة`='%d'", PlayerInfo[playerid][family]);
							mysql_tquery(sql_connection, query_string, "اتصالرجوع_ofالعائلة", "i", playerid);
							return 1;
						}
						return 1;
					}
					SetPVarInt(playerid, !"ofm_القائمة_page", page_id);

					if(!GetPVarInt(playerid, !"ofm_النوع"))
					{
						new query_string[100];
						mysql_format(sql_connection, query_string, sizeof(query_string), "اختر `u_الاسم`,`u_last_التاريخ`,`u_العائلة_الرتبة` FROM `users` WHERE `u_العائلة`='%d'", PlayerInfo[playerid][family]);
						mysql_tquery(sql_connection, query_string, "اتصالرجوع_ofالعائلة", "i", playerid);
						return 1;
					}
				}
				case 1:
				{
					new page_id = GetPVarInt(playerid, !"ofm_القائمة_page") -1;
					if((page_id * 10) + 1 >= GetPVarInt(playerid, !"ofm_القائمة_rows"))
					{
						SendError(playerid, "أنت on the last page of the العائلة عضوs القائمة.");

						if(!GetPVarInt(playerid, !"ofm_النوع"))
						{
							new query_string[100];
							mysql_format(sql_connection, query_string, sizeof(query_string), "اختر `u_الاسم`,`u_last_التاريخ`,`u_العائلة_الرتبة` FROM `users` WHERE `u_العائلة`='%d'", PlayerInfo[playerid][family]);
							mysql_tquery(sql_connection, query_string, "اتصالرجوع_ofالعائلة", "i", playerid);
							return 1;
						}
						return 1;
					}
					SetPVarInt(playerid, !"ofm_القائمة_page", page_id + 2);

					if(!GetPVarInt(playerid, !"ofm_النوع"))
					{
						new query_string[100];
						mysql_format(sql_connection, query_string, sizeof(query_string), "اختر `u_الاسم`,`u_last_التاريخ`,`u_العائلة_الرتبة` FROM `users` WHERE `u_العائلة`='%d'", PlayerInfo[playerid][family]);
						mysql_tquery(sql_connection, query_string, "اتصالرجوع_ofالعائلة", "i", playerid);
						return 1;
					}
				}
				default:
				{
					new pvar_string[28], pl_name[20];
					format(pvar_string, 10, "ofm_%d", listitem -2);
					GetPVarString(playerid, pvar_string, pl_name, 20);
					SetPVarInt(playerid, !"ofm_القائمةالعنصر", listitem -2);

					show_dialog_offpanel(playerid, pl_name, 3);
				}
			}
			return 1;
		}
