			SendClientMessage(seller_id[playerid], col_white, string);
			format(string, sizeof(string),""c_green"* "c_white"You kupil "c_green"%d "c_white"гr. drug استخدام "c_green"%s", sell_item[seller_id[playerid]], PlayerInfo[seller_id[playerid]][name]);
