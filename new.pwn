					{
						mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الاسم`,`u_الرتبة`,`u_last_التاريخ` FROM `users` WHERE `u_عضو` = '%d' AND `u_متصل` = '0'", getPlayerFactionID(playerid));
						mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs", "i", playerid);
						return 1;
					}
					mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الاسم`,`u_الرتبة`,`u_last_التاريخ` FROM `users` WHERE `u_عضو` = '%d' AND `u_الرتبة` = '%d' AND `u_متصل` = '0'", getPlayerFactionID(playerid), GetPVarInt(playerid, "ofm_النوع"));
					mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs", "i", playerid);

				}
				case 2:show_dialog(playerid, d_offmembers_pl_rank, DIALOG_STYLE_INPUT, ""c_server"Changing اللاعب الرتبة", ""c_white"أدخل the الرتبة number you want to set for the اللاعب:", "Entekhab", "Bargasht");
			}
		}
		case d_offmembers_pl_rank:
		{
			new pvar_string[28],
				pl_name[MAX_PLAYER_NAME -4];
			format(pvar_string, sizeof(pvar_string), "ofm_%d", GetPVarInt(playerid, "ofm_القائمةالعنصر"));
			GetPVarString(playerid, pvar_string, pl_name, MAX_PLAYER_NAME -4);
			if(strval(inputtext)< 1 || strval(inputtext)> f_info[PlayerInfo[playerid][member]][f_rank_settings][0]) 
				return show_dialog(playerid, d_offmembers_pl_rank, DIALOG_STYLE_INPUT, ""c_server"Promotion/Demotion", ""c_grey"غير صالح الرتبة number!\n\n"c_white"أدخل the الرتبة number you want to set for the اللاعب:", "Entekhab", "Bargasht"), SendError(playerid, "غير صالح الرتبة value.");
			if(response)
			{
				new _text_string[128];
				format(_text_string,sizeof(_text_string),"UPالتاريخ `users` SET `u_الرتبة` = '%d' WHERE `u_الاسم` = '%s' LIMIT 1",
				strval(inputtext), pl_name);
				mysql_tquery(sql_connection, _text_string, "", "");
				format(_text_string, sizeof _text_string, "لديك تغييرd the الرتبة of "c_server"%s"c_white" to "c_server"%d", pl_name, strval(inputtext));
				SendClientMessage(playerid, col_white, _text_string);
			}
			format(pvar_string, sizeof(pvar_string), ""c_server"%s", pl_name);
			show_dialog(playerid, d_offmembers_pl_menu, DIALOG_STYLE_LIST, pvar_string, ""c_white"اللاعب المعلومات\nDهوmهوs from Organizations\nPromote/Demote اللاعب", "Entekhab", "Bargasht");
		}
		case d_offmembers_pl_menu_info:
