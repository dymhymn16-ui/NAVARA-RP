cmd:s(playerid, params[])
{
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(sscanf(params, "s[108]", params[0])) return SendInfo(playerid, "أدخل: /s [Matn]");
	CheckForAdvTexts(playerid, params[0]);
 	new scm_string[128];
	format(scm_string, sizeof(scm_string ), "%s dad zad: %s!!.", PlayerInfo[playerid][name], params[0]);
	send_world_message(playerid, 50.0, scm_string, col_white, col_white, col_gray, false);
	format(scm_string, sizeof(scm_string ), ": %s!!.", params[0]);
	ApplyAnimation(playerid,"ON_LOOKERS","shout_in",9000.999,0,0,0,0,0,1);
	SetPlayerChatBubble(playerid, scm_string, col_white, 45, 5000);
	return 1;
}

cmd:do(playerid, params[])
{
	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);

	if(sscanf(params, "s[128]", params[0])) return SendInfo(playerid, "أدخل: /do [Matn]");
	do_action(playerid, params[0]);
	// update_activity(playerid);
	return 1;
}
