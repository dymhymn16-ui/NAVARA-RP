					mysql_query(sql_connection, query_string);

					format(query_string, sizeof(query_string), "UPالتاريخ `المنزلs` SET `h_العائلة`=%d WHERE `h_id`='%d'", getPlayerFamilyID(playerid), h_info[house_id][h_id]);
					mysql_query(sql_connection, query_string);
