stock kick_player(playerid)
{
	new ms = GetPlayerPing(playerid)> 200 ? 200 : GetPlayerPing(playerid)+ 50;
	return SetTimerEx("fixed_طرد", ms, 0, "i", playerid);
}

callback: fixed_kick(playerid)
{
	if(!IsPlayerConnected(playerid)) return 1;
	Kick(playerid);
	return 1;
}

stock set_interior(playerid, interior)
{
	p_t_info[playerid][p_data][0] = interior;
	return SetPlayerInterior(playerid, interior);
}

stock set_world(playerid, world)
{
	p_t_info[playerid][p_data][1] = world;
	if(p_t_info[playerid][p_logged] == true && GetPVarInt(playerid, "exam_المركبة") ==  0 && is_drug_effect {playerid} == 0)
	{
		switch(world)
		{
			case 0:
			{
				SetPlayerTime(playerid, timestamp_hour, timestamp_minute), SetPlayerWeather(playerid, global_weather);
			}
			case 1..9: SetPlayerWeather(playerid, 4), SetPlayerTime(playerid, 18, 0);
			case 10:SetPlayerTime(playerid, 12, 0), SetPlayerWeather(playerid, global_weather);
		}
	}
	
	if(p_t_info[playerid][business] != -1) SetPlayerWeather(playerid, 4), SetPlayerTime(playerid, 18, 0);
	return SetPlayerVirtualWorld(playerid, world);
}

stock set_race_pos(playerid, Float:x, Float:y, Float:z, Float:angle, interior, world)
{
	if(world == 0 && p_t_info[playerid][p_data][1] != 0 && is_drug_effect {playerid} == 0) SetPlayerWeather(playerid, global_weather), SetPlayerTime(playerid, timestamp_hour, 0);
	if(interior != -1) set_interior(playerid, interior);

	if(world != -1)set_world(playerid, world);


	p_t_info[playerid][p_tp_immune_time] = 4;
	SetPlayerPos(playerid, x, y, z);
	SetPlayerFacingAngle(playerid, angle);
	p_t_info[playerid][p_pos][0] = x;
	p_t_info[playerid][p_pos][1] = y;
	p_t_info[playerid][p_pos][2] = z;
	p_t_info[playerid][p_pos][3] = angle;

	if(gotome_player[playerid] != -1)
	{
		p_t_info[gotome_player[playerid]][p_tp_immune_time] = 2;
		SetPlayerPos(gotome_player[playerid], x, y, z);
		SetPlayerFacingAngle(gotome_player[playerid], angle);
		p_t_info[gotome_player[playerid]][p_pos][0] = x;
		p_t_info[gotome_player[playerid]][p_pos][1] = y;
		p_t_info[gotome_player[playerid]][p_pos][2] = z;
		p_t_info[gotome_player[playerid]][p_pos][3] = angle;
		set_world(gotome_player[playerid], world);
		set_interior(gotome_player[playerid], interior);
	}

	ClearAnimations(playerid, 1);
	SetCameraBehindPlayer(playerid);
	foreach(new i: admin_players)
	{
		if(GetPVarInt(i, "spectate_الحالة")-1 == playerid)
		{
			switch(GetPlayerState(playerid))
			{
				case 1:
				{
					SetPlayerInterior(i, p_t_info[playerid][p_data][0]);
					SetPlayerVirtualWorld(i, p_t_info[playerid][p_data][1]);
					TogglePlayerSpectating(i, true);
					PlayerSpectatePlayer(i, playerid);
				}
				case 2:
				{
					SetPlayerInterior(i, p_t_info[playerid][p_data][0]);
					SetPlayerVirtualWorld(i, p_t_info[playerid][p_data][1]);
					new veh_id = GetPlayerVehicleID(playerid);
					TogglePlayerSpectating(i, true);
					PlayerSpectateVehicle(i, veh_id);
				}
				case 3:
				{
					SetPlayerInterior(i, p_t_info[playerid][p_data][0]);
					SetPlayerVirtualWorld(i, p_t_info[playerid][p_data][1]);
					new veh_id = GetPlayerVehicleID(playerid);
					TogglePlayerSpectating(i, true);
					PlayerSpectateVehicle (i, veh_id);
				}
			}
		}
	}
	return 1;
}

stock Float:GetDistanceBetweenPlayers(p1,p2)
{
	if(!IsPlayerConnected(p1) || !IsPlayerConnected(p2))
	{
		return -1.00;
	}
	new Float:x1,Float:y1,Float:z1,Float:x2,Float:y2,Float:z2;
	GetPlayerPos(p1,x1,y1,z1);
	GetPlayerPos(p2,x2,y2,z2);
	return floatsqroot(floatpower(floatabs(floatsub(x2,x1)),2)+floatpower(floatabs(floatsub(y2,y1)),2)+floatpower(floatabs(floatsub(z2,z1)),2));
}

stock save_temp_skin(playerid)
{
	return RunQuery("UPالتاريخ `users` SET `u_tempskin`='%d|%d|%d|%d|%d' WHERE `u_id` = '%d'", PlayerInfo[playerid][temp_skin][0], PlayerInfo[playerid][temp_skin][1], PlayerInfo[playerid][temp_skin][2], PlayerInfo[playerid][temp_skin][3], PlayerInfo[playerid][temp_skin][4], PlayerInfo[playerid][id]);
}

stock texture_load_mode(playerid, interval = 1750) 
{
	toggle_controlable(playerid, false);
	SetTimerEx("toggle_controlable", interval, false, "ii", playerid, true);
}

stock set_pos(playerid, Float:x, Float:y, Float:z, Float:angle, interior, world)
{
	if(world == 0 && p_t_info[playerid][p_data][1] != 0 && is_drug_effect {playerid} == 0) SetPlayerWeather(playerid, global_weather), SetPlayerTime(playerid, timestamp_hour, 0);
	if(interior != -1)set_interior(playerid, interior);


	toggle_controlable(playerid, false);
	SetTimerEx("toggle_controlable", 1750, false, "ii", playerid, true);
	if(PlayerInfo[playerid][load_textures] == 1) show_fon_player(playerid);

	if(world != -1)set_world(playerid, world);

	p_t_info[playerid][p_tp_immune_time] = 4;
	SetPlayerPos(playerid, x, y, z);
	SetPlayerFacingAngle(playerid, angle);
	p_t_info[playerid][p_pos][0] = x;
	p_t_info[playerid][p_pos][1] = y;
	p_t_info[playerid][p_pos][2] = z;
	p_t_info[playerid][p_pos][3] = angle;



	p_t_info[playerid][last_alt] = GetTickCount();

	p_t_info [playerid][old_pos][0] = x;
	p_t_info [playerid][old_pos][1] = y;
	p_t_info [playerid][old_pos][2] = z;

	p_t_info[playerid][real_pos][0] = x;
	p_t_info[playerid][real_pos][1] = y;
	p_t_info[playerid][real_pos][2] = z;

	SetCameraBehindPlayer(playerid);
	foreach(new i: admin_players)
	{
		if(GetPVarInt(i, "spectate_الحالة")-1 == playerid)
		{
			switch(GetPlayerState(playerid))
			{
				case 1:
				{
					SetPlayerInterior(i, p_t_info[playerid][p_data][0]);
					SetPlayerVirtualWorld(i, p_t_info[playerid][p_data][1]);
					TogglePlayerSpectating(i, true);
					PlayerSpectatePlayer(i, playerid);
				}
				case 2:
				{
					SetPlayerInterior(i, p_t_info[playerid][p_data][0]);
					SetPlayerVirtualWorld(i, p_t_info[playerid][p_data][1]);
					new veh_id = GetPlayerVehicleID(playerid);
					TogglePlayerSpectating(i, true);
					PlayerSpectateVehicle(i, veh_id);
				}
				case 3:
				{
					SetPlayerInterior(i, p_t_info[playerid][p_data][0]);
					SetPlayerVirtualWorld(i, p_t_info[playerid][p_data][1]);
					new veh_id = GetPlayerVehicleID(playerid);
					TogglePlayerSpectating(i, true);
					PlayerSpectateVehicle (i, veh_id);
				}
			}
		}
	}
	return 1;
}

callback: toggle_controlable(playerid, bool:toggle)
{
	if(!toggle)SetPVarInt(playerid, "مجانيze_الحالة", 1);
	else DeletePVar(playerid, "مجانيze_الحالة");
	if(is_tazered {playerid} != 0) is_tazered {playerid} = 0;
	return TogglePlayerControllable(playerid, toggle);
}
callback: clear_anim(playerid) return ApplyAnimation(playerid, "السيارةRY", "crry_prtial", 4.0,0,0,0,0,0,1);

#include "..\library\static\init.inc"

callback:player_timer(playerid)
{
	if(!IsPlayerConnected(playerid)) KillTimer(PlayerInfo[playerid][main_timer]), PlayerInfo[playerid][main_timer] = -1;
	if(is_searching_player_used[playerid] != INVALID_PLAYER_ID && is_gps_used {playerid}) 
	{
		new targetid = is_searching_player_used[playerid];
		if(!IsPlayerConnected(targetid)) 
		{
			DisablePlayerRaceCheckpoint(playerid);
			is_gps_used {playerid} = 0;
			is_searching_player_used[playerid] = INVALID_PLAYER_ID;
		}
		else
		{
			SetPlayerRaceCheckpoint(playerid, 1, p_t_info[targetid][p_pos][0], p_t_info[targetid][p_pos][1], p_t_info[targetid][p_pos][2], 0.0, 0.0, 0.0, 5);
		}
	}

	if(PlayerInfo[playerid][vip] > 0) {
		if(timestamp > PlayerInfo[playerid][vip_time]) {
			new query_string[100];
			format(query_string, sizeof(query_string), "UPالتاريخ `users` SET `u_vip`='0', `u_vip_الوقت`=0 WHERE `u_id` = '%d' LIMIT 1", PlayerInfo[playerid][id]);
			mysql_query(sql_connection, query_string);

			if(PlayerInfo[playerid][vip] == 1) {
				SendClientMessage(playerid, col_white, ""c_green"* "c_white"الوقت VIP "c_server"'Gقديم'"c_white" أنت انتهى.");
			}

			PlayerInfo[playerid][vip] = 0;
			PlayerInfo[playerid][vip_time] = 0;
			UpdatePlayerName(playerid);
		}
	}

	CheckPlayerPremiumTime(playerid);

	if(PlayerInfo[playerid][war_tp] == 1) {
		PlayerInfo[playerid][war_tp] = 0;
	}

	if(PlayerInfo[playerid][war_tp] > 1) {
		PlayerInfo[playerid][war_tp] --;
	}

	if(PlayerInfo[playerid][mute] == 1) {
		PlayerInfo[playerid][mute] = 0;
		CallRemoteFunction("SV_AddVoice", "d", playerid);
	}

	if(PlayerInfo[playerid][mute] > 1) {
		PlayerInfo[playerid][mute] --;
	}

	if(PlayerInfo[playerid][f_mute] > 0)PlayerInfo[playerid][f_mute] --;
	if(PlayerInfo[playerid][fam_mute] > 0) PlayerInfo[playerid][fam_mute] --;
	if(PlayerInfo[playerid][jailed] > 1) {
		PlayerInfo[playerid][jailed]--;

		UpdatePlayerTimeJailTextdraw(playerid);
	}
	if(player_practice_timer[playerid] > 0)player_practice_timer[playerid] --;
	
	CampfirePlayerTimer(playerid);
	
