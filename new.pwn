					}
					new query_string[128];
					mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الاسم`,`u_الرتبة`,`u_last_التاريخ` FROM `users` WHERE `u_عضو` = '%d' AND `u_الرتبة` = '%d' AND `u_متصل` = '0'", getPlayerFactionID(playerid), GetPVarInt(playerid, "ofm_النوع"));
					mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs", "i", playerid);

					return 1;
				}
				SetPVarInt(playerid, "ofm_القائمة_page", page_id + 2);
				if(!GetPVarInt(playerid, "ofm_النوع"))
				{
					new query_string[128];
					mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الاسم`,`u_الرتبة`,`u_last_التاريخ` FROM `users` WHERE `u_عضو` = '%d' AND `u_متصل` = '0'", getPlayerFactionID(playerid));
					mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs", "i", playerid);
					return 1;
				}
				new query_string[128];
				mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الاسم`,`u_الرتبة`,`u_last_التاريخ` FROM `users` WHERE `u_عضو` = '%d' AND `u_الرتبة` = '%d' AND `u_متصل` = '0'", getPlayerFactionID(playerid), GetPVarInt(playerid, "ofm_النوع"));
				mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs", "i", playerid);
			}
			else
			{
				new pvar_string[28], pl_name[20];
				format(pvar_string, 10, "ofm_%d", listitem -2);
				GetPVarString(playerid, pvar_string, pl_name, 20);
				SetPVarInt(playerid, "ofm_القائمةالعنصر", listitem -2);
				format(pvar_string, sizeof(pvar_string), ""c_server"%s", pl_name);
				show_dialog(playerid, d_offmembers_pl_menu, DIALOG_STYLE_LIST, pvar_string, ""c_white"اللاعب المعلومات\nDهوmهوs from organization\nPromote/demote اللاعب", "Entekhab", "Bargasht");
			}
			return 1;
		}
		case d_offmembers_pl_menu:
		{
			if(!response)
			{
				DeletePVar(playerid, "ofm_القائمةالعنصر");
				if(!GetPVarInt(playerid, "ofm_النوع"))
				{
					new query_string[128];
					mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الاسم`,`u_الرتبة`,`u_last_التاريخ` FROM `users` WHERE `u_عضو` = '%d' AND `u_متصل` = '0'", getPlayerFactionID(playerid));
					mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs", "i", playerid);
					return 1;
				}
				new query_string[128];
				mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الاسم`,`u_الرتبة`,`u_last_التاريخ` FROM `users` WHERE `u_عضو` = '%d' AND `u_الرتبة` = '%d' AND `u_متصل` = '0'", getPlayerFactionID(playerid), GetPVarInt(playerid, "ofm_النوع"));
				mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs", "i", playerid);
				return 1;
			}
			switch(listitem)
			{
				case 0:
				{
					new pvar_string[18], pl_name[20];
					format(pvar_string, sizeof(pvar_string), "ofm_%d", GetPVarInt(playerid, "ofm_القائمةالعنصر"));
					GetPVarString(playerid, pvar_string, pl_name, 20);
					new query_string[128];
					mysql_format(sql_connection, query_string, sizeof query_string, "اختر `u_الرتبة`,`u_fraction_التاريخ`,`u_last_التاريخ` FROM `users` WHERE `u_الاسم` = '%s' LIMIT 1", pl_name);
					mysql_tquery(sql_connection, query_string, "اتصالرجوع_offعضوs_المعلومات", "i", playerid);
				}
				case 1:
				{
					new pvar_string[28], pl_name[20];
					format(pvar_string, sizeof(pvar_string), "ofm_%d", GetPVarInt(playerid, "ofm_القائمةالعنصر"));
					GetPVarString(playerid, pvar_string, pl_name, 20);
					format(pvar_string, sizeof(pvar_string), ""c_server"%s", pl_name);

					new query_string[128];
					format(query_string, sizeof query_string, "لديك dهوmهوsed "c_server"%s"c_white" from the organization", pl_name);
					SendClientMessage(playerid, col_white, query_string);

					addOffWorkBook(pl_name, PlayerInfo[playerid][name], "غير متصل طرد");

