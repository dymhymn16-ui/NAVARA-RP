		case d_reports:
		{
			if(!response) return true;

			new i = 0;
			for(new count = 0; i < max_report; i++)
				if(report_player[i] != -1)
					if(count++ == listitem) break;

			if(report_slot[i] != -1)
			{
				SendError(playerid, "In Soval/Shekayat ham akلاn darhal pardazesh ast.");
				return pc_cmd_arep(playerid, "");
			}

			new dialog_string[600];
            format(dialog_string, sizeof(dialog_string), "\
            "c_white"Mozoe gozaresh "c_green"%s\n\
            "c_white"Soval/Shekayat az "c_gقديم"%s[%d]\n\n\
            "c_gقديم"%s\n", report_cat_الاسم[i],اللاعبالمعلومات[report_اللاعب[i]][الاسم], report_اللاعب[i], report_text[i]);
            show_dialog(playerid, d_mm_request_2, DIALOG_STYLE_INPUT, !""scm_dialog"Answer Report", dialog_string, !"قبول", !"إلغاءlation");

            report_id[playerid] = i;
            report_slot[i] = playerid;

            SendInfo(report_player[i], "إداري "c_server"%s"c_white" shoroe be residegi soval/shekayat shoma kard", PlayerInfo[playerid][name]);
		}
