				case 2:
				{
					new t_string[82 + MAX_PLAYER_NAME];
					format(t_string, sizeof(t_string), ""c_server"* S.معلومات:"c_grey" %s هوsued you a رخصة النقل المائي.", PlayerInfo[playerid][name]);
					SendClientMessage(targetid, col_gray, t_string);
					PlayerInfo[targetid][boat_lic] = 60;

					AdminMes(""c_server"* A.معلومات:"c_grey" %s هوsued a رخصة النقل المائي to %s.", PlayerInfo[playerid][name], PlayerInfo[targetid][name]);

					update_int_sql(targetid, "u_boat_lic", PlayerInfo[targetid][boat_lic]);
				}
				case 3:
				{
					new t_string[82 + MAX_PLAYER_NAME];
					format(t_string, sizeof(t_string), ""c_server"* S.معلومات:"c_grey" %s granted you a gun رخصة.", PlayerInfo[playerid][name]);
					SendClientMessage(targetid, col_gray, t_string);
					PlayerInfo[targetid][gun_lic] = 1;

					AdminMes(""c_server"* A.معلومات:"c_grey" %s هوsued a سلاح رخصة to %s.", PlayerInfo[playerid][name], PlayerInfo[targetid][name]);

					update_int_sql(targetid, "u_gun_lic", PlayerInfo[targetid][gun_lic]);
				}
			}

			DeletePVar(playerid, "gl_id");
		}
  		case d_gps:
		{
			if(!response) return 1;
			switch(listitem)
			{
				case 0:
				{
					show_dialog(playerid, d_gps_0, DIALOG_STYLE_LIST, !""scm_dialog"Important places", "\
					"c_السيرفر"1 | "c_white"Myria\n\
					"c_السيرفر"2 | "c_white"airport Los-Santos\n\
					"c_السيرفر"3 | "c_white"Railroad station Los-Santos\n\
