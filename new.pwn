stock CanWeCheck(playerid)
{
	if((p_t_info[playerid][p_update] -p_t_info[playerid][last_alt]) > 2000) return 1;
	return 0;
}

stock TeleportVehicleToPos(vehicleid, Float:x, Float:y, Float:z, Float:angle, tv_interior = 0, tv_world = 0, bool:with_players = true)
{
    if(!IsValidVehicle(vehicleid))
        return 0;

    SetVehiclePos(vehicleid, x, y, z);
    SetVehicleZAngle(vehicleid, angle);

    LinkVehicleToInterior(vehicleid, tv_interior);
    SetVehicleVirtualWorld(vehicleid, tv_world);

    if(with_players)
    {
        foreach (new playerid: Player)
        {
            if(!IsPlayerInVehicle(playerid, vehicleid)) continue;

            SetPlayerVirtualWorld(playerid, tv_world);
            SetPlayerInterior(playerid, tv_interior);
        }
    }
    return 1;
}

Float:GetDistance(Float:x1, Float:y1, Float:x2, Float:y2, bool:sqrt = true)
{
    x1 -= x2;
    x1 *= x1;
    y1 -= y2;
    y1 *= y1;
    x1 += y1;
    return sqrt ? floatsqroot(x1) : x1;
}

Float:GetDistanceBetweenPoints(Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2)
{
    return VectorSize(x1-x2, y1-y2, z1-z2);
}

Float:GetDistanceBetweenPlayerAndPos(p1,Float:x2,Float:y2,Float:z2) {
	new Float:x1,Float:y1,Float:z1;
	if(!IsPlayerConnected(p1)) return -1.00;
	GetPlayerPos(p1,x1,y1,z1);
	return floatsqroot(floatpower(floatabs(floatsub(x2,x1)),2)+floatpower(floatabs(floatsub(y2,y1)),2)+floatpower(floatabs(floatsub(z2,z1)),2));
}

