// boss system

stock BossTimerSecond()
{
	new string[128];
    if(BossArea!=-1)
	{
		new Float:BossHP=FCNPC_GetHealth(Boss);
		format(string,sizeof(string),"الصحة: %.2f",BossHP);
		TextDrawSetString(Boss_TD[5],string);
		new Float:result = (276.647216 + (0.00172705568 * BossHP));//(86.352784 / 50000)
		TextDrawTextSize(Boss_TD[3], result, 0.0);
	}
	foreach(new playerid:Player)
	{
		if(Boss!=-1)
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if(BossTarget==playerid&&!IsPlayerInRangeOfPoint(playerid, 70.0, BossCircleAreas[BossSpawnLocation][0], BossCircleAreas[BossSpawnLocation][1], BossCircleAreas[BossSpawnLocation][2]))
			{
				FCNPC_StopAim(Boss);
				BossTarget=-1;
			}
			if(BossArea!=-1)
			{
				if(IsPlayerInDynamicArea(playerid,BossArea))
				{
					TextDrawShowForPlayer(playerid, Boss_TD[3]);
					if(!BossTDShowed[playerid])ShowPlayerBossTD(playerid);
					if(vehicleid!=0)
					{
						new Float:a,Float:x,Float:y;
						GetVehicleZAngle(vehicleid, a);
						x = 0.5 * floatsin(-(a+180), degrees);
						y = 0.5 * floatcos(-(a+180), degrees);
						SetVehicleVelocity(vehicleid, x, y, 0.7);
						SendClientMessage(playerid,0xFF0000FF, "Do ليس أدخل the airport همa with a المركبة.");
					}
					else
					{
						if(!IsBossAsleep)CheckForAim(playerid);
						format(string,sizeof(string),"نقاط:_%i_]_الرتبةing:_%i",floatround(BossScore[playerid]),GetPlayerBossRank(playerid));
						PlayerTextDrawSetString(playerid,Boss_PTD[playerid],string);
					}
				}
				if(IsPlayerInDynamicArea(playerid,BossArea2))
				{
					if(!BossTDShowed[playerid])ShowPlayerBossTD(playerid);
					new Float:x,Float:y,Float:a;
					if(vehicleid!=0)
					{
						GetVehicleZAngle(vehicleid, a);
						x = 0.5 * floatsin(-(a+180), degrees);
						y = 0.5 * floatcos(-(a+180), degrees);
						SetVehicleVelocity(vehicleid, x, y, 0.7);
					}
					else
					{
						GetPlayerFacingAngle(playerid, a);
						x = 0.5 * floatsin(-(a+180), degrees);
						y = 0.5 * floatcos(-(a+180), degrees);
						SetPlayerVelocity(playerid, x, y, 0.7);
					}
				}
			}
		}
	}

	if(!timestamp_second && !timestamp_minute)
	{
		switch(timestamp_hour)
		{
			case 0,12,18,21:
			{
				if(Iter_Count(Player)>=5)
				{
					if(BossArea!=-1)return 1;
					Boss=FCNPC_Create("BOSS");
					Angel=FCNPC_Create("Angel85");
					if(Boss==INVALID_PLAYER_ID||Angel==INVALID_PLAYER_ID)
					{
						if(FCNPC_IsValid(Boss))FCNPC_Destroy(Boss);
						if(FCNPC_IsValid(Angel))FCNPC_Destroy(Angel);
						Boss=-1;
						Angel=-1;
						return print("خطأ: السيرفر couldn't إنشاء the NPCs for boss.");
					}
					BossSpawnLocation=random(2);
					FCNPC_Spawn(Angel,216,AngelSpawns[BossSpawnLocation][0],AngelSpawns[BossSpawnLocation][1],AngelSpawns[BossSpawnLocation][2]);
					FCNPC_SetAngle(Angel,AngelSpawns[BossSpawnLocation][3]);
					FCNPC_SetInvulnerable(Angel);
					FCNPC_Spawn(Boss,217,BossCircleAreas[BossSpawnLocation][0],BossCircleAreas[BossSpawnLocation][1],BossCircleAreas[BossSpawnLocation][2]);
					FCNPC_SetWeapon(Boss, 31);
					FCNPC_SetAmmo(Boss, 7070);
					FCNPC_SetWeaponAccuracy(Boss, 31, 1.0);
					FCNPC_SetWeaponReloadTime(Boss, 31, 0);
					FCNPC_SetWeaponSkillLevel(Boss, WEAPONSKILL_M4, 999);
					FCNPC_SetHealth(Boss, 50000.0);
					SetPlayerColor(Boss, 0xFF0000FF);
					FCNPC_SetAnimation(Boss,390,4.0,0,0,0,1,0);
					CreateBossTD();
					SetupBossTD();
					BossArea=CreateDynamicRectangle(BossRectangleAreas[BossSpawnLocation][0],BossRectangleAreas[BossSpawnLocation][1],BossRectangleAreas[BossSpawnLocation][2],BossRectangleAreas[BossSpawnLocation][3]);
					BossArea2=CreateDynamicCircle(BossCircleAreas[BossSpawnLocation][0],BossCircleAreas[BossSpawnLocation][1],25.0,0,0);
					AttachDynamicAreaToPlayer(BossArea2,Boss);
					BossLabel = CreateDynamic3DTextLabel("Zzz...\nzZz...", 0xFF0000FF,BossCircleAreas[BossSpawnLocation][0],BossCircleAreas[BossSpawnLocation][1],BossCircleAreas[BossSpawnLocation][2],100.0,.attachedplayer=Boss);
					AngelLabel = CreateDynamic3DTextLabel("The Angel\nالنوع /angel", 0x00FF00FF,AngelSpawns[BossSpawnLocation][0],AngelSpawns[BossSpawnLocation][1],AngelSpawns[BossSpawnLocation][2],30.0,.attachedplayer=Angel);
					BossTimer = SetTimer("BossDestroyer", 1800000, false);
					//SetPlayerAttachedObject(Boss, 0, 2908, 2, 0.0668, 0.0458, 0.0000, 180.0000, 0.0000, 90.0000, 1.1840, 1.4400, 1.3748, 0xFFFFFFFF, 0xFFFFFFFF);
					SetPlayerAttachedObject(Boss, 0, 2908, 2, 0.070000, 0.044000, 0.010000, -180.000000, 3.899996, 90.000000, 1.505000, 1.707000, 1.865000, 0, 0);
					SetPlayerAttachedObject(Boss, 1, 2907, 1, -0.018000, 0.045000, 0.015000, 90.000000, 180.000000, -90.000000, 1.259000, 1.031999, 1.310999, 0, 0);
					SetPlayerAttachedObject(Boss, 2, 2906, 5, -0.169999, 0.032000, -0.032999, 0.000000, -5.799998, -90.000000, 2.262999, 1.187999, 1.770001, 0, 0);
					SetPlayerAttachedObject(Boss, 3, 2906, 6, -0.159000, 0.034000, -0.058000, 8.399998, -8.800000, -90.000000, 2.263000, 1.000000, 1.835000, 0, 0);
					IsBossAsleep=true;
					SetPlayerColor(Angel, 0x00FF00FF);
					
					foreach(new i:Player)
					{
						BossScore[i]=0;
					}

					SendClientMessageToAll(0xFF0000FF, "{ff0000}[BOSS-EVENT]: "c_white"The mad bloodlust boss هو appread at the world, Use /wita to find him.");
				}
			}
		}
	}
	return 1;
}

stock GivePlayerBossPrize(playerid, boss_rank)
{
	switch(boss_rank)
	{
		case 1:give_money(playerid,	200000),PlayerInfo[playerid][exp]+=5,PlayerLevelUpdateCheck(playerid),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 1 And You Got $200,000 And 5 Respect Points And 7 Gقديمs As Prize.");
		case 2:give_money(playerid,	100000),PlayerInfo[playerid][exp]+=4,PlayerLevelUpdateCheck(playerid),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 2 And You Got $100,000 And 4 Respect Points And 5 Gقديمs As Prize.");
		case 3:give_money(playerid,	50000),PlayerInfo[playerid][exp]+=3,PlayerLevelUpdateCheck(playerid),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 3 And You Got $50,000 And 3 Respect Points And 3 Gقديمs As Prize.");
		case 4:give_money(playerid,	40000),PlayerInfo[playerid][exp]+=2,PlayerLevelUpdateCheck(playerid),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 4 And You Got $40,000 And 2 Respect Points As Prize.");
		case 5:give_money(playerid,	30000),PlayerInfo[playerid][exp]+=1,PlayerLevelUpdateCheck(playerid),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 5 And You Got $30,000 And 1 Respect Points As Prize.");
		case 6:give_money(playerid,	20000),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 6 And You Got $20,000 As Prize.");
		case 7:give_money(playerid,	15000),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 7 And You Got $15,000 As Prize.");
		case 8:give_money(playerid,	8000),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 8 And You Got $8,000 As Prize.");
		case 9:give_money(playerid,	4000),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 9 And You Got $4,000 As Prize.");
		case 10:give_money(playerid, 1000),SendClientMessage(playerid, col_gray, c_server"[السيرفر]: "c_white"Your الرتبة كان 10 And You Got $1,000 As Prize.");
		default:return 1;
	}
	return 1;
}

stock SpawnBossOnServer(playerid, params[])
{
	if(BossArea!=-1)return SendClientMessage(playerid,-1, ""scm_error"Boss هو Already In The World.");
	Boss=FCNPC_Create("BOSS");
	Angel=FCNPC_Create("Angel85");
	if(Boss==INVALID_PLAYER_ID||Angel==INVALID_PLAYER_ID)
	{
		if(FCNPC_IsValid(Boss))FCNPC_Destroy(Boss);
		if(FCNPC_IsValid(Angel))FCNPC_Destroy(Angel);
		Boss=-1;
		Angel=-1;
		return SendError(playerid, "السيرفر couldn't إنشاء the NPCs.");
	}
	if(isnull(params))BossSpawnLocation=random(2);
	else BossSpawnLocation=strval(params[0]);
	FCNPC_Spawn(Angel,216,AngelSpawns[BossSpawnLocation][0],AngelSpawns[BossSpawnLocation][1],AngelSpawns[BossSpawnLocation][2]);
	FCNPC_SetAngle(Angel,AngelSpawns[BossSpawnLocation][3]);
	FCNPC_SetInvulnerable(Angel);
	FCNPC_Spawn(Boss,217,BossCircleAreas[BossSpawnLocation][0],BossCircleAreas[BossSpawnLocation][1],BossCircleAreas[BossSpawnLocation][2]);
	FCNPC_SetWeapon(Boss, 31);
	FCNPC_SetAmmo(Boss, 35000);
	FCNPC_SetWeaponReloadTime(Boss, 31, 0);
	FCNPC_SetWeaponSkillLevel(Boss, WEAPONSKILL_M4, 1000);
	FCNPC_SetWeaponState(Boss, 2);
	set_health(Boss, 50000.0);
	FCNPC_SetHealth(Boss, 50000.0);
	SetPlayerColor(Boss, 0xFF0000FF);
	FCNPC_SetAnimation(Boss,390,4.0,0,0,0,1,0);
	CreateBossTD();
	SetupBossTD();
	BossArea=CreateDynamicRectangle(BossRectangleAreas[BossSpawnLocation][0],BossRectangleAreas[BossSpawnLocation][1],BossRectangleAreas[BossSpawnLocation][2],BossRectangleAreas[BossSpawnLocation][3]);
	BossArea2=CreateDynamicCircle(BossCircleAreas[BossSpawnLocation][0],BossCircleAreas[BossSpawnLocation][1],25.0,0,0);
	AttachDynamicAreaToPlayer(BossArea2,Boss);
	BossLabel=CreateDynamic3DTextLabel("Zzz...\nzZz...", 0xFF0000FF,BossCircleAreas[BossSpawnLocation][0],BossCircleAreas[BossSpawnLocation][1],BossCircleAreas[BossSpawnLocation][2],100.0,.attachedplayer=Boss);
	AngelLabel=CreateDynamic3DTextLabel("The Angel\nالنوع /angel", 0x00FF00FF,AngelSpawns[BossSpawnLocation][0],AngelSpawns[BossSpawnLocation][1],AngelSpawns[BossSpawnLocation][2],30.0,.attachedplayer=Angel);
	BossTimer=SetTimer("BossDestroyer", 1800000, false);
	//SetPlayerAttachedObject(Boss, 0, 2908, 2, 0.0668, 0.0458, 0.0000, 180.0000, 0.0000, 90.0000, 1.1840, 1.4400, 1.3748, 0xFFFFFFFF, 0xFFFFFFFF);
	SetPlayerAttachedObject(Boss, 0, 2908, 2, 0.070000, 0.044000, 0.010000, -180.000000, 3.899996, 90.000000, 1.505000, 1.707000, 1.865000, 0, 0);
	SetPlayerAttachedObject(Boss, 1, 2907, 1, -0.018000, 0.045000, 0.015000, 90.000000, 180.000000, -90.000000, 1.259000, 1.031999, 1.310999, 0, 0);
	SetPlayerAttachedObject(Boss, 2, 2906, 5, -0.169999, 0.032000, -0.032999, 0.000000, -5.799998, -90.000000, 2.262999, 1.187999, 1.770001, 0, 0);
	SetPlayerAttachedObject(Boss, 3, 2906, 6, -0.159000, 0.034000, -0.058000, 8.399998, -8.800000, -90.000000, 2.263000, 1.000000, 1.835000, 0, 0);
	IsBossAsleep=true;
	SetPlayerColor(Angel, 0x00FF00FF);
	foreach(new i:Player)
	{
		BossScore[i]=0;
	}
	SendClientMessageToAll(0xFF0000FF, "{ff0000}[BOSS-EVENT]: "c_white"The mad bloodlust boss هو appread at the world, Use /wita to find him.");
	return 1;
}
//==============================================================================
stock GetPlayerBossRank(playerid)
{
	new boss_rank=1;
	foreach(new i:Player)
	{
		if(BossScore[i]>BossScore[playerid]) boss_rank+=1;
	}
	return boss_rank;
}
//==============================================================================
stock GetTopBossKillers(&first,&second,&third)
{
	new boss_tmp;
	foreach(new i:Player)
	{
		if(BossScore[i]==0)continue;
		if((boss_tmp=GetPlayerBossRank(i))==1)first=i;
		else if(boss_tmp==2)second=i;
		else if(boss_tmp==3)third=i;
	}
	return 1;
}
//==============================================================================
stock ReturnBossKillerScore(playerid)
{
	new str[32];
	format(str, sizeof(str), "%s (%i نقاط)",PName[playerid],floatround(BossScore[playerid]));
	return str;
}
