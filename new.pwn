				InterpolateCameraPos(playerid, 2814.8062, -2420.0977, 24.6413, 2677.9243, -2484.2791, 19.1436, 10000, CAMERA_MOVE);
				InterpolateCameraLookAt(playerid, 2814.0027, -2420.6921, 24.2813, 2678.4658, -2483.4387, 19.0086, 10000, CAMERA_MOVE);

				show_dialog(playerid, d_port_help_2, DIALOG_STYLE_MSGBOX, ""c_server"المساعدة with work", "\
				"c_grey"Working on a forklift:\n\
				"c_white"Containers must be taken to free spaces in the central area of ​​the port,\n\
				for subsequent unloading of containers by loaders.\n\
