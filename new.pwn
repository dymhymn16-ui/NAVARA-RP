cmd:ram(playerid)
{
	if(!cop_player(playerid) && !fbi_player(playerid)) return 1;
	new is_near_house = -1;
	for(new h = 0; h < house_count; h++)
	{
		if(!IsPlayerInRangeOfPoint(playerid, 4.0, h_info[h][h_pos][0], h_info[h][h_pos][1], h_info[h][h_pos][2])) continue;
		is_near_house = h;
		p_t_info[playerid][house] = h;
		new hint = h_info[h][h_int] -1;
		set_pos(playerid, house_int[hint][hint_position][0], house_int[hint][hint_position][1], house_int[hint][hint_position][2], house_int[hint][hint_position][3], house_int[hint][hint_int], h_info[h][h_id]);
		SetPVarInt(playerid, "tp_همa_used", 1);
		break;
	}
	if(is_near_house == -1) return SendError(playerid, "يجب عليك be near the المنزل.");

	new string[87];
	format(string, sizeof(string), ""scm_sucess"You طردed the door of the hoاستخدام. Hoاستخدام المالك: {FFE100}%s", h_info[is_near_house][h_owner_name]);
	SendClientMessage(playerid, col_white, string);

	if(PlayerInfo[playerid][gender] != 0) {me_action(playerid, "طردed in the door of the hoاستخدام.");} else {me_action(playerid, "kلاcked in the door of the hoاستخدام.");}
	return 1;
}


cmd:fill(playerid)
{
	if(filling_count {playerid} != 0) return SendError(playerid, "أنت already reالوقودing the المركبة.");

	for(new t = 0; t < b_count; t ++)
	{
	    if(b_info[t][b_type] != bizz_type_gas) continue;
   	    if(!IsPlayerInRangeOfPoint(playerid, 10.0, b_info[t][b_position][0], b_info[t][b_position][1], b_info[t][b_position][2])) continue;
        if(b_info[t][b_price] == 0) return SendError(playerid, "The السعر for 1 liter هو ليس assigned by the المالك of the الوقود.");
        if(b_info[t][b_owner_inc] == -1) return SendError(playerid, "Thهو refill has لا المالك, it هو ليس working.");
        if(b_info[t][b_close] == 1) return SendError(playerid, "Thهو المشروع هو إغلاقd.");

		SetPVarInt(playerid,"f_biz",t);
		show_dialog(playerid, d_filling, DIALOG_STYLE_LIST, !""scm_dialog"Filling station", !"Reالوقود المركبة\nCanهوter", !"Entekhab", !"Bastan");
	    return 1;
	}
	SendError(playerid, "يجب عليك be near the محطة الوقود.");
	return 1;
}

cmd:gopolice(playerid, params[])
{
    if(!cop_player(playerid)) return 1;
	if(sscanf(params, "d", params[0])) return SendInfo(playerid, "أدخل: /goالشرطة [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't apply thهو to yourself.");

	if(!call_police {params[0]}) return SendError(playerid, "Thهو اللاعب has ليس اتصالed the الشرطة or has already received a اتصال.");

	foreach(new i : logged_players)
	{
		if(cop_player(i))
		{
			new scm_string[128];
			format(scm_string, 128, "%s %s (%s) موافقed اتصالs %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], f_info[PlayerInfo[playerid][member]][f_name]);
			SendClientMessage(i, col_yellow, scm_string);
		}
	}
	new scm_string[108];
	format(scm_string, 108, ""c_green"%s %s"c_white" received your اتصال, يرجى الانتظار.", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name]);
	SendClientMessage(params[0], col_white, scm_string);
	format(scm_string, 72, ""c_green"%s"c_white" Marked on سيارتكd.", PlayerInfo[params[0]][name]);
	SendClientMessage(playerid, col_white, scm_string);

	SetPlayerRaceCheckpoint(playerid, 1, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2], 0.0, 0.0, 0.0, 2.0);
	SendInfo(playerid, "[نظام الملاحة] - The mark هو set.");
	is_gps_used {playerid} = 1;

	call_police {params[0]} = 0;
	return 1;
}


cmd:gomedhelp(playerid, params[])
{
    if(!medic_player(playerid)) return 1;
	if(sscanf(params, "d", params[0])) return SendInfo(playerid, "أدخل: /gomedالمساعدة [id/الاسم]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(params[0] == playerid) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can't apply thهو to yourself.");

	if(!call_medic {params[0]}) return SendError(playerid, "Thهو اللاعب did ليس اتصال for المساعدة soon, any اتصالs have already been received.");

	foreach(new i : logged_players)
	{
		if(medic_player(i))
		{
			new scm_string[128];
			format(scm_string, 128, "%s %s (%s) موافقed اتصالs %s", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name], f_info[PlayerInfo[playerid][member]][f_name]);
			SendClientMessage(i, col_yellow, scm_string);
		}
	}
	new scm_string[108];
	format(scm_string, 108, ""c_green"%s %s"c_white" received your اتصال, يرجى الانتظار.", f_rank[PlayerInfo[playerid][member]][PlayerInfo[playerid][rank] -1], PlayerInfo[playerid][name]);
	SendClientMessage(params[0], col_white, scm_string);
	format(scm_string, 72, ""c_green"%s"c_white" Marked on سيارتكd.", PlayerInfo[params[0]][name]);
	SendClientMessage(playerid, col_white, scm_string);

	SetPlayerRaceCheckpoint(playerid, 1, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2], 0.0, 0.0, 0.0, 2.0);
	SendInfo(playerid, "[نظام الملاحة] - The mark هو set.");
	is_gps_used {playerid} = 1;

	call_medic {params[0]} = 0;
	return 1;
}


cmd:gotaxi(playerid, params[])
{
    if(getJobFactionID(playerid) != job_taxi) return 1;
