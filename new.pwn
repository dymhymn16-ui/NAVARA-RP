		{
			format(label_string, sizeof(label_string), ""c_yellow"%s (#%d)\n"c_green_shop"%s\n"c_white"المالك: "c_server"%s\n"c_white"Extended اليومs: "c_green_shop"%d\n"c_white"Dar Control: "c_server"%s\n"c_white"Vaziyat: "c_server"%s",
			b_types[b_info[biz_id][b_type]], b_info[biz_id][b_id], b_info[biz_id][b_name_edit], b_info[biz_id][b_owner_name], b_info[biz_id][b_days], mafia_owner_name[b_info[biz_id][b_mafia]], (! b_info[biz_id][b_close]) ? ("{1a9616}فتح") : ("{e11010}إغلاقd"));
		}
	}


	UpdateDynamic3DTextLabelText(b_info[biz_id][b_label], COLOR_WHITE, label_string);
	return 1;
}

// Billboard System

stock UpdateBuildText(b_idx)
{
	new font_face[12];
	switch(BildInfo[b_idx][bFontFace])
	{
	    case 0: font_face = "Arial";
	    case 1: font_face = "Calibri";
	    case 2: font_face = "Tahoma";
	    case 3: font_face = "Verdana";
	}
 	new text[144+16];
	if(strlen(BildInfo[b_idx][bOwner]) < 4)
	{
		text = "{000000}Makan tabligh أنت\nContact\nmedia الإعلانات agency";
		BildInfo[b_idx][bAligment] = 1, BildInfo[b_idx][bFontSize]=25, BildInfo[b_idx][bBackColor] = 1;
	}
	else format(text,144+16,"{000000}%s",BildInfo[b_idx][bText]);
	return SetObjectMaterialText(BildInfo[b_idx][bObjectID], text, 0, 130, font_face, BildInfo[b_idx][bFontSize], 0, -1, Colors_BIG[BildInfo[b_idx][bBackColor]], BildInfo[b_idx][bAligment]);
}

stock ShowPlayerEditMenu(playerid)
{
	new string[256] = "{33AA33}Parameter\t{33AA33}Value\n", str[64], p_var = GetPVarInt(playerid,"اخترBildID"), font_face[12], aligment_name[18];

	BildIntro(playerid, p_var, -13);

	switch(BildInfo[p_var][bFontFace])
	{
	    case 0: font_face = "Arial";
	    case 1: font_face = "Calibri";
	    case 2: font_face = "Tahoma";
	    case 3: font_face = "Verdana";
	}

	switch(BildInfo[p_var][bAligment])
	{
	    case 0: aligment_name = "Left";
	    case 1: aligment_name = "Cأدخلed";
	    case 2: aligment_name = "Right";
	}

	strcat(string,"\nText\t{BDB76B}Change...");
	format(str,64,"\nلون الخلفية\t{%s}رجوعground",Colors_LOW[BildInfo[p_var][bBackColor]]), strcat(string,str);
	format(str,64,"\nText font\t%s",font_face), strcat(string,str);
	format(str,32,"\nحجم النص\t%i",BildInfo[p_var][bFontSize]), strcat(string,str);
	format(str,64,"\nمحاذاة النص\t%s",aligment_name), strcat(string,str);
//	format(str,32,"\n[!] Banner المعلومات");
	strcat(string,"\nLease {1A8FA9}نشط\t{EE4000}Turn contract...");

	return show_dialog(playerid,d_rent_billd_setting,DIALOG_STYLE_TABLIST_HEADERS,"{E5D81E}Configuring advertهوing parameters.",string,"Entekhab","Bastan");
}

stock BildIntro(playerid, b_idx, c_dist)
{
	new Float: x = BildInfo[b_idx][bPos][0], Float: y = BildInfo[b_idx][bPos][1];
    GetXYInFront(x, y, BildInfo[b_idx][bPos][3], c_dist);
    //
    SetPlayerCameraPos(playerid, x, y, BildInfo[b_idx][bPos][2]);
    SetPlayerCameraLookAt(playerid, BildInfo[b_idx][bPos][0], BildInfo[b_idx][bPos][1], BildInfo[b_idx][bPos][2]);
    return TogglePlayerControllable(playerid, 0), SetPlayerInterior(playerid, 0), true;
}

stock GetXYInFront(&Float:x, &Float:y, Float:angle, Float:distance)
{
    x += (distance * floatsin(-angle, degrees));
    y += (distance * floatcos(-angle, degrees));
}

stock GetTickDiff(newtick, oldtick)
{
    return newtick - oldtick;
}

// reedit tune system

stock tunes_check(playerid)
{
	if(!IsPlayerInAnyVehicle(playerid)) return 1;

	new bid_ = -1;
	new btype_;

	if(IsPlayerInRangeOfPoint(playerid, 5, 844.8434,-602.2949,18.4219))
	{
		bid_ = 0;
		btype_ = 1;
	}
	else if(IsPlayerInRangeOfPoint(playerid, 5, 1649.2150,2199.1189,10.8203))
	{
		bid_ = 1;
		btype_ = 1;
	}
	else if(IsPlayerInRangeOfPoint(playerid, 5, -1786.7087,1208.8735,25.1250))
	{
		bid_ = 2;
		btype_ = 1;
	}
	else if(IsPlayerInRangeOfPoint(playerid, 5, 1614.0004,-1897.5763,13.5487))
	{
		bid_ = 3;
		btype_ = 2;
	}
	else if(IsPlayerInRangeOfPoint(playerid, 5, 2393.8142,1482.8412,10.8203))
	{
		bid_ = 4;
		btype_ = 2;
	}

	if(bid_ == -1) return 1;

	new veh_id = GetPlayerVehicleID(playerid);
	if(veh_info[veh_id -1][v_type] != vehicle_type_player && veh_info[veh_id -1][v_type] != vehicle_type_family) return SendError(playerid, "Studio tuning faghat baraye vasile naghlie shakhsi ya العائلة dar dastres ast.");
	if(get_passenger_count(playerid)> 0) return SendError(playerid, "Bayad Sar Neshinan Piade Shavand.");
	if(v_velo(veh_id)|| v_plane(veh_id)|| v_boat(veh_id)) return SendError(playerid, "Studio tuning be in model vasile naghlie service nmidahad.");
	if(b_info[bid_][b_close]) return SendError(playerid, "In Studio Tuning Baste Ast.");

	if(btype_ == 1)
	{
		SetPVarInt (playerid, "tuning_فتحed", bid_+1);
	}

	if(btype_ == 2)
	{
		SetPVarInt (playerid, "ptuning_فتحed", bid_+1);
	}

	return tunes_load(playerid, btype_, veh_id);
}

stock tunes_load(playerid, btype, veh_id)
{
	switch(btype)
	{
		case 1:
		{
			SetVehiclePos(veh_id, 947.4241,-1748.4412,1013.3640);
			new freeze_time;
			switch(GetPlayerPing(playerid))
			{
				case 5..100: freeze_time = 2500;
				case 101..200: freeze_time = 3000;
				case 201..300: freeze_time = 3000;
				default: freeze_time = 4000;
			}
			SetTimerEx("toggle_controlable", freeze_time, 0, "ii", playerid, true);
			SetVehicleZAngle(veh_id, 179);
			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, playerid);
			LinkVehicleToInterior(veh_id, 0);
			SetVehicleVirtualWorld(veh_id, playerid);
			SetPlayerArmedWeapon(playerid, 0);
			SetPlayerCameraPos(playerid, tuning_camera_positions[0][0], tuning_camera_positions[0][1], tuning_camera_positions[0][2]);
			SetPlayerCameraLookAt(playerid, tuning_camera_positions[0][3], tuning_camera_positions[0][4], tuning_camera_positions[0][5]);


			speedometr_status(playerid, false);
			KillTimer(speed_timer[playerid]);
			speed_timer[playerid] = -1;
			for(new i = 0; i <= 45; i ++)
			{
				TextDrawShowForPlayer(playerid, td_tuning[i]);
			}
			SelectTextDraw(playerid, 0xB0C4DEFF);

			TogglePlayerControllable(playerid, false);
		}
		case 2:
		{
			SetVehiclePos(veh_id, 947.4241,-1748.4412,1013.3640);
			new freeze_time;
			switch(GetPlayerPing(playerid))
			{
				case 5..100: freeze_time = 2500;
				case 101..200: freeze_time = 3000;
				case 201..300: freeze_time = 3000;
				default: freeze_time = 4000;
			}
			SetTimerEx("toggle_controlable", freeze_time, 0, "ii", playerid, true);
			SetVehicleZAngle(veh_id, 179);
			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, playerid);
			LinkVehicleToInterior(veh_id, 0);
			SetVehicleVirtualWorld(veh_id, playerid);
			SetPlayerArmedWeapon(playerid, 0);
			SetPlayerCameraPos(playerid, tuning_camera_positions[0][0], tuning_camera_positions[0][1], tuning_camera_positions[0][2]);
			SetPlayerCameraLookAt(playerid, tuning_camera_positions[0][3], tuning_camera_positions[0][4], tuning_camera_positions[0][5]);


			speedometr_status(playerid, false);
			KillTimer(speed_timer[playerid]);
			speed_timer[playerid] = -1;
			for(new i = 0; i < 27; i ++)
			{
				TextDrawShowForPlayer(playerid, td_performance[i]);
			}
			SelectTextDraw(playerid, 0xB0C4DEFF);

			TogglePlayerControllable(playerid, false);

			ptd_performance[playerid][0] = CreatePlayerTextDraw(playerid, 44.000000, 277.000000, "LD_SPAC:white");
			PlayerTextDrawBackgroundColor(playerid, ptd_performance[playerid][0], 0);
			PlayerTextDrawFont(playerid, ptd_performance[playerid][0], 4);
			PlayerTextDrawLetterSize(playerid, ptd_performance[playerid][0], 0.500000, 1.000000);
			PlayerTextDrawColor(playerid, ptd_performance[playerid][0], 10486015);
			PlayerTextDrawSetOutline(playerid, ptd_performance[playerid][0], 0);
			PlayerTextDrawSetProportional(playerid, ptd_performance[playerid][0], 1);
			PlayerTextDrawSetShadow(playerid, ptd_performance[playerid][0], 1);
			PlayerTextDrawUseBox(playerid, ptd_performance[playerid][0], 1);
			PlayerTextDrawBoxColor(playerid, ptd_performance[playerid][0], 255);
			PlayerTextDrawTextSize(playerid, ptd_performance[playerid][0], 11.000000, 0.000000);
			PlayerTextDrawSetSelectable(playerid, ptd_performance[playerid][0], 0);

			new Float:td_y = -veh_info[veh_id -1][v_engine_boost]* 328.57;

			ptd_performance[playerid][1] = CreatePlayerTextDraw(playerid, 44.000000, 277.000000, "LD_SPAC:white");
			PlayerTextDrawBackgroundColor(playerid, ptd_performance[playerid][1], 0);
