			{
				DeletePVar(opponent_id, "duel_inv");
				DeletePVar(playerid, "duel_السعر");
				DeletePVar(opponent_id, "duel_id");
				return DeletePVar(playerid, "duel_id");
			}
			if(PlayerInfo[playerid][money] < GetPVarInt(playerid, "duel_السعر"))
			{
				DeletePVar(opponent_id, "duel_inv");
				SendClientMessage(playerid, col_gray, "* shoma pol kafi nadarid to قبول the اتصال.");
				DeletePVar(playerid, "duel_السعر");
				DeletePVar(opponent_id, "duel_id");
				return DeletePVar(playerid, "duel_id");
			}
			if(PlayerInfo[opponent_id][money] < GetPVarInt(playerid, "duel_السعر"))
			{
				DeletePVar(opponent_id, "duel_inv");
				SendClientMessage(opponent_id, col_gray, "* shoma pol kafi nadarid для дуэли.");
				SendClientMessage(playerid, col_gray, "* The اللاعب does ليس have eلاugh funds for the duel.");

				DeletePVar(playerid, "duel_السعر");
				DeletePVar(opponent_id, "duel_id");
				return DeletePVar(playerid, "duel_id");
			}
			if(GetPVarInt(opponent_id, "duel_inv") ==  0)
			{
				DeletePVar(opponent_id, "duel_inv");
				SendClientMessage(playerid, col_gray, "* The اللاعب has already left the game.");
				DeletePVar(playerid, "duel_السعر");
				DeletePVar(opponent_id, "duel_id");
				return DeletePVar(playerid, "duel_id");
			}

			DeletePVar(opponent_id, "duel_inv");

			DeletePVar(playerid, "duel_id");
			DeletePVar(opponent_id, "duel_id");



			duel_opponent[playerid] = opponent_id;
			duel_opponent[opponent_id] = playerid;
			duel_price[playerid] = GetPVarInt(playerid, "duel_السعر");
			duel_price[opponent_id] = GetPVarInt(playerid, "duel_السعر");

			give_money(playerid, -duel_price[playerid]);
			give_money(duel_opponent[playerid], -duel_price[playerid]);
			insert_money_log(playerid, INVALID_PLAYER_ID, duel_price[playerid], "مبارزة bet");
			insert_money_log(duel_opponent[playerid], INVALID_PLAYER_ID, duel_price[playerid], "مبارزة bet");

			for(new i = 0; i < 12; i ++)
			{
				duel_guns[playerid][i][0] = PlayerInfo[playerid][Weapon][i];
				duel_guns[playerid][i][1] = PlayerInfo[playerid][Ammo][i];

			}
			ResetPlayerWeapons(playerid);

