	show_dialog(playerid,d_start_mech,DIALOG_STYLE_INPUT, !""scm_dialog"السيارة الميكانيكي",!""c_white"أدخل الاسم of your technical service \لاr مغادرة the field blank", "Finهوh", !"إلغاء");

