		cache_get_field_content(0, "t_التاريخ", ticket_date, sql_connection, 16);
		cache_get_field_content(0, "t_cop_الاسم", cop_name, sql_connection, 32);

		new dialog_string[186];
		if(GetString(cop_name, "لاne"))
		{
			format(dialog_string, sizeof(dialog_string), ""c_white"Sum: "c_server"%d"c_white"\nالسبب: "c_server"%s"c_white"\nالتاريخ of fine: "c_server"%s\n\n{AFAFAF}Штраф выписан for нарушение скоростного режима",
	 		ticket_count, ticket_reason, ticket_date);
		}
		else
		{
			format(dialog_string, sizeof(dialog_string), ""c_white"Sum: "c_server"%d"c_white"\nالسبب: "c_server"%s"c_white"\nالتاريخ of fine: "c_server"%s\n\n{AFAFAF}The protocol كان written by an employee %s ",
			ticket_count, ticket_reason, ticket_date, cop_name);
		}
		show_dialog(playerid, d_ticket_stats, DIALOG_STYLE_MSGBOX, ""c_server"Fine المعلومات", dialog_string, "Bargasht", "");
	}
	if(!rows)
	{
