					format(tquery_string, sizeof(tquery_string), "اختر * FROM `logs_العائلة` WHERE `الاسم`='%s' ORDER BY `logs_العائلة`.`id` DESC", pl_name);
					mysql_tquery(sql_connection, tquery_string, "logs_اللاعب_العائلة", "i", playerid);
				}
			}
		}
		case d_offamily_pl_rank:
		{
			new pvar_string[28], pl_name[MAX_PLAYER_NAME -4];
			format(pvar_string, sizeof(pvar_string), "ofm_%d", GetPVarInt(playerid, !"ofm_القائمةالعنصر"));
			GetPVarString(playerid, pvar_string, pl_name, MAX_PLAYER_NAME -4);

