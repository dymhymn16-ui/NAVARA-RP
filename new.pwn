			new gangpay_sum = GetPVarInt(playerid, "العصابةدفع_sum");
			DeletePVar(playerid, "العصابةدفع_sum");

			new m_count = 0;

			foreach(new i: logged_players)
			{
				if(PlayerInfo[i][member] != PlayerInfo[playerid][member] || playerid == i) continue;
				m_count ++;
			}

			if(PlayerInfo[playerid][money] < m_count * gangpay_sum) return DeletePVar(playerid, "العصابةدفع_sum"), SendError(playerid, "Shoma pool kafi nadarid.");
			
			give_money(playerid, -m_count * gangpay_sum);
			insert_money_log(playerid, INVALID_PLAYER_ID, -m_count * gangpay_sum, "الجائزةed the prize");
			
			foreach(new i: logged_players)
			{
				if(PlayerInfo[i][member] != PlayerInfo[playerid][member] || playerid == i) continue;
