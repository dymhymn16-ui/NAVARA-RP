				SendClientMessage(playerid, col_white,c_server"* "c_white"Baraye Baz Kardan الراديو "c_server"[/play]"c_white".");
				SendClientMessage(playerid, col_white,c_server"* "c_white"Turn headlight on/off "c_server"[/light]"c_white"."c_white" On/Off cruهوe control "c_server"[/slimit]"c_white".");
				SendClientMessage(playerid, col_white,c_server"* "c_white"Baraye Baz Ya Baste Kardan Kamarband "c_server"[/kamarband]"c_white" Ya Dokme "c_server"[2]"c_white".");
				

				if(IsValidDynamic3DTextLabel(veh_info[veh_id -1][v_sell_text]))
				{
					DestroyDynamic3DTextLabel(veh_info[veh_id -1][v_sell_text]);
					veh_info[veh_id -1][v_sell_text] = Text3D:INVALID_3DTEXT_ID;
				}
				return 1;

			}
			if(veh_info[veh_id -1][v_sell_price] < 1)
			{
				SendError(playerid, "In Vasile naghlie dige baraye forosh nهوt");

				RemovePlayerFromVehicle(playerid);
				new engine, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
				if(engine==1) SetVehicleParamsEx(veh_id,VEHICLE_PARAMS_OFF,false,false,false,false,false,objective);
				return 1;
			}
			if(PlayerInfo[playerid][money] < veh_info[veh_id -1][v_sell_price])
			{
				SendError(playerid, "shoma pol kafi nadarid baraye kharid in vasile.");

				RemovePlayerFromVehicle(playerid);
				new engine, lights, alarm, doors, bonnet, boot, objective;
				GetVehicleParamsEx(veh_id, engine, lights, alarm, doors, bonnet, boot, objective);
				if(engine==1) SetVehicleParamsEx(veh_id,VEHICLE_PARAMS_OFF,false,false,false,false,false,objective);
				return 1;
			}
			if(get_player_veh_count(playerid)>= PlayerInfo[playerid][max_veh]) return SendError(playerid, "ebteda bayad yeki az vasile haye naghlie mojod ro beforosid.");


			format(_text_string, sizeof(_text_string), "UPالتاريخ `users_المركبات` SET `v_المالك`='%d',`v_بيع_السعر` = '0' WHERE `v_id` = '%d'", PlayerInfo[playerid][id], veh_info[veh_id -1][v_id]);
			mysql_tquery(sql_connection, _text_string);


			format(_text_string, sizeof(_text_string), ""c_green"* "c_white"لقد نجحت في acquired "c_green"%s "c_white"for "c_green"$%d", vehicle_name[GetVehicleModel(veh_id)-400], veh_info[veh_id -1][v_sell_price]);
			SendClientMessage(playerid, col_white, _text_string);

			new targetid = INVALID_PLAYER_ID;
