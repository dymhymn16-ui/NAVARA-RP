		SendClientMessage(playerid, col_white, ""c_green"* "c_white"انتهى دوامك، تحتاج إلى الراحة.");
		PlayerInfo[playerid][timejob] = job_none;


		new __t_string[72];
		format(__t_string, sizeof(__t_string), ""c_green"* "c_white"المكتسب: "c_green"$%d", PlayerInfo[playerid][salary]);
		SendClientMessage(playerid, col_white, __t_string);
