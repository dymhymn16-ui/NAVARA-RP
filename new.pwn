					"c_white"Shahr/Ostand:\t\t"c_السيرفر"%s\n\
					"c_white"Mantaghe:\t\t"c_السيرفر"%s\n\
					"c_white"Gheymat:\t\t"c_السيرفر"%s\n\
					"c_white"Ejareh:\t\t"c_السيرفر"%s\n\n\
