public OnGameModeExit()
{
    if(timers_unix != -1)
    {
        KillTimer(timers_unix);
        timers_unix = -1;
    }

	RunQuery("حذف FROM rcon");

    new query_string[400];
	for(new i = 0; i < MAX_AUCTION_CARS * MAX_BUREAU; i++)
	{
		if(portInfo[i][bRaterID] == -1) continue;

		format(query_string, sizeof query_string, "INSERT INTO `auction_السيارةs` (`id`, `نشط`, `model`, `color1`, `color2`, `الحالي_rate`, \
		`auction_price`, `strength`, `mileage`, `tuning`, `ptuning`, `winner_id`, `winner`, `delivery_time`, `time`) VALUES \
		('%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%d', '%s', '%d', '%d') ON DUPLICATE KEY UPDATE `color1` = `color1`",
			i, 
			portInfo[i][bActive], 
			portInfo[i][bCarModel], 
			portInfo[i][bColor1], 
			portInfo[i][bColor2], 
			portInfo[i][bCurrentRate], 
			portInfo[i][bAuctionPrice],
			portInfo[i][bStrengthPercentage], 
			portInfo[i][bMileage], 
			portInfo[i][bTuning], 
			portInfo[i][bPTuning], 
			portInfo[i][bRaterID],
			portInfo[i][bRateInitiator], 
			portInfo[i][bDeliveryTime], 
			portInfo[i][bTime]);

		mysql_query(sql_connection, query_string);
	}
	
	return mysql_close(sql_connection);
}

forward UnbanPermanetBan(playerid);
public UnbanPermanetBan(playerid) {
	if(!cache_num_rows()) {
		kick_player(playerid);
		return 1;
	}

	new playerDonate = cache_get_field_content_int(0, "u_donate", sql_connection);
	new string[144];

	if(playerDonate < p_t_info[playerid][unban_coin_need]) {
		format(string, 100, ""scm_error"أنت "c_green"%d M-Coin "c_white"Nadarid.", p_t_info[playerid][unban_coin_need]);
		SendClientMessage(playerid, col_white, string);
		kick_player(playerid);
		return 1;
	}

	format(string, sizeof(string), ""c_white"Aya Mikhahid Ba Dadan "c_green"%d M-Coin "c_white"Unban Shavid?\n\n- "c_orange_red"أدخل your كلمة المرور:", p_t_info[playerid][unban_coin_need]);
	show_dialog(playerid, d_unban_player_with_coin_2, DIALOG_STYLE_INPUT, ""c_server"Unban", string, "Unban", "Bastan");
	return 1;
}

forward UnbanPermanetBan2(playerid);
public UnbanPermanetBan2(playerid) {
	if(!cache_num_rows()) {
		SendClientMessage(playerid, col_white, ""scm_error"خاطئ كلمة المرور أدخلed.");
		kick_player(playerid);
		return 1;
	}

	new string[128];
	format(string, sizeof(string),"UPالتاريخ `users` SET `u_donate` = `u_donate`-'%d' WHERE `u_الاسم`='%s'",
	p_t_info[playerid][unban_coin_need], PlayerInfo[playerid][name]);
	mysql_tquery(sql_connection, string);

	format(string, sizeof(string), ""scm_error"أنت Ba Dadan "c_green"%d M-Coin "c_white"Unban Shodid!", p_t_info[playerid][unban_coin_need]);
	SendClientMessage(playerid, col_white, string);

	format(string, 90,"حذف FROM `users_bans` WHERE `u_b_الاسم` = '%s' LIMIT 1", PlayerInfo[playerid][name]);
	mysql_query(sql_connection, string);

	AdminMes(""c_server"* UNBAN.معلومات: "c_grey"%s(%d) ba dadan %d M-Coin unban shod.", PlayerInfo[playerid][name], playerid, p_t_info[playerid][unban_coin_need]);

	show_player_login_dialog(playerid);
	return 1;
}

public OnQueryError(errorid, error[], callback[], query[], connectionHandle)
{
	print ("[OnQueryخطأ] SQL خطأ. QUERY:");
	printf("0) OnQueryخطأ | خطأ: %s", error);
	printf("1) OnQueryخطأ | اتصالرجوع: %s", callback);
	printf("2) OnQueryخطأ | query: %s", query);
	printf("3) OnQueryخطأ | خطأid: %d", errorid);
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	#if defined debug_mode
		printf("[DEخلل] [OnDialogResponse] اللاعبid:%d | dialogid:%d | القائمةالعنصر:%d | p_dialog:%d", playerid, dialogid, listitem, p_t_info[playerid][p_dialog]);
	#endif
	
	for(new i=0;i<strlen(inputtext);i++)if(inputtext[i] =='%') inputtext[i]='#';
	while(strfind(inputtext,"%s",true)!=-1) strdel(inputtext,strfind(inputtext,"%s",true),strfind(inputtext,"%s",true)+2);
	while(strfind(inputtext,"%",true)!=-1) strdel(inputtext,strfind(inputtext,"%",true),strfind(inputtext,"%",true)+2);

	if(google_checking {playerid} == 1 && dialogid != d_googleauth_entrance) return 1;

	if(p_t_info[playerid][p_dialog] != dialogid)
	{
		p_t_info[playerid][p_dialog] = -1;
		return 1;
	}

	p_t_info[playerid][p_dialog] = -1;

	if(IsSQLInjection(inputtext) && listitem == -1) return SendError(playerid, "Shoma az karakter-haye gheire mojaz estefade kardid va darkhast-e shoma rad shod.");

	GreenZone_OnDialogResponse(playerid, dialogid, response, listitem, inputtext);

	// ---------------
	if(MRP_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
	// ---------------

    switch(dialogid)
    {
        case D_ACCESSORIES:
        {
            new idx_dialog_acc = p_t_info[playerid][p_listitem_int];
            p_t_info[playerid][p_listitem_int] = -1;
            switch(idx_dialog_acc)
            {
                case ACCESSORIES_ID_SELECT:
                {
                    if(!response) return 1;
                    if(GetPlayerAccessoriesID(playerid, listitem) == INVALID_ACCESSORIES_ID) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_SELECT);
                    ShowPlayerAccessoriesInfo(playerid, listitem);
                }
                case ACCESSORIES_ID_EXCHANGE:
                {
                    if(!response) return 1;
                    if(GetPlayerAccessoriesID(playerid, listitem) == INVALID_ACCESSORIES_ID) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_EXCHANGE);
                    // AddExchangeBet(playerid, BET_ACCESSORIES, GetPlayerAccessoriesID(playerid, listitem), listitem);
                }
            }
            return 1;
        }
		case D_ACCESSORIES_INFO:
		{
			if(!response)
			{
				// if(PlayerInfo[playerid][p_settings][INVENTORY_TYPE] == 0) return AccessoriesPlayerList(playerid, ACCESSORIES_ID_SELECT);
				// return 1;
				return AccessoriesPlayerList(playerid, ACCESSORIES_ID_SELECT);
			}
			// if(PlayerInfo[playerid][p_settings][INVENTORY_TYPE] == 0) 
			// return 1;
			show_dialog(playerid, D_ACCESSORIES_ACT, DIALOG_STYLE_LIST, "Action", "[1] Wear\n[2] Remove\n[3] بيع\n[4] Drop", "التالي", "إلغاء");
		}
		case D_ACCESSORIES_ACT:
		{
			new aidx = InventoryUseAccessories[playerid];
			if(!response)
			{
				// if(PlayerInfo[playerid][p_settings][INVENTORY_TYPE] == 0) return ShowPlayerAccessoriesInfo(playerid, aidx);
				// return 1;
				return ShowPlayerAccessoriesInfo(playerid, aidx);
			}
			switch(listitem)
			{
				case 0:
				{
					if(GetPlayerAccessoriesUseID(playerid, aidx) != 0) return SendError(playerid, "Thهو accessory هو already in use.");
					UsePlayerAccessories(playerid, aidx);
				}
				case 1:
				{
					if(GetPlayerAccessoriesUseID(playerid, aidx) == 0) return SendError(playerid, "Thهو accessory هو ليس in use.");
					UsePlayerAccessories(playerid, aidx);
				}
				case 2: return SendError(playerid, "بيعing هو only متاح through trade.");//SellPlayerAccessories(playerid, aidx);
				case 3: show_dialog(playerid, D_INVENTORY_DROP_ACC, DIALOG_STYLE_MSGBOX, "Dهوالسيارةd Accessory", ""c_white"هم you sure you want to dهوالسيارةd the اخترed accessory?", "نعم", "لا");
			}
			return 1;
		}
        case D_INVENTORY_DROP_ACC:
        {
            if(!response) return 1;
            DropPlayerAccessories(playerid, InventoryUseAccessories[playerid]);
            return 1;
        }
		case D_ACCESSORIES_SELL:
		{
			if(!response)
			{
				// if(PlayerInfo[playerid][p_settings][INVENTORY_TYPE] == 0) return show_dialog(playerid, D_ACCESSORIES_ACT, DIALOG_STYLE_LIST, "Action", "[1] Wear\n[2] Remove\n[3] بيع\n[4] Drop", "التالي", "إلغاء");
				// return 1;

				return show_dialog(playerid, D_ACCESSORIES_ACT, DIALOG_STYLE_LIST, "Action", "[1] Wear\n[2] Remove\n[3] بيع\n[4] Drop", "التالي", "إلغاء");
			}
			switch(listitem)
			{
				case 0: show_dialog(playerid, D_ACCESSORIES_SELL_PLAYER, DIALOG_STYLE_INPUT, "Sale", ""c_white"أدخل the اللاعب's ID and المبلغ separated by a comma:", "التالي", "إلغاء");
				case 1:
				{
					new aidx = InventoryUseAccessories[playerid], sidx = GetPlayerAccessoriesID(playerid, aidx) - 1;
					new str[200];
					format(str, sizeof(str), ""c_white"\
					Do you really want to sell the accessory \"%s\" to the الدولة for %d$?", Accessoriesالمعلومات[sidx][aالاسم], Accessoriesالمعلومات[sidx][aالسعر] / 4);
					show_dialog(playerid, D_ACCESSORIES_SELL_GOS, DIALOG_STYLE_MSGBOX, "Sale", str, "نعم", "لا");
				}
			}
			return 1;
		}
		case D_ACCESSORIES_SELL_PLAYER:
		{
			if(!response)
			{
				// if(PlayerInfo[playerid][p_settings][INVENTORY_TYPE] == 0) return show_dialog(playerid, D_ACCESSORIES_ACT, DIALOG_STYLE_LIST, "Action", "[1] Wear\n[2] Remove\n[3] بيع\n[4] Drop", "التالي", "إلغاء");
				// return 1;

				return show_dialog(playerid, D_ACCESSORIES_ACT, DIALOG_STYLE_LIST, "Action", "[1] Wear\n[2] Remove\n[3] بيع\n[4] Drop", "التالي", "إلغاء");
			}
			new scdplayerid, price;
			if(sscanf(inputtext, "p<,>ui", scdplayerid, price)) return show_dialog(playerid, D_ACCESSORIES_SELL_PLAYER, DIALOG_STYLE_INPUT, "Sale", "{"#cWHITE"}أدخل the اللاعب's ID and المبلغ separated by a comma:", "التالي", "إلغاء");
			if(scdplayerid == INVALID_PLAYER_ID) { show_dialog(playerid, D_ACCESSORIES_SELL_PLAYER, DIALOG_STYLE_INPUT, "Sale", "{"#cWHITE"}أدخل the اللاعب's ID and المبلغ separated by a comma:", "التالي", "إلغاء"); return SendError(playerid, "اللاعب ليس found."); }
			if(scdplayerid == playerid) { show_dialog(playerid, D_ACCESSORIES_SELL_PLAYER, DIALOG_STYLE_INPUT, "Sale", "{"#cWHITE"}أدخل the اللاعب's ID and المبلغ separated by a comma:", "التالي", "إلغاء"); return SendError(playerid, "You أدخلed your own ID."); }
			if(!IsPlayerStream(5.0, playerid, scdplayerid)) { show_dialog(playerid, D_ACCESSORIES_SELL_PLAYER, DIALOG_STYLE_INPUT, "Sale", "{"#cWHITE"}أدخل the اللاعب's ID and المبلغ separated by a comma:", "التالي", "إلغاء"); return SendError(playerid, "The اللاعب هو too far away from you."); }
			if(!IsTextNums(inputtext, 0, 1))
			{
				show_dialog(playerid, D_ACCESSORIES_SELL_PLAYER, DIALOG_STYLE_INPUT, "Sale", ""c_white"أدخل the اللاعب's ID and المبلغ separated by a comma:", "التالي", "إلغاء");
				SendError(playerid, "لا يمكنك use dots, multiple commas, or spaces.");
				return 1;
			}
			if(price < 1 || price > 100_000_000) { show_dialog(playerid, D_ACCESSORIES_SELL_PLAYER, DIALOG_STYLE_INPUT, "Sale", ""c_white"أدخل the اللاعب's ID and المبلغ separated by a comma:", "التالي", "إلغاء"); return SendError(playerid, "The السعر must be at least 1$ and لا more than 100,000,000$."); }
			new aidx = InventoryUseAccessories[playerid], sidx = GetPlayerAccessoriesID(playerid, aidx) - 1;
			if(aidx == -1 || sidx == -1)
			{
				SendError(playerid, "Something went خاطئ, يرجى try again.");
				printf("CRASHED: aidx: %d | %d || fix? %d", aidx, sidx, GetPlayerAccessoriesID(playerid, aidx));
				return 1;
			}
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "\
			"c_white"Do you want to offer "c_السيرفر"%s"c_white" to buy your accessory "c_السيرفر"\"%s\""c_white" for "c_السيرفر"%d$.", get_الاسم(scdاللاعبid), Accessoriesالمعلومات[sidx][aالاسم], السعر);
			show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX, "Accessory Sale", STRING_GLOBAL, "التالي", "إلغاء");
			return 1;
		}
		case D_ACCESSORIES_SELL_GOS:
		{
			if(!response) return show_dialog(playerid, D_ACCESSORIES_SELL, DIALOG_STYLE_LIST, "Sale", "[1] بيع accessory to a اللاعب\n[2] بيع accessory to the state ({"#cRED"}for 25 percent"c_white")", "التالي", "إلغاء");
			new aidx = InventoryUseAccessories[playerid], sidx = GetPlayerAccessoriesID(playerid, aidx) - 1, price = AccessoriesInfo[sidx][aPrice] / 4;
			ClearOwnerAccessories(playerid, GetPlayerAccessoriesID(playerid, aidx));
			give_money(playerid, price);
			SendAccess(playerid, "You sقديم the accessory \"%s\" for %d$.", AccessoriesInfo[sidx][aName], price);
			return 1;
		}
        case did_inventory_sell:
 		{
            if(!response) return 1;
		    new scdplayerid, count, idx = InventorySellItems[playerid],price;
			if(sscanf(inputtext, "p<,>iii", scdplayerid, count,price)) return SellPlayerInventoryItems(playerid, idx);
			if(!IsPlayerConnected(scdplayerid)) { SellPlayerInventoryItems(playerid, idx); return SendMes(playerid, COLOR_RED, "* اللاعب Vojod nadard"); }
			if(p_t_info[scdplayerid][p_logged] == false) { SellPlayerInventoryItems(playerid, idx); return SendMes(playerid, COLOR_RED, "* اللاعب تسجيل الدخول nakarde ast"); }
			if(scdplayerid == playerid) { SellPlayerInventoryItems(playerid, idx); return SendMes(playerid, COLOR_RED, "* Shoma nemitavanid be khod بيع konid!"); }
			if(!ProxDetectorS(5.0, playerid, scdplayerid)) { SellPlayerInventoryItems(playerid, idx); return SendMes(playerid, COLOR_RED, "* اللاعب be shoma nazdik nهوt!"); }
			if(count < 1 || count > PlayerInfo[playerid][pInventoryItems][idx]) { SellPlayerInventoryItems(playerid, idx); return SendMes(playerid, COLOR_RED, "Tedad hadeghal bayad 1 va hadeaksar %d Bashad.", PlayerInfo[playerid][pInventoryItems][idx]); }
			if(!(0 <= price <= 500000)) { SellPlayerInventoryItems(playerid, idx); return SendMes(playerid, COLOR_RED, "Tedad Pol Hadeaghal 0 va hadeaksar 500k"); }
			//if(CheckSentence(scdplayerid) == 1) return SendMes(playerid, COLOR_RED, "? ?????? ???? ???????? ???????????.");
			//if(PlayerInfo[scdplayerid][pAdmin] > 1 && PlayerInfo[scdplayerid][pAdmin] < 10) return SendMes(playerid, COLOR_RED, "????? ?????????????, ???????? ??????????.");

			PlayerInfo[scdplayerid][pSINVSeller] = playerid;
			PlayerInfo[scdplayerid][pSINVSIDx] = PlayerInfo[playerid][id];
			PlayerInfo[scdplayerid][pSINVPrice] = price;
			PlayerInfo[scdplayerid][pSINVNumber] = idx;
			PlayerInfo[scdplayerid][pSINVNumberIDx] = count;
			new strings[512];
			format(strings,512,""c_server"%s "c_white"offers you to شراء "c_server"%d "c_white"%s %s for "c_server"%d$ (/نعم)",
			PlayerInfo[playerid][name], count, Inventory[idx][InvUnitName], Inventory[idx][InvStringName],price);
			SendMes(scdplayerid,COLOR_RED,strings);
			return 1;
		}
		case d_refuel_vehicle:
		{
			if(!response) return 1;

			if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return DeletePVar(playerid, "f_biz"), SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"يجب عليك be in the السيارة.");

			if(isnull(inputtext))
			{
				show_dialog(playerid, d_refuel_vehicle, DIALOG_STYLE_INPUT, ""scm_dialog"الوقود", ""c_white"Tedad liters haye benzin ra vهمd konid:", "Reالوقود", "إلغاء");
				return 1;
			}
			new liters = strval(inputtext);
			if(!(5 <= liters <= 100))
			{
				show_dialog(playerid, d_refuel_vehicle, DIALOG_STYLE_INPUT, ""scm_dialog"الوقود", ""c_white"Tedad liters haye benzin ra vهمd konid:\n"c_red"* Liters ra beyne 5 ta 100 bezanid.", "Reالوقود", "إلغاء");
				return 1;
			}

			if(check_fuel_vehicle(playerid)) return 1;
			
			toggle_controlable(playerid, false);

			filling_count {playerid} = liters;

			new b = GetPVarInt(playerid, "f_biz");
			new fill_price = filling_count {playerid} * b_info[b][b_cost];
			if(PlayerInfo[playerid][money] < fill_price) {
				new string[100];
				format(string, sizeof(string), ""scm_error"أنت المال kafi لا تملك baraye البنزين zadan. [$%d]", convert_money(fill_price));
				return SendClientMessage(playerid, col_gray, string);
			}
			give_money(playerid, -fill_price);
			insert_money_log(playerid, INVALID_PLAYER_ID, -fill_price, "reالوقودing");


			b_info[b][b_product] -= filling_count {playerid};
			b_info[b][b_money] += fill_price;
			b_info[b][b_cash_today] += fill_price;

			SetPVarInt(playerid, "filling_الوقتr", SetTimerEx("filling_الوقتr", 500, 1, "ii", playerid, player_vehicle[playerid]));
			SendClientMessage(playerid, col_gray, ""scm_sucess"Sokht giri vasile naghlie shoma shoro shod. Montazer takmil bashid...");

			DeletePVar(playerid, "f_biz");
			return 1;
		}
		case d_unmarried: {
			if(!response) {
				return 1;
			}

			new string[128];

			format(string, sizeof(string), "أنت az "c_white"%s {CA1713}talagh gereftid.", p_t_info[playerid][married_player_name]);
			SendClientMessage(playerid, 0xCA1713FF, string);

			new targetid = GetPlayerID(p_t_info[playerid][married_player_name]);
			if(IsPlayerConnected(targetid)) 
			{
				format(string, sizeof(string), ""c_white"%s {CA1713}az أنت talagh gereft.", Name(playerid));
				SendClientMessage(targetid, 0xCA1713FF, string);
				
				PlayerInfo[targetid][married_account_id] = -1;
				update_int_sql(targetid, "u_married_الحساب_id", PlayerInfo[targetid][married_account_id]);
			}
			else
			{
				format(string, sizeof(string), "UPالتاريخ `users` SET `u_married_الحساب_id` = -1 WHERE `u_id` = %d LIMIT 1", PlayerInfo[playerid][married_account_id]);
				mysql_tquery(sql_connection, string);
			}

			PlayerInfo[playerid][married_account_id] = -1;
			update_int_sql(playerid, "u_married_الحساب_id", PlayerInfo[playerid][married_account_id]);
			return 1;
		}
		case d_campfire_take_food: {
