                                PlayerInfo[i][salary] += reason_money;
								update_payment(i, reason_money);
                                SendMes(i, col_yellow, "Be hoghooghe shoma ezafe shod: "c_green"$%s.", convert_money(reason_money));
                            }

                            new checkfires;
                            for(new c = 0; c < 5; c++) if(FireInfo[idx][fObject][c] != -1) checkfires++;
                            if(checkfires == 0)
                            {
                                FireInfo[idx][fStatus] = 0;
                                p_t_info[i][FireStatus] = 0;
                                p_t_info[i][FireTimer] = RandomEx(30, 60);
                                SendMes(i, col_blue, "Atashsozi dar yeki az sherkatha dar manteghe "c_white"\"%s\"{00FF00} khamosh shod.", FireInfo[idx][fCity]);
                                SendMes(i, col_wavy, "Montazer tamas jadid bashid.");
                            }
                        }
                        break;
                    }
                }
            }
