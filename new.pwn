stock load_phonebook(playerid)
{
	if(PlayerInfo[playerid][number])
	{
		new sscanf_delimit[60], rows, fields;
		format(sscanf_delimit, 60, "اختر * FROM `users_الهاتفbook` WHERE `u_id` = '%d'", PlayerInfo[playerid][id]);
		mysql_query(sql_connection, sscanf_delimit);
		cache_get_data(rows, fields);
		PlayerInfo[playerid][phones] = rows;
		for(new i; i < rows; i ++)
		{
			cache_get_field_content(i, "u_الهاتف_الاسم", phone_info[playerid][i], sql_connection, MAX_PLAYER_NAME);
			PlayerInfo[playerid][phone_num][i] = cache_get_field_content_int(i, "u_الهاتف_num", sql_connection);
		}
	}
	return 1;
}

