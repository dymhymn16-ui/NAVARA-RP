			switch(listitem)
		    {
		        case 0: show_dialog(playerid,d_rent_billd_text,DIALOG_STYLE_INPUT,"{E5D81E}Editing text",""c_white"We strongly recommend reading {1A8FA9}المساعدة for placing advertهوements"c_white", which هو located to your left\nأدخل the ad text in the field below","Edit","رجوع");
		        case 1:
				{
