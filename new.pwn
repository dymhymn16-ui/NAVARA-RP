cmd:fcontract(playerid)
{
    if(getJobFactionID(playerid) != job_mechanic) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"You do ليس work as a الميكانيكي.");
    else if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"يجب عليك be in the السيارة.");
    else if(veh_info[player_rentcar[playerid] -1][v_type] != vehicle_type_job || veh_info[player_rentcar[playerid] -1][v_owner] != job_mechanic) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"يجب عليك be in the working machine.");

	for(new t = 0; t < b_count; t ++)
	{
	    if(b_info[t][b_type] != bizz_type_gas) continue;
	    if(!IsPlayerInRangeOfPoint(playerid, 10.0, b_info[t][b_position][0], b_info[t][b_position][1], b_info[t][b_position][2])) continue;

		if(b_info[t][b_price] == 0) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"The السعر for 1 liter هو ليس assigned by the المالك of the filling.");
		if(b_info[t][b_owner_inc] == -1) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"Thهو محطة الوقود has لا المالك, it هو ليس working.");


		new _scm_string[128];
		format(_scm_string, 128, ""c_white"Gheymat 1 liter: $%d\n\nأدخل المبلغ of gasoline you want to شراء\n(الرقم should be استخدامd) military 2)", b_info[t][b_cost]);
		show_dialog(playerid, d_mech_contract,DIALOG_STYLE_INPUT,""c_server"الوقود شراء",_scm_string,"Kharid","إلغاء");

		SetPVarInt(playerid,"f_biz",t);
	    return 1;
	}
	SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"يجب عليك be near the محطة الوقود.");
	return 1;
}

cmd:refill(playerid,params[])
{
	if(getJobFactionID(playerid) != job_mechanic) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"Your الميكانيكي هو ليس working.");

	if(sscanf(params,"ui",params[0],params[1],params[2])) return SendInfo(playerid, "أدخل: /refill [id/الاسم] [banzin] [Gheymat]");
	if(params[2] < 80 || params[2] > 1500) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"السعر لا يمكنك be more than $1500 and less than $80");
	if(GetPVarInt(playerid,"الوقود") < params[1] || params[1] < 0) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"لا تملك much الوقود.");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
	if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2] ) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"Bazikon Kheyli door ast.");
	if(GetPlayerState(params[0]) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"The اللاعب must be in the السيارة.");
	if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"يجب عليك be in the machine.");
	if(veh_info[player_rentcar[playerid] -1][v_type] != vehicle_type_job || veh_info[player_rentcar[playerid] -1][v_owner] != job_mechanic) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey" يجب عليك stay in your work السيارة.");

	if(veh_info[GetPlayerVehicleID(params[0]) -1][v_fuel] + params[1] > 100) return SendClientMessage(playerid,col_gray,""c_orange_red"* "c_grey"Too much الوقود can't fit in the tank.");

	new _scm_string[128];
	format(_scm_string, 128, "You offered %s fill up the السيارة for %i liters of gas $%i", PlayerInfo[params[0]][name],params[1],params[2]);
	SendClientMessage(playerid, col_lblue,_scm_string);

	format(_scm_string, 128, ""c_white"%s offers to fill up سيارتك with %i liters for $%i\n\nYou agree?", PlayerInfo[playerid][name],params[1], params[2]);
	show_dialog(params[0],d_refill,DIALOG_STYLE_MSGBOX,""c_server"Reالوقودing",_scm_string,"قبول","رفضion");

	SetPVarInt(playerid,"id_refill",params[0] + 1);
	SetPVarInt(playerid,"السعر_refill", params[2]);
	SetPVarInt(playerid,"litres_refill", params[1]);
	SetPVarInt(params[0],"id_refill",playerid + 1);

	return 1;
}

cmd:repair(playerid,params[])
{
   if(getJobFactionID(playerid) != job_mechanic) return SendError(playerid, "أنت ليس working as a الميكانيكي.");
   if(sscanf(params,"ui",params[0],params[1])) return SendInfo(playerid, "أدخل: /إصلاح [id/الاسم] [Gheymat]");
   if(params[1] < 200 || params[1] > 1000) return SendError(playerid, " السعر for the إصلاح can't be more than $1000 or less е 200$");
   if(!IsPlayerConnected(params[0])) return SendError(playerid, "Bazikon Yaft Nashod.");
   if(!IsPlayerInRangeOfPoint(playerid, 5, p_t_info[params[0]][p_pos][0], p_t_info[params[0]][p_pos][1], p_t_info[params[0]][p_pos][2] ) || GetPlayerVirtualWorld(params[0]) != GetPlayerVirtualWorld(playerid)) return SendError(playerid, "Bazikon Kheyli door ast.");
   if(GetPlayerState(params[0]) != PLAYER_STATE_DRIVER) return SendError(playerid, "اللاعب must be in السيارة.");
   if(GetPlayerState(playerid) != 2) return SendError(playerid, "يجب عليك be in the السيارة.");
   if(veh_info[player_rentcar[playerid] -1][v_type] != vehicle_type_job || veh_info[player_rentcar[playerid] -1][v_owner] != job_mechanic) return SendError(playerid, "يجب عليك be in the working machine.");
   if(params[0] == playerid) return SendError(playerid, "You can't fix your machine.");

   new _scm_string[128];
   format(_scm_string, 128, "You offered %s to fix the السيارة for $%i", PlayerInfo[params[0]][name],params[1]);
   SendClientMessage(playerid, col_lblue, _scm_string);

   format(_scm_string, 128, ""c_white"%s offers to fix سيارتك for $%i\n\nهم you okay?", PlayerInfo[playerid][name],params[1]);
   show_dialog(params[0], d_repair, DIALOG_STYLE_MSGBOX, !""scm_dialog"إصلاح",_scm_string, !"قبول", !"رفضion");

   SetPVarInt(playerid,"id_إصلاح",params[0] + 1);
   SetPVarInt(playerid,"السعر_إصلاح", params[1]);
   SetPVarInt(params[0],"id_إصلاح",playerid + 1);
   return 1;
}

//ALT:truck:t;
cmd:tr(playerid, params[])
{
	if(getJobFactionID(playerid) != job_trucker) return 1;

	if(PlayerInfo[playerid][mute]) return SendMes(playerid, col_light_red, "Shoma az chat mahrum hastid | %d saniye", PlayerInfo[playerid][mute]);
	
	if(sscanf(params, "s[120]", params[0])) return SendInfo(playerid, "أدخل: /tr [Matn]");
 	CheckForAdvTexts(playerid, params[0]);
	new scm_string[144],
		rank_name[16];

	if(PlayerInfo[playerid][truck_skill] >= 0 && PlayerInfo[playerid][truck_skill]<= 30000)	rank_name = "جديدbie";
	else if(PlayerInfo[playerid][truck_skill] >= 30001 && PlayerInfo[playerid][truck_skill]<= 60000)rank_name = "Vodila";
	else if(PlayerInfo[playerid][truck_skill] >= 60001 && PlayerInfo[playerid][truck_skill]<= 90000)rank_name = "الخبرةert";
	else rank_name = "МН السيارةrier";

	format(scm_string, sizeof scm_string, " [TRUCK] %s %s: %s", rank_name, PlayerInfo[playerid][name], params[0]);
	foreach(new i: logged_players) if(getJobFactionID(i) == job_trucker) SendClientMessage(i, 0x4682B4AA, scm_string);

	return 1;
}
cmd:tskill(playerid, params[])
{
	global_string[0] = EOS;

	if(PlayerInfo[playerid][truck_skill] >= 0 && PlayerInfo[playerid][truck_skill]<= 29999)
	{
		format(global_string, 186,
		"\n\n"c_white"Your المستوى هو Beginner (1).\n\
        Available transport: Linerunner.\n\
        Cargo transported: %d/30000 KGS.", اللاعبالمعلومات[اللاعبid][truck_skill]);
		show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX,""c_server"long-range truck", global_string, "Bastan", "");
	}
	else if(PlayerInfo[playerid][truck_skill] >= 30000 && PlayerInfo[playerid][truck_skill]<= 59999)
	{
		format(global_string, 186,
		"\n\n"c_white"Your المستوى هو: السيارةrier (2).\n\
        Available transport: Linerunner, Tanker.\n\
        Cargo transported: %d/60000 KGS.", اللاعبالمعلومات[اللاعبid][truck_skill]);
		show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX,""c_server"long-range truck", global_string, "Bastan", "");

	}
	else if(PlayerInfo[playerid][truck_skill] >= 60000 && PlayerInfo[playerid][truck_skill]<= 89999)
	{
		format(global_string, 186,
		"\n\n"c_white"Your المستوى هو الخبرةert (3).\n\
        Available transport: Linerunner, Tanker, Roadtrain.\n\
        Freight transported: %d/90000 KGS.", اللاعبالمعلومات[اللاعبid][truck_skill]);
		show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX,""c_server"long-range truck", global_string, "Bastan", "");

	}
	else
	{
		format(global_string, 186,
		"\n\n"c_white"Your المستوى هو: International السيارةrier (4).\n\
        Affordable transport: Linerunner, Tanker, Roadtrain.\n\
		Cargo transported: %d.", اللاعبالمعلومات[اللاعبid][truck_skill]);
		show_dialog(playerid, d_none, DIALOG_STYLE_MSGBOX,""c_server"long-range truck", global_string, "Bastan", "");

	}
	return 1;
}

