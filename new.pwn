	if(runningAuctionsCount != 0)
	{
		runningAuctionsCount = 0;

		for(new bureau = 0; bureau < MAX_BUREAU; bureau++)
		{
			for(new vehicleid = 0; vehicleid < MAX_AUCTION_CARS; vehicleid++)
			{
				if(!bureauInfo[bureau][vehicleid][bActive]) continue;
				runningAuctionsCount++;

				if(!(--bureauInfo[bureau][vehicleid][bTime]))
				{
					bureauInfo[bureau][vehicleid][bActive] = false;

					if(bureauInfo[bureau][vehicleid][bCurrentRate] != 0)
					{
						new winner = GetPlayerID(bureauInfo[bureau][vehicleid][bRateInitiator]);
						bureauInfo[bureau][vehicleid][bDeliveryTime] = GetDeliveryTime(bureauInfo[bureau][vehicleid][bStrengthPercentage]);

						if(IsPlayerConnected(winner))
						{
							static const fmt_str[] = "مبروك! You bought the machine "c_white"\"%s\". {2BB000}Machine will be delivered in "c_white"%d ساعات";
							new text[sizeof fmt_str + 11 + 2];

							format(text, sizeof text, fmt_str, vehicle_name[bureauInfo[bureau][vehicleid][bCarModel] -400], (bureauInfo[bureau][vehicleid][bDeliveryTime] -timestamp) / 3600);
							SendClientMessage(winner, COLOR_GREEN, text);
						}
						else
						{
							static const fmt_str[] = "{BC2C2C}[معلومة أثناء عدم الاتصال] "c_white"مبروك! You bought the machine \"%s\". السيارة will be delivered in %d ساعات";
							new text[sizeof fmt_str + 11 + 2], query_string[101 + sizeof text];

							format(text, sizeof text, fmt_str, vehicle_name[bureauInfo[bureau][vehicleid][bCarModel] -400], (bureauInfo[bureau][vehicleid][bDeliveryTime] -timestamp) / 3600);

							format(query_string,sizeof(query_string),"UPالتاريخ `users` SET `u_offmsg_1` = CONCAT(COALESCE(`u_offmsg_1`, ''), '%s', ';') WHERE `u_id` = '%d' LIMIT 1", text, bureauInfo[bureau][vehicleid][bRaterID]);
							mysql_tquery(sql_connection, query_string, "", "");
						}

						unactiveCars++;
						memcpy(portInfo[bureau * MAX_AUCTION_CARS + vehicleid], bureauInfo[bureau][vehicleid], _, sizeof(bureauInfo[][]) * (cellbits / charbits));
					}
				}
			}
		}
	}

	if(unactiveCars != 0)
	{
		unactiveCars = 0;

		for(new veh = 0; veh < sizeof(portInfo); veh++)
		{
			if(portInfo[veh][bDeliveryTime] == timestamp) // the car arrived on Port
			{
				new owner = GetPlayerID(portInfo[veh][bRateInitiator]), text[132], hours;
				portInfo[veh][bActive] = true;
				portInfo[veh][bTime] = GetDeliveryTime(portInfo[veh][bStrengthPercentage]);

				gmtime(portInfo[veh][bTime], _, _, _, hours, _, _);

				if(IsPlayerConnected(owner))
				{
					format(text, sizeof text, ""scm_info"سيارتك "c_green"\"%s\" "c_white"مرحبًا بك في الميناء! ((لديك %d ساعات لاستلام السيارة))", vehicle_name[portInfo[veh][bCarModel] -400], hours);
					SendClientMessage(owner, col_white, text);
				}
				else
				{
					new query_string[78 + sizeof text];
					format(text, sizeof text, ""scm_info"سيارتك "c_green"\"%s\" "c_white"مرحبًا بك في الميناء! لديك %d ساعات لاستلام السيارة ((إشعار أثناء عدم الاتصال))", vehicle_name[portInfo[veh][bCarModel] -400], hours);
					format(query_string,sizeof(query_string),"UPالتاريخ `users` SET `u_offmsg_1` = CONCAT(COALESCE(`u_offmsg_1`, ''), '%s', ';') WHERE `u_id` = '%d' LIMIT 1", text, portInfo[veh][bRaterID]);
					mysql_tquery(sql_connection, query_string, "", "");
				}

			}
			else if(portInfo[veh][bTime] == timestamp) // max waiting time passed, machine is still on port
			{
				new owner = GetPlayerID(portInfo[veh][bRateInitiator]);

				new text[138];

				if(IsPlayerConnected(owner))
				{
					format(text, sizeof text, ""scm_info"سيارتك "c_green"\"%s\" "c_white" أعيد بيعها في المزاد لأنك لم تستلمها في الوقت المحدد.", vehicle_name[portInfo[veh][bCarModel] -400]);
					SendClientMessage(owner, col_white, text);
				}
				else
				{
					new query_string[78 + sizeof text];
					format(text, sizeof text, ""scm_info"سيارتك "c_green"\"%s\" "c_white" أعيد بيعها في المزاد لأنك لم تستلمها في الوقت المحدد. ((إشعار أثناء عدم الاتصال))", vehicle_name[portInfo[veh][bCarModel] -400]);
					format(query_string,sizeof(query_string),"UPالتاريخ `users` SET `u_offmsg_1` = CONCAT(COALESCE(`u_offmsg_1`, ''), '%s', ';') WHERE `u_id` = '%d' LIMIT 1", text, portInfo[veh][bRaterID]);
					mysql_tquery(sql_connection, query_string, "", "");
				}

				new query_string[44];
				format(query_string, sizeof query_string, "حذف FROM `auction_السيارةs` WHERE `id` = '%d'", veh);
				mysql_tquery(sql_connection, query_string);
				ClearVehInfo(veh);
			}
			else unactiveCars++;
		}
	}
	return 1;
}

