		case d_vacancy:
		{
			if(!response) return 1;
			new vacancies = 0;
			for(new i = 0; i < 10; i++)
			    if(VacancyInfo[i][VacancyStatus])
			        vacancies++;

			if(playerLeaderStatus(playerid) && ! gang_player(playerid) && ! mafia_player(playerid))
			{
			    if(listitem == 0 && vacancies == 0) {
			    	return show_dialog (playerid, d_vacancy_create, DIALOG_STYLE_INPUT, ""c_server"Add a vacancy", ""c_white"يرجى indicate the requirements for adالمهمة to your organization:", "قبول", "إلغاء");
				} else
					if(vacancies != 10 && listitem == vacancies) return show_dialog (playerid, d_vacancy_create, DIALOG_STYLE_INPUT, ""c_server"Add a vacancy", ""c_white"يرجى indicate the requirements for adالمهمة to your organization:", "قبول", "إلغاء");
			}

			if(vacancies == 0) return SendError(playerid, "لا متاح vacancies found.");
			if(listitem == vacancies + 1) pc_cmd_vacancy(playerid);

			new items = 0;
			for(new i = 0; i < 10; i++)
			{
			    if(VacancyInfo[i][VacancyStatus] == true) items++;
			    if(items -1 == listitem)
				{
			        new string[63+28+100];
					format(string, sizeof(string), ""c_grey"Organization: {%s}%s\n"c_grey"Criteria: "c_white"%s\n", f_info[VacancyInfo[i][VacancyFraction] -1][f_chat_color], f_info[VacancyInfo[i][VacancyFraction] -1][f_name], VacancyInfo[i][VacancyText]);
					if(VacancyInfo[i][VacancyFraction] != PlayerInfo[playerid][leader])
					{
						return show_dialog (playerid, 0, DIALOG_STYLE_MSGBOX, ""c_server"Vacancy", string, "Bastan", "");
					}
					return show_dialog (playerid, d_vacancy_create_end, DIALOG_STYLE_MSGBOX, ""c_server"Vacancy", string, "قبول", "Bastan");
			    }
			}
		}
		case d_vacancy_create:
		{
			if(!response) return 1;
			new text[120];
			if(sscanf(inputtext, "s[120]", text) || strlen(inputtext) > 120) return show_dialog (playerid, d_vacancy_create, DIALOG_STYLE_INPUT, ""c_server"Add a vacancy", ""c_grey"* The رسالة length لا يمكنك exceed 120 characters.\n\n"c_white"يرجى indicate the requirements for adالمهمة to your organization:", "قبول", "إلغاء");
            for(new i = 0; i < 10; i++)
			    if(VacancyInfo[i][VacancyFraction] == PlayerInfo[playerid][leader] && VacancyInfo[i][VacancyStatus] == true)
			        return SendError(playerid, "Your organization's Vacancy has already been added, حذف the قديم one.");

			for(new i = 0; i < 10; i++)
			{
			    if(VacancyInfo[i][VacancyStatus] == false)
				{
			        VacancyInfo[i][VacancyText] = text;
                    VacancyInfo[i][VacancyFraction] = PlayerInfo[playerid][leader];
                    VacancyInfo[i][VacancyStatus] = true;
					VacancyInfo[i][VacancyCreator] = playerid;

                    SendClientMessage(playerid, col_succes, "Shoma Ba Movafghiat added a جديد vacancy to your organization.");
                    return pc_cmd_vacancy(playerid);
			  }
			}
			return SendError(playerid, "القائمة of vacancies "), pc_cmd_vacancy(playerid);
		}
		case d_vacancy_create_end:
		{
		    if(!response) return pc_cmd_vacancy(playerid);
			for(new i = 0; i < 10; i++)
			{
			    if(VacancyInfo[i][VacancyFraction] == PlayerInfo[playerid][leader])
				{
			        VacancyInfo[i][VacancyStatus] = false;
					VacancyInfo[i][VacancyCreator] = INVALID_PLAYER_ID;

			        return SendClientMessage(playerid, col_succes, "Shoma Ba Movafghiatyour vacancy تم removed.");
			     }
			}
		}
		case d_rieltore:
		{
			if(!response) return 1;

			switch(listitem)
			{
				case 0: show_dialog(playerid, d_rieltore_house, DIALOG_STYLE_LIST, !""scm_dialog"At home", !"\
					"c_السيرفر"1 | "c_white"Houses for sale\n\
					"c_السيرفر"2 | "c_white"Buying a house by number", !"Entekhab", !"Bargasht");
				case 1: show_dialog(playerid, d_rieltore_biz, DIALOG_STYLE_LIST, !""scm_dialog"المشروعes", !"\
					"c_السيرفر"1 | "c_white"businesses for sale\n\
					"c_السيرفر"2 | "c_white"Buying a business by number", !"Entekhab", !"Bargasht");
			}
		}
		case d_photographer_invite:
		{
			if(response)
			{
				if(dynamic_area_photographer_job[playerid] != -1)
					DestroyDynamicArea(dynamic_area_photographer_job[playerid]);
				#if DEBUG_PHOTOGRAPHER_SYSTEM == 1
					printf("d_photographer_دعوة | القائمةالعنصر: %d", listitem);
				#endif
				check_cooldown_photographer(playerid, listitem);
			}
		}
		case d_photographer_invite_1:
		{
			new listitem_ = GetPVarInt(playerid, "photographer_quest_id");
			if(response)
			{

				new quest_id = quest_photographer_id[playerid];
				#if DEBUG_PHOTOGRAPHER_SYSTEM == 1
					printf("d_photographer_دعوة_1 | مهمة_id: %d", quest_id);
				#endif
				if(quest_id < QUEST_OLD_MILITARY)
				{
					listitem_ -= 1;
					dynamic_area_photographer_job[playerid] = CreateDynamicCube(photographer_job_info[quest_id][pjXMinPos],
																				photographer_job_info[quest_id][pjYMinPos],
																				photographer_job_info[quest_id][pjZMinPos],
																				photographer_job_info[quest_id][pjXMaxPos],
																				photographer_job_info[quest_id][pjYMaxPos],
																				photographer_job_info[quest_id][pjZMaxPos],
																				_,
																				_,
																				playerid);
					gps_point_photographer[playerid] = CreateDynamicCP(photographer_gps_point[quest_id][x_pos_gps],
																	   photographer_gps_point[quest_id][y_pos_gps],
																	   photographer_gps_point[quest_id][z_pos_gps],
																	   0.0,
																	   _,
																	   0,
																	   playerid,
																	   8000.0);
					step_photographer_job[playerid] = 0;
					static const str[] = "Great! أخذ a photo of %s ("c_grey" الموقع shown on miniالخريطة"c_succes")";
					new fmt_str[sizeof(str) + 7 * 2 -2 + MAX_NAME_PHOTOGRAPHER_POINT];
					format(fmt_str, sizeof(fmt_str), str, photographer_job_info[quest_id][pjName]);
					SendClientMessage(playerid, col_succes, fmt_str);
				}
				else
				{
					step_photographer_job[playerid] = 0;
					SendClientMessage(playerid, col_succes, "Excellent! قبول the المهمة from the actor ("c_grey" الموقع هو indicated on the miniالخريطة"c_succes")");

					listitem_ -= 1;

					printf("d_photographer_دعوة_1 | index_نظام الملاحة: %d", QUEST_OLD_MILITARY + listitem_);
					gps_point_photographer[playerid] = CreateDynamicCP(photographer_gps_point[QUEST_OLD_MILITARY + listitem_][x_pos_gps],
																	   photographer_gps_point[QUEST_OLD_MILITARY + listitem_][y_pos_gps],
																	   photographer_gps_point[QUEST_OLD_MILITARY + listitem_][z_pos_gps],
																	   0.0,
																	   _,
																	   0,
																	   playerid,
																	   8000.0);


					dynamic_sphere_photographer[playerid] = CreateDynamicSphere(actor_pos_photographer_quest[listitem_][x_pos_actor],
																				actor_pos_photographer_quest[listitem_][y_pos_actor],
																				actor_pos_photographer_quest[listitem_][z_pos_actor],
																				5.0,
																				_,
																				_,
																				playerid);
				}
			}
			else
			{
				DeletePVar(playerid, "photographer_quest_id");
				quest_photographer_id[playerid] = -1;
			}
		}
		case d_photographer_actor_dialog:
		{
			if(response)
			{
				step_photographer_job[playerid] = 1;
				//quest_photographer_id[playerid] = GetPVarInt(playerid, "photographer_quest_id");

				new count_photo = counter_photos_taken{playerid};
				new id_quest = quest_photographer_id[playerid] + count_photo;

				id_quest += ShiftIndexArray(playerid, id_quest);
				#if DEBUG_PHOTOGRAPHER_SYSTEM == 1
					printf("اللاعبDialogShowمهمةPhotogr | id_مهمة: %d | id_مهمة -مهمة_قديم_MILITARY: %d", id_quest,
																											  id_quest -_:QUEST_OLD_MILITARY);
				#endif
				new
					cache_math,
					Float: cache_x_point,
					Float: cache_y_point,
					Float: cache_z_point;
				if(id_quest < QUEST_GRANDMOTHER)
				{
					cache_math = (id_quest -QUEST_OLD_MILITARY);
					#if DEBUG_PHOTOGRAPHER_SYSTEM == 1
						printf("Photographer | d_photographer_actor_dialog | id_مهمة < مهمة_GRANDMOTHER | cache_math: %d", cache_math);
					#endif
					cache_x_point = cylinder_photographer_info[cache_math][x_cilinder_photographer];
					cache_y_point = cylinder_photographer_info[cache_math][y_cilinder_photographer];
					cache_z_point = cylinder_photographer_info[cache_math][minz_cilinder_photographer];

					cylinder_photo_point[playerid] =  CreateDynamicCylinder(cache_x_point,
																			cache_y_point,
																			cache_z_point,
																			cylinder_photographer_info[cache_math][maxz_cilinder_photographer],
																			45.0,
																			_,
																			_,
																			playerid);
				}
				else if(id_quest == QUEST_WIFE)
				{
					#if DEBUG_PHOTOGRAPHER_SYSTEM == 1
						printf("Photographer | d_photographer_actor_dialog | id_مهمة == مهمة_WIFE | cache_math: %d", cache_math);
					#endif
					cache_x_point = 2053.1826;
					cache_y_point = 1544.9056;
					cache_z_point = 10.6719;
				}
				else if(id_quest == QUEST_GRANDMOTHER)
				{
					#if DEBUG_PHOTOGRAPHER_SYSTEM == 1
						printf("Photographer | d_photographer_actor_dialog | id_مهمة == مهمة_GRANDMOTHER | cache_math: %d", cache_math);
					#endif
					cache_x_point = 149.4180;
					cache_y_point = -1721.1514;
					cache_z_point = 8.9440;
				}
				else if(id_quest == QUEST_PRIEST)
				{
					cache_math = (id_quest -QUEST_OLD_MILITARY -2);
					#if DEBUG_PHOTOGRAPHER_SYSTEM == 1
						printf("Photographer | d_photographer_actor_dialog | id_مهمة == مهمة_PRIEST | cache_math: %d", cache_math);
					#endif
					cache_x_point = cylinder_photographer_info[cache_math][x_cilinder_photographer];
					cache_y_point = cylinder_photographer_info[cache_math][y_cilinder_photographer];
					cache_z_point = cylinder_photographer_info[cache_math][minz_cilinder_photographer];
					cylinder_photo_point[playerid] =  CreateDynamicCylinder(cache_x_point,
																			cache_y_point,
																			cache_z_point,
																			cylinder_photographer_info[cache_math][maxz_cilinder_photographer],
																			45.0,
																			_,
																			_,
																			playerid);
				}
				#if DEBUG_PHOTOGRAPHER_SYSTEM == 1
					printf("d_photographer_actor_dialog | id: %d | x_min: %f | y_min: %f | z_min: %f | x_max: %f | y_max: %f | z_max: %f",
																																	id_quest,
																																	photographer_job_info[id_quest][pjXMinPos],
																																	photographer_job_info[id_quest][pjYMinPos],
																																	photographer_job_info[id_quest][pjZMinPos],
																																	photographer_job_info[id_quest][pjXMaxPos],
																																	photographer_job_info[id_quest][pjYMaxPos],
																																	photographer_job_info[id_quest][paxs]);

				#endif
				dynamic_area_photographer_job[playerid] = CreateDynamicCube(photographer_job_info[id_quest][pjXMinPos],
																			photographer_job_info[id_quest][pjYMinPos],
																			photographer_job_info[id_quest][pjZMinPos],
																			photographer_job_info[id_quest][pjXMaxPos],
																			photographer_job_info[id_quest][pjYMaxPos],
																			photographer_job_info[id_quest][pjZMaxPos],
																			_,
																			_,
																			playerid);
				map_icon_photographer[playerid] = CreateDynamicMapIcon(cache_x_point,
																	   cache_y_point,
																	   cache_z_point,
																	   41,
																	   0x0,
																	   _,
																	   0,
																	   playerid,
																	   8000.0,
																	   MAPICON_GLOBAL);
				SendClientMessage(playerid, col_succes, "You took Exercهوe from the actor. Take the مطلوب number of photos ("c_grey" الموقع of the photo angle هو indicated on the miniالخريطة"c_succes")");
			}
		}
		case d_photographer_uninvite:
		{
			if(response)
			{
				EndJobPhotographer(playerid);
				SendClientMessage(playerid, col_succes, "You Tark shoghle feli as a photographer.");
			}
		}
	}
	return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
	#if defined debug_mode
		printf("[DEخلل][OnاللاعبReمهمةClass] اللاعبid: %d", playerid);
	#endif

    SetPlayerTime(playerid, timestamp_hour, timestamp_minute);

    SetSpawnInfo(playerid, 255, 79, 2404.1870,1554.4166,43.8807, 1.0, -1, -1, -1, -1, -1, -1);


   	if(p_t_info[playerid][p_logged])
    {
		SpawnPlayer(playerid);
    }
	
    return 1;
}

stock GetNumberOfPlayersOnThisIP(const test_ip[])
{
	new against_ip[32+1];
	new x = 0;
	new ip_count = 0;
	foreach(new i: Player)
	{
	    GetPlayerIp(x,against_ip,32);
	    if(!strcmp(against_ip, test_ip)) ip_count++;
	}
	return ip_count;
}

// =============================
// NAVARA-RP Server Owner
// =============================
stock ApplyServerOwner(playerid)
{
    new player_name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, player_name, sizeof(player_name));

    if(!strcmp(player_name, "Sev_Iraq", true))
    {
        PlayerInfo[playerid][admin] = 8;
        return 1;
    }
    return 0;
}


public OnPlayerConnect(playerid)
{
	#if defined debug_mode
		printf("[DEخلل] [OnاللاعبConnect] اللاعبid:%d", playerid);
	#endif

	if(AssignRandomBotName(playerid)) return 0;

	DeleteTagFromPlayerName(playerid);

	//==============================================================================
	GetPlayerName(playerid, PlayerInfo[playerid][name], MAX_PLAYER_NAME);

	new change_nickname[MAX_PLAYER_NAME];
	format(change_nickname, sizeof change_nickname, "تسجيل الدخول_USER_%d", playerid);
	SetPlayerName(playerid, change_nickname);

	GetPlayerIp(playerid, p_t_info[playerid][p_ip], 16);

	AddConnect(playerid, 0);

	if(!IsPlayerNPC(playerid) && (!strcmp(PlayerInfo[playerid][name],"Angel85") || !strcmp(PlayerInfo[playerid][name],"BOSS"))) return SendError(playerid, "Estefade az in esm mamلاe mibashad va shoma طرد mهوhavid."), kick_player(playerid);	

	//----------------
	new count_nicknames;

	foreach(new i : logged_players)
    {
		if(isBotPlayer(i)) continue;
        if(!strcmp(PlayerInfo[playerid][name], PlayerInfo[i][name], true)) {
            count_nicknames++;
        }
    }

	if(count_nicknames >= 2) {
		SendClientMessage(playerid, 0x6AA049FF, "CONNECTION رفضED: Nickالاسم gheire ghabel-e ghabool ast");
		SendClientMessage(playerid, 0x6AA049FF, "Lotfan yek nick jadid beyn 3 ta 20 karakter entekhab konid");
		SendClientMessage(playerid, 0x6AA049FF, "Lotfan faghat az horof a-z, A-Z, va adad 0-9 estefade konid");
		SendClientMessage(playerid, 0x6AA049FF, "Az dastoor /quit estefade konid ya dokme ESC ra bezanid va Quit Game ra entekhab konid");
		kick_player(playerid);
		return 0;
	}

	new num_players_on_ip = GetNumberOfPlayersOnThisIP(p_t_info[playerid][p_ip]);
	if(num_players_on_ip > 3)
	{
		if(!is_ip_white_list(p_t_info[playerid][p_ip])) return BlockIpAddress(p_t_info[playerid][p_ip], 60 * 1000);
		SetPlayerScore(playerid, random(5)+ 1);
	}

	PlayAudioStreamForPlayer(playerid, "https://www.gtarp.ir/السيرفر-تسجيل الدخول.mp3");
	p_t_info[playerid][AudioLogin] = true;

	GameTextForPlayer(playerid, "~g~~h~Khosh Amadid Be~n~~w~~h~Mihan~n~~r~~h~RolePlay", 4000, 4);


	clear_player_data(playerid);
	SetPlayerColor(playerid, 0xFFFFFF80); // col_middle_white
	TogglePlayerSpectating(playerid, true); //login camera related
	p_t_info[playerid][p_tp_immune_time] = 6;

	for(new j = 0; j < sizeof td_logo; j ++)
	{
		TextDrawShowForPlayer(playerid, td_logo[j]);
	}

	#include "..\library\modules/objects/m_rem_objects.pwn"


	//==============================================================================
	PlayerLoadPreloadAnims(playerid);
	//==============================================================================
	for(new i = 0; i < 20; i ++) SendClientMessage(playerid, -1, " ");
	
	if(IsPlayerMobile(playerid)) SendInfo(playerid, "Shoma ba Android vهمd bazi shodid.");
	else SendInfo(playerid, "Shoma ba PC vهمd bazi shodid.");

    new tquery_string[144];
    format(tquery_string, sizeof(tquery_string), "اختر `u_id`,`u_last_ip`,`u_last_gpci`,`u_الإعدادات`,`u_skin` FROM `users` WHERE `u_الاسم`='%s' LIMIT 1", PlayerInfo[playerid][name]);
    mysql_tquery(sql_connection, tquery_string, "check_اللاعب_إنشاء حسابed", "i", playerid);
	
	// ---------------
	MRP_OnPlayerConnect(playerid);
	// ---------------
	return 1;
}

public OnPlayerDisconnect(playerid, reason)
{
	#if defined debug_mode
		printf("[DEخلل] [OnاللاعبDهوconnect] اللاعبid:%d | السبب:%d", playerid, reason);
	#endif

	if(FreeBotName(playerid)) return 0;

	AddConnect(playerid, 1);

	MRP_OnPlayerDisconnect(playerid);

	if(IsPlayerNPC(playerid))
	{
		Iter_Remove(logged_players, playerid);
		return 1;
	}

	new szDisconnectReason[3][] =
    {
        "الوقتout/Crash",
        "Quit",
        "طرد/Ban"
    };
 
    SendAction(playerid, "az bazi khهمj shod (%s)", szDisconnectReason[reason]);

	if(p_t_info[playerid][FireStatus] != 0) DestroyFire(playerid);

    ClearHookah(playerid, 1);

	#if defined _metro_stop_included
		ms_OnPlayerDisconnect(playerid);
	#endif

	if(GetPVarInt(playerid, "show_pass") == 1)
	{
		for(new i = 0; i < 39; i++)
		{
		    PlayerTextDrawDestroy(playerid, Passport_PTD[playerid][i]);
		    Passport_PTD[playerid][i] = PlayerText:-1;

			if(i < 6) TextDrawHideForPlayer(playerid, Passport_TD[i]);
		}

		DeletePVar(playerid, "show_pass");
	}

	g_BeforeDelayPositons[playerid][0] = 0.0;
	g_DelayForSetPos[playerid] = 0;

	p_t_info[playerid][gomp] = false;

	if(p_t_info[playerid][campfire_object] != 0) {
		DestroyDynamicObject(p_t_info[playerid][campfire_object]);
		DestroyDynamicObject(p_t_info[playerid][campfire_object_steak]);
		DestroyDynamic3DTextLabel(p_t_info[playerid][campfire_label]);
		p_t_info[playerid][campfire_object] = 0;
		p_t_info[playerid][campfire_object_steak] = 0;
		p_t_info[playerid][campfire_time] = 0;
		p_t_info[playerid][campfire_label] = Text3D:INVALID_3DTEXT_ID;
	}

	if(griderObjectFire[playerid][0]) {
        DestroyDynamicObject(griderObjectFire[playerid][0]);
        DestroyDynamicObject(griderObjectFire[playerid][1]);
        DestroyDynamicObject(griderObjectFire[playerid][2]);
        griderObjectFire[playerid][0] = 0;
        griderObjectFire[playerid][1] = 0;
        griderObjectFire[playerid][2] = 0;
    }

	if(PlayerFlamingHandEffect[playerid]) {
		if(IsPlayerAttachedObjectSlotUsed(playerid, 7)) RemovePlayerAttachedObject(playerid, 7);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 8)) RemovePlayerAttachedObject(playerid, 8);

		PlayerFlamingHandEffect[playerid] = false;
	}

	g_PlayerSpawned[playerid] = false;

	if(ptd_jailtime[playerid][0] != PlayerText:INVALID_TEXT_DRAW) {
		DestroyPlayerTimeJailTextdraw(playerid);
	}

	if(player_lobby_status[playerid] == true && player_lobby_idx[playerid] != -1)
    {
        OnPlayerLeaveLobby(playerid, player_lobby_idx[playerid], "خروج the اللعبة.");
    }
	
	if(satiety_progress_bar[playerid] != INVALID_PLAYER_BAR_ID) {
		DestroyPlayerProgressBar(playerid, satiety_progress_bar[playerid]);
		satiety_progress_bar[playerid] = INVALID_PLAYER_BAR_ID;
	}

    if(speed_one[playerid]) destroyspeed(playerid);
    HideTextDraw_FlinSpeedometr(playerid, true);

	
	if(GetPVarInt(playerid, "تسجيل الدخول_الوقتr"))
	{
		KillTimer(GetPVarInt(playerid, "تسجيل الدخول_الوقتr"));
		DeletePVar(playerid, "تسجيل الدخول_الوقتr");
	}

	KillTimer(timerShowCityPart[playerid]);


	p_t_info[playerid][check_hunger_timer] = SetTimerEx("check_الجوع", 400000, true, "d", playerid);

	CreatePlayerTimeJailTextdraw(playerid);

	if(PlayerInfo[playerid][admin])
	{
		new query_string[136];
		new played_time = NetStats_GetConnectedTime(playerid)/ 1000;
		if(played_time > 3600)played_time = 0;

		format(query_string,sizeof(query_string),"UPالتاريخ `users_إداريs` SET `u_a_التاريخ` = لاW(),\
														   `u_a_online`=`u_a_online`+'%d' \
												    WHERE `u_a_name` = '%s' LIMIT 1", played_الوقت, اللاعبالمعلومات[اللاعبid][الاسم]);
		mysql_tquery(sql_connection, query_string, "", "");

		Iter_Remove(admin_players, playerid);

		PlayerInfo[playerid][admin] = 0;
	}
	
	if(PlayerInfo[playerid][gun_skills][0] > 0 || PlayerInfo[playerid][gun_skills][1] > 0 || PlayerInfo[playerid][gun_skills][2] > 0 || PlayerInfo[playerid][gun_skills][3] > 0 || PlayerInfo[playerid][gun_skills][4] > 0
	|| PlayerInfo[playerid][gun_skills][5] > 0 || PlayerInfo[playerid][gun_skills][6] > 0)
	{
		new text_string[96];

		format(text_string, sizeof(text_string), "UPالتاريخ `users` SET `u_skills`='%d|%d|%d|%d|%d|%d|%d' WHERE `u_id`='%d' LIMIT 1", PlayerInfo[playerid][gun_skills][0], PlayerInfo[playerid][gun_skills][1], PlayerInfo[playerid][gun_skills][2], PlayerInfo[playerid][gun_skills][3], PlayerInfo[playerid][gun_skills][4], PlayerInfo[playerid][gun_skills][5], PlayerInfo[playerid][gun_skills][6], PlayerInfo[playerid][id]);
		mysql_query(sql_connection, text_string);
	}

	if(p_t_info[playerid][complaint] != INVALID_PLAYER_ID)
	{
		KillTimer(p_t_info[playerid][complaint_timer]);
	}
	
 	if(report_id[playerid] != -1)
    {
        report_slot[report_id[playerid]] = -1;
        report_id[playerid] = -1;
    }

