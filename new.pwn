				{
					show_dialog(playerid, d_truck_buy, DIALOG_STYLE_INPUT, ""c_server"شراء wood", ""c_white"أدخل the number of kilograms you want to شراء.\nالدعمs tractor: 10.000 kg.\n1 kg -10$", "Kharid", "إلغاء");
