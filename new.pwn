new const photographer_msg_quest[7][] =
{
	{""c_white"\t\t\t\tHello "c_server"%s"c_white"\n\
	  Our city hall needs a photo report featuring "c_السيرفر"\"%s\""c_white".\n\
	  Could you take a few pictures for us? We'll pay you "c_السيرفر"1000"c_white"$ for this."},
	{""c_server"\t\t\t\t\tHello, son! \n\
	  "c_white"I've been retired for a while, but I've heard rumors about illegal arms sales at the military base. \n\
	  Could you go to the military base and take 2-3 pictures around the perimeter? \n\
	  \t\t\t\tI'll pay you "c_السيرفر"3,000"c_white"$ for this."},
	{""c_white"\t\tI've been المعلوماتrmed that the roads in Las Venturas هم in poor condition. \n\
	  But that's strange, as we allocated funds for repairs last month. \n\
	  \t\tCould you go there and photograph the state of the roads? \n\
	  \t\tI don't have time to do it myself. \n\
	  \t\t\t\tI'll pay you "c_السيرفر"2,500"c_white"$ for this."},
	{""c_server"\t\t\t\t\t\tHello, friend!\n\
	  \t\t\t"c_white"My team and I are planning to build a new residential complex in San Fiero.\n\
  	  \t\t\tBut to get investment, I need to develop a business plan.\n\
	  I need photos of an empty lot in San Fiero, and I'll pay you "c_السيرفر"2,000"c_white"$ for completing this task."},
	{""c_server"\t\t\t\t\t\tHello, grandchild.\n\
	  \t\t"c_white"Could you take a few pictures of the lighthouse in Los Santos?\n\
	  A long time ago, I met my husband there, and we'd love a beautiful picture of this place.\n\
	  \t\t\t\t\tWe'll pay you "c_السيرفر"1,500"c_white"$ for this."},
	{""c_server"\t\t\t\t\t\tHello!\n\
	  "c_white"I'm about to get divorced from my husband, but I really want to win the case and take all his property.\n\
	  \tCould you follow him and find evidence of his infidelity?\n\
	  \t\t\t\t\tI'm willing to pay you "c_السيرفر"2,500"c_white"$ for this."},
	{""c_server"\t\t\t\tHello, my son.\n\
	  "c_white"\tJournalists from Jerusalem want to write an article about my church.\n\
   	  They asked for some photos, but unfortunately, I don't know how to take them.\n\
	  \t\tCould you take a few pictures of my church?\n\
	  \t\t\t\tI'll pay you "c_السيرفر"2,000"c_white"$ for this."}
};

