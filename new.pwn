						format(line_string, sizeof(line_string), ""c_white"العائلة عضوs: {%s}%d/%d اللاعبين\n\n", family_info[family_id][fam_chat_color], family_info[family_id][fam_members], MAX_SLOT_FAMILY_MEMBERS);
						strcat(global_string, line_string);
