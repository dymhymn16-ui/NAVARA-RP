		case d_gz_sell_accept:
		{
			if(seller_id[playerid] == INVALID_PLAYER_ID) return SendError(playerid, "The بيعer left the game.");
			if(!response)
			{
				SendClientMessage(seller_id[playerid], col_gray, ""c_orange_red"* "c_grey"The اللاعب refused to شراء the المنطقة.");
				buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
				sell_price[seller_id[playerid]] = -1;
				sell_item[seller_id[playerid]] = -1;
				seller_id[playerid] = INVALID_PLAYER_ID;
				return 1;
			}
			if(gz_info[sell_item[seller_id[playerid]]][gz_time] > 0)
			{
				SendClientMessage(seller_id[playerid], col_gray, ""c_orange_red"* "c_grey"There هو الحاليly a الحرب going on for thهو المنطقة.");
				SendError(playerid, "There هو الحاليly a الحرب going on for thهو المنطقة.");
				buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
				sell_price[seller_id[playerid]] = -1;
				sell_item[seller_id[playerid]] = -1;
				seller_id[playerid] = INVALID_PLAYER_ID;
				return 1;
			}
			if(PlayerInfo[playerid][money] < sell_price[seller_id[playerid]])
			{
				SendClientMessage(seller_id[playerid], col_gray, ""c_orange_red"* "c_grey"Bazikon pol kafi baraye kharid in ro ndarad.");
				SendError(playerid, "Shoma Pol Kafi nadarid for شراء.");
				buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
				sell_price[seller_id[playerid]] = -1;
				sell_item[seller_id[playerid]] = -1;
				seller_id[playerid] = INVALID_PLAYER_ID;
				return 1;
			}
			if(PlayerInfo[seller_id[playerid]][member] != gz_info[sell_item[seller_id[playerid]]][gz_owner])
			{
				SendClientMessage(seller_id[playerid], col_gray, ""c_orange_red"* "c_grey"Thهو المنطقة لا longer belongs to you.");
				SendError(playerid, "Thهو المنطقة لا longer belongs to the اللاعب.");
				buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
				sell_price[seller_id[playerid]] = -1;
				sell_item[seller_id[playerid]] = -1;
				seller_id[playerid] = INVALID_PLAYER_ID;
				return 1;
			}
			gz_info[sell_item[seller_id[playerid]]][gz_owner] = PlayerInfo[playerid][member];

			new _text_string[128];
			format(_text_string, sizeof(_text_string), ""c_green"* "c_white"You bought المنطقة from "c_green"%s"c_white" for "c_green"$%d"c_white".",PlayerInfo[seller_id[playerid]][name], sell_price[seller_id[playerid]]);
			SendClientMessage(playerid, col_white, _text_string);
			format(_text_string, sizeof(_text_string), ""c_green"* "c_white"You sقديم the المنطقة "c_green"%s"c_white" for "c_green"$%d"c_white".", PlayerInfo[playerid][name], sell_price[seller_id[playerid]]);
			SendClientMessage(seller_id[playerid], col_white, _text_string);

			give_money(playerid,-sell_price[seller_id[playerid]]);
			give_money(seller_id[playerid], sell_price[seller_id[playerid]]);
			insert_money_log(seller_id[playerid], playerid, sell_price[seller_id[playerid]], "بيعzone");

			GangZoneStopFlashForAll(gz_info[sell_item[seller_id[playerid]]][gz_created]);
			HideZoneForAll(gz_info[sell_item[seller_id[playerid]]][gz_created]);
			ShowZoneForAll(gz_info[sell_item[seller_id[playerid]]][gz_created], GetGangZoneColor(gz_info[sell_item[seller_id[playerid]]][gz_owner]));
			SaveGangZone(sell_item[seller_id[playerid]]);


			buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
			sell_price[seller_id[playerid]] = -1;
			sell_item[seller_id[playerid]] = -1;
			seller_id[playerid] = INVALID_PLAYER_ID;


		}
		case d_makegun:
		{
			if(!response) return 1;
			if(PlayerInfo[playerid][crim_guns] < mg_info[listitem][mg_guns])
			{
			    new _text_string[108];
				format(_text_string, 108, ""c_orange_red"* "c_grey"تحتاج إلى "c_orange_red"%d"c_grey" ed. أسلحة to build thهو سلاح.", mg_info[listitem][mg_guns]);
			    SendClientMessage(playerid, col_gray, _text_string);
			    return 1;
			}
            show_dialog(playerid, d_makegun_, DIALOG_STYLE_INPUT, ""c_server"Assembling الأسلحة",""c_white"How many rounds do you want to use for thهو سلاح?", "Collect", "إلغاء");
			SetPVarInt(playerid, "makegun_القائمةالعنصر", listitem);

		}
		case d_makegun_:
		{
			if(!response)
			{
				global_string = ""c_white"Title of سلاح\t"c_white"الرقم of ed.أسلحة\n";
				for(new i = 0; i < 7; i++)
				{
					format(global_string, 1000, "%s%s\t%i\n", global_string, mg_info[i][mg_name], mg_info[i][mg_guns]);
				}
				show_dialog(playerid, d_makegun, DIALOG_STYLE_TABLIST_HEADERS, ""c_server"Assembling الأسلحة", global_string, "Entekhab", "Bastan");
				DeletePVar(playerid, "makegun_القائمةالعنصر");
				return 1;
			}

   			new ammos = strval(inputtext);
   			new listitem_gun = GetPVarInt(playerid, "makegun_القائمةالعنصر");
			if(ammos < 1 || ammos > 500)
			{
				SendClientMessage(playerid, col_gray,""c_orange_red"* "c_grey"You can make it from "c_orange_red"1 "c_grey"to "c_orange_red"500"c_grey".");
				return show_dialog(playerid, d_makegun_, DIALOG_STYLE_INPUT, ""c_server"Assembling الأسلحة",""c_white"How many rounds do you want to use for thهو سلاح?", "Collect", "إلغاء");
			}
			if(PlayerInfo[playerid][crim_ammo] < ammos) return SendError(playerid, "لا تملك that much الذخيرة.");

		    give_weapon(playerid, mg_info[listitem_gun][mg_gunid], ammos);

			me_action(playerid, "made a سلاح from a part");
			SetPlayerChatBubble(playerid, "collected الأسلحة", col_light_purple, 30.0, 10000);

            PlayerInfo[playerid][crim_ammo] -= ammos;
            if(GetPlayerWeapon(playerid)!= mg_info[listitem_gun][mg_gunid])
            {
				PlayerInfo[playerid][crim_guns] -= mg_info[listitem_gun][mg_guns];
			}
			update_int_sql(playerid, "u_الذخيرة", PlayerInfo[playerid][crim_ammo]);
			update_int_sql(playerid, "u_guns", PlayerInfo[playerid][crim_guns]);


			DeletePVar(playerid, "makegun_القائمةالعنصر");
		    return 1;
		}
		case d_gun_sell_accept:
		{
			if(seller_id[playerid] == INVALID_PLAYER_ID) return SendError(playerid, "The بيعer left the game.");
			if(!response)
			{
				SendClientMessage(seller_id[playerid], col_gray, ""c_orange_red"* "c_grey"The اللاعب refused to شراء الأسلحة.");
				buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
				sell_price[seller_id[playerid]] = -1;
				sell_item[seller_id[playerid]] = -1;
				seller_id[playerid] = INVALID_PLAYER_ID;
				return 1;
			}

			if(PlayerInfo[playerid][money] < sell_price[seller_id[playerid]])
			{
				SendClientMessage(seller_id[playerid], col_gray, ""c_orange_red"* "c_grey"Bazikon pol kafi baraye kharid in ro ndarad.");
				SendError(playerid, "Shoma Pol Kafi nadarid for شراء.");
				buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
				sell_price[seller_id[playerid]] = -1;
				sell_item[seller_id[playerid]] = -1;
				seller_id[playerid] = INVALID_PLAYER_ID;
				return 1;
			}
			new weapon_id = GetPVarInt(seller_id[playerid], "بيع_gunid");
			new weapon_slot = WEAPON_Slot[weapon_id];

			if(PlayerInfo[seller_id[playerid]][Ammo][weapon_slot] < sell_item[seller_id[playerid]])
			{
				SendError(playerid, "The اللاعب does ليس have that many rounds.");
				SendClientMessage(seller_id[playerid], col_gray, ""c_orange_red"* "c_grey"لا تملك that many bullets.");
				buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
				sell_price[seller_id[playerid]] = -1;
				sell_item[seller_id[playerid]] = -1;
				seller_id[playerid] = INVALID_PLAYER_ID;
				return 1;
			}
			if(PlayerInfo[seller_id[playerid]][Weapon][weapon_slot] != weapon_id)
			{
				SendError(playerid, "The اللاعب لا longer has thهو سلاح.");
				SendClientMessage(seller_id[playerid], col_gray, ""c_orange_red"* "c_grey"You لا longer have the سلاح you مطلوب to بيع.");
				buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
				sell_price[seller_id[playerid]] = -1;
				sell_item[seller_id[playerid]] = -1;
				seller_id[playerid] = INVALID_PLAYER_ID;
				return 1;
			}


			give_money(playerid, -sell_price[seller_id[playerid]]);
			give_money(seller_id[playerid], sell_price[seller_id[playerid]]);

			insert_money_log(seller_id[playerid], playerid, sell_price[seller_id[playerid]], "بيعgun");

			give_weapon(playerid, weapon_id, sell_item[seller_id[playerid]]);
			take_weapon(seller_id[playerid], weapon_id, sell_item[seller_id[playerid]]);
			new gun_name[24];
			GetWeaponName(weapon_id, gun_name, sizeof(gun_name));


			new string[82];
			format(string, sizeof(string),""c_green"* %s "c_white"bought %s.", PlayerInfo[playerid][name], gun_name);
			SendClientMessage(seller_id[playerid], col_white, string);
			format(string, sizeof(string),""c_green"* "c_white"You kupili %s у "c_green"%s", gun_name, PlayerInfo[seller_id[playerid]][name]);
			SendClientMessage(playerid, col_white, string);
			format(string, sizeof(string),"تحويلred the سلاح(s) %s.", PlayerInfo[playerid][name]);
			me_action(seller_id[playerid], string);

			buyer_id[seller_id[playerid]] = INVALID_PLAYER_ID;
			sell_price[seller_id[playerid]] = -1;
			sell_item[seller_id[playerid]] = -1;
			seller_id[playerid] = INVALID_PLAYER_ID;
			DeletePVar(seller_id[playerid], "بيع_gunid");

			format(string, 77, "UPالتاريخ `السيرفر_المعلومات` SET `serv_nelegal_gun` = `serv_nelegal_gun` + 1");
			mysql_query(sql_connection, string);

			gunrow++;
		}
